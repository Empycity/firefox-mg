+void FirefoxTraceXHRResponseTypeName(XMLHttpRequestResponseType aType,
+                                     nsACString& aName) {
+  switch (aType) {
+    case XMLHttpRequestResponseType::_empty:
+      aName.AssignLiteral("");
+      return;
+    case XMLHttpRequestResponseType::Arraybuffer:
+      aName.AssignLiteral("arraybuffer");
+      return;
+    case XMLHttpRequestResponseType::Blob:
+      aName.AssignLiteral("blob");
+      return;
+    case XMLHttpRequestResponseType::Document:
+      aName.AssignLiteral("document");
+      return;
+    case XMLHttpRequestResponseType::Json:
+      aName.AssignLiteral("json");
+      return;
+    case XMLHttpRequestResponseType::Text:
+      aName.AssignLiteral("text");
+      return;
+  }
+  aName.AssignLiteral("unknown");
+}
