+bool FirefoxTraceExtractQueryParam(const nsACString& aURL, const char* aName,
+                                   nsACString& aValue) {
+  const nsCString flatURL(PromiseFlatCString(aURL));
+  nsAutoCString needle;
+  needle.AssignLiteral("?");
+  needle.Append(aName);
+  needle.Append('=');
+
+  int32_t pos = flatURL.Find(needle);
+  uint32_t valueStart = 0;
+  if (pos >= 0) {
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  } else {
+    needle.AssignLiteral("&");
+    needle.Append(aName);
+    needle.Append('=');
+    pos = flatURL.Find(needle);
+    if (pos < 0) {
+      return false;
+    }
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  }
+
+  int32_t end = flatURL.FindChar('&', valueStart);
+  if (end < 0) {
+    aValue.Assign(Substring(flatURL, valueStart));
+  } else {
+    aValue.Assign(Substring(flatURL, valueStart,
+                            static_cast<uint32_t>(end) - valueStart));
+  }
+  return true;
+}
+
+bool FirefoxTraceExtractFormParam(const nsACString& aBody, const char* aName,
+                                  nsACString& aValue) {
+  const nsCString flatBody(PromiseFlatCString(aBody));
+  nsAutoCString needle;
+  needle.Append(aName);
+  needle.Append('=');
+
+  int32_t pos = 0;
+  uint32_t valueStart = 0;
+  if (StringBeginsWith(flatBody, needle)) {
+    valueStart = needle.Length();
+  } else {
+    needle.Insert('&', 0);
+    pos = flatBody.Find(needle);
+    if (pos < 0) {
+      return false;
+    }
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  }
+
+  int32_t end = flatBody.FindChar('&', valueStart);
+  if (end < 0) {
+    aValue.Assign(Substring(flatBody, valueStart));
+  } else {
+    aValue.Assign(Substring(flatBody, valueStart,
+                            static_cast<uint32_t>(end) - valueStart));
+  }
+  return true;
+}
+
+bool FirefoxTraceJSONIsSpace(char aChar) {
+  return aChar == ' ' || aChar == '\t' || aChar == '\n' || aChar == '\r';
+}
+
+bool FirefoxTraceJSONExtractValue(const nsCString& aJSON, uint32_t aStart,
+                                  nsACString& aValue) {
+  uint32_t p = aStart;
+  if (p >= aJSON.Length()) {
+    return false;
+  }
+  if (aJSON[p] == '"') {
+    ++p;
+    nsAutoCString out;
+    bool escaped = false;
+    for (; p < aJSON.Length(); ++p) {
+      char c = aJSON[p];
+      if (escaped) {
+        out.Append(c);
+        escaped = false;
+        continue;
+      }
+      if (c == '\\') {
+        escaped = true;
+        continue;
+      }
+      if (c == '"') {
+        aValue.Assign(out);
+        return true;
+      }
+      out.Append(c);
+    }
+    return false;
+  }
+
+  uint32_t start = p;
+  while (p < aJSON.Length() && aJSON[p] != ',' && aJSON[p] != '}' &&
+         aJSON[p] != ']' && !FirefoxTraceJSONIsSpace(aJSON[p])) {
+    ++p;
+  }
+  if (p <= start) {
+    return false;
+  }
+  aValue.Assign(Substring(aJSON, start, p - start));
+  return true;
+}
+
+bool FirefoxTraceJSONFindObjectField(const nsCString& aJSON,
+                                     uint32_t aObjectStart,
+                                     const nsACString& aName,
+                                     uint32_t& aValueStart) {
+  if (aObjectStart >= aJSON.Length() || aJSON[aObjectStart] != '{') {
+    return false;
+  }
+  uint32_t p = aObjectStart + 1;
+  while (p < aJSON.Length()) {
+    while (p < aJSON.Length() &&
+           (FirefoxTraceJSONIsSpace(aJSON[p]) || aJSON[p] == ',')) {
+      ++p;
+    }
+    if (p >= aJSON.Length() || aJSON[p] == '}') {
+      return false;
+    }
+    if (aJSON[p] != '"') {
+      return false;
+    }
+    ++p;
+    nsAutoCString key;
+    bool escaped = false;
+    for (; p < aJSON.Length(); ++p) {
+      char c = aJSON[p];
+      if (escaped) {
+        key.Append(c);
+        escaped = false;
+        continue;
+      }
+      if (c == '\\') {
+        escaped = true;
+        continue;
+      }
+      if (c == '"') {
+        ++p;
+        break;
+      }
+      key.Append(c);
+    }
+    while (p < aJSON.Length() && FirefoxTraceJSONIsSpace(aJSON[p])) {
+      ++p;
+    }
+    if (p >= aJSON.Length() || aJSON[p] != ':') {
+      return false;
+    }
+    ++p;
+    while (p < aJSON.Length() && FirefoxTraceJSONIsSpace(aJSON[p])) {
+      ++p;
+    }
+    if (key.Equals(aName)) {
+      aValueStart = p;
+      return true;
+    }
+
+    if (p < aJSON.Length() && aJSON[p] == '"') {
+      ++p;
+      bool valueEscaped = false;
+      for (; p < aJSON.Length(); ++p) {
+        if (valueEscaped) {
+          valueEscaped = false;
+        } else if (aJSON[p] == '\\') {
+          valueEscaped = true;
+        } else if (aJSON[p] == '"') {
+          ++p;
+          break;
+        }
+      }
+    } else {
+      int32_t depth = 0;
+      for (; p < aJSON.Length(); ++p) {
+        char c = aJSON[p];
+        if (c == '{' || c == '[') {
+          ++depth;
+        } else if (c == '}' || c == ']') {
+          if (depth == 0) {
+            break;
+          }
+          --depth;
+        } else if (c == ',' && depth == 0) {
+          break;
+        }
+      }
+    }
+  }
+  return false;
+}
+
+bool FirefoxTraceExtractJSONField(const nsACString& aBody, const char* aName,
+                                  nsACString& aValue) {
+  const nsCString flatBody(PromiseFlatCString(aBody));
+  uint32_t objectStart = 0;
+  const char* part = aName;
+  while (part && *part) {
+    const char* end = part;
+    while (*end && *end != '.') {
+      ++end;
+    }
+    nsAutoCString segment;
+    segment.Assign(part, static_cast<uint32_t>(end - part));
+    uint32_t valueStart = 0;
+    if (segment.IsEmpty() || !FirefoxTraceJSONFindObjectField(
+                                 flatBody, objectStart, segment, valueStart)) {
+      return false;
+    }
+    if (!*end) {
+      return FirefoxTraceJSONExtractValue(flatBody, valueStart, aValue);
+    }
+    if (valueStart >= flatBody.Length() || flatBody[valueStart] != '{') {
+      return false;
+    }
+    objectStart = valueStart;
+    part = end + 1;
+  }
+  return false;
+}
+
+const char* FirefoxTraceConfiguredFields(bool aBody = false) {
+  const char* configured =
+      aBody ? getenv("FIREFOX_TRACE_BODY_FIELDS")
+            : getenv("FIREFOX_TRACE_QUERY_FIELDS");
+  if (!configured || !configured[0]) {
+    configured = aBody ? getenv("TRACE_BODY_FIELDS")
+                       : getenv("TRACE_QUERY_FIELDS");
+  }
+  if (!configured || !configured[0]) {
+    configured = getenv("FIREFOX_TRACE_QUERY_FIELDS");
+  }
+  if (!configured || !configured[0]) {
+    configured = getenv("TRACE_QUERY_FIELDS");
+  }
+  return configured && configured[0] ? configured : nullptr;
+}
+
+bool FirefoxTraceFirstConfiguredFieldMatch(
+    const std::function<bool(const char*, nsACString&)>& aExtract,
+    nsACString& aFieldName, bool aBody = false) {
+  const char* configured = FirefoxTraceConfiguredFields(aBody);
+  if (!configured || !configured[0]) {
+    return false;
+  }
+
+  uint32_t fieldCount = 0;
+  const char* p = configured;
+  while (*p && fieldCount < 64) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' || *p == '\n' ||
+           *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (end > start) {
+      nsAutoCString fieldName;
+      fieldName.Assign(start, static_cast<uint32_t>(end - start));
+      nsAutoCString fieldValue;
+      if (aExtract(fieldName.get(), fieldValue)) {
+        aFieldName.Assign(fieldName);
+        return true;
+      }
+      ++fieldCount;
+    }
+  }
+  return false;
+}
+
+bool FirefoxTraceFirstConfiguredQueryField(const nsACString& aURL,
+                                           nsACString& aFieldName) {
+  return FirefoxTraceFirstConfiguredFieldMatch(
+      [&aURL](const char* aName, nsACString& aValue) {
+        return FirefoxTraceExtractQueryParam(aURL, aName, aValue);
+      },
+      aFieldName, false);
+}
+
+bool FirefoxTraceFirstConfiguredBodyField(const nsACString& aBody,
+                                          nsACString& aFieldName) {
+  if (aBody.IsEmpty()) {
+    return false;
+  }
+  return FirefoxTraceFirstConfiguredFieldMatch(
+      [&aBody](const char* aName, nsACString& aValue) {
+        if (strcmp(aName, "__raw__") == 0) {
+          aValue.Assign(aBody);
+          return true;
+        }
+        return FirefoxTraceExtractFormParam(aBody, aName, aValue) ||
+               FirefoxTraceExtractJSONField(aBody, aName, aValue);
+      },
+      aFieldName, true);
+}
+
+void FirefoxTraceBuildFieldFlushReason(nsACString& aReason,
+                                       const char* aBaseReason,
+                                       const nsACString& aFieldName) {
+  aReason.Assign(aBaseReason);
