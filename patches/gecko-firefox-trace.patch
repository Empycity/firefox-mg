+bool FirefoxTraceShouldRecordFetchContext(const nsACString& aPageURL,
+                                          const nsACString& aCallerURL) {
+  const char* filter = getenv("FIREFOX_TRACE_FETCH_FILTER");
+  if (!filter || !filter[0]) {
+    filter = getenv("TRACE_FETCH_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = getenv("FIREFOX_TRACE_XHR_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = getenv("FIREFOX_TRACE_DOM_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = "content";
+  }
+
+  if (strcmp(filter, "all") == 0) {
+    return true;
+  }
+
+  const nsACString& contextURL = !aPageURL.IsEmpty() ? aPageURL : aCallerURL;
+  if (strcmp(filter, "chrome") == 0) {
+    return FirefoxTraceFetchIsChromeURL(contextURL);
+  }
+
+  if (strcmp(filter, "web") == 0) {
+    return FirefoxTraceFetchIsWebURL(contextURL);
+  }
+
+  if (contextURL.IsEmpty() || FirefoxTraceFetchIsChromeURL(contextURL)) {
+    return false;
+  }
+
+  return true;
+}
