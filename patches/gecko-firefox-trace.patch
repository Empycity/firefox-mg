+  return static_cast<uint32_t>(parsed);
+}
+
+bool FirefoxTraceBuildReasonSuffix(const char* aReason, char* aOut,
+                                   size_t aOutLen, bool aModuleOnly) {
+  if (!aReason || !aReason[0] || !aOut || aOutLen < 2) {
+    return false;
+  }
+
+  size_t out = 0;
+  bool lastUnderscore = false;
+  for (const char* p = aReason; *p && out + 1 < aOutLen; p++) {
+    if (aModuleOnly && (*p == '.' || *p == ':' || *p == '/')) {
+      break;
+    }
+
+    char c = *p;
+    if (c >= 'a' && c <= 'z') {
+      aOut[out++] = c - 'a' + 'A';
+      lastUnderscore = false;
+    } else if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
+      aOut[out++] = c;
+      lastUnderscore = false;
+    } else if (!lastUnderscore && out > 0) {
+      aOut[out++] = '_';
+      lastUnderscore = true;
+    }
+  }
+
+  while (out > 0 && aOut[out - 1] == '_') {
+    out--;
+  }
+  aOut[out] = '\0';
+  return out > 0;
+}
+
+bool FirefoxTraceReadBoundaryCapacityOverride(const char* aSuffix,
+                                              uint32_t aDefault,
+                                              uint32_t* aOutCapacity,
+                                              char* aOutSource,
+                                              size_t aOutSourceLen) {
+  if (!aSuffix || !aSuffix[0] || !aOutCapacity) {
+    return false;
+  }
+
+  char primary[160];
+  char fallback[160];
+  snprintf(primary, sizeof(primary),
+           "FIREFOX_TRACE_JS_BOUNDARY_BUFFER_EVENTS_%s", aSuffix);
+  snprintf(fallback, sizeof(fallback), "TRACE_JS_BOUNDARY_BUFFER_EVENTS_%s",
+           aSuffix);
+
+  const char* primaryValue = getenv(primary);
+  bool usingPrimary = primaryValue && primaryValue[0];
+  const char* value = usingPrimary ? primaryValue : getenv(fallback);
+  if (!value || !value[0]) {
+    return false;
+  }
+
+  *aOutCapacity = FirefoxTraceParseUintValue(
+      value, aDefault, kFirefoxTraceJSBoundaryBufferMaxCapacity);
+  if (aOutSource && aOutSourceLen) {
+    snprintf(aOutSource, aOutSourceLen, "%s",
+             usingPrimary ? primary : fallback);
+  }
+  return true;
+}
+
+uint32_t FirefoxTraceJSBoundaryBufferCapacityForReason(const char* aReason,
+                                                       char* aOutSource,
+                                                       size_t aOutSourceLen) {
+  uint32_t capacity = FirefoxTraceJSBoundaryBufferCapacity();
+  if (aOutSource && aOutSourceLen) {
+    snprintf(aOutSource, aOutSourceLen, "TRACE_JS_BOUNDARY_BUFFER_EVENTS");
+  }
+
+  char suffix[96];
+  if (FirefoxTraceBuildReasonSuffix(aReason, suffix, sizeof(suffix), false) &&
+      FirefoxTraceReadBoundaryCapacityOverride(suffix, capacity, &capacity,
+                                               aOutSource, aOutSourceLen)) {
+    return capacity ? capacity : 1;
+  }
+
+  if (FirefoxTraceBuildReasonSuffix(aReason, suffix, sizeof(suffix), true) &&
+      FirefoxTraceReadBoundaryCapacityOverride(suffix, capacity, &capacity,
+                                               aOutSource, aOutSourceLen)) {
+    return capacity ? capacity : 1;
+  }
+
+  return capacity ? capacity : 1;
+}
