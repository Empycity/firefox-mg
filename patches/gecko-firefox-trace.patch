+bool FirefoxTraceBaseEnabled() {
+  FirefoxTraceApplyRuntimeConfigEnv();
+
+  if (!FirefoxTraceEnvEnabledAlias("FIREFOX_TRACE_ENABLE", "TRACE_ENABLE")) {
+    return false;
+  }
+  if (!FirefoxTraceEnvEnabledAlias("FIREFOX_TRACE_JS", "TRACE_JS")) {
+    return false;
+  }
+  return !FirefoxTraceRuntimeActive || FirefoxTraceRuntimeActive();
+}
