+             "\"raw_byte\":%u,\"semantic\":\"raw_code_section_byte\"}",
+             moduleId, i, code[i]);
+    FirefoxTraceWasmWriteLine(instruction);
+  }
+  if (count < code.size()) {
+    FirefoxTraceWasmWriteLine(
+        "{\"schema\":\"firefox_trace.wasm.v1\",\"type\":\"trace.degraded\","
+        "\"module\":\"wasm\",\"reason\":\"insn_limit\"}");
+  }
+}
