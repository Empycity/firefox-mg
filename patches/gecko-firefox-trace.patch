+  }
+  if (!configured || !configured[0] || !aName || !aName[0]) {
+    return false;
+  }
+  size_t nameLength = strlen(aName);
+  const char* p = configured;
+  while (*p) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' ||
+           *p == '\n' || *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (static_cast<size_t>(end - start) == nameLength &&
+        strncasecmp(start, aName, nameLength) == 0) {
+      return true;
+    }
+  }
+  return false;
+}
