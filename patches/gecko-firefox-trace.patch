+void FirefoxTraceWasmTraceModule(const BytecodeSource& aSource,
+                                 const ModuleMetadata& aMetadata) {
+  if (!FirefoxTraceWasmEnabled()) {
+    return;
+  }
+  uint32_t limit = FirefoxTraceWasmLimit("TRACE_WASM_MODULE_LIMIT", 32, 1024);
+  uint64_t index = sFirefoxTraceWasmModuleCount.fetch_add(1);
+  if (limit && index >= limit) {
+    if (index == limit) {
+      FirefoxTraceWasmWriteLine(
+          "{\"schema\":\"firefox_trace.wasm.v1\",\"type\":\"trace.degraded\","
+          "\"module\":\"wasm\",\"reason\":\"module_limit\"}");
+    }
+    return;
+  }
+
+  mozilla::SHA1Sum::Hash hash;
+  aSource.computeHash(&hash);
+  const auto* hashBytes = reinterpret_cast<const uint8_t*>(&hash);
+  char moduleId[mozilla::SHA1Sum::kHashSize * 2 + 1];
+  static const char kHex[] = "0123456789abcdef";
+  for (size_t i = 0; i < sizeof(hash); ++i) {
+    moduleId[i * 2] = kHex[hashBytes[i] >> 4];
+    moduleId[i * 2 + 1] = kHex[hashBytes[i] & 0x0f];
+  }
+  moduleId[sizeof(hash) * 2] = '\0';
+
+  uint32_t previewLimit = FirefoxTraceWasmLimit("TRACE_WASM_PREVIEW_BYTES", 64, 4096);
+  // Zero is the UI's unlimited spelling.  The inline JSON preview has a
+  // fixed 4096-byte capacity, while the complete module remains available in
+  // the artifact below.
+  if (!previewLimit) {
+    previewLimit = 4096;
+  }
+  Bytes moduleBytes;
+  bool copied = moduleBytes.resize(aSource.length());
+  if (copied) {
+    aSource.copyTo(moduleBytes.begin());
+  }
+  uint32_t previewSize =
+      copied ? std::min<uint32_t>(moduleBytes.length(), previewLimit) : 0;
+  bool dumpRequested = FirefoxTraceWasmEnvEnabled("TRACE_WASM_DUMP");
+  uint32_t dumpLimit = FirefoxTraceWasmLimit("TRACE_WASM_DUMP_MAX_BYTES", 1024 * 1024,
+                                              16 * 1024 * 1024);
+  bool dumped = false;
+  char artifactPath[256] = "";
+  if (dumpRequested && (!dumpLimit || aSource.length() <= dumpLimit) && copied) {
+    snprintf(artifactPath, sizeof(artifactPath), "wasm/%s.wasm", moduleId);
+#if defined(__APPLE__) || defined(__GNUC__)
+    dumped = FirefoxTraceQueueWasmArtifactToParent &&
+             FirefoxTraceQueueWasmArtifactToParent(
+                 moduleId, reinterpret_cast<const char*>(moduleBytes.begin()),
+                 moduleBytes.length());
+#endif
+    if (!dumped) {
+      artifactPath[0] = '\0';
+    }
+  }
+
+  char preview[8193];
+  FirefoxTraceWasmAppendHex(preview, sizeof(preview),
+                            copied ? moduleBytes.begin() : nullptr,
+                            previewSize);
+  char line[12288];
+  snprintf(line, sizeof(line),
+           "{\"schema\":\"firefox_trace.wasm.v1\",\"type\":\"wasm.module\",\"ts_us\":%llu,"
+           "\"module_id\":\"%s\",\"module_sha1\":\"%s\",\"bytecode_size\":%llu,"
+           "\"code_section_size\":%llu,\"function_count\":%llu,\"function_import_count\":%u,"
+           "\"bytecode_preview_hex\":\"%s\",\"bytecode_preview_truncated\":%s,"
+           "\"dump_requested\":%s,\"dump_stored\":%s,\"dump_truncated\":%s,\"artifact_path\":\"%s\"}",
+           static_cast<unsigned long long>(FirefoxTraceWasmNowUS()), moduleId, moduleId,
+           static_cast<unsigned long long>(aSource.length()),
+           static_cast<unsigned long long>(aSource.hasCodeSection() ? aSource.codeSpan().size() : 0),
+           static_cast<unsigned long long>(aMetadata.codeMeta->numFuncs()),
+           aMetadata.codeMeta->numFuncImports, preview,
+           !copied || aSource.length() > previewSize ? "true" : "false",
+           dumpRequested ? "true" : "false", dumped ? "true" : "false",
+           dumpRequested && dumpLimit && aSource.length() > dumpLimit ? "true" : "false", artifactPath);
+  FirefoxTraceWasmWriteLine(line);
+
+  if (!FirefoxTraceWasmEnvEnabled("TRACE_WASM_INSN") || !aSource.hasCodeSection()) {
+    return;
+  }
+  uint32_t insnLimit = FirefoxTraceWasmLimit("TRACE_WASM_INSN_LIMIT", 256, 65536);
+  BytecodeSpan code = aSource.codeSpan();
+  uint32_t count = insnLimit ? std::min<uint32_t>(code.size(), insnLimit)
