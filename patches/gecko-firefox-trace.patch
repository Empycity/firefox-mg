+  if (!limit) {
+    if (aCountOut) {
+      *aCountOut = 0;
+    }
+    return true;
+  }
+
+  uint64_t key =
+      FirefoxTraceDOMHotMemberKey(aOperation, aInterfaceName, aMemberName);
+  FirefoxTraceDOMHotSlot* slot = FirefoxTraceDOMHotMemberSlot(key);
+  if (!slot) {
+    if (aCountOut) {
+      *aCountOut = 0;
+    }
+    return true;
+  }
+
+  uint64_t count =
+      slot->count.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (aCountOut) {
+    *aCountOut = count;
+  }
+  if (count <= limit) {
+    return true;
+  }
+
+  bool expected = false;
+  if (slot->sentinel.compare_exchange_strong(expected, true,
+                                            std::memory_order_relaxed)) {
+    FirefoxTraceWriteDOMHotMemberSentinel(aOperation, aInterfaceName,
+                                          aMemberName, count, limit,
+                                          FirefoxTraceDOMHotMemberSample());
+  }
+
+  uint32_t sample = FirefoxTraceDOMHotMemberSample();
+  if (!sample) {
+    return false;
+  }
+  return count % sample == 0;
+}
+
+bool FirefoxTraceContainsCString(const char* aHaystack, const char* aNeedle,
+                                 size_t aNeedleLen) {
+  if (!aHaystack || !aNeedle || aNeedleLen == 0) {
+    return false;
+  }
+  size_t haystackLen = strlen(aHaystack);
+  if (aNeedleLen > haystackLen) {
+    return false;
+  }
+  for (size_t i = 0; i + aNeedleLen <= haystackLen; i++) {
+    if (strncmp(aHaystack + i, aNeedle, aNeedleLen) == 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool FirefoxTraceCSVMatchesCString(const char* aCSV, const char* aValue) {
+  if (!aCSV || !aCSV[0] || !aValue || !aValue[0]) {
+    return false;
+  }
+
+  const char* p = aCSV;
+  while (*p) {
+    while (*p == ',' || *p == ' ' || *p == '\t') {
+      p++;
+    }
+    const char* start = p;
+    while (*p && *p != ',') {
+      p++;
+    }
+    const char* end = p;
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t')) {
+      end--;
+    }
+    if (end > start) {
+      bool exact = *start == '=';
+      if (exact) {
+        start++;
+      }
+      size_t tokenLen = static_cast<size_t>(end - start);
+      if (!tokenLen) {
+        continue;
+      }
+      if (exact) {
+        if (strlen(aValue) == tokenLen &&
+            strncmp(aValue, start, tokenLen) == 0) {
+          return true;
+        }
+      } else if (FirefoxTraceContainsCString(aValue, start, tokenLen)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool FirefoxTraceDOMConfiguredMemberMatches(const char* aInterfaceName,
+                                            const char* aMemberName,
+                                            const char* aOperation) {
+  const char* interfaces =
+      FirefoxTraceEnv("FIREFOX_TRACE_DOM_INTERFACES", "TRACE_DOM_INTERFACES");
+  if (interfaces && interfaces[0] &&
+      FirefoxTraceCSVMatchesCString(interfaces, aInterfaceName)) {
+    return true;
+  }
+
+  const char* members =
+      FirefoxTraceEnv("FIREFOX_TRACE_DOM_MEMBERS", "TRACE_DOM_MEMBERS");
+  if (!members || !members[0]) {
+    return false;
+  }
+
+  nsAutoCString key;
+  if (aInterfaceName) {
+    key.Append(aInterfaceName);
+  }
+  key.Append('.');
+  if (aMemberName) {
+    key.Append(aMemberName);
+  }
+
+  return FirefoxTraceCSVMatchesCString(members, aMemberName) ||
+         FirefoxTraceCSVMatchesCString(members, key.get()) ||
+         FirefoxTraceCSVMatchesCString(members, aInterfaceName) ||
+         FirefoxTraceCSVMatchesCString(members, aOperation);
+}
+
+bool FirefoxTraceDOMIsSignalMember(const char* aInterfaceName,
+                                   const char* aMemberName,
+                                   const char* aOperation) {
+  if (!aInterfaceName || !aMemberName) {
+    return false;
+  }
+
+  if (FirefoxTraceCSVMatchesCString(
+          "Navigator,NavigatorUAData,WorkerNavigator", aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "userAgent,appVersion,platform,oscpu,vendor,product,language,"
+        "languages,webdriver,hardwareConcurrency,deviceMemory,maxTouchPoints,"
+        "cookieEnabled,onLine,plugins,mimeTypes,permissions,userAgentData,"
+        "getBattery,javaEnabled,vibrate",
+        aMemberName);
+  }
+
+  if (FirefoxTraceCSVMatchesCString("Screen", aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "width,height,availWidth,availHeight,colorDepth,pixelDepth,orientation",
+        aMemberName);
+  }
+
+  if (FirefoxTraceCSVMatchesCString("Window", aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "innerWidth,innerHeight,outerWidth,outerHeight,screenX,screenY,"
+        "devicePixelRatio,matchMedia,open,postMessage",
+        aMemberName);
+  }
+
+  if (FirefoxTraceCSVMatchesCString("Document", aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "hidden,visibilityState,referrer,characterSet,compatMode,fonts,"
+        "hasFocus,createElement",
+        aMemberName);
+  }
+
+  if (FirefoxTraceCSVMatchesCString(
+          "HTMLCanvasElement,OffscreenCanvas,CanvasRenderingContext2D",
+          aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "getContext,toDataURL,toBlob,convertToBlob,getImageData,measureText,"
+        "isPointInPath,isPointInStroke,fillText,strokeText",
+        aMemberName);
+  }
+
+  if (FirefoxTraceContainsCString(aInterfaceName, "WebGL", 5)) {
+    return FirefoxTraceCSVMatchesCString(
+        "getParameter,getExtension,getSupportedExtensions,readPixels,"
+        "getShaderPrecisionFormat,getContextAttributes,getRendererInfo",
+        aMemberName);
+  }
+
+  if (FirefoxTraceCSVMatchesCString(
+          "Crypto,SubtleCrypto,Performance,PerformanceNavigationTiming,"
+          "PerformanceResourceTiming,History,Location,Permissions,"
+          "RTCPeerConnection",
+          aInterfaceName)) {
+    return true;
+  }
+
+  if (strcmp(aOperation, "dom.construct") == 0) {
+    return FirefoxTraceCSVMatchesCString(
+        "XMLHttpRequest,Request,Response,Headers,WebSocket,Worker,"
+        "SharedWorker,RTCPeerConnection,AudioContext,OfflineAudioContext",
+        aInterfaceName);
+  }
+
+  return false;
+}
+
+bool FirefoxTraceShouldRecordDOMMember(const char* aOperation,
+                                       const char* aInterfaceName,
+                                       const char* aMemberName) {
+  const char* mode =
+      FirefoxTraceEnv("FIREFOX_TRACE_DOM_MODE", "TRACE_DOM_MODE");
+  if (!mode || !mode[0]) {
+    mode = FirefoxTraceProfileIs("deep") ? "all" : "signal";
+  }
+
+  if (strcmp(mode, "off") == 0) {
+    return false;
+  }
+  if (strcmp(mode, "all") == 0 || strcmp(mode, "full") == 0) {
+    return true;
+  }
+  if (FirefoxTraceDOMConfiguredMemberMatches(aInterfaceName, aMemberName,
+                                             aOperation)) {
+    return true;
+  }
+
+  // Default "signal": keep fingerprint/risk-relevant DOM surfaces and
+  // explicitly configured members. Full DOM remains available via
+  // TRACE_DOM_MODE=all for narrow reproductions.
+  return FirefoxTraceDOMIsSignalMember(aInterfaceName, aMemberName,
+                                       aOperation);
+}
+
+void FirefoxTraceDescribeValue(JSContext* aCx, JS::Handle<JS::Value> aValue,
+                               nsACString& aKind, nsACString& aPreview);
+
+void FirefoxTraceAppendJsonCString(nsACString& aLine, const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceWriteLine(const nsACString& aLine) {
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+  mkdir(logDir, 0755);
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-dom-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceWriteDOMLineRaw(const nsACString& aLine) {
+  if (XRE_IsContentProcess()) {
+    if (ContentChild* child = ContentChild::GetSingleton()) {
+      Unused << child->SendFirefoxTraceDOMEvent(aLine);
+    }
+    return;
+  }
+
+  FirefoxTraceWriteLine(aLine);
+}
+
+void FirefoxTraceWriteDOMLimitSentinel(uint64_t aLimit) {
+  bool expected = false;
+  if (!sFirefoxTraceDOMLimitSentinelWritten.compare_exchange_strong(expected,
+                                                                    true)) {
+    return;
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\",");
+  line.AppendLiteral("\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(
+      ",\"module\":\"dom\",\"reason\":\"event_limit\",\"limit\":");
+  line.AppendInt(static_cast<uint64_t>(aLimit));
+  line.Append('}');
+  FirefoxTraceWriteDOMLineRaw(line);
+}
+
+void FirefoxTraceWriteDOMEventLine(const nsACString& aLine) {
+  uint64_t limit = FirefoxTraceDOMLimitEvents();
+  if (limit) {
+    uint64_t eventIndex =
+        sFirefoxTraceDOMEventCount.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (eventIndex > limit) {
+      FirefoxTraceWriteDOMLimitSentinel(limit);
+      return;
+    }
+  }
+
+  FirefoxTraceWriteDOMLineRaw(aLine);
+}
+
+void FirefoxTraceAppendDescribedValue(JSContext* aCx, nsACString& aLine,
+                                      JS::Handle<JS::Value> aValue) {
+  nsAutoCString kind;
+  nsAutoCString preview;
+  FirefoxTraceDescribeValue(aCx, aValue, kind, preview);
+
+  aLine.AppendLiteral("{\"kind\":");
+  FirefoxTraceAppendJsonCString(aLine, kind.get());
+  aLine.AppendLiteral(",\"preview\":");
+  FirefoxTraceAppendJsonCString(aLine, preview.get());
+  aLine.Append('}');
+}
+
+void FirefoxTraceDescribeValue(JSContext* aCx, JS::Handle<JS::Value> aValue,
+                               nsACString& aKind, nsACString& aPreview) {
+  if (aValue.isUndefined()) {
+    aKind.AssignLiteral("undefined");
+    aPreview.Truncate();
+    return;
+  }
+  if (aValue.isNull()) {
+    aKind.AssignLiteral("null");
+    aPreview.Truncate();
+    return;
+  }
+  if (aValue.isBoolean()) {
+    aKind.AssignLiteral("boolean");
+    aPreview.Assign(aValue.toBoolean() ? "true"_ns : "false"_ns);
+    return;
+  }
+  if (aValue.isNumber()) {
+    aKind.AssignLiteral("number");
+    aPreview.AppendPrintf("%.17g", aValue.toNumber());
+    return;
+  }
+  if (aValue.isString()) {
+    aKind.AssignLiteral("string");
+    JS::Rooted<JSString*> string(aCx, aValue.toString());
+    JS::UniqueChars utf8 = JS_EncodeStringToUTF8(aCx, string);
+    if (utf8) {
+      aPreview.Assign(utf8.get());
+      if (aPreview.Length() > 512) {
+        aPreview.Truncate(512);
+        aPreview.AppendLiteral("...");
+      }
+    } else {
+      JS_ClearPendingException(aCx);
+      aPreview.AssignLiteral("<encode-failed>");
+    }
+    return;
+  }
+  if (aValue.isSymbol()) {
+    aKind.AssignLiteral("symbol");
+    aPreview.Truncate();
+    return;
+  }
+  if (aValue.isBigInt()) {
+    aKind.AssignLiteral("bigint");
+    aPreview.Truncate();
+    return;
+  }
+  if (aValue.isObject()) {
+    aKind.AssignLiteral("object");
+    aPreview.Assign(JS::GetClass(&aValue.toObject())->name);
+    return;
+  }
+
+  aKind.AssignLiteral("unknown");
+  aPreview.Truncate();
+}
+
+void FirefoxTraceGetCurrentPageURL(JSContext* aCx, nsACString& aPageURL) {
+  JSObject* global = JS::CurrentGlobalOrNull(aCx);
+  if (!global) {
+    return;
+  }
+
+  nsGlobalWindowInner* window = xpc::WindowGlobalOrNull(global);
+  if (!window) {
+    return;
+  }
+
+  Document* document = window->GetExtantDoc();
+  if (!document) {
+    return;
+  }
+
+  nsIURI* uri = document->GetDocumentURI();
+  if (!uri) {
+    return;
+  }
+
+  Unused << uri->GetSpec(aPageURL);
+}
+
+template <typename ArgsT>
+void FirefoxTraceDOMBindingImpl(JSContext* aCx, JS::Handle<JSObject*> aObj,
+                                const char* aOperation,
+                                const char* aInterfaceName,
+                                const char* aMemberName,
+                                JS::Handle<JS::Value> aValue, uint32_t aArgc,
+                                const ArgsT* aArgs,
+                                JS::Handle<JS::Value> aSetterArg) {
+  Unused << aObj;
+
+  if (!FirefoxTraceDOMEnabled()) {
+    return;
+  }
+
+  if (!FirefoxTraceDOMEventAllowed(aOperation)) {
+    return;
+  }
+
+  nsAutoCString pageURL;
+  FirefoxTraceGetCurrentPageURL(aCx, pageURL);
+  if (!FirefoxTraceShouldRecordDOMURL(pageURL)) {
+    return;
+  }
+
+  if (!FirefoxTraceShouldRecordDOMMember(aOperation, aInterfaceName,
+                                         aMemberName)) {
+    return;
+  }
+
+  uint64_t memberCount = 0;
+  if (!FirefoxTraceDOMHotMemberShouldRecord(aOperation, aInterfaceName,
+                                            aMemberName, &memberCount)) {
+    return;
+  }
+
+  const bool previewArgs = FirefoxTraceDOMPreviewAllows("args");
+  const bool previewValue = FirefoxTraceDOMPreviewAllows("value");
+  const bool previewPage = FirefoxTraceDOMPreviewAllows("page");
+  const bool previewCaller = FirefoxTraceDOMPreviewAllows("caller");
+
+  JS::AutoFilename callerFilename;
+  uint32_t callerLine = 0;
+  JS::ColumnNumberOneOrigin callerColumn;
+  bool hasCaller = false;
+  if (previewCaller) {
+    hasCaller =
+        JS::DescribeScriptedCaller(&callerFilename, aCx, &callerLine,
+                                   &callerColumn) &&
+        callerFilename.get();
+  }
+
+  nsAutoCString valueKind;
+  nsAutoCString valuePreview;
+  if (previewValue) {
+    FirefoxTraceDescribeValue(aCx, aValue, valueKind, valuePreview);
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.event.v1\",\"type\":");
+  FirefoxTraceAppendJsonCString(line, aOperation);
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"tid\":\"");
+  line.AppendPrintf("%p", PR_GetCurrentThread());
+  line.AppendLiteral("\",\"interface\":");
+  FirefoxTraceAppendJsonCString(line, aInterfaceName);
+  line.AppendLiteral(",\"member\":");
+  FirefoxTraceAppendJsonCString(line, aMemberName);
+  line.AppendLiteral(",\"argc\":");
+  line.AppendInt(aArgc);
+  if (memberCount) {
+    line.AppendLiteral(",\"member_count\":");
+    line.AppendInt(static_cast<uint64_t>(memberCount));
+  }
+  line.AppendLiteral(",\"args\":[");
+  const uint32_t argPreviewCount =
+      previewArgs ? std::min(aArgc, FirefoxTraceDOMArgLimit()) : 0;
+  for (uint32_t i = 0; i < argPreviewCount; ++i) {
+    if (i) {
+      line.Append(',');
+    }
+
+    if (aArgs) {
+      JS::Rooted<JS::Value> arg(aCx, (*aArgs)[i]);
+      FirefoxTraceAppendDescribedValue(aCx, line, arg);
+    } else if (i == 0) {
+      FirefoxTraceAppendDescribedValue(aCx, line, aSetterArg);
+    } else {
+      FirefoxTraceAppendDescribedValue(aCx, line, JS::UndefinedHandleValue);
+    }
+  }
+  line.Append(']');
+  if (!previewArgs) {
+    line.AppendLiteral(",\"args_preview_enabled\":false");
+  }
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  line.AppendLiteral(",\"origin_call_id\":");
+  if (originCallId) {
+    line.AppendPrintf("\"call_%llu\"",
+                      static_cast<unsigned long long>(originCallId));
+  } else {
+    line.AppendLiteral("null");
+  }
+  if (previewValue) {
+    line.AppendLiteral(",\"value_kind\":");
+    FirefoxTraceAppendJsonCString(line, valueKind.get());
+    line.AppendLiteral(",\"value_preview\":");
+    FirefoxTraceAppendJsonCString(line, valuePreview.get());
+  } else {
+    line.AppendLiteral(",\"value_preview_enabled\":false");
+  }
+  if (previewPage) {
+    line.AppendLiteral(",\"page_url\":");
+    FirefoxTraceAppendJsonCString(line, pageURL.get());
+  } else {
+    line.AppendLiteral(",\"page_url_disabled\":true,\"page_url_size\":");
+    line.AppendInt(static_cast<uint64_t>(pageURL.Length()));
+  }
+  if (previewCaller) {
+    line.AppendLiteral(",\"caller_url\":");
+    FirefoxTraceAppendJsonCString(line,
+                                  hasCaller ? callerFilename.get() : nullptr);
+    line.AppendLiteral(",\"caller_line\":");
+    line.AppendInt(hasCaller ? callerLine : 0);
+    line.AppendLiteral(",\"caller_column\":");
+    line.AppendInt(hasCaller ? callerColumn.oneOriginValue() : 0);
+  } else {
+    line.AppendLiteral(",\"caller_preview_enabled\":false");
+  }
+  line.Append('}');
+
+  if (FirefoxTraceFlushJSBoundaryBuffer && originCallId) {
+    FirefoxTraceFlushJSBoundaryBuffer(aOperation);
+  }
+  FirefoxTraceWriteDOMEventLine(line);
+}
