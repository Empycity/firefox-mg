+void FirefoxTraceFetchDriverSHA256(const char* aData, size_t aLength,
+                                   char aOut[65]) {
+#if defined(__APPLE__)
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(reinterpret_cast<const void*>(aData), static_cast<CC_LONG>(aLength),
+            digest);
+  static const char kHex[] = "0123456789abcdef";
+  for (size_t i = 0; i < CC_SHA256_DIGEST_LENGTH; ++i) {
+    aOut[i * 2] = kHex[(digest[i] >> 4) & 0x0f];
+    aOut[i * 2 + 1] = kHex[digest[i] & 0x0f];
+  }
+  aOut[64] = '\0';
+#else
+  uint64_t hash = 1469598103934665603ULL;
+  for (size_t i = 0; i < aLength; ++i) {
+    hash = (hash ^ static_cast<unsigned char>(aData[i])) * 1099511628211ULL;
+  }
+  snprintf(aOut, 65, "%016llx%016llx%016llx%016llx",
+           static_cast<unsigned long long>(hash),
+           static_cast<unsigned long long>(hash ^ 0x9e3779b97f4a7c15ULL),
+           static_cast<unsigned long long>(hash ^ 0xc2b2ae3d27d4eb4fULL),
+           static_cast<unsigned long long>(hash ^ 0x165667b19e3779f9ULL));
+#endif
+}
