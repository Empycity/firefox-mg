diff --git a/dom/ipc/FirefoxTraceBatchWriter.h b/dom/ipc/FirefoxTraceBatchWriter.h
new file mode 100644
--- /dev/null
+++ b/dom/ipc/FirefoxTraceBatchWriter.h
@@ -0,0 +1,52 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_dom_FirefoxTraceBatchWriter_h
+#define mozilla_dom_FirefoxTraceBatchWriter_h
+
+#include <stdio.h>
+#include <sys/stat.h>
+
+namespace mozilla::dom {
+
+// One scope per IPC batch, not one process-global cache: stop/finalize sees
+// closed files, output-directory changes cannot reuse an old descriptor, and
+// unrelated batches never retain unwritten stdio buffers.
+class FirefoxTraceBatchWriter final {
+ public:
+  enum class Stream : size_t {
+    DOM, XHR, Fetch, WebSocket, Storage, Cookie, Wasm, Script, JS, Count
+  };
+
+  FirefoxTraceBatchWriter() = default;
+  FirefoxTraceBatchWriter(const FirefoxTraceBatchWriter&) = delete;
+  FirefoxTraceBatchWriter& operator=(const FirefoxTraceBatchWriter&) = delete;
+
+  ~FirefoxTraceBatchWriter() {
+    for (FILE* file : files_) {
+      if (file) {
+        fclose(file);
+      }
+    }
+  }
+
+  FILE* Open(Stream aStream, const char* aDirectory, const char* aPath) {
+    size_t index = static_cast<size_t>(aStream);
+    if (index >= static_cast<size_t>(Stream::Count)) {
+      return nullptr;
+    }
+    if (!files_[index]) {
+      mkdir(aDirectory, 0755);
+      files_[index] = fopen(aPath, "a");
+    }
+    return files_[index];
+  }
+
+ private:
+  FILE* files_[static_cast<size_t>(Stream::Count)] = {};
+};
+
+}  // namespace mozilla::dom
+
+#endif  // mozilla_dom_FirefoxTraceBatchWriter_h
diff --git a/js/src/vm/FirefoxTraceValueTransport.h b/js/src/vm/FirefoxTraceValueTransport.h
new file mode 100644
--- /dev/null
+++ b/js/src/vm/FirefoxTraceValueTransport.h
@@ -0,0 +1,94 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef vm_FirefoxTraceValueTransport_h
+#define vm_FirefoxTraceValueTransport_h
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+// Exact content-key comparison, never a probabilistic membership filter.
+// Collisions evict an entry and cause a resend, not a missing artifact.
+class FirefoxTraceValueTransportCache {
+  struct Entry {
+    char key[65] = "";
+    size_t length = 0;
+  };
+  static constexpr size_t Capacity = 4096;
+  Entry entries_[Capacity];
+
+  static size_t Slot(const char* key) {
+    uint64_t hash = 1469598103934665603ULL;
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(key); *p; ++p) {
+      hash = (hash ^ *p) * 1099511628211ULL;
+    }
+    return hash % Capacity;
+  }
+
+ public:
+  bool Contains(const char* key, size_t length) const {
+    if (!key || !*key || strlen(key) > 64) {
+      return false;
+    }
+    const Entry& entry = entries_[Slot(key)];
+    return entry.length == length && strcmp(entry.key, key) == 0;
+  }
+
+  void Remember(const char* key, size_t length) {
+    if (!key || !*key || strlen(key) > 64) {
+      return;
+    }
+    Entry& entry = entries_[Slot(key)];
+    strcpy(entry.key, key);
+    entry.length = length;
+  }
+
+  void Clear() {
+    for (Entry& entry : entries_) {
+      entry.key[0] = '\0';
+      entry.length = 0;
+    }
+  }
+};
+
+// Explicit byte lengths preserve embedded NULs. Cut only at a UTF-8 codepoint
+// boundary so a short preview remains valid JSON/UTF-8.
+inline void FirefoxTraceWriteJsonBytes(FILE* file, const char* data, size_t len,
+                                      size_t limit) {
+  size_t end = len < limit ? len : limit;
+  if (end < len) {
+    while (end && (static_cast<unsigned char>(data[end]) & 0xc0) == 0x80) {
+      --end;
+    }
+  }
+  fputc('"', file);
+  for (size_t i = 0; i < end; ++i) {
+    unsigned char c = static_cast<unsigned char>(data[i]);
+    switch (c) {
+      case '"': fputs("\\\"", file); break;
+      case '\\': fputs("\\\\", file); break;
+      case '\b': fputs("\\b", file); break;
+      case '\f': fputs("\\f", file); break;
+      case '\n': fputs("\\n", file); break;
+      case '\r': fputs("\\r", file); break;
+      case '\t': fputs("\\t", file); break;
+      default:
+        if (c < 0x20) {
+          fprintf(file, "\\u%04x", c);
+        } else {
+          fputc(c, file);
+        }
+        break;
+    }
+  }
+  if (end < len) {
+    fputs("...", file);
+  }
+  fputc('"', file);
+}
+
+#endif  // vm_FirefoxTraceValueTransport_h
