+bool FirefoxTraceDOMEnabled() {
+  const char* enabled = FirefoxTraceEnv("FIREFOX_TRACE_ENABLE", "TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return false;
+  }
+  if (FirefoxTraceRuntimeActive && !FirefoxTraceRuntimeActive()) {
+    return false;
+  }
+
+  const char* domEnabled = FirefoxTraceEnv("FIREFOX_TRACE_DOM", "TRACE_DOM");
+  return !domEnabled || strcmp(domEnabled, "0") != 0;
