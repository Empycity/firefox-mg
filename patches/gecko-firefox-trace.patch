+          FirefoxTraceWriteJsonString(file, valueId);
+          fputs(",\"value_store_path\":", file);
+          FirefoxTraceWriteJsonString(file, stored ? relPath : "");
+          fputs(",\"sha256\":", file);
+          FirefoxTraceWriteJsonString(file, sha256);
+          fputs(",\"stored\":", file);
+          fputs(stored ? "true" : "false", file);
