+uint64_t FirefoxTraceDeferredValueHash(const char* aKey) {
+  uint64_t hash = 1469598103934665603ULL;
+  for (const unsigned char* p = reinterpret_cast<const unsigned char*>(aKey);
+       p && *p; p++) {
+    hash ^= *p;
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
+
+bool FirefoxTraceQueueDeferredJSValue(const char* aArtifactKey,
+                                      const char* aData, size_t aLen,
+                                      char* aValueId, size_t aValueIdLen,
+                                      char* aRelPath, size_t aRelPathLen) {
+  if (!aArtifactKey || !aArtifactKey[0] || !aData || !aValueId ||
+      aValueIdLen == 0 || !aRelPath || aRelPathLen == 0) {
+    return false;
+  }
+
+  uint64_t hash = FirefoxTraceDeferredValueHash(aArtifactKey);
+  size_t slot = static_cast<size_t>(hash % kFirefoxTraceDeferredJSValueTableSize);
+  for (size_t probes = 0; probes < kFirefoxTraceDeferredJSValueTableSize;
+       probes++, slot = (slot + 1) % kFirefoxTraceDeferredJSValueTableSize) {
+    uint32_t encoded = sFirefoxTraceDeferredJSValueTable[slot];
+    if (!encoded) {
+      break;
+    }
+    FirefoxTraceDeferredJSValue& existing =
+        sFirefoxTraceDeferredJSValues[encoded - 1];
+    if (strcmp(existing.artifactKey, aArtifactKey) == 0) {
+      snprintf(aValueId, aValueIdLen, "%s", existing.valueId);
+      snprintf(aRelPath, aRelPathLen, "values/%s.txt", existing.artifactKey);
+      return true;
+    }
+  }
+
+  uint32_t budget = FirefoxTraceJSDeferredValuePoolBytes();
+  if (sFirefoxTraceDeferredJSValueCount >= kFirefoxTraceDeferredJSValueMaxEntries ||
+      aLen > budget || sFirefoxTraceDeferredJSValueBytes > budget - aLen) {
+    sFirefoxTraceDeferredJSValueDropped++;
+    return false;
+  }
+  char* copy = static_cast<char*>(malloc(aLen));
+  if (!copy) {
+    sFirefoxTraceDeferredJSValueDropped++;
+    return false;
+  }
+  memcpy(copy, aData, aLen);
+
+  // Insert after allocation so a failed value never leaves a dangling table
+  // entry.  A SHA-256 key makes this a content-addressed, per-window pool.
+  slot = static_cast<size_t>(hash % kFirefoxTraceDeferredJSValueTableSize);
+  while (sFirefoxTraceDeferredJSValueTable[slot]) {
+    slot = (slot + 1) % kFirefoxTraceDeferredJSValueTableSize;
+  }
+  FirefoxTraceDeferredJSValue& entry =
+      sFirefoxTraceDeferredJSValues[sFirefoxTraceDeferredJSValueCount];
+  entry.data = copy;
+  entry.len = aLen;
+  snprintf(entry.artifactKey, sizeof(entry.artifactKey), "%s", aArtifactKey);
+  uint64_t valueSeq =
+      sFirefoxTraceNextJSValueId.fetch_add(1, std::memory_order_relaxed);
+  SprintfLiteral(entry.valueId, "jsv_%d_%llu", getpid(),
+                 static_cast<unsigned long long>(valueSeq));
+  sFirefoxTraceDeferredJSValueTable[slot] =
+      static_cast<uint32_t>(sFirefoxTraceDeferredJSValueCount + 1);
+  sFirefoxTraceDeferredJSValueCount++;
+  sFirefoxTraceDeferredJSValueBytes += aLen;
+  snprintf(aValueId, aValueIdLen, "%s", entry.valueId);
+  snprintf(aRelPath, aRelPathLen, "values/%s.txt", entry.artifactKey);
+  return true;
+}
+
+void FirefoxTraceFlushDeferredJSValues(const char* aReason) {
+  if (!sFirefoxTraceDeferredJSValueCount && !sFirefoxTraceDeferredJSValueDropped) {
+    return;
+  }
+
+  uint64_t failed = 0;
+  for (size_t i = 0; i < sFirefoxTraceDeferredJSValueCount; i++) {
+    FirefoxTraceDeferredJSValue& entry = sFirefoxTraceDeferredJSValues[i];
+    char relPath[512];
+    if (!FirefoxTraceWriteJSValueStoreFileDirect(
+            entry.valueId, entry.artifactKey, entry.data, entry.len, relPath,
+            sizeof(relPath))) {
+      failed++;
+    }
+    free(entry.data);
+    entry = FirefoxTraceDeferredJSValue();
+  }
+  uint64_t dropped = sFirefoxTraceDeferredJSValueDropped;
+  sFirefoxTraceDeferredJSValueCount = 0;
+  sFirefoxTraceDeferredJSValueBytes = 0;
+  sFirefoxTraceDeferredJSValueDropped = 0;
+  memset(sFirefoxTraceDeferredJSValueTable, 0,
+         sizeof(sFirefoxTraceDeferredJSValueTable));
+
+  if (!dropped && !failed) {
+    return;
+  }
+  char line[640];
+  int len = SprintfLiteral(
+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\","
+      "\"ts_us\":%llu,\"pid\":%d,\"module\":\"js\","
+      "\"reason\":\"deferred_value_pool_limit\",\"sink_reason\":",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid());
+  if (len <= 0) {
+    return;
+  }
+#if defined(XP_UNIX)
+  char* lineBuffer = nullptr;
+  size_t lineSize = 0;
+  FILE* file = open_memstream(&lineBuffer, &lineSize);
+#else
+  FILE* file = FirefoxTraceOpenJSLog();
+#endif
+  if (!file) {
+    return;
+  }
+  fwrite(line, 1, static_cast<size_t>(len), file);
+  FirefoxTraceWriteJsonString(file, aReason ? aReason : "");
+  fprintf(file,
+          ",\"dropped\":%llu,\"write_failed\":%llu,"
+          "\"suggestion\":\"increase TRACE_JS_DEFERRED_VALUE_POOL_BYTES "
+          "or narrow the target request scope\"}\n",
+          static_cast<unsigned long long>(dropped),
+          static_cast<unsigned long long>(failed));
+#if defined(XP_UNIX)
+  fclose(file);
+  FirefoxTraceWriteJSEventLineRaw(lineBuffer, lineSize);
+  free(lineBuffer);
+#else
+  fclose(file);
+#endif
+}
