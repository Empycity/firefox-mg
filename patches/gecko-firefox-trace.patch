+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.xhr.v1\",\"type\":\"xhr.body\"");
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"request_id\":\"xhr_");
+  line.AppendInt(static_cast<uint64_t>(mFirefoxTraceXHRId));
+  line.AppendLiteral("\",\"body_kind\":");
+  FirefoxTraceAppendJsonString(line, aBodyKind);
+  if (FirefoxTraceXHRPreviewKindEnabled("body")) {
+    line.AppendLiteral(",\"body_preview\":");
+    nsAutoCString preview(aBodyPreview);
+    FirefoxTraceTruncatePreview(preview);
+    FirefoxTraceAppendJsonString(line, preview);
+  } else {
+    line.AppendLiteral(",\"body_preview_enabled\":false");
+  }
+  if (FirefoxTraceXHRRequestBodyEnabled() && !aBodyPreview.IsEmpty()) {
+    const nsCString flatBody(PromiseFlatCString(aBodyPreview));
+    uint32_t maxBytes = FirefoxTraceXHRRequestBodyMaxBytes();
+    uint32_t capturedSize =
+        flatBody.Length() > maxBytes ? maxBytes : flatBody.Length();
+    nsAutoCString capturedBody;
+    capturedBody.Assign(Substring(flatBody, 0, capturedSize));
+    bool truncated = capturedSize < flatBody.Length();
+    char sha256[65];
+    FirefoxTraceComputeSHA256Hex(flatBody.get(), flatBody.Length(), sha256);
+
+    line.AppendLiteral(",\"request_body_mode\":");
+    FirefoxTraceAppendJsonCString(line, FirefoxTraceXHRRequestBodyMode());
+    line.AppendLiteral(",\"request_body_size\":");
+    line.AppendInt(static_cast<uint64_t>(flatBody.Length()));
+    line.AppendLiteral(",\"request_body_captured_size\":");
+    line.AppendInt(static_cast<uint64_t>(capturedSize));
+    line.AppendLiteral(",\"request_body_truncated\":");
+    line.Append(truncated ? "true" : "false");
+    line.AppendLiteral(",\"request_body_sha256\":");
+    FirefoxTraceAppendJsonCString(line, sha256);
+    if (capturedSize > 0) {
+      nsAutoCString bodyPreview(capturedBody);
+      if (strcmp(FirefoxTraceXHRRequestBodyMode(), "full") != 0) {
+        FirefoxTraceTruncatePreview(bodyPreview);
+      }
+      line.AppendLiteral(",\"request_body_preview\":");
+      FirefoxTraceAppendJsonString(line, bodyPreview);
+      uint32_t hexBytes = FirefoxTraceXHRRequestBodyHexBytes();
+      uint32_t hexSize = capturedSize > hexBytes ? hexBytes : capturedSize;
+      if (hexSize > 0) {
+        static const char kHex[] = "0123456789abcdef";
+        nsAutoCString hex;
+        const unsigned char* bytes =
+            reinterpret_cast<const unsigned char*>(capturedBody.BeginReading());
+        for (uint32_t i = 0; i < hexSize; ++i) {
+          hex.Append(kHex[(bytes[i] >> 4) & 0x0f]);
+          hex.Append(kHex[bytes[i] & 0x0f]);
+        }
+        line.AppendLiteral(",\"request_body_bytes_hex\":");
+        FirefoxTraceAppendJsonString(line, hex);
+      }
+    }
+    if (FirefoxTraceXHRRequestBodyStoreEnabled()) {
+      char valueId[128];
+      char relPath[512];
+      bool stored = FirefoxTraceWriteXHRRequestBodyStoreFile(
+          capturedBody, valueId, sizeof(valueId), relPath, sizeof(relPath));
+      line.AppendLiteral(",\"request_body_value_id\":");
+      FirefoxTraceAppendJsonCString(line, stored ? valueId : "");
+      line.AppendLiteral(",\"request_body_store_path\":");
+      FirefoxTraceAppendJsonCString(line, stored ? relPath : "");
+      line.AppendLiteral(",\"request_body_stored\":");
+      line.Append(stored ? "true" : "false");
+    }
+    FirefoxTraceAppendConfiguredBodyFields(line, aBodyPreview);
+  } else if (FirefoxTraceXHRRequestBodyEnabled()) {
+    line.AppendLiteral(",\"request_body_skipped\":\"non_string_or_empty\"");
+  }
+  line.Append('}');
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  if (FirefoxTraceFlushJSBoundaryBuffer && originCallId) {
+    nsAutoCString matchedBodyField;
+    Unused << FirefoxTraceFirstConfiguredBodyField(aBodyPreview,
+                                                  matchedBodyField);
+    nsAutoCString flushReason;
+    FirefoxTraceBuildFieldFlushReason(flushReason, "xhr.body",
+                                      matchedBodyField);
+    FirefoxTraceFlushJSBoundaryBuffer(flushReason.get());
+  }
+  FirefoxTraceWriteXHRLine(line);
+}
