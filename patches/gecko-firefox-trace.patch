+void FirefoxTraceWriteOpcodeExecutionLimitSentinel(uint32_t aLimit) {
+  bool expected = false;
+  if (!sFirefoxTraceOpcodeExecutionLimitSentinelWritten.compare_exchange_strong(
+          expected, true)) {
+    return;
+  }
+
+  char line[512];
+  int len = SprintfLiteral(
+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\","
+      "\"ts_us\":%llu,\"pid\":%d,\"module\":\"opcode\","
+      "\"reason\":\"opcode_execution_limit\",\"limit\":%u}\n",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(), aLimit);
+  if (len > 0) {
+    FirefoxTraceWriteJSEventLineRaw(line, static_cast<size_t>(len));
+  }
