+  if (FirefoxTraceCSVMatchesCString(
+          "Navigator,NavigatorUAData,WorkerNavigator", aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "userAgent,appVersion,platform,oscpu,vendor,product,language,"
+        "languages,webdriver,hardwareConcurrency,deviceMemory,maxTouchPoints,"
+        "cookieEnabled,onLine,plugins,mimeTypes,permissions,userAgentData,"
+        "getBattery,javaEnabled,vibrate",
+        aMemberName);
