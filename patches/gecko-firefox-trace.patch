+bool FirefoxTraceShouldRecordDOMURL(const nsACString& aURL) {
+  const char* filter =
+      FirefoxTraceEnv("FIREFOX_TRACE_DOM_FILTER", "TRACE_DOM_FILTER");
+  if (!filter || !filter[0]) {
+    filter = "content";
+  }
+
+  if (strcmp(filter, "all") == 0) {
+    return true;
+  }
+
+  if (strcmp(filter, "chrome") == 0) {
+    return FirefoxTraceIsChromeURL(aURL);
+  }
+
+  if (strcmp(filter, "web") == 0) {
+    return FirefoxTraceIsWebURL(aURL);
+  }
+
+  // Default "content": keep real page contexts and drop browser chrome/no-URL
+  // noise. Use FIREFOX_TRACE_DOM_FILTER=all when internal chrome DOM is needed.
+  if (aURL.IsEmpty() || FirefoxTraceIsChromeURL(aURL)) {
+    return false;
+  }
+
+  return true;
+}
