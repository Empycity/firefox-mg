+
+void FirefoxTraceRecordMessage(JSContext* aCx, const char* aTransport,
+                               const char* aDirection, const char* aPhase,
+                               bool aContextAllowed,
+                               uint64_t aMessageId, uint64_t aParentTaskId,
+                               uint64_t aOriginCallId,
+                               JS::Handle<JS::Value> aPayload,
+                               const void* aSender, const void* aReceiver) {
+  if (!aContextAllowed || !FirefoxTraceDOMEnabled()) {
+    return;
+  }
+
+  nsAutoCString pageURL;
+  FirefoxTraceGetCurrentPageURL(aCx, pageURL);
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.event.v1\",\"type\":\"dom.message\",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"tid\":\"");
+  line.AppendPrintf("%p", PR_GetCurrentThread());
+  line.AppendLiteral("\",\"transport\":");
+  FirefoxTraceAppendJsonCString(line, aTransport);
+  line.AppendLiteral(",\"direction\":");
+  FirefoxTraceAppendJsonCString(line, aDirection);
+  line.AppendLiteral(",\"phase\":");
+  FirefoxTraceAppendJsonCString(line, aPhase);
