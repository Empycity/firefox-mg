+bool FirefoxTraceDOMObjectInCurrentCompartment(JSContext* aCx,
+                                               JSObject* aObject) {
+  return aObject &&
+         JS::GetCompartment(aObject) == js::GetContextCompartment(aCx);
+}
+
+// Targeted depth expansion for protocol payloads (postMessage data /
+// MessageEvent.data). Off by default; TRACE_DOM_ARG_OBJECT_DEPTH=1..4.
+uint32_t FirefoxTraceDOMArgObjectDepth() {
+  const char* value = FirefoxTraceEnv("FIREFOX_TRACE_DOM_ARG_OBJECT_DEPTH",
+                                      "TRACE_DOM_ARG_OBJECT_DEPTH");
+  if (!value || !value[0]) {
+    return 0;
+  }
+  char* end = nullptr;
+  unsigned long parsed = strtoul(value, &end, 10);
+  if (end == value) {
+    return 0;
+  }
+  return parsed > 4 ? 4 : parsed;
+}
+
+void FirefoxTraceAppendExpandedValue(JSContext* aCx, nsACString& aLine,
+                                     JS::Handle<JS::Value> aValue,
+                                     uint32_t aDepth);
+
+void FirefoxTraceAppendExpandedObject(JSContext* aCx, nsACString& aLine,
+                                      JS::Handle<JSObject*> aObject,
+                                      uint32_t aDepth) {
+  aLine.Append('{');
+  JS::Rooted<JS::IdVector> ids(aCx, JS::IdVector(aCx));
+  {
+    // Suppress re-entrant DOM tracing while reading properties; getters on
+    // hostile objects must not re-enter the tracer.
+    ++sFirefoxTraceDOMInternalReadDepth;
+    bool ok = JS_Enumerate(aCx, aObject, &ids);
+    --sFirefoxTraceDOMInternalReadDepth;
+    if (!ok) {
+      JS_ClearPendingException(aCx);
+      aLine.AppendLiteral("{\"_enumerate_failed\":true}");
+      return;
+    }
+  }
+  uint32_t written = 0;
+  const uint32_t kMaxKeys = 32;
+  for (size_t i = 0; i < ids.length() && written < kMaxKeys; ++i) {
+    const JS::RootedId id(aCx, ids[i]);
+    if (!id.get().isString()) {
+      continue;
+    }
+    JS::Rooted<JSString*> keyStr(aCx, id.get().toString());
+    JS::UniqueChars keyUtf8 = JS_EncodeStringToUTF8(aCx, keyStr);
+    if (!keyUtf8) {
+      JS_ClearPendingException(aCx);
+      continue;
+    }
+    JS::Rooted<JS::Value> prop(aCx);
+    {
+      ++sFirefoxTraceDOMInternalReadDepth;
+      bool got = JS_GetPropertyById(aCx, aObject, id, &prop);
+      --sFirefoxTraceDOMInternalReadDepth;
+      if (!got) {
+        JS_ClearPendingException(aCx);
+        continue;
+      }
+    }
+    if (written) {
+      aLine.Append(',');
+    }
+    FirefoxTraceAppendJsonCString(aLine, keyUtf8.get());
+    aLine.Append(':');
+    FirefoxTraceAppendExpandedValue(aCx, aLine, prop, aDepth);
+    ++written;
+  }
+  if (ids.length() > kMaxKeys) {
+    if (written) {
+      aLine.Append(',');
+    }
+    aLine.AppendLiteral("\"_keys_truncated\":true");
+  }
+  aLine.Append('}');
+}
+
+void FirefoxTraceAppendExpandedValue(JSContext* aCx, nsACString& aLine,
+                                     JS::Handle<JS::Value> aValue,
+                                     uint32_t aDepth) {
+  if (aDepth == 0 || !aValue.isObject()) {
+    nsAutoCString kind;
+    nsAutoCString preview;
+    FirefoxTraceDescribeValue(aCx, aValue, kind, preview);
+    aLine.AppendLiteral("{\"kind\":");
+    FirefoxTraceAppendJsonCString(aLine, kind.get());
+    aLine.AppendLiteral(",\"preview\":");
+    FirefoxTraceAppendJsonCString(aLine, preview.get());
+    aLine.Append('}');
+    return;
+  }
+  JS::Rooted<JSObject*> obj(aCx, &aValue.toObject());
+  if (!FirefoxTraceDOMObjectInCurrentCompartment(aCx, obj)) {
+    // Cross-compartment (e.g. widget iframe objects): stop at identity.
+    aLine.AppendLiteral("{\"kind\":\"object\",\"cross_compartment\":true}");
+    return;
+  }
+  bool isArray = false;
+  if (JS::IsArrayObject(aCx, obj, &isArray) && isArray) {
+    uint32_t length = 0;
+    if (!JS::GetArrayLength(aCx, obj, &length)) {
+      JS_ClearPendingException(aCx);
+      length = 0;
+    }
+    aLine.Append('[');
+    const uint32_t kMaxItems = 16;
+    uint32_t n = length < kMaxItems ? length : kMaxItems;
+    JS::Rooted<JS::Value> item(aCx);
+    for (uint32_t i = 0; i < n; ++i) {
+      if (i) {
+        aLine.Append(',');
+      }
+      {
+        ++sFirefoxTraceDOMInternalReadDepth;
+        bool got = JS_GetElement(aCx, obj, i, &item);
+        --sFirefoxTraceDOMInternalReadDepth;
+        if (!got) {
+          JS_ClearPendingException(aCx);
+          aLine.AppendLiteral("null");
+          continue;
+        }
+      }
+      FirefoxTraceAppendExpandedValue(aCx, aLine, item, aDepth - 1);
+    }
+    if (length > n) {
+      if (n) {
+        aLine.Append(',');
+      }
+      aLine.AppendLiteral("\"_truncated\"");
+    }
+    aLine.Append(']');
+    return;
+  }
+  FirefoxTraceAppendExpandedObject(aCx, aLine, obj, aDepth - 1);
+}
+
+void FirefoxTraceAppendDescribedValue(JSContext* aCx, nsACString& aLine,
+                                      JS::Handle<JS::Value> aValue,
+                                      bool aIncludeObjectContract = true) {
+  nsAutoCString kind;
+  nsAutoCString preview;
+  FirefoxTraceDescribeValue(aCx, aValue, kind, preview);
+
+  aLine.AppendLiteral("{\"kind\":");
+  FirefoxTraceAppendJsonCString(aLine, kind.get());
+  aLine.AppendLiteral(",\"preview\":");
+  FirefoxTraceAppendJsonCString(aLine, preview.get());
+  if (FirefoxTraceDOMContractEnabled() && aIncludeObjectContract &&
+      aValue.isObject() &&
+      !FirefoxTraceDOMObjectInCurrentCompartment(aCx, &aValue.toObject())) {
+    aLine.AppendLiteral(",\"object_id\":\"");
+    aLine.AppendPrintf("obj_%p", &aValue.toObject());
+    aLine.AppendLiteral("\",\"cross_compartment\":true");
+  } else if (FirefoxTraceDOMContractEnabled() && aIncludeObjectContract &&
+             aValue.isObject() &&
+             FirefoxTraceDOMShouldWriteObjectContract(&aValue.toObject())) {
+    JS::Rooted<JSObject*> object(aCx, &aValue.toObject());
+    aLine.AppendLiteral(",\"object_contract\":");
+    FirefoxTraceAppendObjectContract(aCx, aLine, object);
+  }
+  aLine.Append('}');
+}
+
+void FirefoxTraceDescribeValue(JSContext* aCx, JS::Handle<JS::Value> aValue,
+                               nsACString& aKind, nsACString& aPreview) {
+  if (aValue.isUndefined()) {
+    aKind.AssignLiteral("undefined");
+    aPreview.Truncate();
+    return;
+  }
+  if (aValue.isNull()) {
+    aKind.AssignLiteral("null");
+    aPreview.Truncate();
+    return;
+  }
+  if (aValue.isBoolean()) {
+    aKind.AssignLiteral("boolean");
+    aPreview.Assign(aValue.toBoolean() ? "true"_ns : "false"_ns);
+    return;
+  }
+  if (aValue.isNumber()) {
+    aKind.AssignLiteral("number");
+    aPreview.AppendPrintf("%.17g", aValue.toNumber());
+    return;
+  }
+  if (aValue.isString()) {
+    aKind.AssignLiteral("string");
+    JS::Rooted<JSString*> string(aCx, aValue.toString());
+    JS::UniqueChars utf8 = JS_EncodeStringToUTF8(aCx, string);
+    if (utf8) {
+      aPreview.Assign(utf8.get());
+      const uint32_t limit = FirefoxTraceDOMPreviewLimit();
+      if (aPreview.Length() > limit) {
+        aPreview.Truncate(limit);
+        aPreview.AppendLiteral("...");
+      }
+    } else {
+      JS_ClearPendingException(aCx);
+      aPreview.AssignLiteral("<encode-failed>");
+    }
+    return;
+  }
+  if (aValue.isSymbol()) {
+    aKind.AssignLiteral("symbol");
+    aPreview.Truncate();
+    return;
+  }
+  if (aValue.isBigInt()) {
+    aKind.AssignLiteral("bigint");
+    aPreview.Truncate();
+    return;
+  }
+  if (aValue.isObject()) {
+    aKind.AssignLiteral("object");
+    aPreview.Assign(JS::GetClass(&aValue.toObject())->name);
+    return;
+  }
+
+  aKind.AssignLiteral("unknown");
+  aPreview.Truncate();
+}
+
+// ImageData is a compact fingerprint input: callers commonly hash the pixel
+// bytes, not merely its width/height or JS class.  Capture this one nested
+// typed array.  It is deliberately not a generic recursive object walk. An
+// item limit is applied only when TRACE_DOM_OBJECT_VALUE_ITEMS is explicit.
+void FirefoxTraceAppendNestedTypedArrayValue(JSContext* aCx, nsACString& aLine,
+                                             JS::Handle<JS::Value> aValue) {
+  nsAutoCString kind;
+  nsAutoCString preview;
+  FirefoxTraceDescribeValue(aCx, aValue, kind, preview);
+  aLine.AppendLiteral("{\"kind\":");
+  FirefoxTraceAppendJsonCString(aLine, kind.get());
+  aLine.AppendLiteral(",\"preview\":");
+  FirefoxTraceAppendJsonCString(aLine, preview.get());
+
+  if (aValue.isObject() && strstr(preview.get(), "Array") != nullptr) {
+    JS::Rooted<JSObject*> object(aCx, &aValue.toObject());
+    JS::Rooted<JS::Value> lengthValue(aCx);
+    if (JS_GetProperty(aCx, object, "length", &lengthValue) &&
+        lengthValue.isNumber()) {
+      const uint64_t sourceLength = static_cast<uint64_t>(std::max(
+          0.0, lengthValue.toNumber()));
+      const uint32_t itemLimit = FirefoxTraceDOMObjectValueItemLimit();
+      const uint32_t length = static_cast<uint32_t>(std::min<uint64_t>(
+          sourceLength, itemLimit == UINT32_MAX ? UINT32_MAX : itemLimit));
+      aLine.AppendLiteral(",\"object_values\":{\"length\":");
+      FirefoxTraceAppendDescribedValue(aCx, aLine, lengthValue, false);
+      if (length < sourceLength) {
+        aLine.AppendLiteral(",\"_truncated\":true,\"_item_limit\":");
+        aLine.AppendInt(itemLimit);
+      }
+      for (uint32_t index = 0; index < length; ++index) {
+        JS::Rooted<JS::Value> value(aCx);
+        if (!JS_GetElement(aCx, object, index, &value)) {
+          JS_ClearPendingException(aCx);
+          continue;
+        }
+        aLine.Append(',');
+        nsAutoCString indexName;
+        indexName.AppendInt(index);
+        FirefoxTraceAppendJsonCString(aLine, indexName.get());
+        aLine.Append(':');
+        FirefoxTraceAppendDescribedValue(aCx, aLine, value, false);
+      }
+      aLine.Append('}');
+    } else {
+      JS_ClearPendingException(aCx);
+    }
+  }
+  aLine.Append('}');
+}
+
+void FirefoxTraceAppendObjectValueSnapshot(JSContext* aCx, nsACString& aLine,
+                                           JS::Handle<JSObject*> aObject) {
+  if (!FirefoxTraceDOMObjectValuesEnabled()) {
+    return;
+  }
+  AutoFirefoxTraceDOMInternalRead internalRead;
+  const char* className = JS::GetClass(aObject)->name;
+  const char* const* names = nullptr;
+  bool captureIndexedValues = false;
+  static const char* const kTextMetrics[] = {
+      "width",
+      "actualBoundingBoxLeft",
+      "actualBoundingBoxRight",
+      "fontBoundingBoxAscent",
+      "fontBoundingBoxDescent",
+      "actualBoundingBoxAscent",
+      "actualBoundingBoxDescent",
+      "emHeightAscent",
+      "emHeightDescent",
+      "hangingBaseline",
+      "alphabeticBaseline",
+      "ideographicBaseline",
+      nullptr};
+  static const char* const kImageData[] = {"width", "height", "data", nullptr};
+  static const char* const kShaderPrecision[] = {
+      "rangeMin", "rangeMax", "precision", nullptr};
+  static const char* const kTypedArray[] = {"length", "byteLength", "byteOffset", nullptr};
+  static const char* const kPluginArray[] = {"length", nullptr};
+  static const char* const kArray[] = {"length", nullptr};
+  if (strcmp(className, "TextMetrics") == 0) {
+    names = kTextMetrics;
+  } else if (strcmp(className, "ImageData") == 0) {
+    names = kImageData;
+  } else if (strcmp(className, "WebGLShaderPrecisionFormat") == 0) {
+    names = kShaderPrecision;
+  } else if (strcmp(className, "Array") == 0) {
+    names = kArray;
+    captureIndexedValues = true;
+  } else if (strcmp(className, "PluginArray") == 0) {
+    names = kPluginArray;
+  } else if (strstr(className, "Array") != nullptr) {
+    names = kTypedArray;
+    captureIndexedValues = true;
+  }
+  if (!names) {
+    return;
+  }
+  aLine.AppendLiteral(",\"object_values\":{");
+  bool first = true;
+  for (const char* const* name = names; *name; ++name) {
+    JS::Rooted<JS::Value> value(aCx);
+    if (!JS_GetProperty(aCx, aObject, *name, &value)) {
+      JS_ClearPendingException(aCx);
+      continue;
+    }
+    if (!first) {
+      aLine.Append(',');
+    }
+    first = false;
+    FirefoxTraceAppendJsonCString(aLine, *name);
+    aLine.Append(':');
+    if (strcmp(className, "ImageData") == 0 &&
+        strcmp(*name, "data") == 0) {
+      FirefoxTraceAppendNestedTypedArrayValue(aCx, aLine, value);
+    } else {
+      FirefoxTraceAppendDescribedValue(aCx, aLine, value, false);
+    }
+  }
+  if (captureIndexedValues) {
+    JS::Rooted<JS::Value> lengthValue(aCx);
+    if (JS_GetProperty(aCx, aObject, "length", &lengthValue) &&
+        lengthValue.isNumber()) {
+      const uint64_t sourceLength = static_cast<uint64_t>(std::max(
+          0.0, lengthValue.toNumber()));
+      const uint32_t itemLimit = FirefoxTraceDOMObjectValueItemLimit();
+      const uint32_t length = static_cast<uint32_t>(std::min<uint64_t>(
+          sourceLength, itemLimit == UINT32_MAX ? UINT32_MAX : itemLimit));
+      for (uint32_t index = 0; index < length; ++index) {
+        JS::Rooted<JS::Value> value(aCx);
+        if (!JS_GetElement(aCx, aObject, index, &value)) {
+          JS_ClearPendingException(aCx);
+          continue;
+        }
+        if (!first) {
+          aLine.Append(',');
+        }
+        first = false;
+        nsAutoCString indexName;
+        indexName.AppendInt(index);
+        FirefoxTraceAppendJsonCString(aLine, indexName.get());
+        aLine.Append(':');
+        FirefoxTraceAppendDescribedValue(aCx, aLine, value, false);
+      }
+      if (length < sourceLength) {
+        if (!first) {
+          aLine.Append(',');
+        }
+        aLine.AppendLiteral("\"_truncated\":true,\"_item_limit\":");
+        aLine.AppendInt(itemLimit);
+      }
+    } else {
+      JS_ClearPendingException(aCx);
+    }
+  }
+  aLine.Append('}');
+}
+
+// Environment contracts describe object shape without reading JS properties.
+// In particular, this never invokes a page getter or recursively walks a DOM
+// graph: prototypes and property descriptors are engine metadata.
+void FirefoxTraceAppendObjectContract(JSContext* aCx, nsACString& aLine,
+                                      JS::Handle<JSObject*> aObject) {
+  AutoFirefoxTraceDOMInternalRead internalRead;
+  aLine.AppendLiteral("{\"object_id\":\"");
+  aLine.AppendPrintf("obj_%p", aObject.get());
+  aLine.AppendLiteral("\",\"class\":");
+  FirefoxTraceAppendJsonCString(aLine, JS::GetClass(aObject)->name);
+  aLine.AppendLiteral(",\"realm_id\":\"");
+  aLine.AppendPrintf("realm_%p", JS::CurrentGlobalOrNull(aCx));
+  aLine.AppendLiteral("\",\"prototype_chain\":[");
+
+  JS::Rooted<JSObject*> current(aCx, aObject);
+  JS::Rooted<JSObject*> prototype(aCx);
+  bool prototypeComplete = true;
+  uint32_t count = 0;
+  const uint32_t depth = FirefoxTraceDOMContractPrototypeDepth();
+  while (current && (!depth || count < depth)) {
+    if (!JS_GetPrototype(aCx, current, &prototype)) {
+      JS_ClearPendingException(aCx);
+      prototypeComplete = false;
+      break;
+    }
+    if (!prototype) {
+      break;
+    }
+    if (count) {
+      aLine.Append(',');
+    }
+    FirefoxTraceAppendJsonCString(aLine, JS::GetClass(prototype)->name);
+    current = prototype;
+    ++count;
+  }
+  aLine.AppendLiteral("],\"prototype_complete\":");
+  FirefoxTraceAppendJsonBoolean(aLine, prototypeComplete);
+  aLine.Append('}');
+}
+
+void FirefoxTraceAppendMemberDescriptor(JSContext* aCx, nsACString& aLine,
+                                        JS::Handle<JSObject*> aObject,
+                                        const char* aMemberName) {
+  AutoFirefoxTraceDOMInternalRead internalRead;
+  JS::Rooted<Maybe<JS::PropertyDescriptor>> descriptor(aCx);
+  JS::Rooted<JSObject*> holder(aCx);
+  if (!JS_GetPropertyDescriptor(aCx, aObject, aMemberName, &descriptor,
+                                &holder)) {
+    JS_ClearPendingException(aCx);
+    aLine.AppendLiteral("{\"available\":false,\"error\":\"lookup_failed\"}");
+    return;
+  }
+  if (descriptor.isNothing()) {
+    aLine.AppendLiteral("{\"available\":false}");
+    return;
+  }
+
+  const JS::PropertyDescriptor& entry = *descriptor;
+  aLine.AppendLiteral("{\"available\":true,\"kind\":");
+  FirefoxTraceAppendJsonCString(
+      aLine, entry.isAccessorDescriptor() ? "accessor" : "data");
+  aLine.AppendLiteral(",\"enumerable\":");
+  FirefoxTraceAppendJsonBoolean(aLine,
+                                entry.hasEnumerable() && entry.enumerable());
+  aLine.AppendLiteral(",\"configurable\":");
+  FirefoxTraceAppendJsonBoolean(
+      aLine, entry.hasConfigurable() && entry.configurable());
+  if (entry.isDataDescriptor()) {
+    aLine.AppendLiteral(",\"writable\":");
+    FirefoxTraceAppendJsonBoolean(aLine,
+                                  entry.hasWritable() && entry.writable());
+  } else {
+    aLine.AppendLiteral(",\"has_getter\":");
+    FirefoxTraceAppendJsonBoolean(aLine, entry.hasGetter());
+    aLine.AppendLiteral(",\"has_setter\":");
+    FirefoxTraceAppendJsonBoolean(aLine, entry.hasSetter());
+  }
+  if (holder) {
+    aLine.AppendLiteral(",\"holder\":");
+    FirefoxTraceAppendObjectContract(aCx, aLine, holder);
+  }
+  aLine.Append('}');
+}
+
+void FirefoxTraceGetCurrentPageURL(JSContext* aCx, nsACString& aPageURL) {
+  JSObject* global = JS::CurrentGlobalOrNull(aCx);
+  if (!global) {
+    return;
+  }
+
+  nsGlobalWindowInner* window = xpc::WindowGlobalOrNull(global);
+  if (!window) {
+    return;
+  }
+
+  Document* document = window->GetExtantDoc();
+  if (!document) {
+    return;
+  }
+
+  nsIURI* uri = document->GetDocumentURI();
+  if (!uri) {
+    return;
+  }
+
+  Unused << uri->GetSpec(aPageURL);
+}
+
+template <typename ArgsT>
+void FirefoxTraceDOMBindingImpl(JSContext* aCx, JS::Handle<JSObject*> aObj,
+                                const char* aOperation,
+                                const char* aInterfaceName,
+                                const char* aMemberName,
+                                JS::Handle<JS::Value> aValue, uint32_t aArgc,
+                                const ArgsT* aArgs,
+                                JS::Handle<JS::Value> aSetterArg) {
+  if (sFirefoxTraceDOMInternalReadDepth) {
+    return;
+  }
+  if (!FirefoxTraceDOMEnabled()) {
+    return;
+  }
+
+  if (!FirefoxTraceDOMEventAllowed(aOperation)) {
+    return;
+  }
+
+  nsAutoCString pageURL;
+  FirefoxTraceGetCurrentPageURL(aCx, pageURL);
+  if (!FirefoxTraceShouldRecordDOMURL(pageURL) &&
+      !(strcmp(aMemberName, "postMessage") == 0 &&
+        sFirefoxTraceLastDOMMessageId)) {
+    return;
+  }
+
+  if (!FirefoxTraceShouldRecordDOMMember(aOperation, aInterfaceName,
+                                         aMemberName)) {
+    return;
+  }
+
+  const bool recordReceiverContract =
+      FirefoxTraceDOMContractEnabled() &&
+      FirefoxTraceDOMObjectInCurrentCompartment(aCx, aObj) &&
+      FirefoxTraceDOMShouldWriteObjectContract(aObj);
+  // The receiver and return value have independent identities.  In
+  // particular, a long-lived Document can be deduplicated while a call such
+  // as Document.createElement() still returns a first-seen DOM object whose
+  // prototype/descriptor contract is required for offline replay.
+  const bool recordValueContract =
+      FirefoxTraceDOMContractEnabled() && aValue.isObject() &&
+      FirefoxTraceDOMObjectInCurrentCompartment(aCx, &aValue.toObject()) &&
+      FirefoxTraceDOMShouldWriteObjectContract(&aValue.toObject());
+  JS::Rooted<JSObject*> promiseObject(aCx);
+  bool isPromiseResult = false;
+  if (aValue.isObject() &&
+      FirefoxTraceDOMObjectInCurrentCompartment(aCx, &aValue.toObject())) {
+    promiseObject = &aValue.toObject();
+    isPromiseResult = JS::IsPromiseObject(promiseObject);
+  }
+  uint64_t memberCount = 0;
+  if (!FirefoxTraceDOMHotMemberShouldRecord(aOperation, aInterfaceName,
+                                            aMemberName, &memberCount) &&
+      !recordReceiverContract && !recordValueContract) {
+    return;
+  }
+  const uint64_t eventSequence =
+      sFirefoxTraceDOMEventSequence.fetch_add(1, std::memory_order_relaxed) +
+      1;
+
+  const bool previewArgs = FirefoxTraceDOMPreviewAllows("args");
+  const bool previewValue = FirefoxTraceDOMPreviewAllows("value");
+  const bool previewPage = FirefoxTraceDOMPreviewAllows("page");
+  const bool previewCaller = FirefoxTraceDOMPreviewAllows("caller");
+
+  JS::AutoFilename callerFilename;
+  uint32_t callerLine = 0;
+  JS::ColumnNumberOneOrigin callerColumn;
+  bool hasCaller = false;
+  if (previewCaller) {
+    hasCaller =
+        JS::DescribeScriptedCaller(&callerFilename, aCx, &callerLine,
+                                   &callerColumn) &&
+        callerFilename.get();
+  }
+
+  nsAutoCString valueKind;
+  nsAutoCString valuePreview;
+  if (previewValue) {
+    FirefoxTraceDescribeValue(aCx, aValue, valueKind, valuePreview);
+  }
+  nsAutoCString valueStorePath;
+  uint64_t valueSize = 0;
+  bool valuePreviewTruncated = false;
+  bool valueStoreAttempted = false;
+  bool valueStored = false;
+  const char* valueStoreSkipped = nullptr;
+  if (previewValue && aValue.isString()) {
+    nsAutoCString fullValue;
+    if (FirefoxTraceDOMFullStringValue(aCx, aValue, fullValue)) {
+      valueSize = fullValue.Length();
+      valuePreviewTruncated = fullValue.Length() > valuePreview.Length();
+      const uint64_t minBytes = FirefoxTraceDOMValueStoreMinBytes();
+      const uint64_t maxBytes = FirefoxTraceDOMValueStoreMaxBytes();
+      if (FirefoxTraceDOMValueStoreEnabled()) {
+        if (maxBytes && fullValue.Length() > maxBytes) {
+          valueStoreSkipped = "too_large";
+        } else if (fullValue.Length() < minBytes) {
+          valueStoreSkipped = "below_min_bytes";
+        } else {
+          valueStoreAttempted = true;
+          valueStored = FirefoxTraceDOMWriteValueStoreFile(fullValue, valueStorePath);
+          if (!valueStored) {
+            valueStoreSkipped = "write_failed";
+          }
+        }
+      }
+    }
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.event.v1\",\"type\":");
+  FirefoxTraceAppendJsonCString(line, aOperation);
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"tid\":\"");
+  line.AppendPrintf("%p", PR_GetCurrentThread());
+  line.AppendLiteral("\",\"event_seq\":");
+  line.AppendInt(eventSequence);
+  line.AppendLiteral(",\"interface\":");
+  FirefoxTraceAppendJsonCString(line, aInterfaceName);
+  line.AppendLiteral(",\"member\":");
+  FirefoxTraceAppendJsonCString(line, aMemberName);
+  line.AppendLiteral(",\"argc\":");
+  line.AppendInt(aArgc);
+  if (memberCount) {
+    line.AppendLiteral(",\"member_count\":");
+    line.AppendInt(static_cast<uint64_t>(memberCount));
+  }
+  line.AppendLiteral(",\"args\":[");
+  const uint32_t argLimit = FirefoxTraceDOMArgLimit();
+  const uint32_t argPreviewCount =
+      previewArgs ? std::min(aArgc, argLimit) : 0;
+  for (uint32_t i = 0; i < argPreviewCount; ++i) {
+    if (i) {
+      line.Append(',');
+    }
+
+    if (aArgs) {
+      JS::Rooted<JS::Value> arg(aCx, (*aArgs)[i]);
+      FirefoxTraceAppendDescribedValue(aCx, line, arg);
+      if (i == 0 && aValue.isUndefined() == aValue.isUndefined() &&
+          strcmp(aMemberName, "postMessage") == 0) {
+        const uint32_t argDepth = FirefoxTraceDOMArgObjectDepth();
+        if (argDepth && arg.isObject()) {
+          line.AppendLiteral(",\"arg_object\":");
+          FirefoxTraceAppendExpandedValue(aCx, line, arg, argDepth);
+        }
+      }
+    } else if (i == 0) {
+      FirefoxTraceAppendDescribedValue(aCx, line, aSetterArg);
+    } else {
+      FirefoxTraceAppendDescribedValue(aCx, line, JS::UndefinedHandleValue);
+    }
+  }
+  line.Append(']');
+  if (!previewArgs) {
+    line.AppendLiteral(",\"args_preview_enabled\":false");
+  } else if (argPreviewCount < aArgc) {
+    line.AppendLiteral(",\"args_truncated\":true,\"args_limit\":");
+    line.AppendInt(argLimit);
+  }
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  line.AppendLiteral(",\"origin_call_id\":");
+  if (originCallId) {
+    line.AppendPrintf("\"call_%llu\"",
+                      static_cast<unsigned long long>(originCallId));
+  } else {
+    line.AppendLiteral("null");
+  }
+  if (strcmp(aMemberName, "postMessage") == 0 &&
+      sFirefoxTraceLastDOMMessageId) {
+    line.AppendLiteral(",\"message_id\":\"msg_");
+    line.AppendInt(static_cast<int64_t>(getpid()));
+    line.Append('_');
+    line.AppendInt(sFirefoxTraceLastDOMMessageId);
+    line.Append('"');
+    sFirefoxTraceLastDOMMessageId = 0;
+  }
+  if (isPromiseResult) {
+    line.AppendLiteral(",\"promise_id\":");
+    FirefoxTraceAppendPromiseId(line, promiseObject);
+  }
+  if (FirefoxTraceDOMContractEnabled()) {
+    line.AppendLiteral(",\"contract_capture\":");
+    FirefoxTraceAppendJsonCString(line,
+                                  recordReceiverContract || recordValueContract
+                                      ? "full"
+                                      : "reference");
+    line.AppendLiteral(",\"receiver_object_id\":\"");
+    line.AppendPrintf("obj_%p", aObj.get());
+    line.Append('"');
+    if (aValue.isObject()) {
+      line.AppendLiteral(",\"value_object_id\":\"");
+      line.AppendPrintf("obj_%p", &aValue.toObject());
+      line.Append('"');
+    }
+  }
+  if (recordReceiverContract) {
+    line.AppendLiteral(",\"receiver_contract\":");
+    FirefoxTraceAppendObjectContract(aCx, line, aObj);
+    line.AppendLiteral(",\"member_descriptor\":");
+    FirefoxTraceAppendMemberDescriptor(aCx, line, aObj, aMemberName);
+  }
+  if (recordValueContract) {
+    JS::Rooted<JSObject*> resultObject(aCx, &aValue.toObject());
+    line.AppendLiteral(",\"value_object_contract\":");
+    FirefoxTraceAppendObjectContract(aCx, line, resultObject);
+  }
+  if (aValue.isObject() &&
+      FirefoxTraceDOMObjectInCurrentCompartment(aCx, &aValue.toObject())) {
+    JS::Rooted<JSObject*> resultObject(aCx, &aValue.toObject());
+    FirefoxTraceAppendObjectValueSnapshot(aCx, line, resultObject);
+  }
+  if (FirefoxTraceDOMPromisesEnabled() && isPromiseResult) {
+    const uint64_t promiseIndex = sFirefoxTraceDOMPromiseObservationCount.fetch_add(
+                                      1, std::memory_order_relaxed) +
+                                  1;
+    const uint64_t promiseLimit = FirefoxTraceDOMPromiseLimit();
+    if (!promiseLimit || promiseIndex <= promiseLimit) {
+      nsCOMPtr<nsIGlobalObject> global = xpc::CurrentNativeGlobal(aCx);
+      if (global) {
+        RefPtr<Promise> promise =
+            Promise::CreateFromExisting(global, promiseObject);
+        if (promise) {
+          const char* initialState = "pending";
+          switch (promise->State()) {
+            case Promise::PromiseState::Resolved:
+              initialState = "fulfilled";
+              break;
+            case Promise::PromiseState::Rejected:
+              initialState = "rejected";
+              break;
+            case Promise::PromiseState::Pending:
+              break;
+          }
+          RefPtr<FirefoxTraceDOMPromiseHandler> handler =
+              new FirefoxTraceDOMPromiseHandler(aInterfaceName, aMemberName,
+                                                originCallId, promiseObject);
+          handler->WriteObservedState(initialState);
+          promise->AppendNativeHandler(handler.get(), true);
+        }
+      }
+    } else {
+      FirefoxTraceWriteDOMPromiseLimitSentinel(promiseLimit);
+    }
+  }
+  if (previewValue) {
+    line.AppendLiteral(",\"value_kind\":");
+    FirefoxTraceAppendJsonCString(line, valueKind.get());
+    line.AppendLiteral(",\"value_preview\":");
+    FirefoxTraceAppendJsonCString(line, valuePreview.get());
+    if (aValue.isString()) {
+      line.AppendLiteral(",\"value_size\":");
+      line.AppendInt(valueSize);
+      line.AppendLiteral(",\"value_preview_truncated\":");
+      FirefoxTraceAppendJsonBoolean(line, valuePreviewTruncated);
+      line.AppendLiteral(",\"value_store_attempted\":");
+      FirefoxTraceAppendJsonBoolean(line, valueStoreAttempted);
+      line.AppendLiteral(",\"value_stored\":");
+      FirefoxTraceAppendJsonBoolean(line, valueStored);
+      line.AppendLiteral(",\"value_store_path\":");
+      FirefoxTraceAppendJsonCString(line, valueStorePath.get());
+      if (valueStoreSkipped) {
+        line.AppendLiteral(",\"value_store_skipped\":");
+        FirefoxTraceAppendJsonCString(line, valueStoreSkipped);
+      }
+    }
+  } else {
+    line.AppendLiteral(",\"value_preview_enabled\":false");
+  }
+  // Protocol payload capture: expand MessageEvent.data (and any member named
+  // "data" on message-like interfaces) to the configured depth.
+  {
+    const uint32_t argDepth = FirefoxTraceDOMArgObjectDepth();
+    if (argDepth && aValue.isObject() &&
+        strcmp(aMemberName, "data") == 0 &&
+        strstr(aInterfaceName, "MessageEvent") != nullptr) {
+      line.AppendLiteral(",\"value_object\":");
+      FirefoxTraceAppendExpandedValue(aCx, line, aValue, argDepth);
+    }
+  }
+  if (previewPage) {
+    line.AppendLiteral(",\"page_url\":");
+    FirefoxTraceAppendJsonCString(line, pageURL.get());
+  } else {
+    line.AppendLiteral(",\"page_url_disabled\":true,\"page_url_size\":");
+    line.AppendInt(static_cast<uint64_t>(pageURL.Length()));
+  }
+  if (previewCaller) {
+    line.AppendLiteral(",\"caller_url\":");
+    FirefoxTraceAppendJsonCString(line,
+                                  hasCaller ? callerFilename.get() : nullptr);
+    line.AppendLiteral(",\"caller_line\":");
+    line.AppendInt(hasCaller ? callerLine : 0);
+    line.AppendLiteral(",\"caller_column\":");
+    line.AppendInt(hasCaller ? callerColumn.oneOriginValue() : 0);
+  } else {
+    line.AppendLiteral(",\"caller_preview_enabled\":false");
+  }
+  line.Append('}');
+
+  if (FirefoxTraceFlushJSBoundaryBuffer && originCallId) {
+    FirefoxTraceFlushJSBoundaryBuffer(aOperation);
+  }
+  FirefoxTraceWriteDOMEventLine(line);
+}
