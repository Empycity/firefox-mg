+
+bool FirefoxTraceJSEarlyScriptFilterEnabled() {
+  if (!FirefoxTraceJSModeIsTargetLike() &&
+      !FirefoxTraceJSTargetBoundaryBufferEnabled()) {
+    return false;
+  }
+
+  const char* value =
+      FirefoxTraceEnv("FIREFOX_TRACE_JS_EARLY_SCRIPT_FILTER",
+                      "TRACE_JS_EARLY_SCRIPT_FILTER");
+  if (value && value[0]) {
+    return strcmp(value, "0") != 0 && strcmp(value, "false") != 0 &&
+           strcmp(value, "none") != 0;
+  }
+
+  // Real anti-bot pages often freeze if target/deep mode still performs
+  // function-name/hash/value work for every unrelated script. When a script URL
+  // filter is configured, reject nonmatching scripts before expensive metadata
+  // collection by default. Set TRACE_JS_EARLY_SCRIPT_FILTER=0 when a run needs
+  // complete parent/origin stack coverage outside the target script.
+  return true;
+}
