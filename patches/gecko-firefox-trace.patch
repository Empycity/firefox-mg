+  if (strstr(buffer, "\"mode\": \"prewarm\"") ||
+      strstr(buffer, "\"mode\":\"prewarm\"")) {
+    return FirefoxTraceRuntimeStatePrewarm;
+  }
+  return FirefoxTraceRuntimeStateActive;
+}
