+          FirefoxTraceAppendJsonString(aLine, outputValue);
+        }
+        if (valueNone || truncated || FirefoxTraceQueryFieldValueStoreEnabled()) {
+          FirefoxTraceAppendQueryFieldMetadata(meta, fieldName, fieldValue,
+                                               truncated, valueNone);
+        }
+        wroteAny = true;
+      }
+      ++fieldCount;
+    }
+  }
+  aLine.Append('}');
+  if (!meta.IsEmpty()) {
+    aLine.AppendLiteral(",\"query_fields_meta\":{");
