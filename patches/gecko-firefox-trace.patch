+bool FirefoxTraceShouldLogBoundary(const char* calleeKind,
+                                   const char* scriptUrl,
+                                   bool isScriptedCallee) {
+  if (!FirefoxTraceJSModeIsBoundary()) {
+    return false;
+  }
+
+  if (!isScriptedCallee && !FirefoxTraceJSNativeEnabled()) {
+    return false;
+  }
+  if (calleeKind && strcmp(calleeKind, "self_hosted") == 0 &&
+      !FirefoxTraceJSNativeEnabled()) {
+    return false;
+  }
+
+  const char* filter = FirefoxTraceJSBoundaryFilter();
+  if (!filter || strcmp(filter, "all") == 0) {
+    return true;
+  }
+  if (strcmp(filter, "web") == 0 || strcmp(filter, "content") == 0) {
+    return FirefoxTraceScriptURLIsWeb(scriptUrl);
+  }
+  if (strcmp(filter, "chrome") == 0) {
+    return FirefoxTraceScriptURLIsChromeLike(scriptUrl);
+  }
+  return true;
+}
