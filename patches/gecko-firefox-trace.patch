+bool FirefoxTraceCSVMatchesCString(const char* aCSV, const char* aValue) {
+  if (!aCSV || !aCSV[0] || !aValue || !aValue[0]) {
+    return false;
+  }
+
+  const char* p = aCSV;
+  while (*p) {
+    while (*p == ',' || *p == ' ' || *p == '\t') {
+      p++;
+    }
+    const char* start = p;
+    while (*p && *p != ',') {
+      p++;
+    }
+    const char* end = p;
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t')) {
+      end--;
+    }
+    if (end > start) {
+      bool exact = *start == '=';
+      if (exact) {
+        start++;
+      }
+      size_t tokenLen = static_cast<size_t>(end - start);
+      if (!tokenLen) {
+        continue;
+      }
+      if (exact) {
+        if (strlen(aValue) == tokenLen &&
+            strncmp(aValue, start, tokenLen) == 0) {
+          return true;
+        }
+      } else if (FirefoxTraceContainsCString(aValue, start, tokenLen)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
