+
+void FirefoxTraceAppendConfiguredBodyFields(nsACString& aLine,
+                                            const nsACString& aBody) {
+  if (aBody.IsEmpty()) {
+    return;
+  }
+  const char* configured = FirefoxTraceConfiguredFields(true);
+  if (!configured || !configured[0]) {
+    return;
+  }
+
+  nsAutoCString fields;
+  nsAutoCString meta;
+  bool wroteAny = false;
+  uint32_t fieldCount = 0;
+  const char* valueMode = FirefoxTraceQueryFieldValueMode();
+  bool valueNone = strcmp(valueMode, "none") == 0 ||
+                   strcmp(valueMode, "off") == 0 ||
+                   strcmp(valueMode, "0") == 0;
+  bool valueFull = strcmp(valueMode, "full") == 0;
+  const char* p = configured;
+  while (*p && fieldCount < 64) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' || *p == '\n' ||
+           *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (end > start) {
+      nsAutoCString fieldName;
+      fieldName.Assign(start, static_cast<uint32_t>(end - start));
+      nsAutoCString fieldValue;
+      if (fieldName.EqualsLiteral("__raw__")) {
+        fieldValue.Assign(aBody);
+      } else if (FirefoxTraceExtractFormParam(aBody, fieldName.get(), fieldValue) ||
+          FirefoxTraceExtractJSONField(aBody, fieldName.get(), fieldValue)) {
+      } else {
+        ++fieldCount;
+        continue;
+      }
+      {
+        nsAutoCString outputValue(fieldValue);
+        bool truncated = false;
+        if (!valueNone && !valueFull) {
+          FirefoxTraceTruncatePreview(outputValue);
+          truncated = !outputValue.Equals(fieldValue);
+        }
+        if (wroteAny) {
+          fields.Append(',');
+        }
+        FirefoxTraceAppendJsonString(fields, fieldName);
+        fields.Append(':');
+        if (valueNone) {
+          fields.AppendLiteral("null");
+        } else {
+          FirefoxTraceAppendJsonString(fields, outputValue);
+        }
+        if (valueNone || truncated || FirefoxTraceQueryFieldValueStoreEnabled()) {
+          FirefoxTraceAppendQueryFieldMetadata(meta, fieldName, fieldValue,
+                                               truncated, valueNone);
+        }
+        wroteAny = true;
+      }
+      ++fieldCount;
+    }
+  }
+  if (!wroteAny) {
+    return;
+  }
+  aLine.AppendLiteral(",\"body_fields\":{");
+  aLine.Append(fields);
+  aLine.Append('}');
+  if (!meta.IsEmpty()) {
+    aLine.AppendLiteral(",\"body_fields_meta\":{");
+    aLine.Append(meta);
+    aLine.Append('}');
+  }
+}
