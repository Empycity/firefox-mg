+  if (FirefoxTraceCSVMatchesCString(
+          "Element,HTMLElement,HTMLCanvasElement,HTMLInputElement,"
+          "HTMLTextAreaElement,HTMLButtonElement,HTMLFormElement",
+          aInterfaceName)) {
+    if (FirefoxTraceCSVMatchesCString(
+            "getBoundingClientRect,getClientRects,clientWidth,clientHeight,"
+            "scrollWidth,scrollHeight,scrollLeft,scrollTop,offsetWidth,"
+            "offsetHeight,offsetLeft,offsetTop,id,className,tagName,nodeName,"
+            "getAttribute,setAttribute,contains,matches,closest,querySelector,"
+            "querySelectorAll,value,checked,dataset,style",
+            aMemberName)) {
+      return true;
+    }
+  }
+
+  if (FirefoxTraceCSVMatchesCString(
+          "HTMLCanvasElement,OffscreenCanvas,CanvasRenderingContext2D",
+          aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "getContext,toDataURL,toBlob,convertToBlob,getImageData,measureText,"
+        "isPointInPath,isPointInStroke,fillText,strokeText",
+        aMemberName);
+  }
+
+  if (FirefoxTraceContainsCString(aInterfaceName, "WebGL", 5)) {
+    return FirefoxTraceCSVMatchesCString(
+        "getParameter,getExtension,getSupportedExtensions,readPixels,"
+        "getShaderPrecisionFormat,getContextAttributes,getRendererInfo",
+        aMemberName);
+  }
+
+  if (FirefoxTraceCSVMatchesCString(
+          "Crypto,SubtleCrypto,Performance,PerformanceNavigationTiming,"
+          "PerformanceResourceTiming,History,Location,Permissions,"
+          "RTCPeerConnection",
+          aInterfaceName)) {
+    return true;
+  }
+
+  if (strcmp(aOperation, "dom.construct") == 0) {
+    return FirefoxTraceCSVMatchesCString(
+        "XMLHttpRequest,Request,Response,Headers,WebSocket,Worker,"
+        "SharedWorker,RTCPeerConnection,AudioContext,OfflineAudioContext",
+        aInterfaceName);
+  }
+
+  return false;
+}
+
+bool FirefoxTraceShouldRecordDOMMember(const char* aOperation,
+                                       const char* aInterfaceName,
+                                       const char* aMemberName) {
+  const char* mode =
+      FirefoxTraceEnv("FIREFOX_TRACE_DOM_MODE", "TRACE_DOM_MODE");
+  if (!mode || !mode[0]) {
+    mode = FirefoxTraceProfileIs("deep") ? "all" : "signal";
+  }
+
+  if (strcmp(mode, "off") == 0) {
+    return false;
+  }
+  if (strcmp(mode, "all") == 0 || strcmp(mode, "full") == 0) {
+    return true;
+  }
+  if (FirefoxTraceDOMConfiguredMemberMatches(aInterfaceName, aMemberName,
+                                             aOperation)) {
+    return true;
+  }
+
+  // Default "signal": keep fingerprint/risk-relevant DOM surfaces and
+  // explicitly configured members. Full DOM remains available via
+  // TRACE_DOM_MODE=all for narrow reproductions.
+  return FirefoxTraceDOMIsSignalMember(aInterfaceName, aMemberName,
+                                       aOperation);
+}
