+bool FirefoxTraceHttpBaseEnabled() {
+  const char* enabled = getenv("FIREFOX_TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) return false;
+  // HttpChannelParent runs in the parent process, so it does not receive the
+  // content-process env update. Read the compact control record directly.
+  const char* controlPath = getenv("FIREFOX_TRACE_CONTROL_FILE");
+  if (!controlPath || !controlPath[0]) controlPath = getenv("TRACE_CONTROL_FILE");
+  if (controlPath && controlPath[0]) {
+    FILE* control = fopen(controlPath, "r");
+    if (control) {
+      char contents[8193];
+      size_t size = fread(contents, 1, sizeof(contents) - 1, control);
+      fclose(control);
+      contents[size] = '\0';
+      // Ignore the nested audit snapshot, which may describe the previous
+      // module state rather than the active configuration.
+      if (char* previousState = strstr(contents, "\"previous_state\"")) {
+        *previousState = '\0';
+      }
+      if (strstr(contents, "\"enabled\": false") ||
+          strstr(contents, "\"enabled\":false")) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool FirefoxTraceHttpRawEnabled() {
+  if (!FirefoxTraceHttpBaseEnabled()) return false;
+  const char* controlPath = getenv("FIREFOX_TRACE_CONTROL_FILE");
+  if (!controlPath || !controlPath[0]) controlPath = getenv("TRACE_CONTROL_FILE");
+  if (controlPath && controlPath[0]) {
+    FILE* control = fopen(controlPath, "r");
+    if (control) {
+      char contents[8193];
+      size_t size = fread(contents, 1, sizeof(contents) - 1, control);
+      fclose(control);
+      contents[size] = '\0';
+      if (char* previousState = strstr(contents, "\"previous_state\"")) {
+        *previousState = '\0';
+      }
+      if (strstr(contents, "\"http_raw\": false") ||
+          strstr(contents, "\"http_raw\":false")) {
+        return false;
+      }
+      if (strstr(contents, "\"http_raw\": true") ||
+          strstr(contents, "\"http_raw\":true")) {
+        return true;
+      }
+    }
+  }
+  const char* raw = getenv("FIREFOX_TRACE_HTTP_RAW");
+  if (!raw || !raw[0]) raw = getenv("TRACE_HTTP_RAW");
+  return raw && raw[0] && strcmp(raw, "0") != 0 && strcmp(raw, "false") != 0 && strcmp(raw, "off") != 0;
+}
+
+uint32_t FirefoxTraceHttpRawLimit(const char* aName, uint32_t aDefault, uint32_t aMaximum) {
+  const char* value = getenv(aName);
+  if ((!value || !value[0]) && !strncmp(aName, "FIREFOX_TRACE_", 14)) {
+    nsAutoCString fallback("TRACE_");
+    fallback.Append(aName + 14);
+    value = getenv(fallback.get());
+  }
+  if (!value || !value[0]) return aDefault;
+  // The trace UI uses both "all" and numeric zero for an unlimited budget.
+  // Keep those spellings consistent with the other trace modules instead of
+  // silently falling back to the small default ("all") or disabling capture
+  // altogether ("0").
+  if (!strcmp(value, "all") || !strcmp(value, "full") ||
+      !strcmp(value, "unlimited")) {
+    return 0;
+  }
+  char* end = nullptr;
+  unsigned long parsed = strtoul(value, &end, 10);
+  return end == value ? aDefault : std::min<uint32_t>(parsed, aMaximum);
+}
+
+void FirefoxTraceHttpRawWriteLine(const nsACString& aLine) {
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) logDir = getenv("TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) logDir = "/tmp/firefox-trace";
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') path.Append('/');
+  path.AppendPrintf("firefox-http-raw-%d.jsonl", getpid());
+  FILE* file = fopen(path.get(), "a");
+  if (!file) return;
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceHttpAppendJsonCString(nsACString& aLine,
+                                       const nsACString& aValue) {
+  aLine.Append('"');
+  for (uint32_t index = 0; index < aValue.Length(); ++index) {
+    const unsigned char c = static_cast<unsigned char>(aValue[index]);
+    switch (c) {
+      case '"':
+        aLine.AppendLiteral("\\\"");
+        break;
+      case '\\':
+        aLine.AppendLiteral("\\\\");
+        break;
+      case '\b':
+        aLine.AppendLiteral("\\b");
+        break;
+      case '\f':
+        aLine.AppendLiteral("\\f");
+        break;
+      case '\n':
+        aLine.AppendLiteral("\\n");
+        break;
+      case '\r':
+        aLine.AppendLiteral("\\r");
+        break;
+      case '\t':
+        aLine.AppendLiteral("\\t");
+        break;
+      default:
+        if (c < 0x20) {
+          aLine.AppendPrintf("\\u%04x", c);
+        } else {
+          aLine.Append(c);
+        }
+        break;
+    }
+  }
+  aLine.Append('"');
+}
+
+const char* FirefoxTraceHttpRequestHeadersMode() {
+  const char* mode = getenv("FIREFOX_TRACE_FETCH_REQUEST_HEADERS");
+  if (!mode || !mode[0]) mode = getenv("TRACE_FETCH_REQUEST_HEADERS");
+  if (!mode || !mode[0]) return "none";
+  return !strcmp(mode, "1") ? "preview" : mode;
+}
+
+bool FirefoxTraceHttpRequestHeadersEnabled() {
+  const char* mode = FirefoxTraceHttpRequestHeadersMode();
+  return strcmp(mode, "0") != 0 && strcmp(mode, "none") != 0 &&
+         strcmp(mode, "off") != 0 && strcmp(mode, "false") != 0;
+}
+
+void FirefoxTraceHttpWriteRequestHeaders(
+    const nsHttpHeaderArray& aHeaders, const nsACString& aMethod,
+    HttpBaseChannel* aChannel, dom::BrowserParent* aBrowserParent) {
+  if (!aChannel || !FirefoxTraceHttpBaseEnabled() ||
+      !FirefoxTraceHttpRequestHeadersEnabled()) {
+    return;
+  }
+
+  const char* mode = FirefoxTraceHttpRequestHeadersMode();
+  const bool full = !strcmp(mode, "full");
+  const uint32_t maxCount = FirefoxTraceHttpRawLimit(
+      "FIREFOX_TRACE_FETCH_REQUEST_HEADERS_MAX_COUNT", 64, 512);
+  const uint32_t valueMax = FirefoxTraceHttpRawLimit(
+      "FIREFOX_TRACE_FETCH_REQUEST_HEADER_VALUE_MAX_BYTES", 4096, 65536);
+
+  nsAutoCString url;
+  nsCOMPtr<nsIURI> uri;
+  Unused << aChannel->GetURI(getter_AddRefs(uri));
+  if (uri) Unused << uri->GetSpec(url);
+
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.http.v1\",\"type\":\"http.request_headers\",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(
+      ",\"stage\":\"final_channel\",\"header_provenance\":\"final_http_channel\"");
+  line.AppendLiteral(",\"channel_id\":");
+  line.AppendInt(aChannel->ChannelId());
+  line.AppendLiteral(",\"method\":");
+  FirefoxTraceHttpAppendJsonCString(line, aMethod);
+  line.AppendLiteral(",\"url\":");
+  FirefoxTraceHttpAppendJsonCString(line, url);
+  BrowsingContext* browsingContext =
+      aBrowserParent ? aBrowserParent->GetBrowsingContext() : nullptr;
+  line.AppendLiteral(",\"browsing_context_id\":");
+  if (browsingContext) {
+    line.AppendInt(browsingContext->Id());
+  } else {
+    line.AppendLiteral("null");
+  }
+  line.AppendLiteral(",\"top_level_browsing_context_id\":");
+  if (browsingContext && browsingContext->Top()) {
+    line.AppendInt(browsingContext->Top()->Id());
+  } else {
+    line.AppendLiteral("null");
+  }
+  line.AppendLiteral(",\"headers_mode\":");
+  FirefoxTraceHttpAppendJsonCString(line, nsDependentCString(mode));
+  line.AppendLiteral(",\"headers\":{");
+
+  bool first = true;
+  bool truncated = false;
+  uint32_t emitted = 0;
+  for (uint32_t index = 0; index < aHeaders.Count(); ++index) {
+    if (maxCount && emitted >= maxCount) {
+      truncated = true;
+      break;
+    }
+    nsHttpAtom atom;
+    nsAutoCString originalName;
+    const char* rawValue =
+        aHeaders.PeekHeaderAt(index, atom, originalName);
+    if (!rawValue) {
+      continue;
+    }
+    nsAutoCString name(originalName.IsEmpty() ? atom.val() : originalName);
+    nsAutoCString value(rawValue);
+    bool valueTruncated = false;
+    if ((!full || (valueMax && value.Length() > valueMax)) && valueMax &&
+        value.Length() > valueMax) {
+      value.Truncate(valueMax);
+      value.AppendLiteral("...");
+      valueTruncated = true;
+    }
+    if (!first) line.Append(',');
+    first = false;
+    FirefoxTraceHttpAppendJsonCString(line, name);
+    line.AppendLiteral(":{\"value\":");
+    FirefoxTraceHttpAppendJsonCString(line, value);
+    if (valueTruncated) line.AppendLiteral(",\"truncated\":true");
+    line.Append('}');
+    ++emitted;
+  }
+  line.Append('}');
+  line.AppendLiteral(",\"headers_count\":");
+  line.AppendInt(emitted);
+  line.AppendLiteral(",\"headers_truncated\":");
+  line.Append(truncated ? "true" : "false");
+  line.Append('}');
+  FirefoxTraceHttpRawWriteLine(line);
+}
