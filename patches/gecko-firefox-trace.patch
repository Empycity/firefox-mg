+uint32_t FirefoxTraceFetchResponseHeadersMaxCount() {
+  const char* value = getenv("FIREFOX_TRACE_FETCH_RESPONSE_HEADERS_MAX_COUNT");
+  if (!value || !value[0]) {
+    value = getenv("TRACE_FETCH_RESPONSE_HEADERS_MAX_COUNT");
+  }
+  if (!value || !value[0]) {
+    return 64;
+  }
+  char* end = nullptr;
+  unsigned long parsed = strtoul(value, &end, 10);
+  if (end == value) {
+    return 64;
+  }
+  // Full-chain uses zero for no trace-side header-count cap. Positive values
+  // remain bounded so scoped/lighter captures can protect their output size.
+  return parsed == 0 ? UINT32_MAX
+                     : (parsed > 512 ? 512 : static_cast<uint32_t>(parsed));
+}
+
+uint32_t FirefoxTraceFetchResponseHeaderValueMaxBytes() {
+  const char* value =
+      getenv("FIREFOX_TRACE_FETCH_RESPONSE_HEADER_VALUE_MAX_BYTES");
+  if (!value || !value[0]) {
+    value = getenv("TRACE_FETCH_RESPONSE_HEADER_VALUE_MAX_BYTES");
+  }
+  if (!value || !value[0]) {
+    return 4096;
+  }
+  char* end = nullptr;
+  unsigned long parsed = strtoul(value, &end, 10);
+  if (end == value) {
+    return 4096;
+  }
+  // See the count parser above: zero is the documented unlimited spelling.
+  return parsed == 0 ? UINT32_MAX
+                     : (parsed > 65536 ? 65536
+                                       : static_cast<uint32_t>(parsed));
+}
