+uint64_t FirefoxTraceDOMHotMemberKey(const char* aOperation,
+                                     const char* aInterfaceName,
+                                     const char* aMemberName) {
+  uint64_t hash = 1469598103934665603ULL;
+  hash = FirefoxTraceHashAppend(hash, aOperation);
+  hash = FirefoxTraceHashAppend(hash, "\xff");
+  hash = FirefoxTraceHashAppend(hash, aInterfaceName);
+  hash = FirefoxTraceHashAppend(hash, "\xff");
+  hash = FirefoxTraceHashAppend(hash, aMemberName);
+  return hash ? hash : 1;
+}
+
+FirefoxTraceDOMHotSlot* FirefoxTraceDOMHotMemberSlot(uint64_t aKey) {
+  constexpr size_t kSlotCount =
+      sizeof(sFirefoxTraceDOMHotSlots) / sizeof(sFirefoxTraceDOMHotSlots[0]);
+  size_t start = static_cast<size_t>(aKey % kSlotCount);
+  for (size_t i = 0; i < 16; ++i) {
+    FirefoxTraceDOMHotSlot& slot =
+        sFirefoxTraceDOMHotSlots[(start + i) % kSlotCount];
+    uint64_t current = slot.key.load(std::memory_order_relaxed);
+    if (current == aKey) {
+      return &slot;
+    }
+    if (current == 0) {
+      uint64_t expected = 0;
+      if (slot.key.compare_exchange_strong(expected, aKey,
+                                           std::memory_order_relaxed)) {
+        return &slot;
+      }
+      if (expected == aKey) {
+        return &slot;
+      }
+    }
+  }
+  return nullptr;
+}
