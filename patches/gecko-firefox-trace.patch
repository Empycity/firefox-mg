+void FirefoxTraceWriteJSDeepSuppressionNotice(const char* calleeKind,
+                                              const char* functionName) {
+  bool expected = false;
+  if (!sFirefoxTraceJSDeepSuppressionNoticeWritten.compare_exchange_strong(
+          expected, true)) {
+    return;
+  }
+
+#if defined(XP_UNIX)
+  char* lineBuffer = nullptr;
+  size_t lineSize = 0;
+  FILE* file = open_memstream(&lineBuffer, &lineSize);
+#else
+  FILE* file = FirefoxTraceOpenJSLog();
+#endif
+  if (!file) {
+    return;
+  }
+
+  fprintf(file,
+          "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.suppressed\","
+          "\"ts_us\":%llu,\"pid\":%d,\"module\":\"js\","
+          "\"reason\":\"deep_descendant_suppressed\","
+          "\"first_callee_kind\":",
+          static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid());
+  FirefoxTraceWriteJsonString(file, calleeKind);
+  fputs(",\"first_function_name\":", file);
+  FirefoxTraceWriteJsonString(file, functionName);
+  fputs(",\"note\":\"deep suppression is configured; rerun with "
+        "TRACE_JS_DEEP_NATIVE=1, TRACE_JS_DEEP_SELFHOSTED=1 or adjusted "
+        "TRACE_JS_DEEP_SUPPRESS_FUNCTIONS for fuller low-level calls\"}\n",
+        file);
+
+#if defined(XP_UNIX)
+  fclose(file);
+  FirefoxTraceWriteJSEventLineRaw(lineBuffer, lineSize);
+  free(lineBuffer);
+#else
+  fclose(file);
+#endif
+}
