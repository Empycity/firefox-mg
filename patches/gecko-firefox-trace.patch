+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
