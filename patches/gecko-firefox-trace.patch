+const char* FirefoxTraceFetchConfiguredFields() {
+  const char* configured = getenv("FIREFOX_TRACE_QUERY_FIELDS");
+  if (!configured || !configured[0]) {
+    configured = getenv("TRACE_QUERY_FIELDS");
+  }
+  return configured && configured[0] ? configured : nullptr;
+}
+
+bool FirefoxTraceFetchFirstConfiguredFieldMatch(
+    const std::function<bool(const char*, nsACString&)>& aExtract,
+    nsACString& aFieldName) {
+  const char* configured = FirefoxTraceFetchConfiguredFields();
+  if (!configured || !configured[0]) {
+    return false;
+  }
+
+  uint32_t fieldCount = 0;
+  const char* p = configured;
+  while (*p && fieldCount < 64) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' || *p == '\n' ||
+           *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (end > start) {
+      nsAutoCString fieldName;
+      fieldName.Assign(start, static_cast<uint32_t>(end - start));
+      nsAutoCString fieldValue;
+      if (aExtract(fieldName.get(), fieldValue)) {
+        aFieldName.Assign(fieldName);
+        return true;
+      }
+      ++fieldCount;
+    }
+  }
+  return false;
+}
+
+bool FirefoxTraceFetchFirstConfiguredQueryField(const nsACString& aURL,
+                                                nsACString& aFieldName) {
+  return FirefoxTraceFetchFirstConfiguredFieldMatch(
+      [&aURL](const char* aName, nsACString& aValue) {
+        return FirefoxTraceFetchExtractQueryParam(aURL, aName, aValue);
+      },
+      aFieldName);
+}
+
+void FirefoxTraceFetchBuildFieldFlushReason(nsACString& aReason,
+                                            const char* aBaseReason,
+                                            const nsACString& aFieldName) {
+  aReason.Assign(aBaseReason);
+  if (!aFieldName.IsEmpty()) {
+    aReason.Append('.');
+    aReason.Append(aFieldName);
+  }
+}
+
+void FirefoxTraceFetchAppendConfiguredQueryFields(nsACString& aLine,
+                                                  const nsACString& aURL) {
+  const char* configured = FirefoxTraceFetchConfiguredFields();
+  if (!configured || !configured[0]) {
+    return;
+  }
+
+  aLine.AppendLiteral(",\"query_fields\":{");
+  nsAutoCString meta;
+  bool wroteAny = false;
+  uint32_t fieldCount = 0;
+  const char* valueMode = FirefoxTraceFetchQueryFieldValueMode();
+  bool valueNone = strcmp(valueMode, "none") == 0 ||
+                   strcmp(valueMode, "off") == 0 ||
+                   strcmp(valueMode, "0") == 0;
+  bool valueFull = strcmp(valueMode, "full") == 0;
+  const char* p = configured;
+  while (*p && fieldCount < 64) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' || *p == '\n' ||
+           *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (end > start) {
+      nsAutoCString fieldName;
+      fieldName.Assign(start, static_cast<uint32_t>(end - start));
+      nsAutoCString fieldValue;
+      if (FirefoxTraceFetchExtractQueryParam(aURL, fieldName.get(),
+                                             fieldValue)) {
+        nsAutoCString outputValue(fieldValue);
+        bool truncated = false;
+        if (!valueNone && !valueFull) {
+          FirefoxTraceFetchTruncatePreview(outputValue);
+          truncated = !outputValue.Equals(fieldValue);
+        }
+        if (wroteAny) {
+          aLine.Append(',');
+        }
+        FirefoxTraceFetchAppendJsonString(aLine, fieldName);
+        aLine.Append(':');
+        if (valueNone) {
+          aLine.AppendLiteral("null");
+        } else {
+          FirefoxTraceFetchAppendJsonString(aLine, outputValue);
+        }
+        if (valueNone || truncated ||
+            FirefoxTraceFetchQueryFieldValueStoreEnabled()) {
+          FirefoxTraceFetchAppendQueryFieldMetadata(meta, fieldName,
+                                                   fieldValue, truncated,
+                                                   valueNone);
+        }
+        wroteAny = true;
+      }
+      ++fieldCount;
+    }
+  }
+  aLine.Append('}');
+  if (!meta.IsEmpty()) {
+    aLine.AppendLiteral(",\"query_fields_meta\":{");
+    aLine.Append(meta);
+    aLine.Append('}');
+  }
+}
