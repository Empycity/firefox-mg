+bool FirefoxTraceTrySendEventToParent(const char* aLine, size_t aLen) {
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendEventToParent) {
+    return FirefoxTraceSendEventToParent(aLine, aLen);
+  }
+#endif
+  return false;
+}
+
+void FirefoxTraceWriteJSEventLineRaw(const char* aLine, size_t aLen) {
+  if (!aLine || !aLen) {
+    return;
+  }
+
+  size_t ipcLen = aLen;
+  if (ipcLen && aLine[ipcLen - 1] == '\n') {
+    ipcLen--;
+  }
+  if (ipcLen && FirefoxTraceTrySendEventToParent(aLine, ipcLen)) {
+    return;
+  }
+
+  FILE* file = FirefoxTraceOpenJSLog();
+  if (!file) {
+    return;
+  }
+  fwrite(aLine, 1, aLen, file);
+  if (aLine[aLen - 1] != '\n') {
+    fputc('\n', file);
+  }
+  fclose(file);
+}
