+  return FirefoxTraceParseUintEnv("FIREFOX_TRACE_OPCODE_MAX_BYTES_PER_SECOND",
+                                  "TRACE_OPCODE_MAX_BYTES_PER_SECOND",
+                                  4 * 1024 * 1024,
+                                  8 * 1024 * 1024);
+}
+
+void FirefoxTraceWriteOpcodeRateLimitSentinel(uint32_t aEventLimit,
+                                              uint32_t aByteLimit) {
+  if (sFirefoxTraceOpcodeRateSentinelWritten) {
+    return;
+  }
+  sFirefoxTraceOpcodeRateSentinelWritten = true;
+
+  char line[512];
+  int len = SprintfLiteral(
+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\","
+      "\"ts_us\":%llu,\"pid\":%d,\"module\":\"opcode\","
+      "\"reason\":\"opcode_rate_limit\",\"max_events_per_second\":%u,"
+      "\"max_bytes_per_second\":%u}\n",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+      aEventLimit, aByteLimit);
+  if (len > 0) {
+    FirefoxTraceWriteJSEventLineRaw(line, static_cast<size_t>(len));
+  }
+}
+
+bool FirefoxTraceConsumeOpcodeRateBudget(uint32_t aEstimatedBytes) {
+  uint32_t eventLimit = FirefoxTraceOpcodeMaxEventsPerSecond();
+  uint32_t byteLimit = FirefoxTraceOpcodeMaxBytesPerSecond();
+  if (!eventLimit && !byteLimit) {
+    return true;
+  }
+
+  int64_t now = static_cast<int64_t>(FirefoxTraceNowUS());
+  if (!sFirefoxTraceOpcodeRateWindowStartUS ||
+      now - sFirefoxTraceOpcodeRateWindowStartUS >= 1000000) {
+    sFirefoxTraceOpcodeRateWindowStartUS = now;
+    sFirefoxTraceOpcodeRateEvents = 0;
+    sFirefoxTraceOpcodeRateBytes = 0;
+  }
+
+  if ((eventLimit &&
+       sFirefoxTraceOpcodeRateEvents + 1 > eventLimit) ||
+      (byteLimit &&
+       sFirefoxTraceOpcodeRateBytes + aEstimatedBytes > byteLimit)) {
+    FirefoxTraceWriteOpcodeRateLimitSentinel(eventLimit, byteLimit);
+    return false;
+  }
+
+  sFirefoxTraceOpcodeRateEvents++;
+  sFirefoxTraceOpcodeRateBytes += aEstimatedBytes;
+  return true;
+}
