+class FirefoxTraceDOMPromiseHandler final : public PromiseNativeHandler {
+ public:
+  NS_DECL_ISUPPORTS
+
+  FirefoxTraceDOMPromiseHandler(const char* aInterface, const char* aMember,
+                                uint64_t aOriginCallId,
+                                JSObject* aPromiseObject)
+      : mInterface(aInterface),
+        mMember(aMember),
+        mOriginCallId(aOriginCallId),
+        mPromiseObject(aPromiseObject) {}
+
+  void WriteObservedState(const char* aState) {
+    nsAutoCString line;
+    line.AppendLiteral(
+        "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"dom.promise.observe\",");
+    line.AppendLiteral("\"ts_us\":");
+    line.AppendInt(static_cast<int64_t>(PR_Now()));
+    line.AppendLiteral(",\"pid\":");
+    line.AppendInt(static_cast<int64_t>(getpid()));
+    line.AppendLiteral(",\"interface\":");
+    FirefoxTraceAppendJsonCString(line, mInterface.get());
+    line.AppendLiteral(",\"member\":");
+    FirefoxTraceAppendJsonCString(line, mMember.get());
+    line.AppendLiteral(",\"state\":");
+    FirefoxTraceAppendJsonCString(line, aState);
+    line.AppendLiteral(",\"promise_id\":");
+    FirefoxTraceAppendPromiseId(line, mPromiseObject);
+    line.AppendLiteral(",\"origin_call_id\":");
+    if (mOriginCallId) {
+      line.AppendPrintf("\"call_%llu\"",
+                        static_cast<unsigned long long>(mOriginCallId));
+    } else {
+      line.AppendLiteral("null");
+    }
+    line.Append('}');
+    FirefoxTraceWriteDOMEventLine(line);
+  }
+
+  void ResolvedCallback(JSContext* aCx, JS::Handle<JS::Value> aValue,
+                        ErrorResult& aRv) override {
+    Write(aCx, "fulfilled", aValue);
+  }
+
+  void RejectedCallback(JSContext* aCx, JS::Handle<JS::Value> aValue,
+                        ErrorResult& aRv) override {
+    Write(aCx, "rejected", aValue);
+  }
+
+ private:
+  ~FirefoxTraceDOMPromiseHandler() = default;
+
+  void Write(JSContext* aCx, const char* aState,
+             JS::Handle<JS::Value> aValue) {
+    nsAutoCString kind;
+    nsAutoCString preview;
+    FirefoxTraceDescribeValue(aCx, aValue, kind, preview);
+
+    nsAutoCString line;
+    line.AppendLiteral("{\"schema\":\"firefox_trace.event.v1\",\"type\":\"dom.promise.settle\",");
+    line.AppendLiteral("\"ts_us\":");
+    line.AppendInt(static_cast<int64_t>(PR_Now()));
+    line.AppendLiteral(",\"pid\":");
+    line.AppendInt(static_cast<int64_t>(getpid()));
+    line.AppendLiteral(",\"interface\":");
+    FirefoxTraceAppendJsonCString(line, mInterface.get());
+    line.AppendLiteral(",\"member\":");
+    FirefoxTraceAppendJsonCString(line, mMember.get());
+    line.AppendLiteral(",\"state\":");
+    FirefoxTraceAppendJsonCString(line, aState);
+    line.AppendLiteral(",\"promise_id\":");
+    FirefoxTraceAppendPromiseId(line, mPromiseObject);
+    line.AppendLiteral(",\"origin_call_id\":");
+    if (mOriginCallId) {
+      line.AppendPrintf("\"call_%llu\"",
+                        static_cast<unsigned long long>(mOriginCallId));
+    } else {
+      line.AppendLiteral("null");
+    }
+    line.AppendLiteral(",\"value\":");
+    FirefoxTraceAppendDescribedValue(aCx, line, aValue, true);
+    line.Append('}');
+    FirefoxTraceWriteDOMEventLine(line);
+  }
+
+  nsCString mInterface;
+  nsCString mMember;
+  uint64_t mOriginCallId;
+  JSObject* mPromiseObject;
+};
