+                                    uint32_t aMax) {
+  if (!value || !value[0]) {
+    return aDefault;
+  }
+
+  char* end = nullptr;
+  unsigned long parsed = strtoul(value, &end, 10);
+  if (end == value || parsed == 0) {
+    return aDefault;
+  }
+  if (parsed > aMax) {
