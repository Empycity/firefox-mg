+bool FirefoxTraceXHRConfiguredHeader(const nsACString& aName) {
+  const char* configured = getenv("FIREFOX_TRACE_HEADER_FIELDS");
+  if (!configured || !configured[0]) {
+    configured = getenv("TRACE_HEADER_FIELDS");
+  }
+  nsCString flatName(PromiseFlatCString(aName));
+  if (!configured || !configured[0] || flatName.IsEmpty()) {
+    return false;
+  }
+  const char* p = configured;
+  while (*p) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' ||
+           *p == '\n' || *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (static_cast<size_t>(end - start) == flatName.Length() &&
+        strncasecmp(start, flatName.get(), flatName.Length()) == 0) {
+      return true;
+    }
+  }
+  return false;
