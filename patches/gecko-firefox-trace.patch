+bool FirefoxTraceUseInterpreterOnly(JSScript* aScript = nullptr) {
+  if (!FirefoxTraceBaseEnabled()) {
+    return false;
+  }
+
+  const char* executionMode =
+      FirefoxTraceEnv("FIREFOX_TRACE_EXECUTION_MODE", "TRACE_EXECUTION_MODE");
+  if (executionMode && strcmp(executionMode, "target-interpreter") == 0) {
+    return true;
+  }
+
+  if (executionMode && strcmp(executionMode, "opcode") == 0) {
+    const char* opcode = FirefoxTraceEnv("FIREFOX_TRACE_OPCODE", "TRACE_OPCODE");
+    const char* vmStep =
+        FirefoxTraceEnv("FIREFOX_TRACE_VM_STEP", "TRACE_VM_STEP");
+    const char* vmWindow =
+        FirefoxTraceEnv("FIREFOX_TRACE_VM_WINDOW", "TRACE_VM_WINDOW");
+    bool interpreterTrace =
+        (opcode && opcode[0] && strcmp(opcode, "0") != 0) ||
+        (vmStep && vmStep[0] && strcmp(vmStep, "0") != 0) ||
+        (vmWindow && vmWindow[0] && strcmp(vmWindow, "0") != 0);
+    return interpreterTrace && FirefoxTraceOpcodeScriptIdentityMatches(aScript) &&
+           FirefoxTraceOpcodeBudgetAvailable(aScript);
+  }
+
+  // Keeping the whole page in the interpreter is far too expensive on real
+  // anti-bot pages. Function-level trace is therefore best-effort by default:
+  // it records calls that pass through the interpreter boundary, while JIT is
+  // preserved for page liveness. Use TRACE_EXECUTION_MODE=target-interpreter
+  // only after narrowing to a small script/function set.
+  return false;
+}
