+void FirefoxTraceScriptResourceAppendHeader(nsACString& aLine,
+                                            nsIHttpChannel* aHttpChannel,
+                                            const char* aName, bool* aFirst) {
+  nsAutoCString value;
+  nsresult rv = aHttpChannel->GetResponseHeader(nsDependentCString(aName), value);
+  if (NS_FAILED(rv) || value.IsEmpty()) {
+    return;
+  }
+  uint32_t limit = FirefoxTraceScriptResourcePreviewLimit();
+  bool truncated = false;
+  if (value.Length() > limit) {
+    value.Truncate(limit);
+    value.AppendLiteral("...");
+    truncated = true;
+  }
+  if (!*aFirst) {
+    aLine.Append(',');
+  }
+  *aFirst = false;
+  FirefoxTraceScriptResourceAppendJsonCString(aLine, aName);
+  aLine.AppendLiteral(":{\"value\":");
+  FirefoxTraceScriptResourceAppendJsonString(aLine, value);
+  if (truncated) {
+    aLine.AppendLiteral(",\"truncated\":true");
+  }
+  aLine.Append('}');
+}
+
+void FirefoxTraceScriptResourceAppendHeaders(nsACString& aLine,
+                                             nsIHttpChannel* aHttpChannel) {
+  const char* mode = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE_HEADERS",
+      "TRACE_SCRIPT_RESOURCE_HEADERS");
+  if (mode && (!strcmp(mode, "0") || !strcmp(mode, "none") ||
+               !strcmp(mode, "off"))) {
+    aLine.AppendLiteral(",\"headers_enabled\":false");
+    return;
+  }
+  aLine.AppendLiteral(",\"headers_enabled\":true,\"headers\":{");
+  bool first = true;
+  const char* configuredNames = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE_HEADER_NAMES",
+      "TRACE_SCRIPT_RESOURCE_HEADER_NAMES");
+  if (configuredNames && configuredNames[0]) {
+    nsAutoCString names(configuredNames);
+    const char* cursor = names.BeginReading();
+    while (*cursor) {
+      while (*cursor == ',' || *cursor == ' ' || *cursor == '\t') {
+        cursor++;
+      }
+      const char* start = cursor;
+      while (*cursor && *cursor != ',') {
+        cursor++;
+      }
+      const char* end = cursor;
+      while (end > start && (end[-1] == ' ' || end[-1] == '\t')) {
+        end--;
+      }
+      if (end > start) {
+        nsDependentCSubstring name(start, end - start);
+        FirefoxTraceScriptResourceAppendHeader(
+            aLine, aHttpChannel, PromiseFlatCString(name).get(), &first);
+      }
+    }
+  } else {
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "content-type",
+                                           &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel,
+                                           "content-encoding", &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "sourcemap",
+                                           &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "x-sourcemap",
+                                           &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "cache-control",
+                                           &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "etag", &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "last-modified",
+                                           &first);
+  }
+  aLine.Append('}');
+}
+
+void FirefoxTraceScriptResourceWriteLine(const nsACString& aLine) {
+  nsCString line(aLine);
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendEventToParent &&
+      FirefoxTraceSendEventToParent(line.BeginReading(), line.Length())) {
+    return;
+  }
+#endif
+  const char* logDir =
+      FirefoxTraceScriptResourceEnv("FIREFOX_TRACE_LOG_DIR", "TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-script-%d.jsonl", getpid());
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+  fwrite(line.BeginReading(), 1, line.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+bool FirefoxTraceScriptResourceStoreArtifact(const char* aSha256,
+                                             const nsCString& aData) {
+  if (!FirefoxTraceScriptResourceStoreEnabled() || !aSha256 || !aSha256[0] ||
+      aData.IsEmpty()) {
+    return false;
+  }
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendScriptSourceToParent &&
+      FirefoxTraceSendScriptSourceToParent(aSha256, aData.BeginReading(),
+                                           aData.Length())) {
+    return true;
+  }
+#endif
+  return false;
+}
+
+const char* FirefoxTraceScriptResourceKind(JS::loader::ScriptLoadRequest* aReq) {
+  if (aReq->IsImportMapRequest()) {
+    return "importmap";
+  }
+  if (aReq->IsModuleRequest()) {
+    return "module";
+  }
+  return "classic";
+}
