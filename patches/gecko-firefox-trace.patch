+void FirefoxTraceWriteJsonString(FILE* file, const char* value) {
+  fputc('"', file);
+  if (value) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(value);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          fputs("\\\"", file);
+          break;
+        case '\\':
+          fputs("\\\\", file);
+          break;
+        case '\b':
+          fputs("\\b", file);
+          break;
+        case '\f':
+          fputs("\\f", file);
+          break;
+        case '\n':
+          fputs("\\n", file);
+          break;
+        case '\r':
+          fputs("\\r", file);
+          break;
+        case '\t':
+          fputs("\\t", file);
+          break;
+        default:
+          if (*p < 0x20) {
+            fprintf(file, "\\u%04x", *p);
+          } else {
+            fputc(*p, file);
+          }
+          break;
+      }
+    }
+  }
+  fputc('"', file);
+}
+
+void FirefoxTraceWriteJsonStringLimited(FILE* file, const char* value,
+                                        uint32_t limit) {
+  fputc('"', file);
+  if (value) {
+    uint32_t written = 0;
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(value);
+         *p && written < limit; ++p, ++written) {
+      switch (*p) {
+        case '"':
+          fputs("\\\"", file);
+          break;
+        case '\\':
+          fputs("\\\\", file);
+          break;
+        case '\b':
+          fputs("\\b", file);
+          break;
+        case '\f':
+          fputs("\\f", file);
+          break;
+        case '\n':
+          fputs("\\n", file);
+          break;
+        case '\r':
+          fputs("\\r", file);
+          break;
+        case '\t':
+          fputs("\\t", file);
+          break;
+        default:
+          if (*p < 0x20) {
+            fprintf(file, "\\u%04x", *p);
+          } else {
+            fputc(*p, file);
+          }
+          break;
+      }
+    }
+    if (value[written]) {
+      fputs("...", file);
+    }
+  }
+  fputc('"', file);
+}
