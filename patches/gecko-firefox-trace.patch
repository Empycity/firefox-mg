+// Object/value enrichment below deliberately reads a small allowlist of
+// native DOM properties (for example TextMetrics.width).  Those reads enter
+// the generated binding again.  Without a re-entry guard they are emitted as
+// if page JavaScript had performed the reads, which duplicates getter events,
+// reverses the apparent call/get order in JSONL, and shifts offline replay.
+// Keep the snapshot values on the outer event while suppressing only Trace's
+// own nested observations.
+static thread_local uint32_t sFirefoxTraceDOMInternalReadDepth = 0;
+
+class AutoFirefoxTraceDOMInternalRead final {
+ public:
+  AutoFirefoxTraceDOMInternalRead() {
+    ++sFirefoxTraceDOMInternalReadDepth;
+  }
+
+  ~AutoFirefoxTraceDOMInternalRead() {
+    MOZ_ASSERT(sFirefoxTraceDOMInternalReadDepth > 0);
+    --sFirefoxTraceDOMInternalReadDepth;
+  }
+
+  AutoFirefoxTraceDOMInternalRead(const AutoFirefoxTraceDOMInternalRead&) =
+      delete;
+  AutoFirefoxTraceDOMInternalRead& operator=(
+      const AutoFirefoxTraceDOMInternalRead&) = delete;
+};
