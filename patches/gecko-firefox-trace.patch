+  // WebIDL constructors are relatively sparse, and their returned instance
+  // contracts identify host APIs that an offline replay must provide.
+  if (strcmp(aOperation, "dom.construct") == 0 &&
+      FirefoxTraceDOMContractEnabled()) {
+    return true;
+  }
