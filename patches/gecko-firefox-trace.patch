+bool FirefoxTraceShouldRecordFetchContext(const nsACString& aPageURL,
+                                          const nsACString& aCallerURL) {
+  const char* filter = getenv("FIREFOX_TRACE_FETCH_FILTER");
+  if (!filter || !filter[0]) {
