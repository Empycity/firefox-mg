+  bool isHTTP = false;
+  bool isHTTPS = false;
+  Unused << aURI->SchemeIs("http", &isHTTP);
+  Unused << aURI->SchemeIs("https", &isHTTPS);
+  return isHTTP || isHTTPS;
+}
+
+bool FirefoxTraceScriptResourceURLIsChromeLike(nsIURI* aURI) {
+  if (!aURI) {
+    return false;
+  }
+  bool isChrome = false;
+  bool isResource = false;
+  bool isAbout = false;
+  bool isMozExtension = false;
+  Unused << aURI->SchemeIs("chrome", &isChrome);
+  Unused << aURI->SchemeIs("resource", &isResource);
+  Unused << aURI->SchemeIs("about", &isAbout);
+  Unused << aURI->SchemeIs("moz-extension", &isMozExtension);
+  return isChrome || isResource || isAbout || isMozExtension;
+}
+
+bool FirefoxTraceScriptResourceShouldRecord(
+    JS::loader::ScriptLoadRequest* aRequest, ScriptLoader* aScriptLoader) {
+  if (!FirefoxTraceScriptResourceEnabled() || !aRequest) {
+    return false;
+  }
+
+  const char* filter = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE_FILTER",
+      "TRACE_SCRIPT_RESOURCE_FILTER");
+  if (!filter || !filter[0]) {
+    filter = "web";
+  }
+  if (!strcmp(filter, "all")) {
+    return true;
+  }
+  bool requestIsWeb = FirefoxTraceScriptResourceURLIsWeb(aRequest->mURI);
+  bool requestIsChrome =
+      FirefoxTraceScriptResourceURLIsChromeLike(aRequest->mURI);
+
+  bool pageIsWeb = false;
+  bool pageIsChrome = false;
+  if (aScriptLoader && aScriptLoader->GetDocument()) {
+    nsIURI* pageURI = aScriptLoader->GetDocument()->GetDocumentURI();
+    pageIsWeb = FirefoxTraceScriptResourceURLIsWeb(pageURI);
+    pageIsChrome = FirefoxTraceScriptResourceURLIsChromeLike(pageURI);
+  }
+
+  if (!strcmp(filter, "chrome")) {
+    return requestIsChrome || pageIsChrome;
+  }
+  if (!strcmp(filter, "web")) {
+    return requestIsWeb || pageIsWeb;
+  }
+  return requestIsWeb || pageIsWeb;
+}
