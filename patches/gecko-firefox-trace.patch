+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceFetchDriverAppendBytesHex(nsACString& aLine,
+                                           const char* aBuffer,
+                                           uint32_t aCount) {
+  static const char kHex[] = "0123456789abcdef";
+  aLine.Append('"');
+  for (uint32_t i = 0; i < aCount; i++) {
+    unsigned char c = static_cast<unsigned char>(aBuffer[i]);
+    aLine.Append(kHex[(c >> 4) & 0x0f]);
+    aLine.Append(kHex[c & 0x0f]);
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceFetchDriverWriteLine(const nsACString& aLine) {
+  if (XRE_IsContentProcess()) {
+#if defined(__APPLE__) || defined(__GNUC__)
+    if (FirefoxTraceSendEventToParent) {
+      nsCString line(aLine);
+      if (NS_IsMainThread()) {
+        Unused << FirefoxTraceSendEventToParent(line.BeginReading(),
+                                                line.Length());
+      } else {
+        NS_DispatchToMainThread(NS_NewRunnableFunction(
+            "FirefoxTraceFetchBodyChunk",
+            [line = std::move(line)]() {
+              if (FirefoxTraceSendEventToParent) {
+                Unused << FirefoxTraceSendEventToParent(line.BeginReading(),
+                                                        line.Length());
+              }
+            }));
+      }
+    }
+#endif
+    return;
+  }
+
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-fetch-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+bool FirefoxTraceFetchDriverWriteBodyArtifact(const char* aValueId,
+                                              const char* aArtifactKey,
+                                              const char* aData,
+                                              size_t aLength) {
+  if (!aValueId || !aValueId[0] || !aArtifactKey || !aArtifactKey[0] ||
+      !aData) {
+    return false;
+  }
+
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (XRE_IsContentProcess() && FirefoxTraceSendValueToParent) {
+    return FirefoxTraceSendValueToParent(aValueId, aArtifactKey, aData,
+                                         aLength);
+  }
+#endif
+
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+  nsAutoCString valuesDir(logDir);
+  if (!valuesDir.IsEmpty() && valuesDir.Last() != '/') {
+    valuesDir.Append('/');
+  }
+  valuesDir.AppendLiteral("values");
+#ifndef XP_WIN
+  mkdir(valuesDir.get(), 0755);
+#endif
+
+  valuesDir.Append('/');
+  valuesDir.Append(aArtifactKey);
+  valuesDir.AppendLiteral(".txt");
+  FILE* file = fopen(valuesDir.get(), "wb");
+  if (!file) {
+    return false;
+  }
+  size_t written = fwrite(aData, 1, aLength, file);
+  fclose(file);
+  return written == aLength;
+}
