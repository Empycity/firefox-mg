+bool FirefoxTraceDOMCSVAllows(const char* aCSV, const char* aShortName,
+                              const char* aFullName,
+                              bool aDefaultValue) {
+  if (!aCSV || !aCSV[0]) {
+    return aDefaultValue;
+  }
+
+  if (strcmp(aCSV, "all") == 0 || strcmp(aCSV, "1") == 0) {
+    return true;
+  }
+  if (strcmp(aCSV, "none") == 0 || strcmp(aCSV, "0") == 0) {
+    return false;
+  }
+
+  return FirefoxTraceCSVMatchesCString(aCSV, aShortName) ||
+         FirefoxTraceCSVMatchesCString(aCSV, aFullName);
+}
