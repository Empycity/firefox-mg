+bool FirefoxTraceScriptResourceExtractSourceMapURL(const nsCString& aData,
+                                                   nsACString& aOutURL) {
+  static constexpr const char* kMarker = "sourceMappingURL=";
+  const char* data = aData.BeginReading();
+  const char* cursor = data;
+  const char* match = nullptr;
+  while ((cursor = strstr(cursor, kMarker))) {
+    match = cursor;
+    cursor += strlen(kMarker);
+  }
+  if (!match) {
+    return false;
+  }
+
+  const char* start = match + strlen(kMarker);
+  const char* end = start;
+  while (*end && *end != '\r' && *end != '\n') {
+    end++;
+  }
+  while (start < end && (*start == ' ' || *start == '\t')) {
+    start++;
+  }
+  while (end > start &&
+         (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '*')) {
+    end--;
+  }
+  if (end <= start) {
+    return false;
+  }
+
+  aOutURL.Assign(start, end - start);
+  return true;
+}
