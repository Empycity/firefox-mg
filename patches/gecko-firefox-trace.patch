+
+static mozilla::ipc::IPCResult FirefoxTraceReceiveDOMEvent(
+    ContentParent* aParent, const nsACString& aLine,
+    FirefoxTraceBatchWriter& aWriter, bool aControlDrain = false) {
+  const char* enabled = PR_GetEnv("FIREFOX_TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return IPC_OK();
+  }
+
+  FirefoxTraceMaybePushRuntimeConfigToChild(aParent);
+
+  if (!aControlDrain && !FirefoxTraceRuntimeAllowsEvent(aLine)) {
+    return IPC_OK();
+  }
+
+  bool isXHR = aLine.Find("firefox_trace.xhr.v1") != kNotFound;
+  bool isFetch = aLine.Find("firefox_trace.fetch.v1") != kNotFound;
+  bool isWebSocket = aLine.Find("firefox_trace.websocket.v1") != kNotFound;
+  bool isStorage = aLine.Find("firefox_trace.storage.v1") != kNotFound;
+  bool isCookie = aLine.Find("firefox_trace.cookie.v1") != kNotFound;
+  bool isWasm = aLine.Find("firefox_trace.wasm.v1") != kNotFound;
+  bool isScriptResource =
+      aLine.Find("firefox_trace.script.v1") != kNotFound ||
+      aLine.Find("\"type\":\"script.resource\"") != kNotFound ||
+      aLine.Find("\"type\": \"script.resource\"") != kNotFound;
+  bool isJS = aLine.Find("\"type\":\"js.") != kNotFound ||
+              aLine.Find("\"type\": \"js.") != kNotFound ||
+              aLine.Find("\"module\":\"js\"") != kNotFound ||
+              aLine.Find("\"module\": \"js\"") != kNotFound ||
+              aLine.Find("\"module\":\"opcode\"") != kNotFound ||
+              aLine.Find("\"module\": \"opcode\"") != kNotFound ||
+              aLine.Find("\"module\":\"vm_step\"") != kNotFound ||
+              aLine.Find("\"module\": \"vm_step\"") != kNotFound;
+  if (isXHR) {
+    const char* xhrEnabled = PR_GetEnv("FIREFOX_TRACE_XHR");
+    if (xhrEnabled && strcmp(xhrEnabled, "0") == 0) {
+      return IPC_OK();
+    }
+  } else if (isFetch) {
+    const char* fetchEnabled = PR_GetEnv("FIREFOX_TRACE_FETCH");
+    if (!fetchEnabled || !fetchEnabled[0]) {
+      fetchEnabled = PR_GetEnv("TRACE_FETCH");
+    }
+    if (fetchEnabled && strcmp(fetchEnabled, "0") == 0) {
+      return IPC_OK();
+    }
+  } else if (isWebSocket) {
+    const char* websocketEnabled = PR_GetEnv("FIREFOX_TRACE_WS");
+    if (!websocketEnabled || !websocketEnabled[0]) {
+      websocketEnabled = PR_GetEnv("TRACE_WS");
+    }
+    if (!websocketEnabled || !websocketEnabled[0] ||
+        strcmp(websocketEnabled, "0") == 0 ||
+        strcmp(websocketEnabled, "false") == 0 ||
+        strcmp(websocketEnabled, "off") == 0) {
+      return IPC_OK();
+    }
+  } else if (isStorage) {
+    const char* storageEnabled = PR_GetEnv("FIREFOX_TRACE_STORAGE");
+    if (!storageEnabled || !storageEnabled[0]) {
+      storageEnabled = PR_GetEnv("TRACE_STORAGE");
+    }
+    if (storageEnabled && strcmp(storageEnabled, "0") == 0) {
+      return IPC_OK();
+    }
+  } else if (isCookie) {
+    const char* cookieEnabled = PR_GetEnv("FIREFOX_TRACE_COOKIE");
+    if (!cookieEnabled || !cookieEnabled[0]) {
+      cookieEnabled = PR_GetEnv("TRACE_COOKIE");
+    }
+    if (cookieEnabled && strcmp(cookieEnabled, "0") == 0) {
+      return IPC_OK();
+    }
+  } else if (isWasm) {
+    const char* wasmEnabled = PR_GetEnv("FIREFOX_TRACE_WASM");
+    if (!wasmEnabled || !wasmEnabled[0]) {
+      wasmEnabled = PR_GetEnv("TRACE_WASM");
+    }
+    if (!wasmEnabled || !wasmEnabled[0] || strcmp(wasmEnabled, "0") == 0 ||
+        strcmp(wasmEnabled, "false") == 0 ||
+        strcmp(wasmEnabled, "off") == 0) {
+      return IPC_OK();
+    }
+  } else if (isScriptResource) {
+    const char* scriptEnabled = PR_GetEnv("FIREFOX_TRACE_SCRIPT_RESOURCE");
+    if (!scriptEnabled || !scriptEnabled[0]) {
+      scriptEnabled = PR_GetEnv("TRACE_SCRIPT_RESOURCE");
+    }
+    if (scriptEnabled && strcmp(scriptEnabled, "0") == 0) {
+      return IPC_OK();
+    }
+  } else if (isJS) {
+    const char* jsEnabled = PR_GetEnv("FIREFOX_TRACE_JS");
+    if (jsEnabled && strcmp(jsEnabled, "0") == 0) {
+      return IPC_OK();
+    }
+  } else {
+    const char* domEnabled = PR_GetEnv("FIREFOX_TRACE_DOM");
+    if (domEnabled && strcmp(domEnabled, "0") == 0) {
+      return IPC_OK();
+    }
+  }
+
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  using Stream = FirefoxTraceBatchWriter::Stream;
+  Stream stream = Stream::DOM;
+  const char* filename = "firefox-dom-%d.jsonl";
+  if (isXHR) {
+    filename = "firefox-xhr-%d.jsonl";
+    stream = Stream::XHR;
+  } else if (isFetch) {
+    filename = "firefox-fetch-%d.jsonl";
+    stream = Stream::Fetch;
+  } else if (isWebSocket) {
+    filename = "firefox-websocket-%d.jsonl";
+    stream = Stream::WebSocket;
+  } else if (isStorage) {
+    filename = "firefox-storage-%d.jsonl";
+    stream = Stream::Storage;
+  } else if (isCookie) {
+    filename = "firefox-cookie-%d.jsonl";
+    stream = Stream::Cookie;
+  } else if (isWasm) {
+    filename = "firefox-wasm-%d.jsonl";
+    stream = Stream::Wasm;
+  } else if (isScriptResource) {
+    filename = "firefox-script-%d.jsonl";
+    stream = Stream::Script;
+  } else if (isJS) {
+    filename = "firefox-js-%d.jsonl";
+    stream = Stream::JS;
+  }
+  path.AppendPrintf(filename, getpid());
+
+  FILE* file = aWriter.Open(stream, logDir, path.get());
+  if (!file) {
+    return IPC_OK();
+  }
+
+  nsAutoCString decoratedLine;
+  FirefoxTraceDecorateRuntimeEventLine(aLine, decoratedLine);
+  fwrite(decoratedLine.BeginReading(), 1, decoratedLine.Length(), file);
+  fputc('\n', file);
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentParent::RecvFirefoxTraceDOMEvent(
+    const nsACString& aLine) {
+  FirefoxTraceBatchWriter writer;
+  return FirefoxTraceReceiveDOMEvent(this, aLine, writer);
+}
+
+static mozilla::ipc::IPCResult FirefoxTraceReceiveDOMEventBatch(
+    ContentParent* aParent, const nsACString& aLines, bool aControlDrain) {
+  FirefoxTraceBatchWriter writer;
+  uint32_t start = 0;
+  while (start < aLines.Length()) {
+    int32_t end = aLines.FindChar('\n', start);
+    uint32_t length = end < 0 ? aLines.Length() - start
+                              : static_cast<uint32_t>(end) - start;
+    if (length) {
+      FirefoxTraceReceiveDOMEvent(aParent, Substring(aLines, start, length),
+                                   writer, aControlDrain);
+    }
+    if (end < 0) {
+      break;
+    }
+    start = static_cast<uint32_t>(end) + 1;
+  }
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentParent::RecvFirefoxTraceDOMEventBatch(
+    const nsACString& aLines) {
+  constexpr char prefix[] = "FIREFOX_TRACE_CONTROL_DRAIN_V1\n";
+  constexpr size_t prefixLength = sizeof(prefix) - 1;
+  if (aLines.Length() >= prefixLength &&
+      memcmp(aLines.BeginReading(), prefix, prefixLength) == 0) {
+    return FirefoxTraceReceiveDOMEventBatch(
+        this, Substring(aLines, prefixLength), true);
+  }
+  return FirefoxTraceReceiveDOMEventBatch(this, aLines, false);
+}
+
+mozilla::ipc::IPCResult ContentParent::RecvFirefoxTraceJSValue(
+    const nsACString& aValueId, const nsACString& aArtifactKey,
+    const nsACString& aData) {
+  const char* enabled = PR_GetEnv("FIREFOX_TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return IPC_OK();
+  }
+
+  if (!FirefoxTraceRuntimeAllowsArtifact()) {
+    return IPC_OK();
+  }
+
+  if (aValueId.IsEmpty()) {
+    return IPC_OK();
+  }
+  const char* valueId = aValueId.BeginReading();
+  bool isQueryFieldValue = aValueId.Length() >= 4 && valueId[0] == 'q' &&
+                           valueId[1] == 'f' && valueId[2] == 'v' &&
+                           valueId[3] == '_';
+  bool isFetchBodyValue =
+      aValueId.Length() >= 11 && strncmp(valueId, "fetch_body_", 11) == 0;
+  bool isFetchRequestBodyValue =
+      aValueId.Length() >= 15 && strncmp(valueId, "fetch_req_body_", 15) == 0;
+  bool isXHRRequestBodyValue =
+      aValueId.Length() >= 13 && strncmp(valueId, "xhr_req_body_", 13) == 0;
+  bool isXHRResponseBodyValue =
+      aValueId.Length() >= 14 && strncmp(valueId, "xhr_resp_body_", 14) == 0;
+  if (isQueryFieldValue) {
+    const char* storeEnabled = PR_GetEnv("FIREFOX_TRACE_QUERY_FIELD_VALUE_STORE");
+    if (!storeEnabled || !storeEnabled[0]) {
+      storeEnabled = PR_GetEnv("TRACE_QUERY_FIELD_VALUE_STORE");
+    }
+    if (!storeEnabled || !storeEnabled[0] || strcmp(storeEnabled, "0") == 0 ||
+        strcmp(storeEnabled, "false") == 0 || strcmp(storeEnabled, "off") == 0) {
+      return IPC_OK();
+    }
+  } else if (isFetchBodyValue) {
+    const char* storeEnabled =
+        PR_GetEnv("FIREFOX_TRACE_FETCH_RESPONSE_BODY_STORE");
+    if (!storeEnabled || !storeEnabled[0]) {
+      storeEnabled = PR_GetEnv("TRACE_FETCH_RESPONSE_BODY_STORE");
+    }
+    if (!storeEnabled || !storeEnabled[0] || strcmp(storeEnabled, "0") == 0 ||
+        strcmp(storeEnabled, "false") == 0 || strcmp(storeEnabled, "off") == 0) {
+      return IPC_OK();
+    }
+  } else if (isFetchRequestBodyValue) {
+    const char* storeEnabled = PR_GetEnv("FIREFOX_TRACE_FETCH_REQUEST_BODY_STORE");
+    if (!storeEnabled || !storeEnabled[0]) {
+      storeEnabled = PR_GetEnv("TRACE_FETCH_REQUEST_BODY_STORE");
+    }
+    if (!storeEnabled || !storeEnabled[0] || strcmp(storeEnabled, "0") == 0 ||
+        strcmp(storeEnabled, "false") == 0 || strcmp(storeEnabled, "off") == 0) {
+      return IPC_OK();
+    }
+  } else if (isXHRRequestBodyValue) {
+    const char* storeEnabled = PR_GetEnv("FIREFOX_TRACE_XHR_REQUEST_BODY_STORE");
+    if (!storeEnabled || !storeEnabled[0]) {
+      storeEnabled = PR_GetEnv("TRACE_XHR_REQUEST_BODY_STORE");
+    }
+    if (!storeEnabled || !storeEnabled[0] || strcmp(storeEnabled, "0") == 0 ||
+        strcmp(storeEnabled, "false") == 0 || strcmp(storeEnabled, "off") == 0) {
+      return IPC_OK();
+    }
+  } else if (isXHRResponseBodyValue) {
+    const char* storeEnabled =
+        PR_GetEnv("FIREFOX_TRACE_XHR_RESPONSE_BODY_STORE");
+    if (!storeEnabled || !storeEnabled[0]) {
+      storeEnabled = PR_GetEnv("TRACE_XHR_RESPONSE_BODY_STORE");
+    }
+    if (!storeEnabled || !storeEnabled[0] || strcmp(storeEnabled, "0") == 0 ||
+        strcmp(storeEnabled, "false") == 0 || strcmp(storeEnabled, "off") == 0) {
+      return IPC_OK();
+    }
+  } else {
+    const char* storeEnabled = PR_GetEnv("FIREFOX_TRACE_JS_VALUE_STORE");
+    if (!storeEnabled || !storeEnabled[0]) {
+      storeEnabled = PR_GetEnv("TRACE_JS_VALUE_STORE");
+    }
+    if (storeEnabled && (strcmp(storeEnabled, "0") == 0 ||
+                         strcmp(storeEnabled, "false") == 0 ||
+                         strcmp(storeEnabled, "off") == 0)) {
+      return IPC_OK();
+    }
+  }
+  for (uint32_t i = 0; i < aValueId.Length(); i++) {
+    char c = valueId[i];
+    bool safe = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                (c >= '0' && c <= '9') || c == '_' || c == '-';
+    if (!safe) {
+      return IPC_OK();
+    }
+  }
+
+  const nsACString* artifactKey = &aValueId;
+  if (aArtifactKey.Length() == 64) {
+    bool isSHA256 = true;
+    for (uint32_t i = 0; i < aArtifactKey.Length(); i++) {
+      char c = aArtifactKey.BeginReading()[i];
+      if (!((c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') ||
+            (c >= '0' && c <= '9'))) {
+        isSHA256 = false;
+        break;
+      }
+    }
+    if (isSHA256) {
+      artifactKey = &aArtifactKey;
+    }
+  }
+
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+  mkdir(logDir, 0755);
+
+  nsAutoCString valuesDir(logDir);
+  if (!valuesDir.IsEmpty() && valuesDir.Last() != '/') {
+    valuesDir.Append('/');
+  }
+  valuesDir.Append("values");
+  mkdir(valuesDir.get(), 0755);
+
+  nsAutoCString path(valuesDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.Append(*artifactKey);
+  path.Append(".txt");
+
+  // A value can occur in many args/returns. SHA-addressed JS artifacts are
+  // immutable, so avoid duplicate IPC-to-disk work for the same value.
+  if (access(path.get(), F_OK) == 0) {
+    return IPC_OK();
+  }
+
+  FILE* file = fopen(path.get(), "wb");
+  if (!file) {
+    return IPC_OK();
+  }
+
+  size_t written = fwrite(aData.BeginReading(), 1, aData.Length(), file);
+  fclose(file);
+  if (written != aData.Length()) {
+    unlink(path.get());
+  }
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentParent::RecvFirefoxTraceWasmArtifact(
+    const nsACString& aModuleId, const nsACString& aData) {
+  const char* enabled = PR_GetEnv("FIREFOX_TRACE_WASM");
+  if (!enabled || !enabled[0]) {
+    enabled = PR_GetEnv("TRACE_WASM");
+  }
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0 ||
+      strcmp(enabled, "false") == 0 || strcmp(enabled, "off") == 0 ||
+      !FirefoxTraceRuntimeAllowsArtifact() || aModuleId.Length() != 40) {
+    return IPC_OK();
+  }
+  for (uint32_t i = 0; i < aModuleId.Length(); ++i) {
+    char c = aModuleId.BeginReading()[i];
+    if (!((c >= 'a' && c <= 'f') || (c >= '0' && c <= '9'))) {
+      return IPC_OK();
+    }
+  }
+
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+  mkdir(logDir, 0755);
+  nsAutoCString wasmDir(logDir);
+  if (!wasmDir.IsEmpty() && wasmDir.Last() != '/') {
+    wasmDir.Append('/');
+  }
+  wasmDir.Append("wasm");
+  mkdir(wasmDir.get(), 0755);
+
+  nsAutoCString path(wasmDir);
+  path.Append('/');
+  path.Append(aModuleId);
+  path.Append(".wasm");
+  FILE* file = fopen(path.get(), "wb");
+  if (!file) {
+    return IPC_OK();
+  }
+  fwrite(aData.BeginReading(), 1, aData.Length(), file);
+  fclose(file);
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentParent::RecvFirefoxTraceVMWindowArtifact(
+    const nsACString& aFileName, const nsACString& aData) {
+  const char* enabled = PR_GetEnv("FIREFOX_TRACE_VM_WINDOW");
+  if (!enabled || !enabled[0]) {
+    enabled = PR_GetEnv("TRACE_VM_WINDOW");
+  }
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0 ||
+      strcmp(enabled, "false") == 0 || strcmp(enabled, "off") == 0 ||
+      !FirefoxTraceRuntimeAllowsArtifact() || aFileName.IsEmpty() ||
+      aFileName.Length() > 255 || aData.IsEmpty()) {
+    return IPC_OK();
+  }
+
+  nsCString flatFileName(aFileName);
+  const char* fileName = flatFileName.get();
+  constexpr const char kPrefix[] = "firefox-vm-window-";
+  if (aFileName.Length() < sizeof(kPrefix) - 1 + 5 ||
+      strncmp(fileName, kPrefix, sizeof(kPrefix) - 1) != 0 ||
+      strcmp(fileName + aFileName.Length() - 4, ".bin") != 0) {
+    return IPC_OK();
+  }
+  for (uint32_t i = 0; i < aFileName.Length(); ++i) {
+    char c = fileName[i];
+    bool safe = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.';
+    if (!safe) {
+      return IPC_OK();
+    }
+  }
+
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    return IPC_OK();
+  }
+  mkdir(logDir, 0755);
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.Append(aFileName);
+  FILE* file = fopen(path.get(), "wb");
+  if (!file) {
+    return IPC_OK();
+  }
+  fwrite(aData.BeginReading(), 1, aData.Length(), file);
+  fclose(file);
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentParent::RecvFirefoxTraceJSScriptSource(
+    const nsACString& aScriptSha256, const nsACString& aData) {
+  const char* enabled = PR_GetEnv("FIREFOX_TRACE_ENABLE");
+  if (!enabled || !enabled[0]) {
+    enabled = PR_GetEnv("TRACE_ENABLE");
+  }
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return IPC_OK();
+  }
+
+  if (!FirefoxTraceRuntimeAllowsArtifact()) {
+    return IPC_OK();
+  }
+
+  const char* dumpEnabled = PR_GetEnv("FIREFOX_TRACE_JS_SCRIPT_DUMP");
+  if (!dumpEnabled || !dumpEnabled[0]) {
+    dumpEnabled = PR_GetEnv("TRACE_JS_SCRIPT_DUMP");
+  }
+  if (!dumpEnabled || !dumpEnabled[0]) {
+    dumpEnabled = PR_GetEnv("FIREFOX_TRACE_SCRIPT_RESOURCE_STORE");
+  }
+  if (!dumpEnabled || !dumpEnabled[0]) {
+    dumpEnabled = PR_GetEnv("TRACE_SCRIPT_RESOURCE_STORE");
+  }
+  if (!dumpEnabled || !dumpEnabled[0] || strcmp(dumpEnabled, "0") == 0) {
+    return IPC_OK();
+  }
+
+  if (aScriptSha256.Length() != 64) {
+    return IPC_OK();
+  }
+  const char* scriptSha256 = aScriptSha256.BeginReading();
+  for (uint32_t i = 0; i < aScriptSha256.Length(); i++) {
+    char c = scriptSha256[i];
+    bool safe = (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') ||
+                (c >= '0' && c <= '9');
+    if (!safe) {
+      return IPC_OK();
+    }
+  }
+
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+  mkdir(logDir, 0755);
+
+  nsAutoCString scriptsDir(logDir);
+  if (!scriptsDir.IsEmpty() && scriptsDir.Last() != '/') {
+    scriptsDir.Append('/');
+  }
+  scriptsDir.Append("scripts");
+  mkdir(scriptsDir.get(), 0755);
+
+  nsAutoCString path(scriptsDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.Append(aScriptSha256);
+  path.Append(".js");
+
+  FILE* file = fopen(path.get(), "wb");
+  if (!file) {
+    return IPC_OK();
+  }
+
+  fwrite(aData.BeginReading(), 1, aData.Length(), file);
+  fclose(file);
+  return IPC_OK();
+}
