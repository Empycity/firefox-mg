+void FirefoxTraceScriptResourceAppendJsonCString(nsACString& aLine,
+                                                 const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(static_cast<char>(*p));
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
