+    char* p = strchr(env, '{');
+    if (!p) {
+      return;
+    }
+    char* end = strchr(p, '}');
+    if (!end) {
+      return;
+    }
+    p++;
+    while (p < end) {
+      while (p < end && (*p == ' ' || *p == '\n' || *p == '\r' ||
+                         *p == '\t' || *p == ',')) {
+        p++;
+      }
+      if (p >= end || *p != '"') {
+        break;
+      }
+      p++;
+      char* keyStart = p;
+      while (p < end && *p != '"') {
+        p++;
+      }
+      if (p >= end) {
+        break;
+      }
+      char key[256];
+      size_t keyLen = std::min<size_t>(p - keyStart, sizeof(key) - 1);
+      memcpy(key, keyStart, keyLen);
+      key[keyLen] = '\0';
+      p++;
+      while (p < end && *p != ':') {
+        p++;
+      }
+      if (p >= end) {
+        break;
+      }
+      p++;
+      while (p < end && (*p == ' ' || *p == '\n' || *p == '\r' ||
+                         *p == '\t')) {
+        p++;
+      }
+      char value[2048];
+      size_t valueLen = 0;
+      if (p < end && *p == '"') {
+        p++;
+        char* valueStart = p;
+        while (p < end && *p != '"') {
+          p++;
+        }
+        valueLen = std::min<size_t>(p - valueStart, sizeof(value) - 1);
+        memcpy(value, valueStart, valueLen);
+        if (p < end) {
+          p++;
+        }
+      } else {
+        char* valueStart = p;
+        while (p < end && *p != ',' && *p != '}') {
+          p++;
+        }
+        valueLen = std::min<size_t>(p - valueStart, sizeof(value) - 1);
+        memcpy(value, valueStart, valueLen);
+        while (valueLen && (value[valueLen - 1] == ' ' ||
+                            value[valueLen - 1] == '\n' ||
+                            value[valueLen - 1] == '\r' ||
+                            value[valueLen - 1] == '\t')) {
+          valueLen--;
+        }
+      }
+      value[valueLen] = '\0';
+      if ((strncmp(key, "TRACE_", 6) == 0 ||
+           strncmp(key, "FIREFOX_TRACE_", 14) == 0) &&
+          value[0]) {
+        setenv(key, value, 1);
+      }
+    }
+  };
+
+  auto applyUnset = [](char* aBuffer) {
+    char* unset = strstr(aBuffer, "\"unset\"");
+    if (!unset) {
+      return;
+    }
+    char* p = strchr(unset, '[');
+    char* end = p ? strchr(p, ']') : nullptr;
+    if (!p || !end) {
+      return;
+    }
+    p++;
+    while (p < end) {
+      while (p < end &&
+             (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t' ||
+              *p == ',')) {
+        p++;
+      }
+      if (p >= end || *p != '"') {
+        break;
+      }
+      p++;
+      char* start = p;
+      while (p < end && *p != '"') {
+        p++;
+      }
+      if (p >= end) {
+        break;
+      }
+      char key[256];
+      size_t keyLen = std::min<size_t>(p - start, sizeof(key) - 1);
+      memcpy(key, start, keyLen);
+      key[keyLen] = '\0';
+      if ((strncmp(key, "TRACE_", 6) == 0 ||
+           strncmp(key, "FIREFOX_TRACE_", 14) == 0)) {
+        unsetenv(key);
+      }
+      p++;
+    }
+  };
+
+  auto applyTopLevelString = [](char* aBuffer, const char* aJsonKey,
+                                const char* aEnvKey) {
+    char pattern[96];
+    snprintf(pattern, sizeof(pattern), "\"%s\"", aJsonKey);
+    char* p = strstr(aBuffer, pattern);
+    if (!p) {
+      return;
+    }
+    p = strchr(p, ':');
+    if (!p) {
+      return;
+    }
+    p++;
+    while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t') {
+      p++;
+    }
+    if (*p != '"') {
+      return;
+    }
+    p++;
+    char* start = p;
+    while (*p && *p != '"') {
+      p++;
+    }
+    if (!*p) {
+      return;
+    }
+    char value[512];
+    size_t len = std::min<size_t>(p - start, sizeof(value) - 1);
+    memcpy(value, start, len);
+    value[len] = '\0';
+    if (value[0]) {
