+extern "C" void FirefoxTraceFlushJSBoundaryBuffer(const char* aReason) {
+  FirefoxTraceRefreshJSSegmentState();
+
+  if (!FirefoxTraceJSBoundaryBufferEnabled()) {
+    return;
+  }
+  if (!FirefoxTraceJSBoundaryBufferReasonEnabled(aReason)) {
+    return;
+  }
+
+  uint64_t writeSeq = sFirefoxTraceJSBoundaryBufferWriteSeq;
+  if (writeSeq <= sFirefoxTraceJSBoundaryBufferFlushedSeq) {
+    return;
+  }
+
+  uint64_t firstSeq = sFirefoxTraceJSBoundaryBufferFlushedSeq + 1;
+  char capacitySource[160];
+  uint32_t capacity = FirefoxTraceJSBoundaryBufferCapacityForReason(
+      aReason, capacitySource, sizeof(capacitySource));
+  uint32_t storageCapacity = kFirefoxTraceJSBoundaryBufferMaxCapacity;
+  uint64_t droppedBeforeFlush = sFirefoxTraceJSBoundaryBufferDropped;
+  uint64_t skippedByWindow = 0;
+  if (writeSeq >= capacity && firstSeq < writeSeq - capacity + 1) {
+    skippedByWindow = writeSeq - capacity + 1 - firstSeq;
+    firstSeq = writeSeq - capacity + 1;
+  }
+
+  FirefoxTraceWriteJSBoundaryBufferDegraded(
+      aReason, droppedBeforeFlush, storageCapacity, capacity, capacitySource);
+
+  uint64_t flushed = 0;
+  for (uint64_t seq = firstSeq; seq <= writeSeq; seq++) {
+    size_t slot = static_cast<size_t>((seq - 1) % storageCapacity);
+    FirefoxTraceJSBufferedEvent& event = sFirefoxTraceJSBoundaryBuffer[slot];
+    if (event.line && event.seq == seq && !event.flushed) {
+      FirefoxTraceWriteJSEventLineRaw(event.line, event.len);
+      event.flushed = true;
+      flushed++;
+    }
+  }
+  sFirefoxTraceJSBoundaryBufferFlushedSeq = writeSeq;
+  FirefoxTraceWriteJSBoundaryBufferFlushSummary(
+      aReason, firstSeq, writeSeq, flushed, droppedBeforeFlush,
+      skippedByWindow, capacity, storageCapacity, capacitySource);
+}
