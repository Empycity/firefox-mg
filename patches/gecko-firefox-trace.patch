+    if (!p) {
+      return;
+    }
+    p = strchr(p, ':');
+    if (!p) {
+      return;
+    }
+    p++;
+    while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t') {
+      p++;
+    }
+    char value[32];
+    size_t len = 0;
+    while (*p >= '0' && *p <= '9' && len + 1 < sizeof(value)) {
