+mozilla::ipc::IPCResult mozilla::dom::ContentChild::RecvFirefoxTraceRuntimeConfig(
+    const nsACString& aConfigJson) {
+  nsCString config(aConfigJson);
+  config.Append('\0');
+  FirefoxTraceApplyRuntimeConfigJson(config.BeginWriting());
+  const char* versionText = PR_GetEnv("TRACE_CONTROL_VERSION");
+  const char* configHash = PR_GetEnv("TRACE_CONFIG_HASH");
+  uint64_t version = versionText ? strtoull(versionText, nullptr, 10) : 0;
+  bool ackSent = SendFirefoxTraceRuntimeConfigApplied(
+      version, nsDependentCString(configHash ? configHash : ""));
+  FirefoxTraceWriteRuntimeConfigReceipt(
+      version, nsDependentCString(configHash ? configHash : ""), ackSent);
+  return IPC_OK();
+}
