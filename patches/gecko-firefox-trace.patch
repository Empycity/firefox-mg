+struct FirefoxTraceJSHotFunctionBucket {
+  std::atomic<uint64_t> key{0};
+  std::atomic<uint64_t> count{0};
+  std::atomic<bool> sentinelWritten{false};
+};
+
+static FirefoxTraceJSHotFunctionBucket sFirefoxTraceJSHotFunctionBuckets[4096];
+
+FirefoxTraceJSHotFunctionBucket* FirefoxTraceJSHotFunctionBucketFor(
+    uint64_t key) {
+  size_t start = static_cast<size_t>(key) %
+                 (sizeof(sFirefoxTraceJSHotFunctionBuckets) /
+                  sizeof(sFirefoxTraceJSHotFunctionBuckets[0]));
+  for (size_t probe = 0;
+       probe < sizeof(sFirefoxTraceJSHotFunctionBuckets) /
+                   sizeof(sFirefoxTraceJSHotFunctionBuckets[0]);
+       probe++) {
+    FirefoxTraceJSHotFunctionBucket* bucket =
+        &sFirefoxTraceJSHotFunctionBuckets
+            [(start + probe) %
+             (sizeof(sFirefoxTraceJSHotFunctionBuckets) /
+              sizeof(sFirefoxTraceJSHotFunctionBuckets[0]))];
+    uint64_t empty = 0;
+    if (bucket->key.compare_exchange_strong(empty, key,
+                                            std::memory_order_relaxed)) {
+      bucket->count.store(0, std::memory_order_relaxed);
+      bucket->sentinelWritten.store(false, std::memory_order_relaxed);
+      return bucket;
+    }
+    if (bucket->key.load(std::memory_order_relaxed) == key) {
+      return bucket;
+    }
+  }
+  return nullptr;
+}
+
+void FirefoxTraceWriteJSHotFunctionSentinel(const char* scriptUrl,
+                                            const char* functionName,
+                                            uint64_t key, uint64_t count,
+                                            uint32_t limit,
+                                            uint32_t sample) {
+#if defined(XP_UNIX)
+  char* lineBuffer = nullptr;
+  size_t lineSize = 0;
+  FILE* file = open_memstream(&lineBuffer, &lineSize);
+#else
+  FILE* file = FirefoxTraceOpenJSLog();
+#endif
+  if (!file) {
+    return;
+  }
+
+  fputs("{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\",",
+        file);
+  fprintf(file,
+          "\"ts_us\":%llu,\"pid\":%d,\"module\":\"js\","
+          "\"reason\":\"hot_function_limit\",\"function_key\":\"%llx\","
+          "\"count\":%llu,\"limit\":%u,\"sample\":%u,\"script_url\":",
+          static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+          static_cast<unsigned long long>(key),
+          static_cast<unsigned long long>(count), limit, sample);
+  FirefoxTraceWriteJsonString(file, scriptUrl);
+  fputs(",\"function_name\":", file);
+  FirefoxTraceWriteJsonString(file, functionName);
+  fputs("}\n", file);
+
+#if defined(XP_UNIX)
+  fclose(file);
+  FirefoxTraceWriteJSEventLineRaw(lineBuffer, lineSize);
+  free(lineBuffer);
+#else
+  fclose(file);
+#endif
+}
+
+bool FirefoxTraceShouldLogHotFunction(const char* scriptUrl,
+                                      const char* functionName,
+                                      uint64_t* outCount,
+                                      bool* outSampled) {
+  if (outCount) {
+    *outCount = 0;
+  }
+  if (outSampled) {
+    *outSampled = false;
+  }
+
+  uint32_t limit = FirefoxTraceJSHotFunctionLimit();
+  if (!limit) {
+    return true;
+  }
+
+  uint64_t key = FirefoxTraceJSFunctionKey(scriptUrl, functionName);
+  FirefoxTraceJSHotFunctionBucket* bucket =
+      FirefoxTraceJSHotFunctionBucketFor(key);
+  if (!bucket) {
+    return true;
+  }
+
+  uint64_t count =
+      bucket->count.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (outCount) {
+    *outCount = count;
+  }
+  if (count <= limit) {
+    return true;
+  }
+
+  uint32_t sample = FirefoxTraceJSHotFunctionSample();
+  bool sampled = sample && (count % sample == 0);
+  if (outSampled) {
+    *outSampled = sampled;
+  }
+
+  bool expected = false;
+  if (bucket->sentinelWritten.compare_exchange_strong(
+          expected, true, std::memory_order_relaxed)) {
+    FirefoxTraceWriteJSHotFunctionSentinel(scriptUrl, functionName, key, count,
+                                           limit, sample);
+  }
+
+  return sampled;
+}
