+  if (FirefoxTraceCSVMatchesCString("Screen", aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "width,height,availWidth,availHeight,colorDepth,pixelDepth,orientation",
+        aMemberName);
+  }
+
+  if (FirefoxTraceCSVMatchesCString("Window", aInterfaceName)) {
+    if (FirefoxTraceCSVMatchesCString(
+            "innerWidth,innerHeight,outerWidth,outerHeight,screenX,screenY,"
+            "devicePixelRatio,matchMedia,open,postMessage",
+            aMemberName)) {
+      return true;
+    }
+  }
+
+  if (FirefoxTraceCSVMatchesCString("Document", aInterfaceName)) {
+    if (FirefoxTraceCSVMatchesCString(
+            "hidden,visibilityState,referrer,characterSet,compatMode,fonts,"
+            "hasFocus,createElement,elementFromPoint,elementsFromPoint,"
+            "querySelector,querySelectorAll,activeElement,createTextNode",
+            aMemberName)) {
+      return true;
+    }
+  }
+
+  if (FirefoxTraceCSVMatchesCString("Node", aInterfaceName) &&
+      FirefoxTraceCSVMatchesCString(
+          "appendChild,insertBefore,removeChild,replaceChild", aMemberName)) {
+    return true;
+  }
