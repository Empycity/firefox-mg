+bool FirefoxTraceScriptURLIsWeb(const char* scriptUrl) {
+  if (!scriptUrl || !scriptUrl[0]) {
+    return false;
+  }
+  if (strstr(scriptUrl, "/Nightly.app/Contents/Resources/") ||
+      strstr(scriptUrl, "/Contents/Resources/browser/chrome/") ||
+      strstr(scriptUrl, "/dist/bin/browser/chrome/")) {
+    return false;
+  }
+  return strncmp(scriptUrl, "http://", 7) == 0 ||
+         strncmp(scriptUrl, "https://", 8) == 0 ||
+         strncmp(scriptUrl, "file://", 7) == 0 ||
+         strncmp(scriptUrl, "blob:", 5) == 0;
+}
+
+bool FirefoxTraceScriptURLIsChromeLike(const char* scriptUrl) {
+  if (!scriptUrl || !scriptUrl[0]) {
+    return false;
+  }
+  return strncmp(scriptUrl, "chrome://", 9) == 0 ||
+         strncmp(scriptUrl, "resource://", 11) == 0 ||
+         strcmp(scriptUrl, "self-hosted") == 0 ||
+         strstr(scriptUrl, "/Nightly.app/Contents/Resources/") ||
+         strstr(scriptUrl, "/Contents/Resources/browser/chrome/") ||
+         strstr(scriptUrl, "/dist/bin/browser/chrome/");
+}
