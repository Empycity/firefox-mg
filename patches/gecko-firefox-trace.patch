+  if (FirefoxTraceCSVMatchesCString("HTMLIFrameElement", aInterfaceName) &&
+      FirefoxTraceCSVMatchesCString("contentWindow,contentDocument", aMemberName)) {
+    return true;
+  }
+
+  if (FirefoxTraceCSVMatchesCString("MutationObserver", aInterfaceName) &&
+      FirefoxTraceCSVMatchesCString("observe,disconnect,takeRecords", aMemberName)) {
+    return true;
+  }
+
+  if (FirefoxTraceCSVMatchesCString(
+          "EventTarget,Window,Document,Element,HTMLElement,Node",
+          aInterfaceName)) {
+    if (FirefoxTraceCSVMatchesCString(
+            "addEventListener,removeEventListener,dispatchEvent",
+            aMemberName)) {
+      return true;
+    }
+  }
+
+  if (FirefoxTraceCSVMatchesCString(
+          "Event,UIEvent,MouseEvent,PointerEvent,TouchEvent,Touch,"
+          "WheelEvent,KeyboardEvent,InputEvent,DragEvent",
+          aInterfaceName)) {
+    return FirefoxTraceCSVMatchesCString(
+        "type,timeStamp,isTrusted,target,currentTarget,eventPhase,bubbles,"
+        "cancelable,defaultPrevented,composed,detail,view,which,screenX,"
+        "screenY,clientX,clientY,pageX,pageY,offsetX,offsetY,movementX,"
+        "movementY,x,y,button,buttons,relatedTarget,ctrlKey,shiftKey,altKey,"
+        "metaKey,getModifierState,pointerId,width,height,pressure,"
+        "tangentialPressure,tiltX,tiltY,twist,pointerType,isPrimary,deltaX,"
+        "deltaY,deltaZ,deltaMode,identifier,radiusX,radiusY,rotationAngle,"
+        "force,touches,targetTouches,changedTouches,key,code,location,repeat,"
+        "isComposing,keyCode,charCode,data,inputType,dataTransfer",
+        aMemberName);
