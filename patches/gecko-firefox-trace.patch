+// final trace retains dynamic-time inputs without synchronous hot-path I/O.
+extern "C" void FirefoxTraceRecordDateNow(double aValue) {
+  if (!FirefoxTraceJSFullSpoolEnabled()) {
+    return;
+  }
+
+  uint64_t sequence = sFirefoxTraceNextJSTimeSequence.fetch_add(
+      1, std::memory_order_relaxed);
