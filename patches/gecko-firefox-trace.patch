+uint32_t FirefoxTraceDOMArgLimit() {
+  const char* argLimit =
+      FirefoxTraceEnv("FIREFOX_TRACE_DOM_ARG_LIMIT", "TRACE_DOM_ARG_LIMIT");
+  if (!argLimit || !argLimit[0]) {
+    argLimit = FirefoxTraceEnv("FIREFOX_TRACE_ARG_LIMIT", "TRACE_ARG_LIMIT");
+  }
+  if (!argLimit || !argLimit[0]) {
+    return 8;
+  }
+
+  char* end = nullptr;
+  unsigned long parsed = strtoul(argLimit, &end, 10);
+  if (end == argLimit) {
+    return 8;
+  }
+
+  if (parsed > 64) {
+    return 64;
+  }
+
+  return static_cast<uint32_t>(parsed);
+}
