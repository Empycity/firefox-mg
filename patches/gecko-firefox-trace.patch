+void FirefoxTraceWriteVMStepLimitSentinel(uint32_t aLimit) {
+  bool expected = false;
+  if (!sFirefoxTraceVMStepLimitSentinelWritten.compare_exchange_strong(
+          expected, true)) {
+    return;
+  }
+  char line[384];
+  int len = SprintfLiteral(
+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\","
+      "\"ts_us\":%llu,\"pid\":%d,\"module\":\"vm_step\","
+      "\"reason\":\"vm_step_limit\",\"limit\":%u}\n",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(), aLimit);
+  if (len > 0) {
+    FirefoxTraceWriteJSEventLineRaw(line, static_cast<size_t>(len));
+  }
+}
+
+void FirefoxTraceWriteVMStep(JSScript* aScript, uint64_t aPC,
+                              const InterpreterRegs& aRegs) {
+  if (!FirefoxTraceVMStepMatches(aPC)) {
+    return;
+  }
+  uint32_t limit = FirefoxTraceParseUintEnv("FIREFOX_TRACE_VM_STEP_LIMIT",
+                                            "TRACE_VM_STEP_LIMIT", 2048,
+                                            UINT32_MAX);
+  uint64_t step = sFirefoxTraceVMStepCount.fetch_add(
+                      1, std::memory_order_relaxed) +
+                  1;
+  if (limit && step > limit) {
+    FirefoxTraceWriteVMStepLimitSentinel(limit);
+    return;
+  }
+  char line[768];
+  int len = SprintfLiteral(
+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"js.vm_step\","
+      "\"ts_us\":%llu,\"pid\":%d,\"step_index\":%llu,"
+      "\"script_line\":%u,\"script_column\":%u,"
+      "\"script_bytecode_length\":%zu,\"vm_dispatch_pc\":%llu,"
+      "\"stack_depth\":%u,\"execution_tier\":\"interpreter\"}\n",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+      static_cast<unsigned long long>(step), aScript->lineno(),
+      aScript->column().oneOriginValue(), aScript->length(),
+      static_cast<unsigned long long>(aPC), aRegs.stackDepth());
+  if (len > 0) {
+    FirefoxTraceWriteJSEventLineRaw(line, static_cast<size_t>(len));
+  }
+}
+
+void FirefoxTraceWriteOpcodeEvent(JSScript* aScript, jsbytecode* aPC,
+                                  const InterpreterRegs& aRegs) {
+  FirefoxTraceRefreshJSSegmentState();
+  if (!aScript || !aPC) {
+    return;
+  }
+
+  const char* scriptURL = aScript->filename();
+  if (!FirefoxTraceOpcodeScriptMatches(scriptURL) ||
+      !FirefoxTraceOpcodeScriptIdentityMatches(aScript)) {
+    return;
+  }
+
+  uint64_t pcOffset = aScript->pcToOffset(aPC);
+  bool opcodeLogEnabled = FirefoxTraceOpcodeEventLoggingEnabled();
+  bool vmWindowEnabled = FirefoxTraceVMWindowEnabled();
+  bool vmStepMatch = FirefoxTraceVMStepMatches(pcOffset);
+  bool opcodePCMatch = opcodeLogEnabled && FirefoxTraceOpcodePCMatches(pcOffset);
+  bool vmWindowMatch =
+      vmWindowEnabled && FirefoxTraceOpcodePCMatches(pcOffset);
+  if (!vmStepMatch && !opcodePCMatch && !vmWindowMatch) {
+    return;
+  }
+  if (vmWindowMatch) {
+    FirefoxTraceAppendVMWindowRecord(aScript, aPC, pcOffset, aRegs);
+  }
+  // The execution budget applies only to instructions selected for verbose
+  // opcode/VM-step output. A narrow PC range must not spend its budget on
+  // unrelated bytecodes executed earlier in the same script.
+  if ((vmStepMatch || opcodePCMatch) &&
+      !FirefoxTraceConsumeOpcodeExecutionBudget(aScript)) {
+    return;
+  }
+  if (!vmStepMatch && !opcodePCMatch) {
+    return;
+  }
+  // Reserve a bounded local budget before formatting/IPC. This keeps a hot
+  // VM loop from spending CPU on JSON construction after the safe window is
+  // exhausted; the separate IPC budget remains the final cross-process gate.
+  uint32_t estimatedBytes =
+      2048 + static_cast<uint32_t>(strlen(scriptURL ? scriptURL : ""));
+  if (!FirefoxTraceConsumeOpcodeRateBudget(estimatedBytes)) {
+    return;
+  }
+  // vm_step is scoped by the pinned JSScript but has its own dispatch PC and
+  // limit. This allows a running trace to move the VM marker independently of
+  // the opcode display window.
+  FirefoxTraceWriteVMStep(aScript, pcOffset, aRegs);
+  if (!opcodePCMatch) {
+    return;
+  }
+
+  uint32_t limit = FirefoxTraceOpcodeLimit();
+  uint64_t eventIndex = sFirefoxTraceOpcodeEventCount.fetch_add(
+                            1, std::memory_order_relaxed) +
+                        1;
+  if (limit && eventIndex > limit) {
+    FirefoxTraceWriteOpcodeLimitSentinel(limit);
+    return;
+  }
+
+#if defined(XP_UNIX)
+  char* lineBuffer = nullptr;
+  size_t lineSize = 0;
+  FILE* file = open_memstream(&lineBuffer, &lineSize);
+#else
+  FILE* file = FirefoxTraceOpenJSLog();
+#endif
+  if (!file) {
+    return;
+  }
+
+  JSOp op = JSOp(*aPC);
+  unsigned bytecodeLength = GetBytecodeLength(aPC);
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  fprintf(file,
+          "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"js.opcode\","
+          "\"ts_us\":%llu,\"pid\":%d,\"event_index\":%llu,"
+          "\"script_url\":",
+          static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+          static_cast<unsigned long long>(eventIndex));
+  FirefoxTraceWriteJsonString(file, scriptURL);
+  fprintf(file,
+          ",\"script_line\":%u,\"script_column\":%u,"
+          "\"script_bytecode_length\":%zu,\"pc\":%llu,\"op\":%u,"
+          "\"op_name\":",
+          aScript->lineno(), aScript->column().oneOriginValue(),
+          aScript->length(),
+          static_cast<unsigned long long>(pcOffset),
+          static_cast<unsigned>(uint8_t(op)));
+  FirefoxTraceWriteJsonString(file, CodeName(op));
+  fprintf(file,
+          ",\"bytecode_length\":%u,\"operand_format\":%u,"
+          "\"stack_depth\":%u,\"stack_uses\":%u,\"stack_defs\":%u,"
+          "\"execution_tier\":\"interpreter\"",
+          bytecodeLength, JOF_TYPE(CodeSpec(op).format),
+          aRegs.stackDepth(), StackUses(op, aPC), StackDefs(op));
+  if (FirefoxTraceOpcodeOperandsEnabled() && bytecodeLength > 1) {
+    static const char kHex[] = "0123456789abcdef";
+    char operandHex[33];
+    unsigned operandBytes = std::min<unsigned>(bytecodeLength - 1, 16);
+    for (unsigned i = 0; i < operandBytes; i++) {
+      uint8_t byte = uint8_t(aPC[i + 1]);
+      operandHex[i * 2] = kHex[byte >> 4];
+      operandHex[i * 2 + 1] = kHex[byte & 0x0f];
+    }
+    operandHex[operandBytes * 2] = '\0';
+    fputs(",\"operand_bytes_hex\":", file);
+    FirefoxTraceWriteJsonString(file, operandHex);
+    if (bytecodeLength - 1 > operandBytes) {
+      fputs(",\"operand_bytes_truncated\":true", file);
+    }
+  }
+  FirefoxTraceWriteOpcodeStackSlots(file, aRegs);
+  if (originCallId) {
+    fprintf(file, ",\"origin_call_id\":\"call_%llu\"",
+            static_cast<unsigned long long>(originCallId));
+  }
+  fputs(",\"segment_id\":", file);
+  FirefoxTraceWriteJsonString(file, FirefoxTraceEnv("TRACE_SEGMENT_ID"));
+  fputs(",\"control_version\":", file);
+  FirefoxTraceWriteJsonString(file, FirefoxTraceEnv("TRACE_CONTROL_VERSION"));
+  fputs(",\"config_hash\":", file);
+  FirefoxTraceWriteJsonString(file, FirefoxTraceEnv("TRACE_CONFIG_HASH"));
+  fputs("}\n", file);
+
+#if defined(XP_UNIX)
+  fclose(file);
+  FirefoxTraceWriteJSEventLineRaw(lineBuffer, lineSize);
+  free(lineBuffer);
+#else
+  fclose(file);
+#endif
+}
+
+uint64_t FirefoxTraceHashCString(uint64_t hash, const char* value) {
+  const unsigned char* p = reinterpret_cast<const unsigned char*>(
+      value && value[0] ? value : "<null>");
+  while (*p) {
+    hash ^= *p++;
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
+
+uint64_t FirefoxTraceJSFunctionKey(const char* scriptUrl,
+                                   const char* functionName) {
+  uint64_t hash = 1469598103934665603ULL;
+  hash = FirefoxTraceHashCString(hash, scriptUrl);
+  hash ^= '|';
+  hash *= 1099511628211ULL;
+  hash = FirefoxTraceHashCString(hash, functionName);
+  return hash ? hash : 1;
+}
+
+void FirefoxTraceComputeJSScriptId(const char* scriptUrl,
+                                   const char* functionName, uint32_t line,
+                                   uint32_t column, char out[32]) {
+  uint64_t hash = 1469598103934665603ULL;
+  hash = FirefoxTraceHashCString(hash, scriptUrl);
+  hash ^= '|';
+  hash *= 1099511628211ULL;
+  hash = FirefoxTraceHashCString(hash, functionName);
+  hash ^= line & 0xff;
+  hash *= 1099511628211ULL;
+  hash ^= (line >> 8) & 0xff;
+  hash *= 1099511628211ULL;
+  hash ^= column & 0xff;
+  hash *= 1099511628211ULL;
+  hash ^= (column >> 8) & 0xff;
+  hash *= 1099511628211ULL;
+  snprintf(out, 32, "sid_%016llx", static_cast<unsigned long long>(hash));
+}
+
+static std::atomic<uint64_t> sFirefoxTraceJSScriptDumped[4096];
+
+bool FirefoxTraceMarkJSScriptDumped(const char* scriptSha256) {
+  if (!scriptSha256 || !scriptSha256[0]) {
+    return false;
+  }
+
+  uint64_t key = FirefoxTraceHashCString(1469598103934665603ULL, scriptSha256);
+  if (!key) {
+    key = 1;
+  }
+  size_t bucketCount = sizeof(sFirefoxTraceJSScriptDumped) /
+                       sizeof(sFirefoxTraceJSScriptDumped[0]);
+  size_t start = static_cast<size_t>(key) % bucketCount;
+  for (size_t probe = 0; probe < bucketCount; probe++) {
+    std::atomic<uint64_t>& bucket =
+        sFirefoxTraceJSScriptDumped[(start + probe) % bucketCount];
+    uint64_t seen = bucket.load(std::memory_order_relaxed);
+    if (seen == key) {
+      return false;
+    }
+    uint64_t empty = 0;
+    if (seen == empty &&
+        bucket.compare_exchange_strong(empty, key,
+                                       std::memory_order_relaxed)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool FirefoxTraceWriteJSScriptSourceFile(const char* scriptSha256,
+                                         const char* data, size_t len,
+                                         char* relPath, size_t relPathLen) {
+  if (!FirefoxTraceBaseEnabled()) {
+    return false;
+  }
+  if (!scriptSha256 || !scriptSha256[0] || !data || !relPath || !relPathLen) {
+    return false;
+  }
+
+  snprintf(relPath, relPathLen, "scripts/%s.js", scriptSha256);
+
+  if (!FirefoxTraceMarkJSScriptDumped(scriptSha256)) {
+    return true;
+  }
+
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendScriptSourceToParent &&
+      FirefoxTraceSendScriptSourceToParent(scriptSha256, data, len)) {
+    return true;
+  }
+#endif
+
+  const char* logDir = FirefoxTraceLogDir();
+  mkdir(logDir, 0755);
+
+  char scriptsDir[4096];
+  SprintfLiteral(scriptsDir, "%s/scripts", logDir);
+  mkdir(scriptsDir, 0755);
+
+  char path[4096];
+  SprintfLiteral(path, "%s/%s", logDir, relPath);
+  FILE* file = fopen(path, "wb");
+  if (!file) {
+    return false;
+  }
+
+  size_t written = fwrite(data, 1, len, file);
+  fclose(file);
+  return written == len;
+}
+
+bool FirefoxTraceComputeJSScriptSHA256(JSContext* cx, JS::HandleScript script,
+                                       char out[65], uint32_t* outLength,
+                                       const char** outStatus,
+                                       char* outSourcePath,
+                                       size_t outSourcePathLen,
+                                       const char** outSourceStatus,
+                                       bool dumpSource) {
+  if (outLength) {
+    *outLength = 0;
+  }
+  if (outStatus) {
+    *outStatus = nullptr;
+  }
+  if (outSourcePath && outSourcePathLen) {
+    outSourcePath[0] = '\0';
+  }
+  if (outSourceStatus) {
+    *outSourceStatus = nullptr;
+  }
+  if (!cx || !script) {
+    if (outStatus) {
+      *outStatus = "no_script";
+    }
+    return false;
+  }
+
+  ScriptSource* source = script->scriptSource();
+  if (!source) {
+    if (outStatus) {
+      *outStatus = "no_source";
+    }
+    return false;
+  }
+
+  bool hasSourceText = false;
+  if (!ScriptSource::loadSource(cx, source, &hasSourceText)) {
+    JS_ClearPendingException(cx);
+    if (outStatus) {
+      *outStatus = "load_failed";
+    }
+    return false;
+  }
+  if (!hasSourceText) {
+    if (outStatus) {
+      *outStatus = "no_source_text";
+    }
+    return false;
+  }
+
+  uint32_t sourceLength = source->length();
+  if (outLength) {
+    *outLength = sourceLength;
+  }
+  uint32_t maxBytes = FirefoxTraceJSScriptHashMaxBytes();
+  if (sourceLength > maxBytes) {
+    if (outStatus) {
+      *outStatus = "too_large";
+    }
+    return false;
+  }
+
+  JS::Rooted<JSLinearString*> sourceText(cx,
+                                         source->substring(cx, 0, sourceLength));
+  if (!sourceText) {
+    JS_ClearPendingException(cx);
+    if (outStatus) {
+      *outStatus = "substring_failed";
+    }
+    return false;
+  }
+
+  JS::RootedString sourceString(cx, sourceText);
+  JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, sourceString);
+  if (!utf8) {
+    JS_ClearPendingException(cx);
+    if (outStatus) {
+      *outStatus = "encode_failed";
+    }
+    return false;
+  }
+
+  FirefoxTraceComputeSHA256Hex(utf8.get(), strlen(utf8.get()), out);
+  if (dumpSource && FirefoxTraceJSScriptDumpEnabled()) {
+    size_t sourceBytes = strlen(utf8.get());
+    uint32_t dumpMaxBytes = FirefoxTraceJSScriptDumpMaxBytes();
+    if (sourceBytes > dumpMaxBytes) {
+      if (outSourceStatus) {
+        *outSourceStatus = "too_large";
+      }
+    } else if (FirefoxTraceWriteJSScriptSourceFile(
+                   out, utf8.get(), sourceBytes, outSourcePath,
+                   outSourcePathLen)) {
+      if (outSourceStatus) {
+        *outSourceStatus = "stored";
+      }
+    } else if (outSourceStatus) {
+      *outSourceStatus = "write_failed";
+    }
+  }
+  if (outStatus) {
+    *outStatus = "ok";
+  }
+  return true;
+}
+
+struct FirefoxTraceJSHotFunctionBucket {
+  std::atomic<uint64_t> key{0};
+  std::atomic<uint64_t> count{0};
+  std::atomic<bool> sentinelWritten{false};
+};
+
+static FirefoxTraceJSHotFunctionBucket sFirefoxTraceJSHotFunctionBuckets[4096];
+
+FirefoxTraceJSHotFunctionBucket* FirefoxTraceJSHotFunctionBucketFor(
+    uint64_t key) {
+  size_t start = static_cast<size_t>(key) %
+                 (sizeof(sFirefoxTraceJSHotFunctionBuckets) /
+                  sizeof(sFirefoxTraceJSHotFunctionBuckets[0]));
+  for (size_t probe = 0;
+       probe < sizeof(sFirefoxTraceJSHotFunctionBuckets) /
+                   sizeof(sFirefoxTraceJSHotFunctionBuckets[0]);
+       probe++) {
+    FirefoxTraceJSHotFunctionBucket* bucket =
+        &sFirefoxTraceJSHotFunctionBuckets
+            [(start + probe) %
+             (sizeof(sFirefoxTraceJSHotFunctionBuckets) /
+              sizeof(sFirefoxTraceJSHotFunctionBuckets[0]))];
+    uint64_t empty = 0;
+    if (bucket->key.compare_exchange_strong(empty, key,
+                                            std::memory_order_relaxed)) {
+      bucket->count.store(0, std::memory_order_relaxed);
+      bucket->sentinelWritten.store(false, std::memory_order_relaxed);
+      return bucket;
+    }
+    if (bucket->key.load(std::memory_order_relaxed) == key) {
+      return bucket;
+    }
+  }
+  return nullptr;
+}
+
+void FirefoxTraceWriteJSHotFunctionSentinel(const char* scriptUrl,
+                                            const char* functionName,
+                                            uint64_t key, uint64_t count,
+                                            uint32_t limit,
+                                            uint32_t sample) {
+#if defined(XP_UNIX)
+  char* lineBuffer = nullptr;
+  size_t lineSize = 0;
+  FILE* file = open_memstream(&lineBuffer, &lineSize);
+#else
+  FILE* file = FirefoxTraceOpenJSLog();
+#endif
+  if (!file) {
+    return;
+  }
+
+  fputs("{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\",",
+        file);
+  fprintf(file,
+          "\"ts_us\":%llu,\"pid\":%d,\"module\":\"js\","
+          "\"reason\":\"hot_function_limit\",\"function_key\":\"%llx\","
+          "\"count\":%llu,\"limit\":%u,\"sample\":%u,\"script_url\":",
+          static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+          static_cast<unsigned long long>(key),
+          static_cast<unsigned long long>(count), limit, sample);
+  FirefoxTraceWriteJsonString(file, scriptUrl);
+  fputs(",\"function_name\":", file);
+  FirefoxTraceWriteJsonString(file, functionName);
+  fputs("}\n", file);
+
+#if defined(XP_UNIX)
+  fclose(file);
+  FirefoxTraceWriteJSEventLineRaw(lineBuffer, lineSize);
+  free(lineBuffer);
+#else
+  fclose(file);
+#endif
+}
+
+bool FirefoxTraceShouldLogHotFunction(const char* scriptUrl,
+                                      const char* functionName,
+                                      uint64_t* outCount,
+                                      bool* outSampled) {
+  if (outCount) {
+    *outCount = 0;
+  }
+  if (outSampled) {
+    *outSampled = false;
+  }
+
+  uint32_t limit = FirefoxTraceJSHotFunctionLimit();
+  if (!limit) {
+    return true;
+  }
+
+  uint64_t key = FirefoxTraceJSFunctionKey(scriptUrl, functionName);
+  FirefoxTraceJSHotFunctionBucket* bucket =
+      FirefoxTraceJSHotFunctionBucketFor(key);
+  if (!bucket) {
+    return true;
+  }
+
+  uint64_t count =
+      bucket->count.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (outCount) {
+    *outCount = count;
+  }
+  if (count <= limit) {
+    return true;
+  }
+
+  uint32_t sample = FirefoxTraceJSHotFunctionSample();
+  bool sampled = sample && (count % sample == 0);
+  if (outSampled) {
+    *outSampled = sampled;
+  }
+
+  bool expected = false;
+  if (bucket->sentinelWritten.compare_exchange_strong(
+          expected, true, std::memory_order_relaxed)) {
+    FirefoxTraceWriteJSHotFunctionSentinel(scriptUrl, functionName, key, count,
+                                           limit, sample);
+  }
+
+  return sampled;
+}
+
+class MOZ_STACK_CLASS AutoFirefoxTraceJSCall {
+ public:
+  AutoFirefoxTraceJSCall(JSContext* cx, const CallArgs& args,
+                         MaybeConstruct construct)
+      : cx_(cx),
+        args_(args),
+        enabled_(FirefoxTraceJSStackEnabled()),
+        logEnabled_(FirefoxTraceJSLogEnabled()),
+        argc_(args.length()) {
+    if (!enabled_) {
+      return;
+    }
+
+    // Object previews may execute scripted getters or proxy traps. Those
+    // calls must run normally, but tracing them would recursively preview
+    // their arguments and overflow the content-process stack.
+    if (sFirefoxTraceJSValuePreviewDepth > 0) {
+      enabled_ = false;
+      logEnabled_ = false;
+      return;
+    }
+
+    cacheCalleeRoutingMetadata();
+    earlyScriptFilterActive_ =
+        FirefoxTraceJSModeIsTargetLike() &&
+        FirefoxTraceCanEarlyRejectTargetByScriptURL();
+    if (earlyScriptFilterActive_ &&
+        !(FirefoxTraceJSModeIsDeep() && sFirefoxTraceDeepCaptureDepth > 0) &&
+        !FirefoxTraceTargetScriptURLMatches(scriptUrl_)) {
+      enabled_ = false;
+      logEnabled_ = false;
+      return;
+    }
+
+    cacheCalleeMetadata();
+    targetMatch_ = FirefoxTraceShouldCaptureTargetValues(
+        scriptUrl_, functionName_, scriptSha256_, scriptSha256Available_);
+    objectTargetMatch_ = FirefoxTraceMatchesConfiguredJSIdentity(
+        scriptUrl_, functionName_, scriptSha256_, scriptSha256Available_);
+    const bool boundaryEligible =
+        FirefoxTraceJSModeIsBoundary() &&
+        FirefoxTraceShouldLogBoundary(calleeKind_, scriptUrl_,
+                                       isScriptedCallee_);
+    autoCaptureValues_ =
+        FirefoxTraceJSAutoCaptureValuesEnabled() &&
+        FirefoxTraceJSModeIsBoundary() && isScriptedCallee_ &&
+        boundaryEligible;
+    captureValues_ =
+        (FirefoxTraceJSCaptureValuesEnabled() &&
+         (targetMatch_ ||
+          (FirefoxTraceJSModeIsBoundary() && isScriptedCallee_ &&
+           boundaryEligible) ||
+          (FirefoxTraceJSModeIsDeep() &&
+           sFirefoxTraceDeepCaptureDepth > 0))) ||
+        autoCaptureValues_;
+    if (captureValues_ &&
+        FirefoxTraceShouldSuppressDeepDescendant(calleeKind_, functionName_,
+                                                targetMatch_)) {
+      FirefoxTraceWriteJSDeepSuppressionNotice(calleeKind_, functionName_);
+      enabled_ = false;
+      logEnabled_ = false;
+      captureValues_ = false;
+      return;
+    }
+    logEnabled_ =
+        logEnabled_ &&
+        (boundaryEligible ||
+         targetMatch_ || captureValues_);
+    pruneNonTargetFunctionStack_ =
+        FirefoxTraceJSPruneNonTargetFunctionsEnabled() &&
+        FirefoxTraceHasFunctionFilters();
+
+    if (pruneNonTargetFunctionStack_ && !logEnabled_ && !targetMatch_ &&
+        !captureValues_) {
+      enabled_ = false;
+      return;
+    }
+
+    if (logEnabled_ || targetMatch_ || captureValues_) {
+      maybeDumpScriptSource();
+    }
+
+    callId_ = sFirefoxTraceNextJSCallId.fetch_add(1, std::memory_order_relaxed);
+    parentCallId_ = sFirefoxTraceCurrentJSCallId;
+    parentScriptedCallId_ = sFirefoxTraceCurrentScriptedJSCallId;
+    sFirefoxTraceCurrentJSCallId = callId_;
+    if (isScriptedCallee_) {
+      sFirefoxTraceCurrentScriptedJSCallId = callId_;
+    }
+    if (FirefoxTraceJSModeIsDeep() && captureValues_) {
+      sFirefoxTraceDeepCaptureDepth++;
+      pushedDeepCaptureDepth_ = true;
+    }
+
+    if (logEnabled_ && captureValues_ &&
+        !FirefoxTraceShouldLogHotFunction(scriptUrl_, functionName_, &hotCount_,
+                                          &hotSampled_)) {
+      logEnabled_ = false;
+      hotSuppressed_ = true;
+    }
+
+    if (logEnabled_) {
+      writeEvent("js.call.enter", construct == CONSTRUCT, true);
+    }
+  }
+
+  bool finish(bool ok) {
+    if (!enabled_) {
+      return ok;
+    }
+
+    if (logEnabled_) {
+      ok_ = ok;
+      writeEvent("js.call.return", false, false);
+    }
+
+    sFirefoxTraceCurrentJSCallId = parentCallId_;
+    sFirefoxTraceCurrentScriptedJSCallId = parentScriptedCallId_;
+    if (pushedDeepCaptureDepth_) {
+      sFirefoxTraceDeepCaptureDepth--;
+      pushedDeepCaptureDepth_ = false;
+    }
+    enabled_ = false;
+    return ok;
+  }
+
+  ~AutoFirefoxTraceJSCall() {
+    if (enabled_) {
+      sFirefoxTraceCurrentJSCallId = parentCallId_;
+      sFirefoxTraceCurrentScriptedJSCallId = parentScriptedCallId_;
+      if (pushedDeepCaptureDepth_) {
+        sFirefoxTraceDeepCaptureDepth--;
+      }
+    }
+  }
+
+ private:
+  const char* calleeKind(JSFunction* fun) const {
+    if (!fun) {
+      if (args_.callee().is<ProxyObject>()) {
+        return "proxy";
+      }
+      return args_.callee().isCallable() ? "callable" : "object";
+    }
+
+    if (fun->isNativeFun()) {
+      return "native";
+    }
+    if (fun->isSelfHostedBuiltin()) {
+      return "self_hosted";
+    }
+    if (fun->isInterpreted()) {
+      return "interpreted";
+    }
+    return "function";
+  }
+
+  const char* functionName(JSFunction* fun) const {
+    if (!fun) {
+      return nullptr;
+    }
+    return fun->maybePartialDisplayAtom() ? nullptr : "anonymous";
+  }
+
+  JSScript* calleeScript(JSFunction* fun) {
+    if (!fun || !fun->isInterpreted() || !fun->hasBytecode()) {
+      return nullptr;
+    }
+    return fun->nonLazyScript();
+  }
+
+  void cacheCalleeRoutingMetadata() {
+    if (routingMetadataCached_) {
+      return;
+    }
+    routingMetadataCached_ = true;
+
+    if (args_.callee().is<JSFunction>()) {
+      fun_ = &args_.callee().as<JSFunction>();
+    }
+
+    JSScript* script = calleeScript(fun_);
+    script_ = script;
+    calleeKind_ = calleeKind(fun_);
+    scriptUrl_ = script_ ? script_->filename() : nullptr;
+    line_ = script_ ? script_->lineno() : 0;
+    column_ = script_ ? script_->column().oneOriginValue() : 0;
+    isScriptedCallee_ = script_ != nullptr;
+  }
+
+  void cacheCalleeMetadata() {
+    if (calleeMetadataCached_) {
+      return;
+    }
+    cacheCalleeRoutingMetadata();
+    calleeMetadataCached_ = true;
+
+    functionName_ = functionName(fun_);
+    if (fun_ && fun_->maybePartialDisplayAtom()) {
+      JS::RootedString name(cx_, fun_->maybePartialDisplayAtom());
+      functionNameBytes_ = JS_EncodeStringToUTF8(cx_, name);
+      if (functionNameBytes_) {
+        functionName_ = functionNameBytes_.get();
+      }
+    }
+    FirefoxTraceComputeJSScriptId(scriptUrl_, functionName_, line_, column_,
+                                  scriptId_);
+    if (script_ && FirefoxTraceJSScriptHashEnabled()) {
+      JS::RootedScript rootedScript(cx_, script_);
+      scriptSha256Available_ = FirefoxTraceComputeJSScriptSHA256(
+          cx_, rootedScript, scriptSha256_, &scriptSourceLength_,
+          &scriptHashStatus_, scriptSourcePath_, sizeof(scriptSourcePath_),
+          &scriptSourceStatus_, false);
+    }
+  }
+
+  void maybeDumpScriptSource() {
+    if (!cx_ || !script_ || !scriptSha256Available_ ||
+        !FirefoxTraceJSScriptDumpEnabled() || scriptSourcePath_[0]) {
+      return;
+    }
+
+    char scriptSha256[65];
+    uint32_t sourceLength = 0;
+    const char* hashStatus = nullptr;
+    JS::RootedScript rootedScript(cx_, script_);
+    if (FirefoxTraceComputeJSScriptSHA256(
+            cx_, rootedScript, scriptSha256, &sourceLength, &hashStatus,
+            scriptSourcePath_, sizeof(scriptSourcePath_), &scriptSourceStatus_,
+            true)) {
+      scriptSourceLength_ = sourceLength;
+    } else if (!scriptSourceStatus_) {
+      scriptSourceStatus_ = hashStatus;
+    }
+  }
+
+  void writePropertyKey(FILE* file, JS::HandleId id) {
+    if (id.isInt()) {
+      fprintf(file, "\"%d\"", id.toInt());
+      return;
+    }
+
+    if (id.isString()) {
+      JS::RootedString str(cx_, id.toString());
+      JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx_, str);
+      FirefoxTraceWriteJsonString(file, utf8 ? utf8.get() : "<key-encode-failed>");
+      if (!utf8) {
+        JS_ClearPendingException(cx_);
+      }
+      return;
+    }
+
+    if (id.isSymbol()) {
+      FirefoxTraceWriteJsonString(file, "<symbol>");
+      return;
+    }
+
+    FirefoxTraceWriteJsonString(file, "<unknown-key>");
+  }
+
+  bool shouldReadObjectPropertyValue(JS::HandleId id) {
+    const char* filters = FirefoxTraceJSObjectValueKeys();
+    if (!filters) {
+      return true;
+    }
+    if (!filters[0]) {
+      return false;
+    }
+
+    char intKey[32];
+    const char* key = nullptr;
+    JS::UniqueChars utf8;
+    if (id.isInt()) {
+      SprintfLiteral(intKey, "%d", id.toInt());
+      key = intKey;
+    } else if (id.isString()) {
+      JS::RootedString str(cx_, id.toString());
+      utf8 = JS_EncodeStringToUTF8(cx_, str);
+      if (!utf8) {
+        JS_ClearPendingException(cx_);
+        return false;
+      }
+      key = utf8.get();
+    } else if (id.isSymbol()) {
+      key = "<symbol>";
+    } else {
+      key = "<unknown-key>";
+    }
+    return FirefoxTraceCSVMatches(filters, key);
+  }
+
