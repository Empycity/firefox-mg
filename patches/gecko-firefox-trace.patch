+void FirefoxTraceWriteRuntimeConfigAck(ContentParent* aParent,
+                                       uint64_t aVersion,
+                                       const nsACString& aConfigHash) {
+  FirefoxTraceWriteRuntimeConfigRecord(aParent, "trace.config.applied",
+                                       aVersion, aConfigHash, "ack");
+}
