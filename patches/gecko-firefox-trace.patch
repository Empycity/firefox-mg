 namespace {
 
+bool FirefoxTraceStorageEnabled() {
+  const char* enabled = getenv("FIREFOX_TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return false;
+  }
+  if (FirefoxTraceRuntimeActive && !FirefoxTraceRuntimeActive()) {
+    return false;
+  }
+
+  const char* storageEnabled = getenv("FIREFOX_TRACE_STORAGE");
+  if (!storageEnabled || !storageEnabled[0]) {
+    storageEnabled = getenv("TRACE_STORAGE");
+  }
+  return !storageEnabled || strcmp(storageEnabled, "0") != 0;
+}
+
+bool FirefoxTraceStorageURLStartsWith(const nsACString& aURL,
+                                      const char* aPrefix) {
+  return StringBeginsWith(aURL, nsDependentCString(aPrefix));
+}
+
+bool FirefoxTraceStorageIsChromeURL(const nsACString& aURL) {
+  return FirefoxTraceStorageURLStartsWith(aURL, "chrome://") ||
+         FirefoxTraceStorageURLStartsWith(aURL, "resource://") ||
+         FirefoxTraceStorageURLStartsWith(aURL, "about:");
+}
+
+bool FirefoxTraceStorageIsWebURL(const nsACString& aURL) {
+  return FirefoxTraceStorageURLStartsWith(aURL, "http://") ||
+         FirefoxTraceStorageURLStartsWith(aURL, "https://");
+}
+
+bool FirefoxTraceShouldRecordStorageContext(const nsACString& aPageURL,
+                                            const nsACString& aCallerURL) {
+  const char* filter = getenv("FIREFOX_TRACE_STORAGE_FILTER");
+  if (!filter || !filter[0]) {
+    filter = getenv("TRACE_STORAGE_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = getenv("FIREFOX_TRACE_DOM_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = "content";
+  }
+
+  if (strcmp(filter, "all") == 0) {
+    return true;
+  }
+
+  const nsACString& contextURL = !aPageURL.IsEmpty() ? aPageURL : aCallerURL;
+  if (strcmp(filter, "chrome") == 0) {
+    return FirefoxTraceStorageIsChromeURL(contextURL);
+  }
+
+  if (strcmp(filter, "web") == 0) {
+    return FirefoxTraceStorageIsWebURL(contextURL);
+  }
+
+  if (contextURL.IsEmpty() || FirefoxTraceStorageIsChromeURL(contextURL)) {
+    return false;
+  }
+
+  return true;
+}
+
+void FirefoxTraceStorageAppendJsonCString(nsACString& aLine,
+                                          const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceStorageAppendJsonString(nsACString& aLine,
+                                         const nsACString& aValue) {
+  FirefoxTraceStorageAppendJsonCString(aLine,
+                                       PromiseFlatCString(aValue).get());
+}
+
+void FirefoxTraceStorageAppendJsonString16(nsACString& aLine,
+                                           const nsAString& aValue) {
+  NS_ConvertUTF16toUTF8 utf8(aValue);
+  FirefoxTraceStorageAppendJsonString(aLine, utf8);
+}
+
+void FirefoxTraceStorageTruncatePreview(nsACString& aPreview) {
+  uint32_t limit = 4096;
+  const char* configured = getenv("FIREFOX_TRACE_PREVIEW_LIMIT");
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long parsed = strtoul(configured, &end, 10);
+    if (end != configured && parsed > 0) {
+      limit = parsed > 65536 ? 65536 : static_cast<uint32_t>(parsed);
+    }
+  }
+  if (aPreview.Length() > limit) {
+    aPreview.Truncate(limit);
+    aPreview.AppendLiteral("...");
+  }
+}
+
+void FirefoxTraceWriteStorageLine(const nsACString& aLine) {
+  if (XRE_IsContentProcess()) {
+    if (ContentChild* child = ContentChild::GetSingleton()) {
+      Unused << child->SendFirefoxTraceDOMEvent(aLine);
+    }
+    return;
+  }
+
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-storage-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceStorageGetCaller(JSContext* aCx, nsACString& aCallerURL,
+                                  uint32_t* aLine, uint32_t* aColumn) {
+  *aLine = 0;
+  *aColumn = 0;
+  if (!aCx) {
+    return;
+  }
+
+  JS::AutoFilename filename;
+  JS::ColumnNumberOneOrigin column;
+  if (!JS::DescribeScriptedCaller(&filename, aCx, aLine, &column) ||
+      !filename.get()) {
+    return;
+  }
+
+  aCallerURL.Assign(filename.get());
+  *aColumn = column.oneOriginValue();
+}
