+void FirefoxTraceFetchAppendRequestURLField(nsACString& aLine,
+                                            const char* aKey,
+                                            const nsACString& aURL) {
+  const char* mode = FirefoxTraceFetchRequestURLMode();
+  bool none = strcmp(mode, "none") == 0 || strcmp(mode, "off") == 0 ||
+              strcmp(mode, "0") == 0;
+  bool previewOnly = strcmp(mode, "preview") == 0 ||
+                     strcmp(mode, "truncated") == 0;
+
+  if (none) {
+    aLine.AppendLiteral(",\"");
+    aLine.Append(aKey);
+    aLine.AppendLiteral("_disabled\":true,\"");
+    aLine.Append(aKey);
+    aLine.AppendLiteral("_size\":");
+    aLine.AppendInt(static_cast<uint32_t>(aURL.Length()));
+    return;
+  }
+
+  nsAutoCString value(aURL);
+  bool truncated = false;
+  if (previewOnly) {
+    FirefoxTraceFetchTruncatePreview(value);
+    truncated = !value.Equals(aURL);
+  }
+
+  aLine.AppendLiteral(",\"");
+  aLine.Append(aKey);
+  aLine.AppendLiteral("\":");
+  FirefoxTraceFetchAppendJsonString(aLine, value);
+
+  if (previewOnly) {
+    aLine.AppendLiteral(",\"");
+    aLine.Append(aKey);
+    aLine.AppendLiteral("_size\":");
+    aLine.AppendInt(static_cast<uint32_t>(aURL.Length()));
+    aLine.AppendLiteral(",\"");
+    aLine.Append(aKey);
+    aLine.AppendLiteral("_truncated\":");
+    aLine.Append(truncated ? "true" : "false");
+  }
+}
+
+void FirefoxTraceFetchAppendBytesHex(nsACString& aLine,
+                                     const nsACString& aValue,
+                                     uint32_t aMaxBytes) {
+  static const char kHex[] = "0123456789abcdef";
+  const char* data = aValue.BeginReading();
+  uint32_t len = std::min(aMaxBytes, static_cast<uint32_t>(aValue.Length()));
+  aLine.Append('"');
+  for (uint32_t i = 0; i < len; i++) {
+    unsigned char c = static_cast<unsigned char>(data[i]);
+    aLine.Append(kHex[(c >> 4) & 0x0f]);
+    aLine.Append(kHex[c & 0x0f]);
+  }
+  aLine.Append('"');
+}
