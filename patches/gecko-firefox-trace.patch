+void FirefoxTraceFetchAppendQueryFieldMetadata(nsACString& aMeta,
+                                               const nsACString& aFieldName,
+                                               const nsACString& aFieldValue,
+                                               bool aTruncated,
+                                               bool aValueDisabled) {
+  const nsCString flatValue(PromiseFlatCString(aFieldValue));
+  if (!aMeta.IsEmpty()) {
+    aMeta.Append(',');
+  }
+  FirefoxTraceFetchAppendJsonString(aMeta, aFieldName);
+  aMeta.AppendLiteral(":{\"size\":");
+  aMeta.AppendInt(static_cast<uint64_t>(flatValue.Length()));
+  if (aTruncated) {
+    aMeta.AppendLiteral(",\"truncated\":true");
+  }
+  if (aValueDisabled) {
+    aMeta.AppendLiteral(",\"value_disabled\":true");
+  }
+
+  if (FirefoxTraceFetchQueryFieldValueStoreEnabled()) {
+    uint32_t minBytes = FirefoxTraceFetchQueryFieldStoreMinBytes();
+    uint32_t maxBytes = FirefoxTraceFetchQueryFieldStoreMaxBytes();
+    if (flatValue.Length() >= minBytes && flatValue.Length() <= maxBytes) {
+      uint64_t valueSeq = sFirefoxTraceNextFetchQueryValueId.fetch_add(
+          1, std::memory_order_relaxed);
+      char valueId[128];
+      char relPath[512];
+      char sha256[65];
+      snprintf(valueId, sizeof(valueId), "qfv_fetch_%d_%llu", getpid(),
+               static_cast<unsigned long long>(valueSeq));
+      FirefoxTraceFetchComputeSHA256Hex(flatValue.get(), flatValue.Length(),
+                                        sha256);
+      bool stored = FirefoxTraceFetchWriteQueryFieldValueStoreFile(
+          valueId, aFieldValue, relPath, sizeof(relPath));
+      aMeta.AppendLiteral(",\"value_id\":");
+      FirefoxTraceFetchAppendJsonCString(aMeta, valueId);
+      aMeta.AppendLiteral(",\"value_store_path\":");
+      FirefoxTraceFetchAppendJsonCString(aMeta, stored ? relPath : "");
+      aMeta.AppendLiteral(",\"sha256\":");
+      FirefoxTraceFetchAppendJsonCString(aMeta, sha256);
+      aMeta.AppendLiteral(",\"stored\":");
+      aMeta.Append(stored ? "true" : "false");
+    } else if (flatValue.Length() > maxBytes) {
+      aMeta.AppendLiteral(",\"value_store_skipped\":\"too_large\"");
+    }
+  }
+  aMeta.Append('}');
+}
