+void FirefoxTraceWriteDOMLimitSentinel(uint64_t aLimit) {
+  bool expected = false;
+  if (!sFirefoxTraceDOMLimitSentinelWritten.compare_exchange_strong(expected,
+                                                                    true)) {
+    return;
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\",");
+  line.AppendLiteral("\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(
+      ",\"module\":\"dom\",\"reason\":\"event_limit\",\"limit\":");
+  line.AppendInt(static_cast<uint64_t>(aLimit));
+  line.Append('}');
+  FirefoxTraceWriteDOMLineRaw(line);
+}
+
+void FirefoxTraceWriteDOMEventLine(const nsACString& aLine) {
+  uint64_t limit = FirefoxTraceDOMLimitEvents();
+  if (limit) {
+    uint64_t eventIndex =
+        sFirefoxTraceDOMEventCount.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (eventIndex > limit) {
+      FirefoxTraceWriteDOMLimitSentinel(limit);
+      return;
+    }
+  }
+
+  FirefoxTraceWriteDOMLineRaw(aLine);
+}
