+void FirefoxTraceAppendRequestURLField(nsACString& aLine, const char* aKey,
+                                       const nsACString& aURL) {
+  const char* mode = FirefoxTraceRequestURLMode();
+  bool none = strcmp(mode, "none") == 0 || strcmp(mode, "off") == 0 ||
+              strcmp(mode, "0") == 0;
+  bool previewOnly = strcmp(mode, "preview") == 0 ||
+                     strcmp(mode, "truncated") == 0;
+
+  if (none) {
+    aLine.AppendLiteral(",\"");
+    aLine.Append(aKey);
+    aLine.AppendLiteral("_disabled\":true,\"");
+    aLine.Append(aKey);
+    aLine.AppendLiteral("_size\":");
+    aLine.AppendInt(static_cast<uint32_t>(aURL.Length()));
+    return;
+  }
+
+  nsAutoCString value(aURL);
+  bool truncated = false;
+  if (previewOnly) {
+    FirefoxTraceTruncatePreview(value);
+    truncated = !value.Equals(aURL);
+  }
+
+  aLine.AppendLiteral(",\"");
+  aLine.Append(aKey);
+  aLine.AppendLiteral("\":");
+  FirefoxTraceAppendJsonString(aLine, value);
+
+  if (previewOnly) {
+    aLine.AppendLiteral(",\"");
+    aLine.Append(aKey);
+    aLine.AppendLiteral("_size\":");
+    aLine.AppendInt(static_cast<uint32_t>(aURL.Length()));
+    aLine.AppendLiteral(",\"");
+    aLine.Append(aKey);
+    aLine.AppendLiteral("_truncated\":");
+    aLine.Append(truncated ? "true" : "false");
+  }
+}
