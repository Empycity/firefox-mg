+bool FirefoxTraceFetchEventKindEnabled(const char* aKind) {
+  const char* events = getenv("FIREFOX_TRACE_FETCH_EVENTS");
+  if (!events || !events[0]) {
+    events = getenv("TRACE_FETCH_EVENTS");
+  }
+  if (!events || !events[0] || strcmp(events, "all") == 0) {
+    return true;
+  }
+  if (strcmp(events, "none") == 0 || strcmp(events, "0") == 0) {
+    return false;
+  }
+  return FirefoxTraceFetchContainsToken(events, aKind);
