+
+bool FirefoxTraceWriteQueryFieldValueStoreFile(const char* aValueId,
+                                               const nsACString& aValue,
+                                               char* aRelPath,
+                                               size_t aRelPathLen) {
+  if (!aValueId || !aValueId[0] || !aRelPath || !aRelPathLen) {
+    return false;
+  }
+
+  const nsCString flatValue(PromiseFlatCString(aValue));
+  snprintf(aRelPath, aRelPathLen, "values/%s.txt", aValueId);
+
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendValueToParent &&
+      FirefoxTraceSendValueToParent(aValueId, "", flatValue.get(),
+                                    flatValue.Length())) {
+    return true;
+  }
+#endif
+
+  const char* logDir = FirefoxTraceXHRLogDir();
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString valuesDir(logDir);
+  if (!valuesDir.IsEmpty() && valuesDir.Last() != '/') {
+    valuesDir.Append('/');
+  }
+  valuesDir.Append("values");
+#ifndef XP_WIN
+  mkdir(valuesDir.get(), 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.Append(aRelPath);
+
+  FILE* file = fopen(path.get(), "wb");
+  if (!file) {
+    return false;
+  }
+  size_t written = fwrite(flatValue.BeginReading(), 1, flatValue.Length(), file);
+  fclose(file);
+  return written == flatValue.Length();
+}
+
+bool FirefoxTraceWriteXHRRequestBodyStoreFile(const nsACString& aValue,
+                                              char* aValueId,
+                                              size_t aValueIdLen,
+                                              char* aRelPath,
+                                              size_t aRelPathLen) {
+  if (!aValueId || !aValueIdLen || !aRelPath || !aRelPathLen) {
+    return false;
+  }
+  uint64_t valueSeq = sFirefoxTraceNextXHRRequestBodyValueId.fetch_add(
+      1, std::memory_order_relaxed);
+  snprintf(aValueId, aValueIdLen, "xhr_req_body_%d_%llu", getpid(),
+           static_cast<unsigned long long>(valueSeq));
+  return FirefoxTraceWriteQueryFieldValueStoreFile(aValueId, aValue, aRelPath,
+                                                   aRelPathLen);
+}
+
+bool FirefoxTraceWriteXHRResponseBodyStoreFile(const nsACString& aValue,
+                                               const char* aSha256,
+                                               char* aValueId,
+                                               size_t aValueIdLen,
+                                               char* aRelPath,
+                                               size_t aRelPathLen) {
+  if (!aValueId || !aValueIdLen || !aRelPath || !aRelPathLen) {
+    return false;
+  }
+  uint64_t valueSeq = sFirefoxTraceNextXHRResponseBodyValueId.fetch_add(
+      1, std::memory_order_relaxed);
+  snprintf(aValueId, aValueIdLen, "xhr_resp_body_%d_%llu", getpid(),
+           static_cast<unsigned long long>(valueSeq));
+  if (aSha256 && aSha256[0]) {
+    snprintf(aRelPath, aRelPathLen, "values/%s.txt", aSha256);
+  } else {
+    snprintf(aRelPath, aRelPathLen, "values/%s.txt", aValueId);
+  }
+
+#if defined(__APPLE__) || defined(__GNUC__)
+  const nsCString flatValue(PromiseFlatCString(aValue));
+  if (FirefoxTraceSendValueToParent &&
+      FirefoxTraceSendValueToParent(aValueId, aSha256 ? aSha256 : "",
+                                    flatValue.get(), flatValue.Length())) {
+    return true;
+  }
+#endif
+
+  return FirefoxTraceWriteQueryFieldValueStoreFile(aValueId, aValue, aRelPath,
+                                                   aRelPathLen);
+}
+
+void FirefoxTraceAppendQueryFieldMetadata(nsACString& aMeta,
+                                          const nsACString& aFieldName,
+                                          const nsACString& aFieldValue,
+                                          bool aTruncated,
+                                          bool aValueDisabled) {
+  const nsCString flatValue(PromiseFlatCString(aFieldValue));
+  if (!aMeta.IsEmpty()) {
+    aMeta.Append(',');
+  }
+  FirefoxTraceAppendJsonString(aMeta, aFieldName);
+  aMeta.AppendLiteral(":{\"size\":");
+  aMeta.AppendInt(static_cast<uint64_t>(flatValue.Length()));
+  if (aTruncated) {
+    aMeta.AppendLiteral(",\"truncated\":true");
+  }
+  if (aValueDisabled) {
+    aMeta.AppendLiteral(",\"value_disabled\":true");
+  }
+
+  if (FirefoxTraceQueryFieldValueStoreEnabled()) {
+    uint32_t minBytes = FirefoxTraceQueryFieldStoreMinBytes();
+    uint32_t maxBytes = FirefoxTraceQueryFieldStoreMaxBytes();
+    if (flatValue.Length() >= minBytes && flatValue.Length() <= maxBytes) {
+      uint64_t valueSeq = sFirefoxTraceNextXHRQueryValueId.fetch_add(
+          1, std::memory_order_relaxed);
+      char valueId[128];
+      char relPath[512];
+      char sha256[65];
+      snprintf(valueId, sizeof(valueId), "qfv_xhr_%d_%llu", getpid(),
+               static_cast<unsigned long long>(valueSeq));
+      FirefoxTraceComputeSHA256Hex(flatValue.get(), flatValue.Length(),
+                                   sha256);
+      bool stored = FirefoxTraceWriteQueryFieldValueStoreFile(
+          valueId, aFieldValue, relPath, sizeof(relPath));
+      aMeta.AppendLiteral(",\"value_id\":");
+      FirefoxTraceAppendJsonCString(aMeta, valueId);
+      aMeta.AppendLiteral(",\"value_store_path\":");
+      FirefoxTraceAppendJsonCString(aMeta, stored ? relPath : "");
+      aMeta.AppendLiteral(",\"sha256\":");
+      FirefoxTraceAppendJsonCString(aMeta, sha256);
+      aMeta.AppendLiteral(",\"stored\":");
+      aMeta.Append(stored ? "true" : "false");
+    } else if (flatValue.Length() > maxBytes) {
+      aMeta.AppendLiteral(",\"value_store_skipped\":\"too_large\"");
+    }
+  }
+  aMeta.Append('}');
+}
