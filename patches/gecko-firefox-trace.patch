+void Storage::FirefoxTraceStorageEvent(Storage* aStorage, const char* aType,
+                                       const char* aStorageType,
+                                       const nsAString& aKey,
+                                       const nsAString* aValue,
+                                       bool aFound) {
+  if (!FirefoxTraceStorageEnabled()) {
+    return;
+  }
+
+  nsAutoCString pageURL;
+  if (aStorage) {
+    if (nsPIDOMWindowInner* window = aStorage->GetParentObject()) {
+      if (Document* doc = window->GetExtantDoc()) {
+        if (nsIURI* docURI = doc->GetDocumentURI()) {
+          Unused << docURI->GetSpec(pageURL);
