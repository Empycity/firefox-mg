+void FetchDriver::FirefoxTraceOnResponseBodySegment(const char* aBuffer,
+                                                    uint32_t aCount,
+                                                    uint64_t aOffset) {
+  if (!mFirefoxTraceFetchId || !aBuffer || !aCount ||
+      !FirefoxTraceFetchDriverEnabled() ||
+      !FirefoxTraceFetchDriverResponseBodyEnabled()) {
+    return;
+  }
+
+  if (FirefoxTraceFetchDriverResponseBodyStoreEnabled()) {
+    uint32_t limit = FirefoxTraceFetchDriverResponseBodyStoreMaxBytes();
+    if (mFirefoxTraceBodyArtifact.Length() > limit ||
+        aCount > limit - mFirefoxTraceBodyArtifact.Length()) {
+      mFirefoxTraceBodyArtifactTruncated = true;
+    } else {
+      mFirefoxTraceBodyArtifact.Append(aBuffer, aCount);
+    }
+  }
+
+  if (!FirefoxTraceFetchDriverBodyChunkEventEnabled()) {
+    return;
+  }
+
+  uint32_t eventLimit = FirefoxTraceFetchDriverBodyChunkEventLimit();
+  if (eventLimit && mFirefoxTraceBodyChunkEvents >= eventLimit) {
+    return;
+  }
+
+  uint32_t maxBytes = FirefoxTraceFetchDriverResponseBodyMaxBytes();
+  if (mFirefoxTraceBodyCaptured >= maxBytes) {
+    return;
+  }
+
+  uint32_t remaining = maxBytes - mFirefoxTraceBodyCaptured;
+  uint32_t capture = std::min(aCount, remaining);
+  if (!capture) {
+    return;
+  }
+
+  uint32_t hexBytes = std::min(capture,
+                               FirefoxTraceFetchDriverResponseBodyHexBytes());
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.fetch.v1\",\"type\":\"fetch.body_chunk\","
+      "\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"request_id\":\"fetch_");
+  line.AppendInt(static_cast<uint64_t>(mFirefoxTraceFetchId));
+  line.Append('"');
+  line.AppendLiteral(",\"chunk_index\":");
+  line.AppendInt(static_cast<uint32_t>(mFirefoxTraceBodyChunkEvents));
+  line.AppendLiteral(",\"offset\":");
+  line.AppendInt(aOffset);
+  line.AppendLiteral(",\"source_count\":");
+  line.AppendInt(aCount);
+  line.AppendLiteral(",\"captured_size\":");
+  line.AppendInt(capture);
+  line.AppendLiteral(",\"captured_total\":");
+  line.AppendInt(static_cast<uint32_t>(mFirefoxTraceBodyCaptured + capture));
+  line.AppendLiteral(",\"capture_truncated\":");
+  line.Append(aCount > capture ? "true" : "false");
+  line.AppendLiteral(",\"body_preview\":");
+  nsDependentCSubstring captured(aBuffer, aBuffer + capture);
+  FirefoxTraceFetchDriverAppendJsonCString(
+      line, PromiseFlatCString(captured).get());
+  if (hexBytes) {
+    line.AppendLiteral(",\"body_bytes_hex\":");
+    FirefoxTraceFetchDriverAppendBytesHex(line, aBuffer, hexBytes);
+    line.AppendLiteral(",\"body_bytes_hex_truncated\":");
+    line.Append(capture > hexBytes ? "true" : "false");
+  }
+  line.Append('}');
+
+  mFirefoxTraceBodyCaptured += capture;
+  ++mFirefoxTraceBodyChunkEvents;
+  FirefoxTraceFetchDriverWriteLine(line);
+}
+
+void FetchDriver::FirefoxTraceFinishResponseBodyArtifact() {
+  if (!mFirefoxTraceFetchId || !FirefoxTraceFetchDriverEnabled() ||
+      !FirefoxTraceFetchDriverResponseBodyStoreEnabled() ||
+      mFirefoxTraceBodyArtifact.IsEmpty()) {
+    return;
+  }
+
+  char sha256[65];
+  FirefoxTraceFetchDriverSHA256(mFirefoxTraceBodyArtifact.BeginReading(),
+                                mFirefoxTraceBodyArtifact.Length(), sha256);
+  char valueId[128];
+  snprintf(valueId, sizeof(valueId), "fetch_body_%d_%llu", getpid(),
+           static_cast<unsigned long long>(mFirefoxTraceFetchId));
+  bool stored = !mFirefoxTraceBodyArtifactTruncated &&
+                FirefoxTraceFetchDriverWriteBodyArtifact(
+                    valueId, sha256, mFirefoxTraceBodyArtifact.BeginReading(),
+                    mFirefoxTraceBodyArtifact.Length());
+
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.fetch.v1\",\"type\":\"fetch.body_artifact\","
+      "\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"request_id\":\"fetch_");
+  line.AppendInt(mFirefoxTraceFetchId);
+  line.AppendLiteral("\",\"body_value_id\":");
+  FirefoxTraceFetchDriverAppendJsonCString(line, valueId);
+  line.AppendLiteral(",\"body_value_store_path\":");
+  nsAutoCString path("values/");
+  path.Append(sha256);
+  path.AppendLiteral(".txt");
+  FirefoxTraceFetchDriverAppendJsonCString(line, stored ? path.get() : "");
+  line.AppendLiteral(",\"body_value_stored\":");
+  line.Append(stored ? "true" : "false");
+  line.AppendLiteral(",\"body_value_truncated\":");
+  line.Append(mFirefoxTraceBodyArtifactTruncated ? "true" : "false");
+  line.AppendLiteral(",\"body_size\":");
+  line.AppendInt(static_cast<uint64_t>(mFirefoxTraceBodyArtifact.Length()));
+  line.AppendLiteral(",\"body_sha256\":");
+  FirefoxTraceFetchDriverAppendJsonCString(line, sha256);
+  line.Append('}');
+  FirefoxTraceFetchDriverWriteLine(line);
+}
