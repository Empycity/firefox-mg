+  applyEnv(buffer);
+  applyTopLevelString(buffer, "segment_id", "TRACE_SEGMENT_ID");
+  applyTopLevelString(buffer, "segment_label", "TRACE_SEGMENT_LABEL");
+  applyTopLevelString(buffer, "config_hash", "TRACE_CONFIG_HASH");
+  applyTopLevelUint(buffer, "version", "TRACE_CONTROL_VERSION");
