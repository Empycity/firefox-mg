+uint64_t FirefoxTraceFetchEvent(nsIGlobalObject* aGlobal, JSContext* aCx,
+                                Request& aRequest) {
+  if (!FirefoxTraceFetchEnabled()) {
+    return 0;
+  }
+
+  nsAutoCString url;
+  aRequest.GetUrl(url);
+  nsAutoCString method;
+  aRequest.GetMethod(method);
+
+  nsAutoCString pageURL;
+  if (nsCOMPtr<nsPIDOMWindowInner> window = do_QueryInterface(aGlobal)) {
+    if (Document* doc = window->GetExtantDoc()) {
+      if (nsIURI* docURI = doc->GetDocumentURI()) {
+        Unused << docURI->GetSpec(pageURL);
+      }
+    }
+  }
+
+  nsAutoCString callerURL;
+  uint32_t callerLine = 0;
+  uint32_t callerColumn = 0;
+  FirefoxTraceFetchGetCaller(aCx, callerURL, &callerLine, &callerColumn);
+
+  if (!FirefoxTraceShouldRecordFetchContext(pageURL, callerURL)) {
+    return 0;
+  }
+
+  int64_t bodyLength = 0;
+  nsCOMPtr<nsIInputStream> ignoredBody;
+  aRequest.GetBody(getter_AddRefs(ignoredBody), &bodyLength);
+
+  uint64_t fetchId =
+      sFirefoxTraceNextFetchId.fetch_add(1, std::memory_order_relaxed);
+
+  if (!FirefoxTraceFetchEventKindEnabled("call")) {
+    return fetchId;
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.fetch.v1\",\"type\":\"fetch.call\"");
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  FirefoxTraceFetchAppendRequestId(line, fetchId);
+  line.AppendLiteral(",\"method\":");
+  FirefoxTraceFetchAppendJsonString(line, method);
+  FirefoxTraceFetchAppendRequestURLField(line, "url", url);
+  FirefoxTraceFetchAppendConfiguredQueryFields(line, url);
+  nsAutoCString matchedQueryField;
+  Unused << FirefoxTraceFetchFirstConfiguredQueryField(url, matchedQueryField);
+  line.AppendLiteral(",\"body_length\":");
+  line.AppendInt(bodyLength);
+  line.AppendLiteral(",\"keepalive\":");
+  line.Append(aRequest.Keepalive() ? "true" : "false");
+  line.AppendLiteral(",\"page_url\":");
+  FirefoxTraceFetchAppendJsonString(line, pageURL);
+  line.AppendLiteral(",\"origin_call_id\":");
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  if (originCallId) {
+    line.AppendPrintf("\"call_%llu\"",
+                      static_cast<unsigned long long>(originCallId));
+  } else {
+    line.AppendLiteral("null");
+  }
+  line.AppendLiteral(",\"caller_url\":");
+  FirefoxTraceFetchAppendJsonString(line, callerURL);
+  line.AppendLiteral(",\"caller_line\":");
+  line.AppendInt(callerLine);
+  line.AppendLiteral(",\"caller_column\":");
+  line.AppendInt(callerColumn);
+  line.Append('}');
+  if (FirefoxTraceFlushJSBoundaryBuffer && originCallId) {
+    nsAutoCString flushReason;
+    FirefoxTraceFetchBuildFieldFlushReason(flushReason, "fetch.call",
+                                           matchedQueryField);
+    FirefoxTraceFlushJSBoundaryBuffer(flushReason.get());
+  }
+  FirefoxTraceWriteFetchLine(line);
+  return fetchId;
+}
