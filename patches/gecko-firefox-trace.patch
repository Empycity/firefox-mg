+uint64_t FirefoxTraceHashCString(uint64_t hash, const char* value) {
+  const unsigned char* p = reinterpret_cast<const unsigned char*>(
+      value && value[0] ? value : "<null>");
+  while (*p) {
+    hash ^= *p++;
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
+
+uint64_t FirefoxTraceJSFunctionKey(const char* scriptUrl,
+                                   const char* functionName) {
+  uint64_t hash = 1469598103934665603ULL;
+  hash = FirefoxTraceHashCString(hash, scriptUrl);
+  hash ^= '|';
+  hash *= 1099511628211ULL;
+  hash = FirefoxTraceHashCString(hash, functionName);
+  return hash ? hash : 1;
+}
+
+void FirefoxTraceComputeJSScriptId(const char* scriptUrl,
+                                   const char* functionName, uint32_t line,
+                                   uint32_t column, char out[32]) {
+  uint64_t hash = 1469598103934665603ULL;
+  hash = FirefoxTraceHashCString(hash, scriptUrl);
+  hash ^= '|';
+  hash *= 1099511628211ULL;
+  hash = FirefoxTraceHashCString(hash, functionName);
+  hash ^= line & 0xff;
+  hash *= 1099511628211ULL;
+  hash ^= (line >> 8) & 0xff;
+  hash *= 1099511628211ULL;
+  hash ^= column & 0xff;
+  hash *= 1099511628211ULL;
+  hash ^= (column >> 8) & 0xff;
+  hash *= 1099511628211ULL;
+  snprintf(out, 32, "sid_%016llx", static_cast<unsigned long long>(hash));
+}
