+extern "C" bool FirefoxTraceSendEventToParent(const char* aLine, size_t aLen) {
+  if (!aLine || !aLen) {
+    return false;
+  }
+
+  // PContentChild is owned by the content main thread. JS/Fetch/WebSocket can
+  // run on Worker threads, so copy the event and marshal it to the owning
+  // thread before entering IPC.
+  if (!NS_IsMainThread()) {
+    return FirefoxTraceQueueEventToParent(aLine, aLen);
+  }
+
+  mozilla::dom::ContentChild* child =
+      mozilla::dom::ContentChild::GetSingleton();
+  if (!child) {
+    return false;
+  }
+
+  nsDependentCSubstring line(aLine, aLen);
+  if (!FirefoxTraceRuntimeAllowsEvent(line)) {
+    return true;
+  }
+  uint64_t droppedEvents = 0;
+  uint64_t droppedBytes = 0;
+  if (!FirefoxTraceConsumeEventBudget(aLen, &droppedEvents, &droppedBytes)) {
+    FirefoxTraceSendEventBudgetDegraded(child, droppedEvents, droppedBytes);
+    return true;
+  }
+  return child->SendFirefoxTraceDOMEvent(line);
+}
+
+extern "C" bool FirefoxTraceSendEventBatchToParent(const char* aLines,
+                                                     size_t aLen) {
+  if (!aLines || !aLen) {
+    return false;
+  }
+  if (!NS_IsMainThread()) {
+    nsCString lines(aLines, aLen);
+    NS_DispatchToMainThread(NS_NewRunnableFunction(
+        "FirefoxTraceQueuedEventBatch", [lines = std::move(lines)]() {
+          Unused << FirefoxTraceSendEventBatchToParent(lines.BeginReading(),
+                                                       lines.Length());
+        }));
+    return true;
+  }
+  mozilla::dom::ContentChild* child =
+      mozilla::dom::ContentChild::GetSingleton();
+  if (!child) {
+    return false;
+  }
+  nsDependentCSubstring lines(aLines, aLen);
+  return child->SendFirefoxTraceDOMEventBatch(lines);
+}
+
+// Only already-captured main-thread JS bytes use this path. The dedicated
+// receiver persists them even after the parent has entered paused state.
+extern "C" bool FirefoxTraceSendJSBatchDrainToParent(const char* aLines,
+                                                    size_t aLen) {
+  if (!NS_IsMainThread() || !aLines || !aLen) {
+    return false;
+  }
+  auto* child = mozilla::dom::ContentChild::GetSingleton();
+  if (!child) {
+    return false;
+  }
+  // Reuse the existing wire message: no generated IPC ABI/vtable changes.
+  nsAutoCString message("FIREFOX_TRACE_CONTROL_DRAIN_V1\n");
+  message.Append(aLines, aLen);
+  return child->SendFirefoxTraceDOMEventBatch(message);
+}
