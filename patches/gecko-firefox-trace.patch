+bool FirefoxTraceRuntimeAllowsEvent(const nsACString& aLine) {
+  FirefoxTraceRuntimeState state = FirefoxTraceRuntimeStateCached();
+  if (state == FirefoxTraceRuntimeStateActive) {
+    return true;
+  }
+  if (state == FirefoxTraceRuntimeStatePaused) {
+    return false;
+  }
+  return aLine.Find("firefox_trace.script.v1") != kNotFound ||
+         aLine.Find("\"type\":\"script.resource\"") != kNotFound ||
+         aLine.Find("\"type\": \"script.resource\"") != kNotFound;
+}
