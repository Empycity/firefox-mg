+void FirefoxTraceFetchAppendRequestHeaders(nsACString& aLine,
+                                           InternalRequest& aRequest,
+                                           nsACString* aMatchedField = nullptr) {
+  const char* mode = FirefoxTraceFetchRequestHeadersMode();
+  if (!FirefoxTraceFetchRequestHeadersEnabled()) {
+    aLine.AppendLiteral(",\"request_headers_enabled\":false");
+    return;
+  }
+
+  nsTArray<InternalHeaders::Entry> entries;
+  aRequest.Headers()->GetEntries(entries);
+
+  const char* names = getenv("FIREFOX_TRACE_FETCH_REQUEST_HEADER_NAMES");
+  if (!names || !names[0]) {
+    names = getenv("TRACE_FETCH_REQUEST_HEADER_NAMES");
+  }
+
+  const uint32_t maxCount = FirefoxTraceFetchRequestHeadersMaxCount();
+  const uint32_t valueMax = FirefoxTraceFetchRequestHeaderValueMaxBytes();
+  const bool full = !strcmp(mode, "full");
+  bool truncated = false;
+  uint32_t emitted = 0;
+  nsAutoCString targetFields;
+  bool firstTarget = true;
+
+  aLine.AppendLiteral(
+      ",\"request_headers_enabled\":true,\"request_headers_mode\":");
+  FirefoxTraceFetchAppendJsonCString(aLine, mode);
+  aLine.AppendLiteral(",\"request_headers\":{");
+  bool first = true;
+  for (const auto& entry : entries) {
+    if (FirefoxTraceFetchConfiguredHeader(entry.mName.get())) {
+      if (aMatchedField && aMatchedField->IsEmpty()) {
+        aMatchedField->Assign(entry.mName);
+      }
+      if (!firstTarget) {
+        targetFields.Append(',');
+      }
+      firstTarget = false;
+      FirefoxTraceFetchAppendJsonString(targetFields, entry.mName);
+      targetFields.Append(':');
+      FirefoxTraceFetchAppendJsonString(targetFields, entry.mValue);
+    }
+    if (names && names[0] &&
+        !FirefoxTraceFetchContainsToken(names, entry.mName.get())) {
+      continue;
+    }
+    if (emitted >= maxCount) {
+      truncated = true;
+      break;
+    }
+
+    nsAutoCString value(entry.mValue);
+    bool valueTruncated = false;
+    if ((!full || value.Length() > valueMax) && value.Length() > valueMax) {
+      value.Truncate(valueMax);
+      value.AppendLiteral("...");
+      valueTruncated = true;
+    }
+
+    if (!first) {
+      aLine.Append(',');
+    }
+    first = false;
+    FirefoxTraceFetchAppendJsonString(aLine, entry.mName);
+    aLine.AppendLiteral(":{\"value\":");
+    FirefoxTraceFetchAppendJsonString(aLine, value);
+    if (valueTruncated) {
+      aLine.AppendLiteral(",\"truncated\":true");
+    }
+    aLine.Append('}');
+    ++emitted;
+  }
+  aLine.Append('}');
+  aLine.AppendLiteral(",\"request_headers_count\":");
+  aLine.AppendInt(emitted);
+  aLine.AppendLiteral(",\"request_headers_truncated\":");
+  aLine.Append(truncated ? "true" : "false");
+  if (!targetFields.IsEmpty()) {
+    aLine.AppendLiteral(",\"header_fields\":{");
+    aLine.Append(targetFields);
+    aLine.Append('}');
+  }
+}
+
+bool FirefoxTraceFetchExtractQueryParam(const nsACString& aURL,
+                                        const char* aName,
+                                        nsACString& aValue) {
+  const nsCString flatURL(PromiseFlatCString(aURL));
+  nsAutoCString needle;
+  needle.AssignLiteral("?");
+  needle.Append(aName);
+  needle.Append('=');
+
+  int32_t pos = flatURL.Find(needle);
+  uint32_t valueStart = 0;
+  if (pos >= 0) {
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  } else {
+    needle.AssignLiteral("&");
+    needle.Append(aName);
+    needle.Append('=');
+    pos = flatURL.Find(needle);
+    if (pos < 0) {
+      return false;
+    }
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  }
+
+  int32_t end = flatURL.FindChar('&', valueStart);
+  if (end < 0) {
+    aValue.Assign(Substring(flatURL, valueStart));
+  } else {
+    aValue.Assign(Substring(flatURL, valueStart,
+                            static_cast<uint32_t>(end) - valueStart));
+  }
+  return true;
+}
+
+bool FirefoxTraceFetchJSONIsSpace(char aChar) {
+  return aChar == ' ' || aChar == '\t' || aChar == '\n' || aChar == '\r';
+}
+
+bool FirefoxTraceFetchExtractFormParam(const nsACString& aBody,
+                                       const char* aName,
+                                       nsACString& aValue) {
+  const nsCString flatBody(PromiseFlatCString(aBody));
+  nsAutoCString needle;
+  needle.Append(aName);
+  needle.Append('=');
+
+  int32_t pos = 0;
+  uint32_t valueStart = 0;
+  if (StringBeginsWith(flatBody, needle)) {
+    valueStart = needle.Length();
+  } else {
+    needle.Insert('&', 0);
+    pos = flatBody.Find(needle);
+    if (pos < 0) {
+      return false;
+    }
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  }
+
+  int32_t end = flatBody.FindChar('&', valueStart);
+  if (end < 0) {
+    aValue.Assign(Substring(flatBody, valueStart));
+  } else {
+    aValue.Assign(Substring(flatBody, valueStart,
+                            static_cast<uint32_t>(end) - valueStart));
+  }
+  return true;
+}
+
+bool FirefoxTraceFetchExtractJSONField(const nsACString& aBody,
+                                       const char* aName,
+                                       nsACString& aValue) {
+  const nsCString flatBody(PromiseFlatCString(aBody));
+  // Body targets may be expressed as JSON paths (for example
+  // solution.interrogation.p).  The fetch event remains keyed by the complete
+  // configured path, while this lightweight extractor locates its terminal
+  // JSON member.  This preserves the existing flat-key behavior and makes
+  // nested request values available to the boundary flush path.
+  const char* fieldName = strrchr(aName, '.');
+  fieldName = fieldName ? fieldName + 1 : aName;
+  nsAutoCString needle;
+  needle.Append('"');
+  needle.Append(fieldName);
+  needle.Append('"');
+
+  int32_t pos = flatBody.Find(needle);
+  if (pos < 0) {
+    return false;
+  }
+  uint32_t p = static_cast<uint32_t>(pos) + needle.Length();
+  while (p < flatBody.Length() && FirefoxTraceFetchJSONIsSpace(flatBody[p])) {
+    ++p;
+  }
+  if (p >= flatBody.Length() || flatBody[p] != ':') {
+    return false;
+  }
+  ++p;
+  while (p < flatBody.Length() && FirefoxTraceFetchJSONIsSpace(flatBody[p])) {
+    ++p;
+  }
+  if (p >= flatBody.Length()) {
+    return false;
+  }
+
+  if (flatBody[p] == '"') {
+    ++p;
+    nsAutoCString out;
+    bool escaped = false;
+    for (; p < flatBody.Length(); ++p) {
+      char c = flatBody[p];
+      if (escaped) {
+        out.Append(c);
+        escaped = false;
+        continue;
+      }
+      if (c == '\\') {
+        escaped = true;
+        continue;
+      }
+      if (c == '"') {
+        aValue.Assign(out);
+        return true;
+      }
+      out.Append(c);
+    }
+    return false;
+  }
+
+  uint32_t start = p;
+  while (p < flatBody.Length() && flatBody[p] != ',' && flatBody[p] != '}' &&
+         flatBody[p] != ']' && !FirefoxTraceFetchJSONIsSpace(flatBody[p])) {
+    ++p;
+  }
+  if (p <= start) {
+    return false;
+  }
+  aValue.Assign(Substring(flatBody, start, p - start));
+  return true;
+}
+
+const char* FirefoxTraceFetchConfiguredFields(bool aBody = false) {
+  const char* configured =
+      aBody ? getenv("FIREFOX_TRACE_BODY_FIELDS")
+            : getenv("FIREFOX_TRACE_QUERY_FIELDS");
+  if (!configured || !configured[0]) {
+    configured = aBody ? getenv("TRACE_BODY_FIELDS")
+                       : getenv("TRACE_QUERY_FIELDS");
+  }
+  if (!configured || !configured[0]) {
+    configured = getenv("FIREFOX_TRACE_QUERY_FIELDS");
+  }
+  if (!configured || !configured[0]) {
+    configured = getenv("TRACE_QUERY_FIELDS");
+  }
+  return configured && configured[0] ? configured : nullptr;
+}
+
+bool FirefoxTraceFetchFirstConfiguredFieldMatch(
+    const std::function<bool(const char*, nsACString&)>& aExtract,
+    nsACString& aFieldName, bool aBody = false) {
+  const char* configured = FirefoxTraceFetchConfiguredFields(aBody);
+  if (!configured || !configured[0]) {
+    return false;
+  }
+
+  uint32_t fieldCount = 0;
+  const char* p = configured;
+  while (*p && fieldCount < 64) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' || *p == '\n' ||
+           *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (end > start) {
+      nsAutoCString fieldName;
+      fieldName.Assign(start, static_cast<uint32_t>(end - start));
+      nsAutoCString fieldValue;
+      if (aExtract(fieldName.get(), fieldValue)) {
+        aFieldName.Assign(fieldName);
+        return true;
+      }
+      ++fieldCount;
+    }
+  }
+  return false;
+}
+
+bool FirefoxTraceFetchFirstConfiguredQueryField(const nsACString& aURL,
+                                                nsACString& aFieldName) {
+  return FirefoxTraceFetchFirstConfiguredFieldMatch(
+      [&aURL](const char* aName, nsACString& aValue) {
+        return FirefoxTraceFetchExtractQueryParam(aURL, aName, aValue);
+      },
+      aFieldName, false);
+}
+
+bool FirefoxTraceFetchFirstConfiguredBodyField(const nsACString& aBody,
+                                               nsACString& aFieldName) {
+  if (aBody.IsEmpty()) {
+    return false;
+  }
+  return FirefoxTraceFetchFirstConfiguredFieldMatch(
+      [&aBody](const char* aName, nsACString& aValue) {
+        if (strcmp(aName, "__raw__") == 0) {
+          aValue.Assign(aBody);
+          return true;
+        }
+        return FirefoxTraceFetchExtractFormParam(aBody, aName, aValue) ||
+               FirefoxTraceFetchExtractJSONField(aBody, aName, aValue);
+      },
+      aFieldName, true);
+}
+
+void FirefoxTraceFetchBuildFieldFlushReason(nsACString& aReason,
+                                            const char* aBaseReason,
+                                            const nsACString& aFieldName) {
+  aReason.Assign(aBaseReason);
+  if (!aFieldName.IsEmpty()) {
+    aReason.Append('.');
+    aReason.Append(aFieldName);
+  }
+}
+
+void FirefoxTraceFetchAppendConfiguredQueryFields(nsACString& aLine,
+                                                  const nsACString& aURL) {
+  const char* configured = FirefoxTraceFetchConfiguredFields(false);
+  if (!configured || !configured[0]) {
+    return;
+  }
+
+  aLine.AppendLiteral(",\"query_fields\":{");
+  nsAutoCString meta;
+  bool wroteAny = false;
+  uint32_t fieldCount = 0;
+  const char* valueMode = FirefoxTraceFetchQueryFieldValueMode();
+  bool valueNone = strcmp(valueMode, "none") == 0 ||
+                   strcmp(valueMode, "off") == 0 ||
+                   strcmp(valueMode, "0") == 0;
+  bool valueFull = strcmp(valueMode, "full") == 0;
+  const char* p = configured;
+  while (*p && fieldCount < 64) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' || *p == '\n' ||
+           *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (end > start) {
+      nsAutoCString fieldName;
+      fieldName.Assign(start, static_cast<uint32_t>(end - start));
+      nsAutoCString fieldValue;
+      if (FirefoxTraceFetchExtractQueryParam(aURL, fieldName.get(),
+                                             fieldValue)) {
+        nsAutoCString outputValue(fieldValue);
+        bool truncated = false;
+        if (!valueNone && !valueFull) {
+          FirefoxTraceFetchTruncatePreview(outputValue);
+          truncated = !outputValue.Equals(fieldValue);
+        }
+        if (wroteAny) {
+          aLine.Append(',');
+        }
+        FirefoxTraceFetchAppendJsonString(aLine, fieldName);
+        aLine.Append(':');
+        if (valueNone) {
+          aLine.AppendLiteral("null");
+        } else {
+          FirefoxTraceFetchAppendJsonString(aLine, outputValue);
+        }
+        if (valueNone || truncated ||
+            FirefoxTraceFetchQueryFieldValueStoreEnabled()) {
+          FirefoxTraceFetchAppendQueryFieldMetadata(meta, fieldName,
+                                                   fieldValue, truncated,
+                                                   valueNone);
+        }
+        wroteAny = true;
+      }
+      ++fieldCount;
+    }
+  }
+  aLine.Append('}');
+  if (!meta.IsEmpty()) {
+    aLine.AppendLiteral(",\"query_fields_meta\":{");
+    aLine.Append(meta);
+    aLine.Append('}');
+  }
+}
+
+void FirefoxTraceFetchAppendConfiguredBodyFields(nsACString& aLine,
+                                                 const nsACString& aBody) {
+  const char* configured = FirefoxTraceFetchConfiguredFields(true);
+  if (!configured || !configured[0] || aBody.IsEmpty()) {
+    return;
+  }
+
+  aLine.AppendLiteral(",\"body_fields\":{");
+  nsAutoCString meta;
+  bool wroteAny = false;
+  uint32_t fieldCount = 0;
+  const char* valueMode = FirefoxTraceFetchQueryFieldValueMode();
+  bool valueNone = strcmp(valueMode, "none") == 0 ||
+                   strcmp(valueMode, "off") == 0 ||
+                   strcmp(valueMode, "0") == 0;
+  bool valueFull = strcmp(valueMode, "full") == 0;
+  const char* p = configured;
+  while (*p && fieldCount < 64) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' || *p == '\n' ||
+           *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (end > start) {
+      nsAutoCString fieldName;
+      fieldName.Assign(start, static_cast<uint32_t>(end - start));
+      nsAutoCString fieldValue;
+      if (fieldName.EqualsLiteral("__raw__")) {
+        fieldValue.Assign(aBody);
+      } else if (FirefoxTraceFetchExtractFormParam(aBody, fieldName.get(),
+                                             fieldValue) ||
+          FirefoxTraceFetchExtractJSONField(aBody, fieldName.get(),
+                                            fieldValue)) {
+      } else {
+        ++fieldCount;
+        continue;
+      }
+      {
+        nsAutoCString outputValue(fieldValue);
+        bool truncated = false;
+        if (!valueNone && !valueFull) {
+          FirefoxTraceFetchTruncatePreview(outputValue);
+          truncated = !outputValue.Equals(fieldValue);
+        }
+        if (wroteAny) {
+          aLine.Append(',');
+        }
+        FirefoxTraceFetchAppendJsonString(aLine, fieldName);
+        aLine.Append(':');
+        if (valueNone) {
+          aLine.AppendLiteral("null");
+        } else {
+          FirefoxTraceFetchAppendJsonString(aLine, outputValue);
+        }
+        if (valueNone || truncated ||
+            FirefoxTraceFetchQueryFieldValueStoreEnabled()) {
+          FirefoxTraceFetchAppendQueryFieldMetadata(meta, fieldName,
+                                                    fieldValue, truncated,
+                                                    valueNone);
+        }
+        wroteAny = true;
+      }
+      ++fieldCount;
+    }
+  }
+  aLine.Append('}');
+  if (!meta.IsEmpty()) {
+    aLine.AppendLiteral(",\"body_fields_meta\":{");
+    aLine.Append(meta);
+    aLine.Append('}');
+  }
+}
