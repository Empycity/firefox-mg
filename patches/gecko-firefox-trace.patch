+uint32_t FirefoxTraceJSMaxValueBytes() {
+  const char* value =
+      FirefoxTraceEnv("FIREFOX_TRACE_JS_MAX_VALUE_BYTES",
+                      "TRACE_JS_MAX_VALUE_BYTES");
+  if (!value || !value[0]) {
+    return 65536;
+  }
+
+  char* end = nullptr;
+  unsigned long parsed = strtoul(value, &end, 10);
+  if (end == value || parsed == 0) {
+    return 65536;
+  }
+  return parsed > 1048576 ? 1048576 : static_cast<uint32_t>(parsed);
+}
+
+uint32_t FirefoxTraceParseUintEnv(const char* aPrimary, const char* aAlias,
+                                  uint32_t aDefault, uint32_t aMax) {
+  const char* value = FirefoxTraceEnv(aPrimary, aAlias);
+  if (!value || !value[0]) {
+    return aDefault;
+  }
+
+  char* end = nullptr;
+  unsigned long parsed = strtoul(value, &end, 10);
+  if (end == value) {
+    return aDefault;
+  }
+  if (parsed > aMax) {
+    return aMax;
+  }
+  return static_cast<uint32_t>(parsed);
+}
