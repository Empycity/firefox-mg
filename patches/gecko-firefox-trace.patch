+bool FirefoxTraceOpcodeScriptIdentityMatches(JSScript* aScript) {
+  if (!aScript || !aScript->filename()) {
+    return false;
+  }
+  const char* scriptFilter = FirefoxTraceEnv(
+      "FIREFOX_TRACE_OPCODE_SCRIPT_CONTAINS",
+      "TRACE_OPCODE_SCRIPT_CONTAINS");
+  if (!scriptFilter || !scriptFilter[0]) {
+    scriptFilter = FirefoxTraceEnv("FIREFOX_TRACE_JS_SCRIPT_CONTAINS",
+                                   "TRACE_SCRIPT_CONTAINS");
+  }
+  if (!FirefoxTraceCSVMatches(scriptFilter, aScript->filename())) {
+    return false;
+  }
+
+  auto matchesOptionalUint = [](const char* aPrimary, const char* aFallback,
+                                uint64_t aActual) {
+    const char* value = FirefoxTraceEnv(aPrimary, aFallback);
+    if (!value || !value[0]) {
+      return true;
+    }
+    char* end = nullptr;
+    unsigned long long parsed = strtoull(value, &end, 10);
+    return end != value && end && *end == '\0' && parsed == aActual;
+  };
+  return matchesOptionalUint("FIREFOX_TRACE_OPCODE_SCRIPT_LINE",
+                             "TRACE_OPCODE_SCRIPT_LINE", aScript->lineno()) &&
+         matchesOptionalUint("FIREFOX_TRACE_OPCODE_SCRIPT_COLUMN",
+                             "TRACE_OPCODE_SCRIPT_COLUMN",
+                             aScript->column().oneOriginValue()) &&
+         matchesOptionalUint("FIREFOX_TRACE_OPCODE_SCRIPT_BYTECODE_LENGTH",
+                             "TRACE_OPCODE_SCRIPT_BYTECODE_LENGTH",
+                             aScript->length());
+}
