{
  "schema": "firefox_trace.agent_config.v1",
  "kind": "agent-next",
  "version": 1,
  "ui": {
    "url": "https://TARGET.example/",
    "trace_dir": "/absolute/path/to/firefox-trace-YYYYMMDD-HHMMSS",
    "firefox_bin": "/absolute/path/to/firefox",
    "profile_dir": "",
    "label": "final-repro-object-overlay",
    "plan": "full-chain",
    "preset": "full-chain",
    "trace_start": "active",
    "trace_start_label": "打开即记录（捕获加载 JS / Script，推荐查链路）",
    "reuse_trace": false,
    "query_fields": "TARGET_FIELD",
    "body_fields": "__disabled__",
    "header_fields": "__disabled__",
    "cookie_fields": "__disabled__",
    "field_scopes": {
      "query": true,
      "body": false,
      "header": false,
      "cookie": false
    },
    "intensity": "通用完整值落盘（默认）",
    "intensity_key": "auto",
    "unlimited_trace": true,
    "show_advanced": true,
    "vm_stage": "默认关闭 VM（普通 full-chain）"
  },
  "modules": {
    "js": true,
    "xhr": true,
    "fetch": true,
    "dom": true,
    "cookie": true,
    "storage": true,
    "script": true,
    "ws": true,
    "http_raw": false,
    "wasm": false
  },
  "options": {
    "profile": "discover",
    "js_mode": "boundary",
    "script_contains": "TARGET_SCRIPT.js",
    "script_sha256": "",
    "function_contains": "=TARGET_FUNCTION",
    "target_match": "all",
    "query_fields": "TARGET_FIELD",
    "body_fields": "__disabled__",
    "header_fields": "__disabled__",
    "cookie_fields": "__disabled__",
    "object_depth": "1",
    "object_keys": "32",
    "array_items": "16",
    "typed_array_bytes": "256",
    "value_metadata": "1",
    "primitive_metadata": "1",
    "value_store_min_bytes": "1",
    "value_store_max_bytes": "0",
    "limit_events": "0"
  },
  "vm": {
    "opcode": false,
    "opcode_operands": false,
    "opcode_stack": false,
    "opcode_stack_primitives": false,
    "vm_step": false,
    "wasm_module": false,
    "wasm_dump": false,
    "wasm_insn": false,
    "unlimited": false,
    "script_contains": "",
    "script_sha256": "",
    "pc_range": "",
    "script_line": "",
    "script_column": "",
    "script_bytecode_length": "",
    "dispatch_pc": "",
    "opcode_limit": "4096",
    "opcode_execution_limit": "65536",
    "vm_step_limit": "2048",
    "opcode_max_events_per_second": "2000",
    "opcode_max_bytes_per_second": "4194304",
    "ipc_max_events_per_second": "6000",
    "ipc_max_bytes_per_second": "4194304",
    "opcode_stack_slots": "2",
    "wasm_module_limit": "16",
    "wasm_preview_bytes": "128",
    "wasm_dump_max_bytes": "1048576",
    "wasm_insn_limit": "512"
  },
  "env": {
    "TRACE_JS_FULL_SPOOL": "1",
    "TRACE_JS_SCRIPT_EVENTS": "1",
    "TRACE_JS_OBJECT_TARGET_ONLY": "1",
    "TRACE_WASM": "0"
  },
  "env_text": "TRACE_JS_FULL_SPOOL=1\nTRACE_JS_SCRIPT_EVENTS=1\nTRACE_JS_OBJECT_TARGET_ONLY=1\nTRACE_WASM=0\n",
  "meta": {
    "generated_by": "agent",
    "note": "Replace TARGET_FIELD, TARGET_SCRIPT.js and TARGET_FUNCTION with Agent-confirmed identities before loading."
  }
}
