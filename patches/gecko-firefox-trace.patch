+already_AddRefed<nsIInputStream> InternalResponse::CloneBodyForTrace(
+    int64_t* aBodySize) {
+  if (Type() == ResponseType::Opaque ||
+      Type() == ResponseType::Opaqueredirect) {
+    if (aBodySize) {
