+  JS::AutoFilename filename;
+  JS::ColumnNumberOneOrigin column;
+  if (!JS::DescribeScriptedCaller(&filename, aCx, aLine, &column) ||
+      !filename.get()) {
+    return;
+  }
+
+  aCallerURL.Assign(filename.get());
+  *aColumn = column.oneOriginValue();
+}
