+bool FirefoxTraceXHRContainsToken(const char* aCSV, const char* aToken) {
+  if (!aCSV || !aCSV[0] || !aToken || !aToken[0]) {
+    return false;
+  }
+
+  const char* p = aCSV;
+  size_t tokenLen = strlen(aToken);
+  while (*p) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' ||
+           *p == '\n' || *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (static_cast<size_t>(end - start) == tokenLen &&
+        strncmp(start, aToken, tokenLen) == 0) {
+      return true;
+    }
+  }
+  return false;
