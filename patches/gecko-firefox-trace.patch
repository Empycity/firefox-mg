+
+bool FirefoxTraceCanEarlyRejectTargetByScriptURL() {
+  if (!FirefoxTraceJSEarlyScriptFilterEnabled()) {
+    return false;
+  }
+
+  const char* scriptFilters =
+      FirefoxTraceEnv("FIREFOX_TRACE_JS_SCRIPT_CONTAINS",
+                      "TRACE_SCRIPT_CONTAINS");
+  if (!scriptFilters || !scriptFilters[0]) {
+    return false;
+  }
+
+  const char* matchMode =
+      FirefoxTraceEnv("FIREFOX_TRACE_TARGET_MATCH", "TRACE_TARGET_MATCH");
+  if (matchMode && strcmp(matchMode, "any") == 0) {
+    // With `any`, a function-name or hash filter can still match even when the
+    // script URL filter misses. Early rejection is safe only when script URL is
+    // the sole configured dimension.
+    return !FirefoxTraceHasEnvList("FIREFOX_TRACE_JS_FUNCTION_CONTAINS",
+                                   "TRACE_FUNCTION_CONTAINS") &&
+           !FirefoxTraceHasEnvList("FIREFOX_TRACE_JS_SCRIPT_SHA256",
+                                   "TRACE_SCRIPT_SHA256");
+  }
+
+  // Default auto and explicit all both require every configured dimension to
+  // match, so a script URL miss is enough to reject the call.
+  return true;
+}
