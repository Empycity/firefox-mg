+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"js.time\","
+      "\"ts_us\":%llu,\"pid\":%d,\"call_id\":\"call_%llu\","
+      "\"sequence\":%llu,\"value_ms\":%.17g}\n",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+      static_cast<unsigned long long>(FirefoxTraceCurrentJSCallId()),
+      static_cast<unsigned long long>(sequence), aValue);
+  if (len > 0 && static_cast<size_t>(len) < sizeof(line)) {
+    FirefoxTraceWriteJSEventLine(line, static_cast<size_t>(len));
+  }
+}
 
