# Do not commit the full Firefox source checkout or build outputs.
/gecko-dev/
/.mozbuild/
/.mozbuild-state/
/obj-*/

# Runtime profiles and browser cache/state. Keep only the template.
/profiles/*
!/profiles/
!/profiles/trace-user.js

# Trace outputs and artifacts.
/firefox-trace-*/
/values/
/scripts/
*.jsonl

# Generated example state and IDE metadata.
/examples/**/state*.json
/examples/**/.idea/
/examples/**/.run-stats.json
/examples/douyin/creator-runtime-contract.json
/examples/douyin/creator-live-contract.json
/examples/douyin/cookie.txt
/examples/douyin/.analysis/
/examples/douyin/security-runtime.json

# Local agent/editor/cache state.
/.codex/
/.agents/
.DS_Store
**/.DS_Store
__pycache__/
examples/aliv2/dynamic_client/runtime/
*.pyc

# Logs and temp files.
*.log
*.tmp
*.swp

# Trace run outputs stay local; only case code/docs/configs are committed.
examples/**/traces/
examples/**/trace-logs/
examples/5s/runtime-data/
examples/douyin/log/
