+const char* FirefoxTraceOpcodeValueTypeName(const Value& aValue) {
+  if (aValue.isUndefined()) {
+    return "undefined";
+  }
+  if (aValue.isNull()) {
+    return "null";
+  }
+  if (aValue.isBoolean()) {
+    return "boolean";
+  }
+  if (aValue.isNumber()) {
+    return "number";
+  }
+  if (aValue.isString()) {
+    return "string";
+  }
+  if (aValue.isSymbol()) {
+    return "symbol";
+  }
+  if (aValue.isBigInt()) {
+    return "bigint";
+  }
+  if (aValue.isObject()) {
+    return "object";
+  }
+  if (aValue.isMagic()) {
+    return "magic";
+  }
+  return "unknown";
+}
