+enum FirefoxTraceRuntimeState {
+  FirefoxTraceRuntimeStatePaused = 0,
+  FirefoxTraceRuntimeStateActive = 1,
+  FirefoxTraceRuntimeStatePrewarm = 2,
+};
+
+static int64_t sFirefoxTraceRuntimePausedSinceUS = 0;
+
+uint64_t FirefoxTracePromiseDrainUS() {
+  const char* configured = PR_GetEnv("FIREFOX_TRACE_PROMISE_DRAIN_MS");
+  if (!configured || !configured[0]) {
+    configured = PR_GetEnv("TRACE_PROMISE_DRAIN_MS");
+  }
+  unsigned long long milliseconds = 250;
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long long parsed = strtoull(configured, &end, 10);
+    if (end != configured) {
+      milliseconds = parsed;
+    }
+  }
+  milliseconds = std::min<unsigned long long>(milliseconds, 2000);
+  return milliseconds * PR_USEC_PER_MSEC;
+}
+
+// The control document carries a nested previous_state audit record. Trace
+// configuration must only read keys from the JSON root, never stale keys from
+// that nested object.
+char* FirefoxTraceFindTopLevelJsonKey(char* aBuffer, const char* aJsonKey) {
+  if (!aBuffer || !aJsonKey) {
+    return nullptr;
+  }
+  const size_t keyLen = strlen(aJsonKey);
+  int depth = 0;
+  for (char* p = aBuffer; *p; ++p) {
+    if (*p == '"') {
+      char* stringStart = p + 1;
+      char* q = stringStart;
+      while (*q && *q != '"') {
+        if (*q == '\\' && q[1]) {
+          q += 2;
+        } else {
+          ++q;
+        }
+      }
+      if (!*q) {
+        return nullptr;
+      }
+      if (depth == 1 && static_cast<size_t>(q - stringStart) == keyLen &&
+          !strncmp(stringStart, aJsonKey, keyLen)) {
+        char* afterKey = q + 1;
+        while (*afterKey == ' ' || *afterKey == '\n' || *afterKey == '\r' ||
+               *afterKey == '\t') {
+          ++afterKey;
+        }
+        if (*afterKey == ':') {
+          return p;
+        }
+      }
+      p = q;
+      continue;
+    }
+    if (*p == '{' || *p == '[') {
+      ++depth;
+    } else if (*p == '}' || *p == ']') {
+      --depth;
+    }
+  }
+  return nullptr;
+}
+
+FirefoxTraceRuntimeState FirefoxTraceReadRuntimeStateFromControlFile(
+    const char* aPath) {
+  if (!aPath || !aPath[0]) {
+    return FirefoxTraceRuntimeStateActive;
+  }
+
+  FILE* file = fopen(aPath, "rb");
+  if (!file) {
+    return FirefoxTraceRuntimeStateActive;
+  }
+
+  char buffer[65537];
+  size_t len = fread(buffer, 1, sizeof(buffer) - 1, file);
+  fclose(file);
+  buffer[len] = '\0';
+
+  auto applyEnv = [](char* aBuffer) {
+    char* env = strstr(aBuffer, "\"env\"");
+    if (!env) {
+      return;
+    }
+    char* p = strchr(env, '{');
+    if (!p) {
+      return;
+    }
+    char* end = strchr(p, '}');
+    if (!end) {
+      return;
+    }
+    p++;
+    while (p < end) {
+      while (p < end && (*p == ' ' || *p == '\n' || *p == '\r' ||
+                         *p == '\t' || *p == ',')) {
+        p++;
+      }
+      if (p >= end || *p != '"') {
+        break;
+      }
+      p++;
+      char* keyStart = p;
+      while (p < end && *p != '"') {
+        p++;
+      }
+      if (p >= end) {
+        break;
+      }
+      char key[256];
+      size_t keyLen = std::min<size_t>(p - keyStart, sizeof(key) - 1);
+      memcpy(key, keyStart, keyLen);
+      key[keyLen] = '\0';
+      p++;
+      while (p < end && *p != ':') {
+        p++;
+      }
+      if (p >= end) {
+        break;
+      }
+      p++;
+      while (p < end && (*p == ' ' || *p == '\n' || *p == '\r' ||
+                         *p == '\t')) {
+        p++;
+      }
+      char value[2048];
+      size_t valueLen = 0;
+      if (p < end && *p == '"') {
+        p++;
+        char* valueStart = p;
+        while (p < end && *p != '"') {
+          p++;
+        }
+        valueLen = std::min<size_t>(p - valueStart, sizeof(value) - 1);
+        memcpy(value, valueStart, valueLen);
+        if (p < end) {
+          p++;
+        }
+      } else {
+        char* valueStart = p;
+        while (p < end && *p != ',' && *p != '}') {
+          p++;
+        }
+        valueLen = std::min<size_t>(p - valueStart, sizeof(value) - 1);
+        memcpy(value, valueStart, valueLen);
+        while (valueLen && (value[valueLen - 1] == ' ' ||
+                            value[valueLen - 1] == '\n' ||
+                            value[valueLen - 1] == '\r' ||
+                            value[valueLen - 1] == '\t')) {
+          valueLen--;
+        }
+      }
+      value[valueLen] = '\0';
+      if ((strncmp(key, "TRACE_", 6) == 0 ||
+           strncmp(key, "FIREFOX_TRACE_", 14) == 0) &&
+          value[0]) {
+        setenv(key, value, 1);
+      }
+    }
+  };
+
+  auto applyUnset = [](char* aBuffer) {
+    char* unset = strstr(aBuffer, "\"unset\"");
+    if (!unset) {
+      return;
+    }
+    char* p = strchr(unset, '[');
+    char* end = p ? strchr(p, ']') : nullptr;
+    if (!p || !end) {
+      return;
+    }
+    p++;
+    while (p < end) {
+      while (p < end &&
+             (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t' ||
+              *p == ',')) {
+        p++;
+      }
+      if (p >= end || *p != '"') {
+        break;
+      }
+      p++;
+      char* start = p;
+      while (p < end && *p != '"') {
+        p++;
+      }
+      if (p >= end) {
+        break;
+      }
+      char key[256];
+      size_t keyLen = std::min<size_t>(p - start, sizeof(key) - 1);
+      memcpy(key, start, keyLen);
+      key[keyLen] = '\0';
+      if ((strncmp(key, "TRACE_", 6) == 0 ||
+           strncmp(key, "FIREFOX_TRACE_", 14) == 0)) {
+        unsetenv(key);
+      }
+      p++;
+    }
+  };
+
+  auto applyTopLevelString = [](char* aBuffer, const char* aJsonKey,
+                                const char* aEnvKey) {
+    char* p = FirefoxTraceFindTopLevelJsonKey(aBuffer, aJsonKey);
+    if (!p) {
+      return;
+    }
+    p = strchr(p, ':');
+    if (!p) {
+      return;
+    }
+    p++;
+    while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t') {
+      p++;
+    }
+    if (*p != '"') {
+      return;
+    }
+    p++;
+    char* start = p;
+    while (*p && *p != '"') {
+      p++;
+    }
+    if (!*p) {
+      return;
+    }
+    char value[512];
+    size_t len = std::min<size_t>(p - start, sizeof(value) - 1);
+    memcpy(value, start, len);
+    value[len] = '\0';
+    if (value[0]) {
+      setenv(aEnvKey, value, 1);
+    }
+  };
+
+  auto applyTopLevelUint = [](char* aBuffer, const char* aJsonKey,
+                              const char* aEnvKey) {
+    char* p = FirefoxTraceFindTopLevelJsonKey(aBuffer, aJsonKey);
+    if (!p) {
+      return;
+    }
+    p = strchr(p, ':');
+    if (!p) {
+      return;
+    }
+    p++;
+    while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t') {
+      p++;
+    }
+    char value[32];
+    size_t len = 0;
+    while (*p >= '0' && *p <= '9' && len + 1 < sizeof(value)) {
+      value[len++] = *p++;
+    }
+    value[len] = '\0';
+    if (value[0]) {
+      setenv(aEnvKey, value, 1);
+    }
+  };
+
+  applyEnv(buffer);
+  applyUnset(buffer);
+  applyTopLevelString(buffer, "segment_id", "TRACE_SEGMENT_ID");
+  applyTopLevelString(buffer, "segment_label", "TRACE_SEGMENT_LABEL");
+  applyTopLevelString(buffer, "config_hash", "TRACE_CONFIG_HASH");
+  applyTopLevelUint(buffer, "version", "TRACE_CONTROL_VERSION");
+
+  char* previousState = strstr(buffer, "\"previous_state\"");
+  if (previousState) {
+    *previousState = '\0';
+  }
+
+  if (strstr(buffer, "\"enabled\": false") ||
+      strstr(buffer, "\"enabled\":false")) {
+    return FirefoxTraceRuntimeStatePaused;
+  }
+  if (strstr(buffer, "\"mode\": \"prewarm\"") ||
+      strstr(buffer, "\"mode\":\"prewarm\"")) {
+    return FirefoxTraceRuntimeStatePrewarm;
+  }
+  return FirefoxTraceRuntimeStateActive;
+}
+
+FirefoxTraceRuntimeState FirefoxTraceRuntimeStateCached() {
+  static int64_t sLastCheckUS = 0;
+  static FirefoxTraceRuntimeState sState = FirefoxTraceRuntimeStateActive;
+  const int64_t now = PR_Now();
+  auto setState = [&](FirefoxTraceRuntimeState aNext) {
+    if (sState != aNext) {
+      sState = aNext;
+      sFirefoxTraceRuntimePausedSinceUS =
+          aNext == FirefoxTraceRuntimeStatePaused ? now : 0;
+    }
+    return sState;
+  };
+
+  const char* path = PR_GetEnv("FIREFOX_TRACE_CONTROL_FILE");
+  if (!path || !path[0]) {
+    path = PR_GetEnv("TRACE_CONTROL_FILE");
+  }
+  if (!path || !path[0]) {
+    return setState(FirefoxTraceRuntimeStateActive);
+  }
+
+  const int64_t checkNow = PR_Now();
+  if (sLastCheckUS && checkNow - sLastCheckUS < 200000) {
+    return sState;
+  }
+  sLastCheckUS = checkNow;
+
+  struct stat st;
+  if (stat(path, &st) != 0) {
+    return setState(FirefoxTraceRuntimeStateActive);
+  }
+  (void)st;
+  return setState(FirefoxTraceReadRuntimeStateFromControlFile(path));
+}
+
+bool FirefoxTraceRuntimeAllowsEvent(const nsACString& aLine) {
+  FirefoxTraceRuntimeState state = FirefoxTraceRuntimeStateCached();
+  if (state == FirefoxTraceRuntimeStateActive) {
+    return true;
+  }
+  if (state == FirefoxTraceRuntimeStatePaused) {
+    const bool isPromiseSettlement =
+        aLine.Find("\"type\":\"dom.promise.settle\"") != kNotFound ||
+        aLine.Find("\"type\": \"dom.promise.settle\"") != kNotFound;
+    if (isPromiseSettlement && sFirefoxTraceRuntimePausedSinceUS > 0) {
+      return PR_Now() - sFirefoxTraceRuntimePausedSinceUS <=
+             static_cast<int64_t>(FirefoxTracePromiseDrainUS());
+    }
+    return false;
+  }
+  return aLine.Find("firefox_trace.script.v1") != kNotFound ||
+         aLine.Find("\"type\":\"script.resource\"") != kNotFound ||
+         aLine.Find("\"type\": \"script.resource\"") != kNotFound;
+}
+
+bool FirefoxTraceRuntimeAllowsArtifact() {
+  return FirefoxTraceRuntimeStateCached() == FirefoxTraceRuntimeStateActive;
+}
+
+void FirefoxTraceAppendRuntimeJsonFields(nsCString& aOut) {
+  const char* segmentId = PR_GetEnv("TRACE_SEGMENT_ID");
+  const char* configHash = PR_GetEnv("TRACE_CONFIG_HASH");
+  const char* controlVersion = PR_GetEnv("TRACE_CONTROL_VERSION");
+
+  if (segmentId && segmentId[0] && aOut.Find("\"segment_id\"") == kNotFound) {
+    aOut.Append(",\"segment_id\":\"");
+    aOut.Append(segmentId);
+    aOut.Append('"');
+  }
+  if (controlVersion && controlVersion[0] &&
+      aOut.Find("\"control_version\"") == kNotFound) {
+    aOut.Append(",\"control_version\":");
+    aOut.Append(controlVersion);
+  }
+  if (configHash && configHash[0] &&
+      aOut.Find("\"config_hash\"") == kNotFound) {
+    aOut.Append(",\"config_hash\":\"");
+    aOut.Append(configHash);
+    aOut.Append('"');
+  }
+}
+
+void FirefoxTraceDecorateRuntimeEventLine(const nsACString& aLine,
+                                          nsCString& aOut) {
+  if (aLine.IsEmpty() || aLine.Last() != '}') {
+    aOut.Assign(aLine);
+    return;
+  }
+
+  aOut.Assign(Substring(aLine, 0, aLine.Length() - 1));
+  FirefoxTraceAppendRuntimeJsonFields(aOut);
+  aOut.Append('}');
+}
+
+bool FirefoxTraceReadControlJson(nsCString& aOut) {
+  const char* path = PR_GetEnv("FIREFOX_TRACE_CONTROL_FILE");
+  if (!path || !path[0]) {
+    path = PR_GetEnv("TRACE_CONTROL_FILE");
+  }
+  if (!path || !path[0]) {
+    return false;
+  }
+
+  FILE* file = fopen(path, "rb");
+  if (!file) {
+    return false;
+  }
+  char buffer[65537];
+  size_t len = fread(buffer, 1, sizeof(buffer) - 1, file);
+  fclose(file);
+  buffer[len] = '\0';
+  aOut.Assign(buffer, len);
+  return true;
+}
+
+void FirefoxTraceWriteRuntimeConfigRecord(ContentParent* aParent,
+                                          const char* aType,
+                                          uint64_t aVersion,
+                                          const nsACString& aConfigHash,
+                                          const char* aDetail) {
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    return;
+  }
+  mkdir(logDir, 0755);
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.Append("firefox-control-acks.jsonl");
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+  fprintf(file,
+          "{\"schema\":\"firefox_trace.event.v1\","
+          "\"type\":\"%s\",\"ts_us\":%lld,"
+          "\"child_id\":%llu,\"pid\":%d,\"control_version\":%llu,"
+          "\"config_hash\":\"%s\",\"detail\":\"%s\"}\n",
+          aType, static_cast<long long>(PR_Now()),
+          static_cast<unsigned long long>(aParent ? aParent->ChildID() : 0),
+          aParent ? aParent->Pid() : 0,
+          static_cast<unsigned long long>(aVersion),
+          PromiseFlatCString(aConfigHash).get(), aDetail ? aDetail : "");
+  fclose(file);
+}
+
+void FirefoxTraceMaybePushRuntimeConfigToChild(ContentParent* aParent) {
+  if (!aParent) {
+    return;
+  }
+
+  FirefoxTraceRuntimeStateCached();
+  const char* version = PR_GetEnv("TRACE_CONTROL_VERSION");
+  const char* hash = PR_GetEnv("TRACE_CONFIG_HASH");
+  nsAutoCString key;
+  key.Append(version && version[0] ? version : "");
+  key.Append(':');
+  key.Append(hash && hash[0] ? hash : "");
+
+  static std::map<ContentParent*, nsCString> sLastPushed;
+  static std::map<ContentParent*, nsCString> sLastDiagnostic;
+  static std::map<ContentParent*, int64_t> sLastAttemptUS;
+  auto diagnostic = [&](const char* aDetail) {
+    nsAutoCString diagnosticKey(key);
+    diagnosticKey.Append(':');
+    diagnosticKey.Append(aDetail);
+    auto previous = sLastDiagnostic.find(aParent);
+    if (previous != sLastDiagnostic.end() && previous->second == diagnosticKey) {
+      return;
+    }
+    sLastDiagnostic[aParent] = diagnosticKey;
+    FirefoxTraceWriteRuntimeConfigRecord(
+        aParent, "trace.config.push", version ? strtoull(version, nullptr, 10) : 0,
+        nsDependentCString(hash ? hash : ""), aDetail);
+  };
+  auto found = sLastPushed.find(aParent);
+  if (found != sLastPushed.end() && found->second == key) {
+    return;
+  }
+
+  if (!aParent->CanSend()) {
+    diagnostic("channel_unavailable");
+    return;
+  }
+
+  int64_t now = PR_Now();
+  auto lastAttempt = sLastAttemptUS.find(aParent);
+  if (lastAttempt != sLastAttemptUS.end() &&
+      now - lastAttempt->second < PR_USEC_PER_SEC) {
+    return;
+  }
+  sLastAttemptUS[aParent] = now;
+
+  nsAutoCString config;
+  if (!FirefoxTraceReadControlJson(config)) {
+    diagnostic("control_read_failed");
+    return;
+  }
+
+  if (aParent->SendFirefoxTraceRuntimeConfig(config)) {
+    sLastPushed[aParent] = key;
+    diagnostic("sent");
+  } else {
+    diagnostic("send_failed");
+  }
+}
+
+StaticRefPtr<nsITimer> sFirefoxTraceRuntimeConfigPushTimer;
+
+void FirefoxTraceRuntimeConfigPushTimerCallback(nsITimer*, void*) {
+  nsTArray<ContentParent*> parents;
+  ContentParent::GetAll(parents);
+  for (ContentParent* parent : parents) {
+    FirefoxTraceMaybePushRuntimeConfigToChild(parent);
+  }
+}
+
+void FirefoxTraceEnsureRuntimeConfigPushTimerImpl() {
+  if (sFirefoxTraceRuntimeConfigPushTimer) {
+    return;
+  }
+  const char* path = PR_GetEnv("FIREFOX_TRACE_CONTROL_FILE");
+  if (!path || !path[0]) {
+    path = PR_GetEnv("TRACE_CONTROL_FILE");
+  }
+  if (!path || !path[0]) {
+    return;
+  }
+  RefPtr<nsITimer> timer;
+  NS_NewTimerWithFuncCallback(
+      getter_AddRefs(timer),
+      FirefoxTraceRuntimeConfigPushTimerCallback, nullptr, 200,
+      nsITimer::TYPE_REPEATING_SLACK,
+      "firefoxTrace::RuntimeConfigPushTimer");
+  sFirefoxTraceRuntimeConfigPushTimer = timer;
+  ClearOnShutdown(&sFirefoxTraceRuntimeConfigPushTimer);
+}
