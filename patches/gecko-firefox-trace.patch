+void FirefoxTraceWriteOpcodeStackSlots(FILE* aFile,
+                                       const InterpreterRegs& aRegs) {
+  uint32_t requested = FirefoxTraceOpcodeStackSlots();
+  uint32_t depth = aRegs.stackDepth();
+  uint32_t count = std::min(requested, depth);
+  if (!count) {
+    return;
+  }
+
+  bool includePrimitives = FirefoxTraceOpcodeStackPrimitivesEnabled();
+  fputs(",\"stack_top\":[", aFile);
+  for (uint32_t i = 0; i < count; i++) {
+    if (i) {
+      fputc(',', aFile);
+    }
+    const Value& value = aRegs.sp[-static_cast<int>(i + 1)];
+    fprintf(aFile, "{\"slot_from_top\":%u,\"type\":", i);
+    FirefoxTraceWriteJsonString(aFile, FirefoxTraceOpcodeValueTypeName(value));
+    if (includePrimitives) {
+      if (value.isBoolean()) {
+        fputs(",\"value\":", aFile);
+        fputs(value.toBoolean() ? "true" : "false", aFile);
+      } else if (value.isInt32()) {
+        fprintf(aFile, ",\"value\":%d", value.toInt32());
+      } else if (value.isDouble()) {
+        fprintf(aFile, ",\"value\":%.17g", value.toDouble());
+      } else if (value.isNull() || value.isUndefined()) {
+        fputs(",\"value\":null", aFile);
+      }
+    }
+    fputc('}', aFile);
+  }
+  fputc(']', aFile);
+}
