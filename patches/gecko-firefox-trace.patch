+bool FirefoxTraceOpcodeConfigured() {
+  const char* opcode = FirefoxTraceEnv("FIREFOX_TRACE_OPCODE", "TRACE_OPCODE");
+  const char* vmStep = FirefoxTraceEnv("FIREFOX_TRACE_VM_STEP", "TRACE_VM_STEP");
+  const char* vmWindow =
+      FirefoxTraceEnv("FIREFOX_TRACE_VM_WINDOW", "TRACE_VM_WINDOW");
+  bool opcodeEnabled = opcode && opcode[0] && strcmp(opcode, "0") != 0;
+  bool vmStepEnabled = vmStep && vmStep[0] && strcmp(vmStep, "0") != 0;
+  bool vmWindowEnabled =
+      vmWindow && vmWindow[0] && strcmp(vmWindow, "0") != 0;
+  if (!opcodeEnabled && !vmStepEnabled && !vmWindowEnabled) {
+    return false;
+  }
+
+  const char* executionMode =
+      FirefoxTraceEnv("FIREFOX_TRACE_EXECUTION_MODE", "TRACE_EXECUTION_MODE");
+  if (!executionMode || strcmp(executionMode, "opcode") != 0) {
+    return false;
+  }
+
+  const char* scriptFilter = FirefoxTraceEnv(
+      "FIREFOX_TRACE_OPCODE_SCRIPT_CONTAINS",
+      "TRACE_OPCODE_SCRIPT_CONTAINS");
+  if (!scriptFilter || !scriptFilter[0]) {
+    scriptFilter = FirefoxTraceEnv("FIREFOX_TRACE_JS_SCRIPT_CONTAINS",
+                                   "TRACE_SCRIPT_CONTAINS");
+  }
+  return scriptFilter && scriptFilter[0];
+}
