+void FirefoxTraceCookieStoreTruncatePreview(nsACString& aPreview) {
+  uint32_t limit = 4096;
+  const char* configured = getenv("FIREFOX_TRACE_PREVIEW_LIMIT");
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long parsed = strtoul(configured, &end, 10);
+    if (end != configured && parsed > 0) {
+      limit = parsed > 65536 ? 65536 : static_cast<uint32_t>(parsed);
+    }
+  }
+  if (aPreview.Length() > limit) {
+    aPreview.Truncate(limit);
+    aPreview.AppendLiteral("...");
+  }
+}
