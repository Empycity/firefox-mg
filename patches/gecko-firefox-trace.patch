+bool FirefoxTraceCookieStorageEnabled() {
+  const char* enabled = getenv("FIREFOX_TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return false;
+  }
+  if (FirefoxTraceRuntimeActive && !FirefoxTraceRuntimeActive()) {
+    return false;
+  }
+
+  const char* cookieEnabled = getenv("FIREFOX_TRACE_COOKIE");
+  if (!cookieEnabled || !cookieEnabled[0]) {
+    cookieEnabled = getenv("TRACE_COOKIE");
+  }
+  return !cookieEnabled || strcmp(cookieEnabled, "0") != 0;
+}
+
+void FirefoxTraceCookieStorageAppendJsonCString(nsACString& aLine,
+                                                const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceCookieStorageAppendJsonString(nsACString& aLine,
+                                               const nsACString& aValue) {
+  FirefoxTraceCookieStorageAppendJsonCString(aLine,
+                                             PromiseFlatCString(aValue).get());
+}
+
+void FirefoxTraceCookieStorageTruncatePreview(nsACString& aPreview) {
+  uint32_t limit = 4096;
+  const char* configured = getenv("FIREFOX_TRACE_PREVIEW_LIMIT");
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long parsed = strtoul(configured, &end, 10);
+    if (end != configured && parsed > 0) {
+      limit = parsed > 65536 ? 65536 : static_cast<uint32_t>(parsed);
+    }
+  }
+  if (aPreview.Length() > limit) {
+    aPreview.Truncate(limit);
+    aPreview.AppendLiteral("...");
+  }
+}
+
+void FirefoxTraceCookieStorageWriteLine(const nsACString& aLine) {
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-cookie-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceCookieStorageLifecycleEvent(
+    const char* aReason, const char* aOutcome,
+    const nsACString& aBaseDomain, const OriginAttributes& aOriginAttributes,
+    Cookie* aCookie, bool aFromHttp, int64_t aCount = -1) {
+  if (!FirefoxTraceCookieStorageEnabled()) {
+    return;
+  }
+
+  nsAutoCString originSuffix;
+  aOriginAttributes.CreateSuffix(originSuffix);
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.cookie.v1\","
+                     "\"type\":\"cookie.lifecycle\",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"source\":\"storage\",\"reason\":");
+  FirefoxTraceCookieStorageAppendJsonCString(line, aReason);
+  line.AppendLiteral(",\"outcome\":");
+  FirefoxTraceCookieStorageAppendJsonCString(line, aOutcome);
+  line.AppendLiteral(",\"from_http\":");
+  line.Append(aFromHttp ? "true" : "false");
+  line.AppendLiteral(",\"base_domain\":");
+  FirefoxTraceCookieStorageAppendJsonString(line, aBaseDomain);
+  line.AppendLiteral(",\"origin_attributes_suffix\":");
+  FirefoxTraceCookieStorageAppendJsonString(line, originSuffix);
+  line.AppendLiteral(",\"private_browsing_id\":");
+  line.AppendInt(static_cast<int64_t>(aOriginAttributes.mPrivateBrowsingId));
+  if (aCount >= 0) {
+    line.AppendLiteral(",\"count\":");
+    line.AppendInt(aCount);
+  }
+  if (!aOriginAttributes.mPartitionKey.IsEmpty()) {
+    NS_ConvertUTF16toUTF8 partitionKey(aOriginAttributes.mPartitionKey);
+    line.AppendLiteral(",\"partition_key\":");
+    FirefoxTraceCookieStorageAppendJsonString(line, partitionKey);
+  }
+
+  if (aCookie) {
+    line.AppendLiteral(",\"key\":");
+    FirefoxTraceCookieStorageAppendJsonString(line, aCookie->Name());
+    nsAutoCString valuePreview(aCookie->Value());
+    FirefoxTraceCookieStorageTruncatePreview(valuePreview);
+    line.AppendLiteral(",\"value_preview\":");
+    FirefoxTraceCookieStorageAppendJsonString(line, valuePreview);
+    line.AppendLiteral(",\"host\":");
+    FirefoxTraceCookieStorageAppendJsonString(line, aCookie->Host());
+    nsAutoCString rawHost(aCookie->RawHost());
+    line.AppendLiteral(",\"raw_host\":");
+    FirefoxTraceCookieStorageAppendJsonString(line, rawHost);
+    line.AppendLiteral(",\"path\":");
+    FirefoxTraceCookieStorageAppendJsonString(line, aCookie->Path());
+    line.AppendLiteral(",\"secure\":");
+    line.Append(aCookie->IsSecure() ? "true" : "false");
+    line.AppendLiteral(",\"http_only\":");
+    line.Append(aCookie->IsHttpOnly() ? "true" : "false");
+    line.AppendLiteral(",\"session\":");
+    line.Append(aCookie->IsSession() ? "true" : "false");
+    line.AppendLiteral(",\"expiry\":");
+    line.AppendInt(aCookie->Expiry());
+    line.AppendLiteral(",\"same_site\":");
+    line.AppendInt(aCookie->SameSite());
+    line.AppendLiteral(",\"partitioned\":");
+    line.Append(aCookie->IsPartitioned() ? "true" : "false");
+    line.AppendLiteral(",\"last_accessed\":");
+    line.AppendInt(aCookie->LastAccessed());
+    line.AppendLiteral(",\"creation_time\":");
+    line.AppendInt(aCookie->CreationTime());
+  }
+
+  line.Append('}');
+  FirefoxTraceCookieStorageWriteLine(line);
+}
