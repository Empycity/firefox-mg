+
+  if (!FirefoxTraceJSDeepSelfHostedEnabled() && calleeKind &&
+      strcmp(calleeKind, "self_hosted") == 0) {
+    return true;
+  }
+
+  return FirefoxTraceJSDeepSuppressFunctionMatches(functionName);
+}
