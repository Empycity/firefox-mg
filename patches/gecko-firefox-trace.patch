+void FirefoxTraceFetchDriverAppendJsonCString(nsACString& aLine,
+                                              const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceFetchDriverAppendBytesHex(nsACString& aLine,
+                                           const char* aBuffer,
+                                           uint32_t aCount) {
+  static const char kHex[] = "0123456789abcdef";
+  aLine.Append('"');
+  for (uint32_t i = 0; i < aCount; i++) {
+    unsigned char c = static_cast<unsigned char>(aBuffer[i]);
+    aLine.Append(kHex[(c >> 4) & 0x0f]);
+    aLine.Append(kHex[c & 0x0f]);
+  }
+  aLine.Append('"');
+}
