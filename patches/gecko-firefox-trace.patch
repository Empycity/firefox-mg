+bool FirefoxTraceContainsCString(const char* aHaystack, const char* aNeedle,
+                                 size_t aNeedleLen) {
+  if (!aHaystack || !aNeedle || aNeedleLen == 0) {
+    return false;
+  }
+  size_t haystackLen = strlen(aHaystack);
+  if (aNeedleLen > haystackLen) {
+    return false;
+  }
+  for (size_t i = 0; i + aNeedleLen <= haystackLen; i++) {
+    if (strncmp(aHaystack + i, aNeedle, aNeedleLen) == 0) {
+      return true;
+    }
+  }
+  return false;
+}
