+
+void FirefoxTraceWriteJSBoundaryBufferDegraded(const char* aReason,
+                                               uint64_t aDropped,
+                                               uint32_t aStorageCapacity,
+                                               uint32_t aWindowCapacity,
+                                               const char* aWindowSource) {
+  if (!aDropped || sFirefoxTraceJSBoundaryBufferDegradedWritten) {
+    return;
+  }
+  sFirefoxTraceJSBoundaryBufferDegradedWritten = true;
+
+  char line[512];
+  int len = SprintfLiteral(
+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\","
+      "\"ts_us\":%llu,\"pid\":%d,\"module\":\"js\","
+      "\"reason\":\"boundary_buffer_overwrite\",\"sink_reason\":",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid());
+  if (len <= 0) {
+    return;
+  }
+
+#if defined(XP_UNIX)
+  char* lineBuffer = nullptr;
+  size_t lineSize = 0;
+  FILE* file = open_memstream(&lineBuffer, &lineSize);
+#else
+  FILE* file = FirefoxTraceOpenJSLog();
+#endif
+  if (!file) {
+    return;
+  }
+  fwrite(line, 1, static_cast<size_t>(len), file);
+  FirefoxTraceWriteJsonString(file, aReason ? aReason : "");
+  fprintf(file,
+          ",\"dropped\":%llu,\"storage_capacity\":%u,"
+          "\"window_capacity\":%u,\"window_capacity_source\":",
+          static_cast<unsigned long long>(aDropped), aStorageCapacity,
+          aWindowCapacity);
+  FirefoxTraceWriteJsonString(file, aWindowSource);
+  fputs(",\"suggestion\":\"increase TRACE_JS_BOUNDARY_BUFFER_EVENTS or the "
+        "sink-specific TRACE_JS_BOUNDARY_BUFFER_EVENTS_<REASON>, narrow "
+        "TRACE_JS_BOUNDARY_FLUSH_ON, or rerun with TRACE_SCRIPT_CONTAINS / "
+        "TRACE_FUNCTION_CONTAINS and target-return\"}\n",
+        file);
+#if defined(XP_UNIX)
+  fclose(file);
+  FirefoxTraceWriteJSEventLineRaw(lineBuffer, lineSize);
+  free(lineBuffer);
+#else
+  fclose(file);
+#endif
+}
+
+void FirefoxTraceBufferJSBoundaryEvent(const char* aLine, size_t aLen) {
+  if (!aLine || !aLen) {
+    return;
+  }
+
+  uint64_t seq = ++sFirefoxTraceJSBoundaryBufferWriteSeq;
+  uint32_t capacity = kFirefoxTraceJSBoundaryBufferMaxCapacity;
+  size_t slot = static_cast<size_t>((seq - 1) % capacity);
+  FirefoxTraceJSBufferedEvent& event = sFirefoxTraceJSBoundaryBuffer[slot];
+  if (event.line && !event.flushed &&
+      event.seq > sFirefoxTraceJSBoundaryBufferFlushedSeq) {
+    sFirefoxTraceJSBoundaryBufferDropped++;
+  }
+  free(event.line);
+  event.line = static_cast<char*>(malloc(aLen + 1));
+  if (!event.line) {
+    event.len = 0;
+    event.seq = 0;
+    event.flushed = true;
+    sFirefoxTraceJSBoundaryBufferDropped++;
+    return;
+  }
+  memcpy(event.line, aLine, aLen);
+  event.line[aLen] = '\0';
+  event.len = aLen;
+  event.seq = seq;
+  event.flushed = false;
+}
+
+void FirefoxTraceWriteJSBoundaryBufferFlushSummary(const char* aReason,
+                                                   uint64_t aFirstSeq,
+                                                   uint64_t aLastSeq,
+                                                   uint64_t aFlushed,
+                                                   uint64_t aDropped,
+                                                   uint64_t aSkippedByWindow,
+                                                   uint32_t aWindowCapacity,
+                                                   uint32_t aStorageCapacity,
+                                                   const char* aWindowSource,
+                                                   bool aDirectWrite = false) {
+  if (!aFlushed) {
+    return;
+  }
+
+#if defined(XP_UNIX)
+  char* lineBuffer = nullptr;
+  size_t lineSize = 0;
+  FILE* file = open_memstream(&lineBuffer, &lineSize);
+#else
+  FILE* file = FirefoxTraceOpenJSLog();
+#endif
+  if (!file) {
+    return;
+  }
+
+  fputs("{\"schema\":\"firefox_trace.event.v1\","
+        "\"type\":\"js.boundary.flush_summary\",",
+        file);
+  fprintf(file,
+          "\"ts_us\":%llu,\"pid\":%d,\"flush_index\":%llu,\"reason\":",
+          static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+          static_cast<unsigned long long>(
+              ++sFirefoxTraceJSBoundaryBufferFlushCount));
+  FirefoxTraceWriteJsonString(file, aReason ? aReason : "");
+  fprintf(file,
+          ",\"first_seq\":%llu,\"last_seq\":%llu,\"flushed\":%llu,"
+          "\"dropped_before_flush\":%llu,\"skipped_by_window\":%llu,"
+          "\"window_capacity\":%u,\"storage_capacity\":%u,"
+          "\"window_capacity_source\":",
+          static_cast<unsigned long long>(aFirstSeq),
+          static_cast<unsigned long long>(aLastSeq),
+          static_cast<unsigned long long>(aFlushed),
+          static_cast<unsigned long long>(aDropped),
+          static_cast<unsigned long long>(aSkippedByWindow), aWindowCapacity,
+          aStorageCapacity);
+  FirefoxTraceWriteJsonString(file, aWindowSource);
+  fprintf(file,
+          ",\"capacity\":%u,"
+          "\"complete_window\":%s,"
+          "\"suggestion\":\"if dropped_before_flush is nonzero, treat this run "
+          "as candidate-only; if skipped_by_window is nonzero, increase the "
+          "sink-specific boundary window or rerun with a narrower target\"}\n",
+          aWindowCapacity,
+          (aDropped || aSkippedByWindow) ? "false" : "true");
+
+#if defined(XP_UNIX)
+  fclose(file);
+  if (aDirectWrite) {
+    FILE* direct = FirefoxTraceOpenJSLog();
+    if (direct) {
+      fwrite(lineBuffer, 1, lineSize, direct);
+      fclose(direct);
+    }
+  } else {
+    FirefoxTraceWriteJSEventLineRaw(lineBuffer, lineSize);
+  }
+  free(lineBuffer);
+#else
+  fclose(file);
+#endif
+}
