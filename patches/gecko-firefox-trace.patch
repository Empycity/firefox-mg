+bool FirefoxTraceWriteJSValueStoreFile(const char* valueId, const char* data,
+                                       size_t len, char* relPath,
+                                       size_t relPathLen) {
+  if (!valueId || !data || !relPath || !relPathLen) {
+    return false;
+  }
+
+  const char* logDir = FirefoxTraceLogDir();
+  mkdir(logDir, 0755);
+
+  char valuesDir[4096];
+  SprintfLiteral(valuesDir, "%s/values", logDir);
+  mkdir(valuesDir, 0755);
+
+  snprintf(relPath, relPathLen, "values/%s.txt", valueId);
+
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendValueToParent &&
+      FirefoxTraceSendValueToParent(valueId, data, len)) {
+    return true;
+  }
+#endif
+
+  char path[4096];
+  SprintfLiteral(path, "%s/%s", logDir, relPath);
+  FILE* file = fopen(path, "wb");
+  if (!file) {
+    return false;
+  }
+
+  size_t written = fwrite(data, 1, len, file);
+  fclose(file);
+  return written == len;
+}
