+bool FirefoxTraceXHREventKindEnabled(const char* aType) {
+  const char* events = getenv("FIREFOX_TRACE_XHR_EVENTS");
+  if (!events || !events[0]) {
+    events = getenv("TRACE_XHR_EVENTS");
+  }
+  if (!events || !events[0] || strcmp(events, "all") == 0) {
+    return true;
+  }
+  if (strcmp(events, "none") == 0 || strcmp(events, "0") == 0) {
+    return false;
+  }
+  if (FirefoxTraceXHRContainsToken(events, aType)) {
+    return true;
+  }
+  const char* shortType = strstr(aType, ".");
+  return shortType && FirefoxTraceXHRContainsToken(events, shortType + 1);
+}
