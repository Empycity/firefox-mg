+bool FirefoxTraceMessageContextAllowed(JSContext* aCx) {
+  if (!FirefoxTraceDOMEnabled()) {
+    return false;
+  }
+  nsAutoCString pageURL;
+  FirefoxTraceGetCurrentPageURL(aCx, pageURL);
+  return FirefoxTraceShouldRecordDOMURL(pageURL);
+}
