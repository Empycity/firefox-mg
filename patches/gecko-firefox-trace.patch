+bool FirefoxTraceOpcodePCMatches(uint64_t aPCOffset) {
+  const char* range = FirefoxTraceEnv("FIREFOX_TRACE_OPCODE_PC_RANGE",
+                                      "TRACE_OPCODE_PC_RANGE");
+  if (!range || !range[0]) {
+    return true;
+  }
+
+  char* separator = nullptr;
+  unsigned long long start = strtoull(range, &separator, 10);
+  if (separator == range || !separator || *separator != ':') {
+    return false;
+  }
+  char* end = nullptr;
+  unsigned long long finish = strtoull(separator + 1, &end, 10);
+  if (end == separator + 1 || !end || *end != '\0' || start > finish) {
+    return false;
+  }
+  return aPCOffset >= start && aPCOffset <= finish;
+}
