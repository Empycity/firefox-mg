+bool FirefoxTraceWriteJSValueStoreFile(const char* valueId,
+                                       const char* artifactKey,
+                                       const char* data, size_t len, char* relPath,
+                                       size_t relPathLen) {
+  if (!FirefoxTraceBaseEnabled()) {
+    return false;
+  }
+  if (!valueId || !artifactKey || !data || !relPath || !relPathLen) {
+    return false;
+  }
+
+  const char* logDir = FirefoxTraceLogDir();
+  snprintf(relPath, relPathLen, "values/%s.txt", artifactKey);
+  bool cacheable = FirefoxTraceEnvEnabledAlias(
+      "FIREFOX_TRACE_JS_VALUE_TRANSPORT_CACHE",
+      "TRACE_JS_VALUE_TRANSPORT_CACHE", true) &&
+      strlen(logDir) < sizeof(sFirefoxTraceSentJSValuesDir);
+  if (cacheable) {
+    if (strcmp(sFirefoxTraceSentJSValuesDir, logDir) != 0) {
+      sFirefoxTraceSentJSValues.Clear();
+      strcpy(sFirefoxTraceSentJSValuesDir, logDir);
+    }
+    if (sFirefoxTraceSentJSValues.Contains(artifactKey, len)) {
+      return true;
+    }
+  }
+
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendValueToParent &&
+      FirefoxTraceSendValueToParent(valueId, artifactKey, data, len)) {
+    if (cacheable) {
+      sFirefoxTraceSentJSValues.Remember(artifactKey, len);
+    }
+    return true;
+  }
+#endif
+
+  // Only the non-IPC writer needs to touch the filesystem in this process.
+  mkdir(logDir, 0755);
+  char valuesDir[4096];
+  SprintfLiteral(valuesDir, "%s/values", logDir);
+  mkdir(valuesDir, 0755);
+
+  char path[4096];
+  SprintfLiteral(path, "%s/%s", logDir, relPath);
+  FILE* file = fopen(path, "wb");
+  if (!file) {
+    return false;
+  }
+
+  size_t written = fwrite(data, 1, len, file);
+  bool closed = fclose(file) == 0;
+  if (written != len || !closed) {
+    unlink(path);
+    return false;
+  }
+  if (cacheable) {
+    sFirefoxTraceSentJSValues.Remember(artifactKey, len);
+  }
+  return true;
+}
