+bool FirefoxTraceScriptResourceStoreEnabled() {
+  return FirefoxTraceScriptResourceEnvTruthy("FIREFOX_TRACE_SCRIPT_RESOURCE_STORE") ||
+         FirefoxTraceScriptResourceEnvTruthy("TRACE_SCRIPT_RESOURCE_STORE");
+}
+
+uint32_t FirefoxTraceScriptResourceCaptureMaxBytes() {
+  uint32_t limit = 4 * 1024 * 1024;
+  const char* configured = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE_MAX_BYTES",
+      "TRACE_SCRIPT_RESOURCE_MAX_BYTES");
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long parsed = strtoul(configured, &end, 10);
+    if (end != configured && parsed > 0) {
+      limit = parsed > 64 * 1024 * 1024 ? 64 * 1024 * 1024
+                                        : static_cast<uint32_t>(parsed);
+    }
+  }
+  return limit;
+}
+
+uint32_t FirefoxTraceScriptResourcePreviewLimit() {
+  uint32_t limit = 2048;
+  const char* configured = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE_PREVIEW_LIMIT",
+      "TRACE_SCRIPT_RESOURCE_PREVIEW_LIMIT");
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long parsed = strtoul(configured, &end, 10);
+    if (end != configured && parsed > 0) {
+      limit = parsed > 65536 ? 65536 : static_cast<uint32_t>(parsed);
+    }
+  }
+  return limit;
+}
+
+void FirefoxTraceScriptResourceAppendJsonCString(nsACString& aLine,
+                                                 const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(static_cast<char>(*p));
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceScriptResourceAppendJsonString(nsACString& aLine,
+                                                const nsACString& aValue) {
+  FirefoxTraceScriptResourceAppendJsonCString(
+      aLine, PromiseFlatCString(aValue).get());
+}
+
+void FirefoxTraceScriptResourceComputeSHA256Hex(const char* aData, size_t aLen,
+                                                char aOut[65]) {
+#if defined(__APPLE__)
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(reinterpret_cast<const void*>(aData), static_cast<CC_LONG>(aLen),
+            digest);
+  static const char kHex[] = "0123456789abcdef";
+  for (size_t i = 0; i < CC_SHA256_DIGEST_LENGTH; i++) {
+    aOut[i * 2] = kHex[(digest[i] >> 4) & 0x0f];
+    aOut[i * 2 + 1] = kHex[digest[i] & 0x0f];
+  }
+  aOut[64] = '\0';
+#else
+  uint64_t hash = 1469598103934665603ULL;
+  const unsigned char* p = reinterpret_cast<const unsigned char*>(aData);
+  for (size_t i = 0; i < aLen; i++) {
+    hash ^= p[i];
+    hash *= 1099511628211ULL;
+  }
+  snprintf(aOut, 65, "fnv1a64-%016llx", static_cast<unsigned long long>(hash));
+#endif
+}
+
+bool FirefoxTraceScriptResourceExtractSourceMapURL(const nsCString& aData,
+                                                   nsACString& aOutURL) {
+  static constexpr const char* kMarker = "sourceMappingURL=";
+  const char* data = aData.BeginReading();
+  const char* cursor = data;
+  const char* match = nullptr;
+  while ((cursor = strstr(cursor, kMarker))) {
+    match = cursor;
+    cursor += strlen(kMarker);
+  }
+  if (!match) {
+    return false;
+  }
+
+  const char* start = match + strlen(kMarker);
+  const char* end = start;
+  while (*end && *end != '\r' && *end != '\n') {
+    end++;
+  }
+  while (start < end && (*start == ' ' || *start == '\t')) {
+    start++;
+  }
+  while (end > start &&
+         (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '*')) {
+    end--;
+  }
+  if (end <= start) {
+    return false;
+  }
+
+  aOutURL.Assign(start, end - start);
+  return true;
+}
+
+void FirefoxTraceScriptResourceAppendHeader(nsACString& aLine,
+                                            nsIHttpChannel* aHttpChannel,
+                                            const char* aName, bool* aFirst) {
+  nsAutoCString value;
+  nsresult rv = aHttpChannel->GetResponseHeader(nsDependentCString(aName), value);
+  if (NS_FAILED(rv) || value.IsEmpty()) {
+    return;
+  }
+  uint32_t limit = FirefoxTraceScriptResourcePreviewLimit();
+  bool truncated = false;
+  if (value.Length() > limit) {
+    value.Truncate(limit);
+    value.AppendLiteral("...");
+    truncated = true;
+  }
+  if (!*aFirst) {
+    aLine.Append(',');
+  }
+  *aFirst = false;
+  FirefoxTraceScriptResourceAppendJsonCString(aLine, aName);
+  aLine.AppendLiteral(":{\"value\":");
+  FirefoxTraceScriptResourceAppendJsonString(aLine, value);
+  if (truncated) {
+    aLine.AppendLiteral(",\"truncated\":true");
+  }
+  aLine.Append('}');
+}
+
+void FirefoxTraceScriptResourceAppendHeaders(nsACString& aLine,
+                                             nsIHttpChannel* aHttpChannel) {
+  const char* mode = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE_HEADERS",
+      "TRACE_SCRIPT_RESOURCE_HEADERS");
+  if (mode && (!strcmp(mode, "0") || !strcmp(mode, "none") ||
+               !strcmp(mode, "off"))) {
+    aLine.AppendLiteral(",\"headers_enabled\":false");
+    return;
+  }
+  aLine.AppendLiteral(",\"headers_enabled\":true,\"headers\":{");
+  bool first = true;
+  const char* configuredNames = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE_HEADER_NAMES",
+      "TRACE_SCRIPT_RESOURCE_HEADER_NAMES");
+  if (configuredNames && configuredNames[0]) {
+    nsAutoCString names(configuredNames);
+    const char* cursor = names.BeginReading();
+    while (*cursor) {
+      while (*cursor == ',' || *cursor == ' ' || *cursor == '\t') {
+        cursor++;
+      }
+      const char* start = cursor;
+      while (*cursor && *cursor != ',') {
+        cursor++;
+      }
+      const char* end = cursor;
+      while (end > start && (end[-1] == ' ' || end[-1] == '\t')) {
+        end--;
+      }
+      if (end > start) {
+        nsDependentCSubstring name(start, end - start);
+        FirefoxTraceScriptResourceAppendHeader(
+            aLine, aHttpChannel, PromiseFlatCString(name).get(), &first);
+      }
+    }
+  } else {
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "content-type",
+                                           &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel,
+                                           "content-encoding", &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "sourcemap",
+                                           &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "x-sourcemap",
+                                           &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "cache-control",
+                                           &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "etag", &first);
+    FirefoxTraceScriptResourceAppendHeader(aLine, aHttpChannel, "last-modified",
+                                           &first);
+  }
+  aLine.Append('}');
+}
+
+void FirefoxTraceScriptResourceWriteLine(const nsACString& aLine) {
+  nsCString line(aLine);
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendEventToParent &&
+      FirefoxTraceSendEventToParent(line.BeginReading(), line.Length())) {
+    return;
+  }
+#endif
+  const char* logDir =
+      FirefoxTraceScriptResourceEnv("FIREFOX_TRACE_LOG_DIR", "TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-script-%d.jsonl", getpid());
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+  fwrite(line.BeginReading(), 1, line.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+bool FirefoxTraceScriptResourceStoreArtifact(const char* aSha256,
+                                             const nsCString& aData) {
+  if (!FirefoxTraceScriptResourceStoreEnabled() || !aSha256 || !aSha256[0] ||
+      aData.IsEmpty()) {
+    return false;
+  }
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendScriptSourceToParent &&
+      FirefoxTraceSendScriptSourceToParent(aSha256, aData.BeginReading(),
+                                           aData.Length())) {
+    return true;
+  }
+#endif
+  return false;
+}
+
+const char* FirefoxTraceScriptResourceKind(JS::loader::ScriptLoadRequest* aReq) {
+  if (aReq->IsImportMapRequest()) {
+    return "importmap";
+  }
+  if (aReq->IsModuleRequest()) {
+    return "module";
+  }
+  return "classic";
+}
