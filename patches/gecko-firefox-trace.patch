+// The control document carries a nested previous_state audit record. Trace
+// configuration must only read keys from the JSON root, never stale keys from
+// that nested object.
+char* FirefoxTraceFindTopLevelJsonKey(char* aBuffer, const char* aJsonKey) {
+  if (!aBuffer || !aJsonKey) {
+    return nullptr;
+  }
+  const size_t keyLen = strlen(aJsonKey);
+  int depth = 0;
+  for (char* p = aBuffer; *p; ++p) {
+    if (*p == '"') {
+      char* stringStart = p + 1;
+      char* q = stringStart;
+      while (*q && *q != '"') {
+        if (*q == '\\' && q[1]) {
+          q += 2;
+        } else {
+          ++q;
+        }
+      }
+      if (!*q) {
+        return nullptr;
+      }
+      if (depth == 1 && static_cast<size_t>(q - stringStart) == keyLen &&
+          !strncmp(stringStart, aJsonKey, keyLen)) {
+        char* afterKey = q + 1;
+        while (*afterKey == ' ' || *afterKey == '\n' || *afterKey == '\r' ||
+               *afterKey == '\t') {
+          ++afterKey;
+        }
+        if (*afterKey == ':') {
+          return p;
+        }
+      }
+      p = q;
+      continue;
+    }
+    if (*p == '{' || *p == '[') {
+      ++depth;
+    } else if (*p == '}' || *p == ']') {
+      --depth;
+    }
+  }
+  return nullptr;
+}
