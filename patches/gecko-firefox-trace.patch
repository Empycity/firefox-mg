+bool FirefoxTraceExtractQueryParam(const nsACString& aURL, const char* aName,
+                                   nsACString& aValue) {
+  const nsCString flatURL(PromiseFlatCString(aURL));
+  nsAutoCString needle;
+  needle.AssignLiteral("?");
+  needle.Append(aName);
+  needle.Append('=');
+
+  int32_t pos = flatURL.Find(needle);
+  uint32_t valueStart = 0;
+  if (pos >= 0) {
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  } else {
+    needle.AssignLiteral("&");
+    needle.Append(aName);
+    needle.Append('=');
+    pos = flatURL.Find(needle);
+    if (pos < 0) {
+      return false;
+    }
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  }
+
+  int32_t end = flatURL.FindChar('&', valueStart);
+  if (end < 0) {
+    aValue.Assign(Substring(flatURL, valueStart));
+  } else {
+    aValue.Assign(Substring(flatURL, valueStart,
+                            static_cast<uint32_t>(end) - valueStart));
+  }
+  return true;
+}
+
+bool FirefoxTraceExtractFormParam(const nsACString& aBody, const char* aName,
+                                  nsACString& aValue) {
+  const nsCString flatBody(PromiseFlatCString(aBody));
+  nsAutoCString needle;
+  needle.Append(aName);
+  needle.Append('=');
+
+  int32_t pos = 0;
+  uint32_t valueStart = 0;
+  if (StringBeginsWith(flatBody, needle)) {
+    valueStart = needle.Length();
+  } else {
+    needle.Insert('&', 0);
+    pos = flatBody.Find(needle);
+    if (pos < 0) {
+      return false;
+    }
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  }
+
+  int32_t end = flatBody.FindChar('&', valueStart);
+  if (end < 0) {
+    aValue.Assign(Substring(flatBody, valueStart));
+  } else {
+    aValue.Assign(Substring(flatBody, valueStart,
+                            static_cast<uint32_t>(end) - valueStart));
+  }
+  return true;
+}
+
+bool FirefoxTraceJSONIsSpace(char aChar) {
+  return aChar == ' ' || aChar == '\t' || aChar == '\n' || aChar == '\r';
+}
+
+bool FirefoxTraceExtractJSONField(const nsACString& aBody, const char* aName,
+                                  nsACString& aValue) {
+  const nsCString flatBody(PromiseFlatCString(aBody));
+  nsAutoCString needle;
+  needle.Append('"');
+  needle.Append(aName);
+  needle.Append('"');
+
+  int32_t pos = flatBody.Find(needle);
+  if (pos < 0) {
+    return false;
+  }
+  uint32_t p = static_cast<uint32_t>(pos) + needle.Length();
+  while (p < flatBody.Length() && FirefoxTraceJSONIsSpace(flatBody[p])) {
+    ++p;
+  }
+  if (p >= flatBody.Length() || flatBody[p] != ':') {
+    return false;
+  }
+  ++p;
+  while (p < flatBody.Length() && FirefoxTraceJSONIsSpace(flatBody[p])) {
+    ++p;
+  }
+  if (p >= flatBody.Length()) {
+    return false;
+  }
+
+  if (flatBody[p] == '"') {
+    ++p;
+    nsAutoCString out;
+    bool escaped = false;
+    for (; p < flatBody.Length(); ++p) {
+      char c = flatBody[p];
+      if (escaped) {
+        out.Append(c);
+        escaped = false;
+        continue;
+      }
+      if (c == '\\') {
+        escaped = true;
+        continue;
+      }
+      if (c == '"') {
+        aValue.Assign(out);
+        return true;
+      }
+      out.Append(c);
+    }
+    return false;
+  }
+
+  uint32_t start = p;
+  while (p < flatBody.Length() && flatBody[p] != ',' && flatBody[p] != '}' &&
+         flatBody[p] != ']' && !FirefoxTraceJSONIsSpace(flatBody[p])) {
+    ++p;
+  }
+  if (p <= start) {
+    return false;
+  }
+  aValue.Assign(Substring(flatBody, start, p - start));
+  return true;
+}
