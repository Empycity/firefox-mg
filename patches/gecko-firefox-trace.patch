+  aRequest.GetURL(url);
+  nsAutoCString method;
+  aRequest.GetMethod(method);
+  nsAutoCString referrer;
+  aRequest.GetReferrer(referrer);
+
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.fetch.v1\",\"type\":\"fetch.request\"");
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  FirefoxTraceFetchAppendRequestId(line, aFetchId);
+  line.AppendLiteral(",\"method\":");
+  FirefoxTraceFetchAppendJsonString(line, method);
+  FirefoxTraceFetchAppendRequestURLField(line, "url", url);
+  FirefoxTraceFetchAppendConfiguredQueryFields(line, url);
+  line.AppendLiteral(",\"body_length\":");
+  line.AppendInt(aRequest.BodyLength());
+  line.AppendLiteral(",\"mode\":");
+  FirefoxTraceFetchAppendJsonCString(
+      line, FirefoxTraceFetchRequestModeName(aRequest.Mode()));
+  line.AppendLiteral(",\"credentials\":");
+  FirefoxTraceFetchAppendJsonCString(
+      line, FirefoxTraceFetchCredentialsName(aRequest.GetCredentialsMode()));
+  line.AppendLiteral(",\"cache\":");
+  FirefoxTraceFetchAppendJsonCString(
+      line, FirefoxTraceFetchCacheName(aRequest.GetCacheMode()));
+  line.AppendLiteral(",\"redirect\":");
+  FirefoxTraceFetchAppendJsonCString(
+      line, FirefoxTraceFetchRedirectName(aRequest.GetRedirectMode()));
+  line.AppendLiteral(",\"keepalive\":");
+  line.Append(aRequest.GetKeepalive() ? "true" : "false");
+  line.AppendLiteral(",\"referrer\":");
+  FirefoxTraceFetchAppendJsonString(line, referrer);
+  FirefoxTraceFetchAppendRequestBodyPreview(line, aRequest);
+  line.Append('}');
+  FirefoxTraceWriteFetchLine(line);
+}
+
+void FirefoxTraceFetchResponseEvent(uint64_t aFetchId,
+                                    InternalResponse& aResponse) {
+  if (!aFetchId || !FirefoxTraceFetchEnabled() ||
+      !FirefoxTraceFetchEventKindEnabled("response")) {
+    return;
+  }
+
+  nsCOMPtr<nsIInputStream> ignoredBody;
+  int64_t bodySize = InternalResponse::UNKNOWN_BODY_SIZE;
+  aResponse.GetBody(getter_AddRefs(ignoredBody), &bodySize);
+  nsTArray<nsCString> urlList;
+  aResponse.GetURLList(urlList);
+
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.fetch.v1\",\"type\":\"fetch.response\"");
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  FirefoxTraceFetchAppendRequestId(line, aFetchId);
+  line.AppendLiteral(",\"response_type\":");
+  FirefoxTraceFetchAppendJsonCString(
+      line, FirefoxTraceFetchResponseTypeName(aResponse.Type()));
+  line.AppendLiteral(",\"status\":");
+  line.AppendInt(aResponse.GetStatus());
+  line.AppendLiteral(",\"status_text\":");
+  FirefoxTraceFetchAppendJsonString(line, aResponse.GetStatusText());
+  FirefoxTraceFetchAppendRequestURLField(line, "url", aResponse.GetURL());
+  line.AppendLiteral(",\"redirected\":");
+  line.Append(aResponse.IsRedirected() ? "true" : "false");
+  line.AppendLiteral(",\"redirect_count\":");
+  line.AppendInt(
+      static_cast<uint32_t>(urlList.Length() > 0 ? urlList.Length() - 1 : 0));
