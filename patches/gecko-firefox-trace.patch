+  bool bodyWillFlush = FirefoxTraceXHREventKindEnabled("xhr.body") &&
+                       !aBodyPreview.IsEmpty();
+  if (!FirefoxTraceXHREvent("xhr.send", nullptr, nullptr, !bodyWillFlush)) {
+    return;
+  }
