+bool FirefoxTraceCookieStoreEnabled() {
+  const char* enabled = getenv("FIREFOX_TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return false;
+  }
+  if (FirefoxTraceRuntimeActive && !FirefoxTraceRuntimeActive()) {
+    return false;
+  }
+
+  const char* cookieEnabled = getenv("FIREFOX_TRACE_COOKIE");
+  if (!cookieEnabled || !cookieEnabled[0]) {
+    cookieEnabled = getenv("TRACE_COOKIE");
+  }
+  return !cookieEnabled || strcmp(cookieEnabled, "0") != 0;
+}
+
+bool FirefoxTraceCookieStoreURLStartsWith(const nsACString& aURL,
+                                          const char* aPrefix) {
+  return StringBeginsWith(aURL, nsDependentCString(aPrefix));
+}
+
+bool FirefoxTraceCookieStoreIsChromeURL(const nsACString& aURL) {
+  return FirefoxTraceCookieStoreURLStartsWith(aURL, "chrome://") ||
+         FirefoxTraceCookieStoreURLStartsWith(aURL, "resource://") ||
+         FirefoxTraceCookieStoreURLStartsWith(aURL, "about:");
+}
+
+bool FirefoxTraceCookieStoreIsWebURL(const nsACString& aURL) {
+  return FirefoxTraceCookieStoreURLStartsWith(aURL, "http://") ||
+         FirefoxTraceCookieStoreURLStartsWith(aURL, "https://");
+}
+
+bool FirefoxTraceShouldRecordCookieStoreContext(const nsACString& aPageURL,
+                                                const nsACString& aCallerURL) {
+  const char* filter = getenv("FIREFOX_TRACE_COOKIE_FILTER");
+  if (!filter || !filter[0]) {
+    filter = getenv("TRACE_COOKIE_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = getenv("FIREFOX_TRACE_DOM_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = "content";
+  }
+
+  if (strcmp(filter, "all") == 0) {
+    return true;
+  }
+
+  const nsACString& contextURL = !aPageURL.IsEmpty() ? aPageURL : aCallerURL;
+  if (strcmp(filter, "chrome") == 0) {
+    return FirefoxTraceCookieStoreIsChromeURL(contextURL);
+  }
+
+  if (strcmp(filter, "web") == 0) {
+    return FirefoxTraceCookieStoreIsWebURL(contextURL);
+  }
+
+  if (contextURL.IsEmpty() || FirefoxTraceCookieStoreIsChromeURL(contextURL)) {
+    return false;
+  }
+
+  return true;
+}
+
+void FirefoxTraceCookieStoreAppendJsonCString(nsACString& aLine,
+                                              const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceCookieStoreAppendJsonString(nsACString& aLine,
+                                             const nsACString& aValue) {
+  FirefoxTraceCookieStoreAppendJsonCString(aLine,
+                                           PromiseFlatCString(aValue).get());
+}
+
+void FirefoxTraceCookieStoreAppendJsonString16(nsACString& aLine,
+                                               const nsAString& aValue) {
+  NS_ConvertUTF16toUTF8 utf8(aValue);
+  FirefoxTraceCookieStoreAppendJsonString(aLine, utf8);
+}
+
+void FirefoxTraceCookieStoreTruncatePreview(nsACString& aPreview) {
+  uint32_t limit = 4096;
+  const char* configured = getenv("FIREFOX_TRACE_PREVIEW_LIMIT");
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long parsed = strtoul(configured, &end, 10);
+    if (end != configured && parsed > 0) {
+      limit = parsed > 65536 ? 65536 : static_cast<uint32_t>(parsed);
+    }
+  }
+  if (aPreview.Length() > limit) {
+    aPreview.Truncate(limit);
+    aPreview.AppendLiteral("...");
+  }
+}
+
+void FirefoxTraceWriteCookieStoreLine(const nsACString& aLine) {
+  if (XRE_IsContentProcess()) {
+    if (ContentChild* child = ContentChild::GetSingleton()) {
+      Unused << child->SendFirefoxTraceDOMEvent(aLine);
+    }
+    return;
+  }
+
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-cookie-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceCookieStoreGetCaller(JSContext* aCx, nsACString& aCallerURL,
+                                      uint32_t* aLine, uint32_t* aColumn) {
+  *aLine = 0;
+  *aColumn = 0;
+  if (!aCx) {
+    return;
+  }
+
+  JS::AutoFilename filename;
+  JS::ColumnNumberOneOrigin column;
+  if (!JS::DescribeScriptedCaller(&filename, aCx, aLine, &column) ||
+      !filename.get()) {
+    return;
+  }
+
+  aCallerURL.Assign(filename.get());
+  *aColumn = column.oneOriginValue();
+}
+
+void FirefoxTraceCookieStoreAppendMaybeString16(nsACString& aLine,
+                                                const char* aName,
+                                                const nsAString* aValue) {
+  if (!aValue || aValue->IsVoid()) {
+    return;
+  }
+  aLine.AppendLiteral(",\"");
+  aLine.Append(aName);
+  aLine.AppendLiteral("\":");
+  FirefoxTraceCookieStoreAppendJsonString16(aLine, *aValue);
+}
+
+bool FirefoxTraceCookieStoreConfiguredName(const nsAString* aName) {
+  if (!aName || aName->IsEmpty()) {
+    return false;
+  }
+  const char* configured = getenv("FIREFOX_TRACE_COOKIE_FIELDS");
+  if (!configured || !configured[0]) {
+    configured = getenv("TRACE_COOKIE_FIELDS");
+  }
+  NS_ConvertUTF16toUTF8 name(*aName);
+  if (!configured || !configured[0]) {
+    return false;
+  }
+  const char* p = configured;
+  while (*p) {
+    while (*p == ',' || *p == ';' || *p == ' ' || *p == '\t' ||
+           *p == '\n' || *p == '\r') {
+      ++p;
+    }
+    const char* start = p;
+    while (*p && *p != ',' && *p != ';') {
+      ++p;
+    }
+    const char* end = p;
+    while (end > start &&
+           (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\n' ||
+            end[-1] == '\r')) {
+      --end;
+    }
+    if (static_cast<size_t>(end - start) == name.Length() &&
+        !strncmp(start, name.get(), name.Length())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void FirefoxTraceCookieStoreEvent(CookieStore* aStore, const char* aType,
+                                  const nsAString* aName,
+                                  const nsAString* aValue,
+                                  const nsAString* aURL,
+                                  const nsAString* aDomain,
+                                  const nsAString* aPath,
+                                  bool aPartitioned) {
+  if (!FirefoxTraceCookieStoreEnabled()) {
+    return;
+  }
+
+  nsAutoCString pageURL;
+  if (aStore) {
+    if (nsPIDOMWindowInner* window = aStore->GetOwnerWindow()) {
+      if (Document* doc = window->GetExtantDoc()) {
+        if (nsIURI* docURI = doc->GetDocumentURI()) {
+          Unused << docURI->GetSpec(pageURL);
+        }
+      }
+    }
+  }
+
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  nsAutoCString callerURL;
+  uint32_t callerLine = 0;
+  uint32_t callerColumn = 0;
+  FirefoxTraceCookieStoreGetCaller(cx, callerURL, &callerLine, &callerColumn);
+
+  if (!FirefoxTraceShouldRecordCookieStoreContext(pageURL, callerURL)) {
+    return;
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.cookie.v1\",\"type\":");
+  FirefoxTraceCookieStoreAppendJsonCString(line, aType);
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"source\":\"cookieStore\"");
+  FirefoxTraceCookieStoreAppendMaybeString16(line, "key", aName);
+  if (aValue && !aValue->IsVoid()) {
+    NS_ConvertUTF16toUTF8 valuePreview(*aValue);
+    FirefoxTraceCookieStoreTruncatePreview(valuePreview);
+    line.AppendLiteral(",\"value_preview\":");
+    FirefoxTraceCookieStoreAppendJsonString(line, valuePreview);
+  }
+  bool matchedCookie = FirefoxTraceCookieStoreConfiguredName(aName);
+  if (matchedCookie) {
+    line.AppendLiteral(",\"cookie_fields\":{");
+    FirefoxTraceCookieStoreAppendJsonString16(line, *aName);
+    line.Append(':');
+    if (aValue && !aValue->IsVoid()) {
+      FirefoxTraceCookieStoreAppendJsonString16(line, *aValue);
+    } else {
+      line.AppendLiteral("null");
+    }
+    line.Append('}');
+  }
+  FirefoxTraceCookieStoreAppendMaybeString16(line, "url", aURL);
+  FirefoxTraceCookieStoreAppendMaybeString16(line, "domain", aDomain);
+  FirefoxTraceCookieStoreAppendMaybeString16(line, "path", aPath);
+  line.AppendLiteral(",\"partitioned\":");
+  line.Append(aPartitioned ? "true" : "false");
+  line.AppendLiteral(",\"page_url\":");
+  FirefoxTraceCookieStoreAppendJsonString(line, pageURL);
+  line.AppendLiteral(",\"origin_call_id\":");
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  if (originCallId) {
+    line.AppendPrintf("\"call_%llu\"",
+                      static_cast<unsigned long long>(originCallId));
+  } else {
+    line.AppendLiteral("null");
+  }
