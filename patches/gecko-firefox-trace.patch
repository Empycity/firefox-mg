+uint64_t FirefoxTraceHashAppend(uint64_t aHash, const char* aValue) {
+  if (!aValue) {
+    return aHash;
+  }
+  const unsigned char* p = reinterpret_cast<const unsigned char*>(aValue);
+  while (*p) {
+    aHash ^= *p++;
+    aHash *= 1099511628211ULL;
+  }
+  return aHash;
+}
