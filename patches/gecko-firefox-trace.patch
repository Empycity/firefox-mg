+bool FirefoxTraceEnvEnabled(const char* name, bool defaultValue = false) {
+  const char* value = getenv(name);
+  if (!value || !value[0]) {
+    return defaultValue;
+  }
+  return strcmp(value, "0") != 0;
+}
+
+const char* FirefoxTraceEnv(const char* primary, const char* fallback = nullptr) {
+  const char* value = getenv(primary);
+  if (value && value[0]) {
+    return value;
+  }
+  return fallback ? getenv(fallback) : nullptr;
+}
+
+bool FirefoxTraceEnvEnabledAlias(const char* primary, const char* fallback,
+                                 bool defaultValue = false) {
+  const char* value = FirefoxTraceEnv(primary, fallback);
+  if (!value || !value[0]) {
+    return defaultValue;
+  }
+  return strcmp(value, "0") != 0;
+}
