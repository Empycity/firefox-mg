+FirefoxTraceRuntimeState FirefoxTraceReadRuntimeStateFromControlFile(
+    const char* aPath) {
+  if (!aPath || !aPath[0]) {
+    return FirefoxTraceRuntimeStateActive;
+  }
+
+  FILE* file = fopen(aPath, "rb");
+  if (!file) {
+    return FirefoxTraceRuntimeStateActive;
