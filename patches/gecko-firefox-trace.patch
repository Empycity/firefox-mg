+bool FirefoxTraceCookieEnabled() {
+  const char* enabled = getenv("FIREFOX_TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return false;
+  }
+  if (FirefoxTraceRuntimeActive && !FirefoxTraceRuntimeActive()) {
+    return false;
+  }
+
+  const char* cookieEnabled = getenv("FIREFOX_TRACE_COOKIE");
+  if (!cookieEnabled || !cookieEnabled[0]) {
+    cookieEnabled = getenv("TRACE_COOKIE");
+  }
+  return !cookieEnabled || strcmp(cookieEnabled, "0") != 0;
+}
+
+bool FirefoxTraceCookieURLStartsWith(const nsACString& aURL,
+                                     const char* aPrefix) {
+  return StringBeginsWith(aURL, nsDependentCString(aPrefix));
+}
+
+bool FirefoxTraceCookieIsChromeURL(const nsACString& aURL) {
+  return FirefoxTraceCookieURLStartsWith(aURL, "chrome://") ||
+         FirefoxTraceCookieURLStartsWith(aURL, "resource://") ||
+         FirefoxTraceCookieURLStartsWith(aURL, "about:");
+}
+
+bool FirefoxTraceCookieIsWebURL(const nsACString& aURL) {
+  return FirefoxTraceCookieURLStartsWith(aURL, "http://") ||
+         FirefoxTraceCookieURLStartsWith(aURL, "https://");
+}
+
+bool FirefoxTraceShouldRecordCookieContext(const nsACString& aPageURL,
+                                           const nsACString& aCallerURL) {
+  const char* filter = getenv("FIREFOX_TRACE_COOKIE_FILTER");
+  if (!filter || !filter[0]) {
+    filter = getenv("TRACE_COOKIE_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = getenv("FIREFOX_TRACE_DOM_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = "content";
+  }
+
+  if (strcmp(filter, "all") == 0) {
+    return true;
+  }
+
+  const nsACString& contextURL = !aPageURL.IsEmpty() ? aPageURL : aCallerURL;
+  if (strcmp(filter, "chrome") == 0) {
+    return FirefoxTraceCookieIsChromeURL(contextURL);
+  }
+
+  if (strcmp(filter, "web") == 0) {
+    return FirefoxTraceCookieIsWebURL(contextURL);
+  }
+
+  if (contextURL.IsEmpty() || FirefoxTraceCookieIsChromeURL(contextURL)) {
+    return false;
+  }
+
+  return true;
+}
+
+void FirefoxTraceCookieAppendJsonCString(nsACString& aLine,
+                                         const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceCookieAppendJsonString(nsACString& aLine,
+                                        const nsACString& aValue) {
+  FirefoxTraceCookieAppendJsonCString(aLine, PromiseFlatCString(aValue).get());
+}
+
+void FirefoxTraceCookieAppendJsonString16(nsACString& aLine,
+                                          const nsAString& aValue) {
+  NS_ConvertUTF16toUTF8 utf8(aValue);
+  FirefoxTraceCookieAppendJsonString(aLine, utf8);
+}
+
+void FirefoxTraceCookieTruncatePreview(nsACString& aPreview) {
+  uint32_t limit = 4096;
+  const char* configured = getenv("FIREFOX_TRACE_PREVIEW_LIMIT");
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long parsed = strtoul(configured, &end, 10);
+    if (end != configured && parsed > 0) {
+      limit = parsed > 65536 ? 65536 : static_cast<uint32_t>(parsed);
+    }
+  }
+  if (aPreview.Length() > limit) {
+    aPreview.Truncate(limit);
+    aPreview.AppendLiteral("...");
+  }
+}
+
+void FirefoxTraceWriteCookieLine(const nsACString& aLine) {
+  if (XRE_IsContentProcess()) {
+    if (ContentChild* child = ContentChild::GetSingleton()) {
+      Unused << child->SendFirefoxTraceDOMEvent(aLine);
+    }
+    return;
+  }
+
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-cookie-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceCookieGetCaller(JSContext* aCx, nsACString& aCallerURL,
+                                 uint32_t* aLine, uint32_t* aColumn) {
+  *aLine = 0;
+  *aColumn = 0;
+  if (!aCx) {
+    return;
+  }
+
+  JS::AutoFilename filename;
+  JS::ColumnNumberOneOrigin column;
+  if (!JS::DescribeScriptedCaller(&filename, aCx, aLine, &column) ||
+      !filename.get()) {
+    return;
+  }
+
+  aCallerURL.Assign(filename.get());
+  *aColumn = column.oneOriginValue();
+}
+
+void FirefoxTraceCookieNameFromSetString(const nsAString& aCookieString,
+                                         nsAString& aName) {
+  aName.Truncate();
+  nsAString::const_iterator start;
+  nsAString::const_iterator end;
+  aCookieString.BeginReading(start);
+  aCookieString.EndReading(end);
+
+  while (start != end && nsContentUtils::IsHTMLWhitespace(*start)) {
+    ++start;
+  }
+  nsAString::const_iterator cur = start;
+  while (cur != end && *cur != '=' && *cur != ';') {
+    ++cur;
+  }
+  nsAString::const_iterator trimmedEnd = cur;
+  while (trimmedEnd != start) {
+    nsAString::const_iterator prev = trimmedEnd;
+    --prev;
+    if (!nsContentUtils::IsHTMLWhitespace(*prev)) {
+      break;
+    }
+    trimmedEnd = prev;
+  }
+  aName.Assign(Substring(start, trimmedEnd));
+}
+
+void FirefoxTraceDocumentCookieEvent(Document* aDocument, const char* aType,
+                                     const nsAString* aKey,
+                                     const nsAString* aValue, bool aFound) {
+  if (!FirefoxTraceCookieEnabled()) {
+    return;
+  }
+
+  nsAutoCString pageURL;
+  if (aDocument) {
+    if (nsIURI* uri = aDocument->GetDocumentURI()) {
+      Unused << uri->GetSpec(pageURL);
+    }
+  }
+
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  nsAutoCString callerURL;
+  uint32_t callerLine = 0;
+  uint32_t callerColumn = 0;
+  FirefoxTraceCookieGetCaller(cx, callerURL, &callerLine, &callerColumn);
+
+  if (!FirefoxTraceShouldRecordCookieContext(pageURL, callerURL)) {
+    return;
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.cookie.v1\",\"type\":");
+  FirefoxTraceCookieAppendJsonCString(line, aType);
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"source\":\"document.cookie\"");
+  line.AppendLiteral(",\"found\":");
+  line.Append(aFound ? "true" : "false");
+  if (aKey) {
+    line.AppendLiteral(",\"key\":");
+    FirefoxTraceCookieAppendJsonString16(line, *aKey);
+  }
+  if (aValue) {
+    NS_ConvertUTF16toUTF8 valuePreview(*aValue);
+    FirefoxTraceCookieTruncatePreview(valuePreview);
+    line.AppendLiteral(",\"value_preview\":");
+    FirefoxTraceCookieAppendJsonString(line, valuePreview);
+  }
+  line.AppendLiteral(",\"page_url\":");
+  FirefoxTraceCookieAppendJsonString(line, pageURL);
+  line.AppendLiteral(",\"origin_call_id\":");
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  if (originCallId) {
+    line.AppendPrintf("\"call_%llu\"",
+                      static_cast<unsigned long long>(originCallId));
+  } else {
+    line.AppendLiteral("null");
+  }
+  line.AppendLiteral(",\"caller_url\":");
+  FirefoxTraceCookieAppendJsonString(line, callerURL);
+  line.AppendLiteral(",\"caller_line\":");
+  line.AppendInt(callerLine);
+  line.AppendLiteral(",\"caller_column\":");
+  line.AppendInt(callerColumn);
+  line.Append('}');
+  if (FirefoxTraceFlushJSBoundaryBuffer && originCallId) {
+    FirefoxTraceFlushJSBoundaryBuffer(aType);
+  }
+  FirefoxTraceWriteCookieLine(line);
+}
