+void FirefoxTraceFetchComputeSHA256Hex(const char* data, size_t len,
+                                       char out[65]) {
+#if defined(__APPLE__)
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(reinterpret_cast<const void*>(data), static_cast<CC_LONG>(len),
+            digest);
+  static const char kHex[] = "0123456789abcdef";
+  for (size_t i = 0; i < CC_SHA256_DIGEST_LENGTH; i++) {
+    out[i * 2] = kHex[(digest[i] >> 4) & 0x0f];
+    out[i * 2 + 1] = kHex[digest[i] & 0x0f];
+  }
+  out[64] = '\0';
+#else
+  uint64_t hash = 1469598103934665603ULL;
+  const unsigned char* p = reinterpret_cast<const unsigned char*>(data);
+  for (size_t i = 0; i < len; i++) {
+    hash ^= p[i];
+    hash *= 1099511628211ULL;
+  }
+  snprintf(out, 65, "fnv1a64-%016llx", static_cast<unsigned long long>(hash));
+#endif
+}
