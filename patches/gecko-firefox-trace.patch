+  void writeArrayItems(FILE* file, JS::HandleObject obj, uint32_t depth,
+                       const char* role, uint32_t argIndex,
+                       const char* valuePath) {
+    uint32_t length = 0;
+    if (!JS::GetArrayLength(cx_, obj, &length)) {
+      JS_ClearPendingException(cx_);
+      fputs(",\"array_error\":\"length_failed\"", file);
+      return;
+    }
+
+    uint32_t limit = std::min(length, FirefoxTraceJSArrayItems());
+    fprintf(file, ",\"length\":%u,\"items\":[", length);
+    for (uint32_t i = 0; i < limit; i++) {
+      if (i) {
+        fputc(',', file);
+      }
+      JS::RootedValue item(cx_);
+      if (!JS_GetElement(cx_, obj, i, &item)) {
+        writeGetFailedValue(file);
+      } else {
+        char itemName[32];
+        char childPath[256];
+        snprintf(itemName, sizeof(itemName), "[%u]", i);
+        childValuePath(childPath, sizeof(childPath), valuePath, itemName);
+        writeValuePreview(file, item, depth > 0 ? depth - 1 : 0, role,
+                          argIndex, childPath);
+      }
+    }
+    fputc(']', file);
+    if (length > limit) {
+      fputs(",\"items_truncated\":true", file);
+    }
+  }
+
+  void writeObjectProps(FILE* file, JS::HandleObject obj, uint32_t depth,
+                        const char* role, uint32_t argIndex,
+                        const char* valuePath) {
+    JS::RootedIdVector ids(cx_);
+    if (!js::GetPropertyKeys(cx_, obj, JSITER_OWNONLY, &ids)) {
+      JS_ClearPendingException(cx_);
+      fputs(",\"props_error\":\"get_keys_failed\"", file);
+      return;
+    }
+
+    uint32_t keyLimit = FirefoxTraceJSObjectKeys();
+    uint32_t limit = std::min<uint32_t>(ids.length(), keyLimit);
+    fprintf(file, ",\"prop_count\":%zu,\"props\":[", ids.length());
+    for (uint32_t i = 0; i < limit; i++) {
+      if (i) {
+        fputc(',', file);
+      }
+      JS::RootedId id(cx_, ids[i]);
+      fputs("{\"key\":", file);
+      writePropertyKey(file, id);
+      if (!shouldReadObjectPropertyValue(id)) {
+        fputs(",\"value_skipped\":\"key_filter\"", file);
+      } else {
+        fputs(",\"value\":", file);
+        JS::RootedValue prop(cx_);
+        if (!JS_GetPropertyById(cx_, obj, id, &prop)) {
+          writeGetFailedValue(file);
+        } else {
+          char keyBuf[128];
+          char childPath[256];
+          if (!propertyKeyCString(id, keyBuf, sizeof(keyBuf))) {
+            snprintf(keyBuf, sizeof(keyBuf), "<key-encode-failed>");
+          }
+          childValuePath(childPath, sizeof(childPath), valuePath, keyBuf);
+          writeValuePreview(file, prop, depth > 0 ? depth - 1 : 0, role,
+                            argIndex, childPath);
+        }
+      }
+      fputc('}', file);
+    }
+    fputc(']', file);
+    if (ids.length() > limit) {
+      fputs(",\"props_truncated\":true", file);
+    }
+  }
