+bool XMLHttpRequestMainThread::FirefoxTraceXHREvent(
+    const char* aType, const nsACString* aDetailName,
+    const nsACString* aDetailValue, bool aFlushBoundary) {
+  if (!FirefoxTraceXHREnabled()) {
+    return false;
+  }
+
+  if (!mFirefoxTraceXHRId) {
+    mFirefoxTraceXHRId =
+        sFirefoxTraceNextXHRId.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  nsAutoCString url(mFirefoxTraceXHRURL);
+  if (url.IsEmpty() && mRequestURL) {
+    Unused << mRequestURL->GetSpec(url);
+  }
+
+  nsAutoCString pageURL;
+  if (Document* doc = GetDocumentIfCurrent()) {
+    if (nsIURI* docURI = doc->GetDocumentURI()) {
+      Unused << docURI->GetSpec(pageURL);
+    }
+  }
+
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  nsAutoCString callerURL;
+  uint32_t callerLine = 0;
+  uint32_t callerColumn = 0;
+  FirefoxTraceGetCaller(cx, callerURL, &callerLine, &callerColumn);
+
+  if (!FirefoxTraceShouldRecordXHRContext(pageURL, callerURL)) {
+    return false;
+  }
+
+  if (!FirefoxTraceXHREventKindEnabled(aType)) {
+    return true;
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.xhr.v1\",\"type\":");
+  FirefoxTraceAppendJsonCString(line, aType);
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"request_id\":\"xhr_");
+  line.AppendInt(static_cast<uint64_t>(mFirefoxTraceXHRId));
+  line.AppendLiteral("\",\"xhr_ptr\":\"");
+  line.AppendPrintf("%p", this);
+  line.AppendLiteral("\",\"method\":");
+  FirefoxTraceAppendJsonString(line, mFirefoxTraceXHRMethod);
+  FirefoxTraceAppendRequestURLField(line, "url", url);
+  FirefoxTraceAppendConfiguredQueryFields(line, url);
+  nsAutoCString matchedQueryField;
+  Unused << FirefoxTraceFirstConfiguredQueryField(url, matchedQueryField);
+  line.AppendLiteral(",\"async\":");
+  line.Append(mFlagSynchronous ? "false" : "true");
+  line.AppendLiteral(",\"with_credentials\":");
+  line.Append(mFlagACwithCredentials ? "true" : "false");
+  line.AppendLiteral(",\"ready_state\":");
+  line.AppendInt(static_cast<uint32_t>(mState));
+  line.AppendLiteral(",\"page_url\":");
+  FirefoxTraceAppendJsonString(line, pageURL);
+  line.AppendLiteral(",\"origin_call_id\":");
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  if (originCallId) {
+    line.AppendPrintf("\"call_%llu\"",
+                      static_cast<unsigned long long>(originCallId));
+  } else {
+    line.AppendLiteral("null");
+  }
+  line.AppendLiteral(",\"caller_url\":");
+  FirefoxTraceAppendJsonString(line, callerURL);
+  line.AppendLiteral(",\"caller_line\":");
+  line.AppendInt(callerLine);
+  line.AppendLiteral(",\"caller_column\":");
+  line.AppendInt(callerColumn);
+
+  if (aDetailName) {
+    line.AppendLiteral(",\"detail_name\":");
+    FirefoxTraceAppendJsonString(line, *aDetailName);
+  }
+  if (aDetailValue) {
+    const char* previewKind =
+        strcmp(aType, "xhr.header") == 0 ? "header" : "detail";
+    if (FirefoxTraceXHRPreviewKindEnabled(previewKind)) {
+      nsAutoCString preview(*aDetailValue);
+      FirefoxTraceTruncatePreview(preview);
+      line.AppendLiteral(",\"detail_value\":");
+      FirefoxTraceAppendJsonString(line, preview);
+    } else {
+      line.AppendLiteral(",\"detail_value_disabled\":true");
+    }
+  }
+
+  line.Append('}');
+  if (aFlushBoundary && FirefoxTraceFlushJSBoundaryBuffer && originCallId) {
+    nsAutoCString flushReason;
+    FirefoxTraceBuildFieldFlushReason(flushReason, aType, matchedQueryField);
+    FirefoxTraceFlushJSBoundaryBuffer(flushReason.get());
+  }
+  FirefoxTraceWriteXHRLine(line);
+  return true;
+}
