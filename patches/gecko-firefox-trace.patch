+class MOZ_STACK_CLASS AutoFirefoxTraceScriptRun {
+ public:
+  explicit AutoFirefoxTraceScriptRun(JSContext* cx, JSScript* script)
+      : enabled_(FirefoxTraceJSStackEnabled()),
+        logEnabled_(FirefoxTraceJSLogEnabled() &&
+                    FirefoxTraceJSModeIsBoundary() &&
+                    FirefoxTraceJSScriptEventsEnabled() &&
+                    FirefoxTraceShouldLogBoundary(
+                        "script", script ? script->filename() : nullptr, true)),
+        scriptUrl_(script ? script->filename() : nullptr),
+        line_(script ? script->lineno() : 0),
+        column_(script ? script->column().oneOriginValue() : 0) {
+    FirefoxTraceComputeJSScriptId(scriptUrl_, nullptr, line_, column_,
+                                  scriptId_);
+    if (cx && script && FirefoxTraceJSScriptHashEnabled()) {
+      JS::RootedScript rootedScript(cx, script);
+      scriptSha256Available_ = FirefoxTraceComputeJSScriptSHA256(
+          cx, rootedScript, scriptSha256_, &scriptSourceLength_,
+          &scriptHashStatus_, scriptSourcePath_, sizeof(scriptSourcePath_),
+          &scriptSourceStatus_, logEnabled_);
+    }
+
+    if (!enabled_) {
+      return;
+    }
+
+    callId_ = sFirefoxTraceNextJSCallId.fetch_add(1, std::memory_order_relaxed);
+    parentCallId_ = sFirefoxTraceCurrentJSCallId;
+    parentScriptedCallId_ = sFirefoxTraceCurrentScriptedJSCallId;
+    sFirefoxTraceCurrentScriptedJSCallId = callId_;
+
+    if (logEnabled_) {
+      writeEvent("js.script.enter", true);
+    }
+  }
+
+  bool finish(bool ok) {
+    if (!enabled_) {
+      return ok;
+    }
+
+    if (logEnabled_) {
+      ok_ = ok;
+      writeEvent("js.script.return", false);
+    }
+
+    sFirefoxTraceCurrentScriptedJSCallId = parentScriptedCallId_;
+    enabled_ = false;
+    return ok;
+  }
+
+  ~AutoFirefoxTraceScriptRun() {
+    if (enabled_) {
+      sFirefoxTraceCurrentScriptedJSCallId = parentScriptedCallId_;
+    }
+  }
+
+ private:
+  void writeEvent(const char* type, bool enter) {
+#if defined(XP_UNIX)
