+  const char* value =
+      FirefoxTraceEnv("FIREFOX_TRACE_JS_PRUNE_NON_TARGET_FUNCTIONS",
+                      "TRACE_JS_PRUNE_NON_TARGET_FUNCTIONS");
+  if (value && value[0]) {
+    return strcmp(value, "0") != 0 && strcmp(value, "false") != 0 &&
+           strcmp(value, "none") != 0;
+  }
+
+  // In target/deep runs, maintaining call_id/current-stack state for every
+  // non-target function inside a hot obfuscated script can be enough to perturb
+  // script timeout heuristics. Default to pruning those non-target frames after
+  // filter evaluation. Use TRACE_JS_PRUNE_NON_TARGET_FUNCTIONS=0 when a run
+  // needs complete function-level parent stacks.
+  return true;
+}
