+
+bool FirefoxTraceContains(const char* haystack, const char* needle,
+                          size_t needleLen) {
+  if (!haystack || !needle || needleLen == 0) {
+    return false;
+  }
+  size_t haystackLen = strlen(haystack);
+  if (needleLen > haystackLen) {
+    return false;
+  }
+  for (size_t i = 0; i + needleLen <= haystackLen; i++) {
+    if (strncmp(haystack + i, needle, needleLen) == 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool FirefoxTraceCSVMatches(const char* csv, const char* value) {
+  if (!csv || !csv[0] || !value || !value[0]) {
+    return false;
+  }
+
+  const char* p = csv;
+  while (*p) {
+    while (*p == ',' || *p == ' ' || *p == '\t') {
+      p++;
+    }
+    const char* start = p;
+    while (*p && *p != ',') {
+      p++;
+    }
+    const char* end = p;
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t')) {
+      end--;
+    }
+    if (end > start) {
+      bool exact = *start == '=';
+      if (exact) {
+        start++;
+      }
+      size_t tokenLen = static_cast<size_t>(end - start);
+      if (tokenLen == 0) {
+        continue;
+      }
+      if (exact) {
+        if (strlen(value) == tokenLen && strncmp(value, start, tokenLen) == 0) {
+          return true;
+        }
+      } else if (FirefoxTraceContains(value, start, tokenLen)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
