+
+void FirefoxTraceDescribeXHRSendBody(
+    const Nullable<
+        DocumentOrBlobOrArrayBufferViewOrArrayBufferOrFormDataOrURLSearchParamsOrUSVString>&
+        aData,
+    nsACString& aKind, nsACString& aPreview) {
+  if (aData.IsNull()) {
+    aKind.AssignLiteral("null");
+    return;
+  }
+
+  const auto& value = aData.Value();
+  if (value.IsUSVString()) {
+    aKind.AssignLiteral("string");
+    CopyUTF16toUTF8(value.GetAsUSVString(), aPreview);
+    return;
+  }
+
+  if (value.IsURLSearchParams()) {
+    aKind.AssignLiteral("URLSearchParams");
+    value.GetAsURLSearchParams().Serialize(aPreview);
+    return;
+  }
+
+  if (value.IsDocument()) {
+    aKind.AssignLiteral("Document");
+    return;
+  }
+  if (value.IsBlob()) {
+    aKind.AssignLiteral("Blob");
+    return;
+  }
+  if (value.IsArrayBuffer()) {
+    aKind.AssignLiteral("ArrayBuffer");
+    return;
+  }
+  if (value.IsArrayBufferView()) {
+    aKind.AssignLiteral("ArrayBufferView");
+    return;
+  }
+  if (value.IsFormData()) {
+    aKind.AssignLiteral("FormData");
+    return;
+  }
+
+  aKind.AssignLiteral("unknown");
+}
+
+void FirefoxTraceXHRResponseTypeName(XMLHttpRequestResponseType aType,
+                                     nsACString& aName) {
+  switch (aType) {
+    case XMLHttpRequestResponseType::_empty:
+      aName.AssignLiteral("");
+      return;
+    case XMLHttpRequestResponseType::Arraybuffer:
+      aName.AssignLiteral("arraybuffer");
+      return;
+    case XMLHttpRequestResponseType::Blob:
+      aName.AssignLiteral("blob");
+      return;
+    case XMLHttpRequestResponseType::Document:
+      aName.AssignLiteral("document");
+      return;
+    case XMLHttpRequestResponseType::Json:
+      aName.AssignLiteral("json");
+      return;
+    case XMLHttpRequestResponseType::Text:
+      aName.AssignLiteral("text");
+      return;
+  }
+  aName.AssignLiteral("unknown");
+}
