+uint64_t FirefoxTraceParseBudget(const char* aPrimary, const char* aFallback) {
+  const char* value = PR_GetEnv(aPrimary);
+  if (!value || !value[0]) {
+    value = PR_GetEnv(aFallback);
+  }
+  if (!value || !value[0]) {
+    return 0;
+  }
+  char* end = nullptr;
+  unsigned long long parsed = strtoull(value, &end, 10);
+  return end == value ? 0 : static_cast<uint64_t>(parsed);
+}
