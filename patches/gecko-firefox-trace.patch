+bool FirefoxTraceShouldSuppressDeepDescendant(const char* calleeKind,
+                                             const char* functionName,
+                                             bool targetMatch) {
+  if (!FirefoxTraceJSModeIsDeep() || sFirefoxTraceDeepCaptureDepth == 0 ||
+      targetMatch) {
+    return false;
