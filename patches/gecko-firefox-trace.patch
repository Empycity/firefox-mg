+void FirefoxTraceFetchAppendRequestBodyPreview(nsACString& aLine,
+                                               InternalRequest& aRequest,
+                                               nsACString* aMatchedField = nullptr) {
+  const char* mode = FirefoxTraceFetchRequestBodyMode();
+  if (!FirefoxTraceFetchRequestBodyEnabled()) {
+    aLine.AppendLiteral(",\"body_preview_enabled\":false");
+    return;
+  }
+
+  aLine.AppendLiteral(",\"body_preview_enabled\":true,\"body_preview_mode\":");
+  FirefoxTraceFetchAppendJsonCString(aLine, mode);
+
+  nsCOMPtr<nsIInputStream> originalBody;
+  int64_t bodyLength = InternalResponse::UNKNOWN_BODY_SIZE;
+  aRequest.GetBody(getter_AddRefs(originalBody), &bodyLength);
+  if (!originalBody) {
+    aLine.AppendLiteral(",\"body_preview_skipped\":\"no_body\"");
+    return;
+  }
+
+  SafeRefPtr<InternalRequest> clonedRequest = aRequest.Clone();
+  if (!clonedRequest) {
+    aLine.AppendLiteral(",\"body_preview_skipped\":\"clone_failed\"");
+    return;
+  }
+
+  nsCOMPtr<nsIInputStream> body;
+  clonedRequest->GetBody(getter_AddRefs(body), &bodyLength);
+  if (!body) {
+    aLine.AppendLiteral(",\"body_preview_skipped\":\"clone_no_body\"");
+    return;
+  }
+
+  uint64_t available = 0;
+  nsresult rv = body->Available(&available);
+  if (NS_FAILED(rv)) {
+    aLine.AppendLiteral(",\"body_preview_skipped\":\"available_failed\"");
+    return;
+  }
+  if (!available) {
+    aLine.AppendLiteral(",\"body_preview_skipped\":\"not_available\"");
+    return;
+  }
+
+  uint32_t maxBytes = FirefoxTraceFetchRequestBodyMaxBytes();
+  uint64_t wanted = available;
+  if (bodyLength >= 0) {
+    wanted = std::min<uint64_t>(wanted, static_cast<uint64_t>(bodyLength));
+  }
+  uint64_t toRead64 = std::min<uint64_t>(wanted, maxBytes);
+  if (toRead64 > static_cast<uint64_t>(INT32_MAX)) {
+    toRead64 = INT32_MAX;
+  }
+
+  nsAutoCString data;
+  uint64_t written = 0;
+  rv = NS_ReadInputStreamToString(body, data, static_cast<int64_t>(toRead64),
+                                  &written);
+  if (NS_FAILED(rv)) {
+    aLine.AppendLiteral(",\"body_preview_skipped\":\"read_failed\"");
+    return;
+  }
+
+  bool truncated = available > written ||
+                   (bodyLength >= 0 &&
+                    static_cast<uint64_t>(bodyLength) > written);
+  nsAutoCString preview(data);
+  FirefoxTraceFetchTruncatePreview(preview);
+  bool previewTruncated = !preview.Equals(data);
+
+  char sha256[65];
+  FirefoxTraceFetchComputeSHA256Hex(data.BeginReading(), data.Length(), sha256);
+
+  aLine.AppendLiteral(",\"body_preview\":");
+  FirefoxTraceFetchAppendJsonString(aLine, preview);
+  aLine.AppendLiteral(",\"body_preview_size\":");
+  aLine.AppendInt(static_cast<uint64_t>(data.Length()));
+  aLine.AppendLiteral(",\"body_preview_truncated\":");
+  aLine.Append((truncated || previewTruncated) ? "true" : "false");
+  aLine.AppendLiteral(",\"body_available_bytes\":");
+  aLine.AppendInt(available);
+  aLine.AppendLiteral(",\"body_sha256\":");
+  FirefoxTraceFetchAppendJsonCString(aLine, sha256);
+  FirefoxTraceFetchAppendConfiguredBodyFields(aLine, data);
+  if (aMatchedField) {
+    Unused << FirefoxTraceFetchFirstConfiguredBodyField(data, *aMatchedField);
+  }
+
+  uint32_t hexBytes = FirefoxTraceFetchRequestBodyHexBytes();
+  if (hexBytes) {
+    aLine.AppendLiteral(",\"body_bytes_hex\":");
+    FirefoxTraceFetchAppendBytesHex(aLine, data, hexBytes);
+    aLine.AppendLiteral(",\"body_bytes_hex_truncated\":");
+    aLine.Append(data.Length() > hexBytes ? "true" : "false");
+  }
+
+  if (FirefoxTraceFetchRequestBodyStoreEnabled()) {
+    uint64_t valueSeq = sFirefoxTraceNextFetchRequestBodyValueId.fetch_add(
+        1, std::memory_order_relaxed);
+    char valueId[128];
+    char relPath[512];
+    snprintf(valueId, sizeof(valueId), "fetch_req_body_%d_%llu", getpid(),
+             static_cast<unsigned long long>(valueSeq));
+    bool stored = FirefoxTraceFetchWriteBodyValueStoreFile(
+        valueId, data, relPath, sizeof(relPath));
+    aLine.AppendLiteral(",\"body_value_id\":");
+    FirefoxTraceFetchAppendJsonCString(aLine, valueId);
+    aLine.AppendLiteral(",\"body_value_store_path\":");
+    FirefoxTraceFetchAppendJsonCString(aLine, stored ? relPath : "");
+    aLine.AppendLiteral(",\"body_value_stored\":");
+    aLine.Append(stored ? "true" : "false");
+  }
+}
