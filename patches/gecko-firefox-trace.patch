+mozilla::ipc::IPCResult ContentParent::RecvFirefoxTraceRuntimeConfigApplied(
+    const uint64_t& aVersion, const nsACString& aConfigHash) {
+  FirefoxTraceWriteRuntimeConfigAck(this, aVersion, aConfigHash);
+  return IPC_OK();
