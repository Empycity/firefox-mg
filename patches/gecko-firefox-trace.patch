+bool FirefoxTraceTrySendEventToParent(const char* aLine, size_t aLen) {
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendEventToParent) {
+    return FirefoxTraceSendEventToParent(aLine, aLen);
+  }
+#endif
+  return false;
+}
+
+void FirefoxTraceFlushJSBatch() {
+  if (!sFirefoxTraceJSBatchLen) {
+    return;
+  }
+  bool sent = false;
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendEventBatchToParent) {
+    sent = FirefoxTraceSendEventBatchToParent(sFirefoxTraceJSBatchData,
+                                              sFirefoxTraceJSBatchLen);
+  }
+#endif
+  if (!sent) {
+    FirefoxTraceWriteJSEventLineRaw(sFirefoxTraceJSBatchData,
+                                    sFirefoxTraceJSBatchLen);
+  }
+  sFirefoxTraceJSBatchLen = 0;
+}
+
+// The parent may already have observed enabled=false when the content ACK is
+// being prepared. Sending through its normal active-event gate would discard
+// this tail. Persist only bytes captured under the previous active state,
+// without re-reading config or generating new page events.
+extern "C" bool FirefoxTraceDrainJSBatchForControl() {
+  if (!sFirefoxTraceJSBatchLen) {
+    return true;
+  }
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendJSBatchDrainToParent) {
+    if (!FirefoxTraceSendJSBatchDrainToParent(sFirefoxTraceJSBatchData,
+                                             sFirefoxTraceJSBatchLen)) {
+      return false;
+    }
+    sFirefoxTraceJSBatchLen = 0;
+    return true;
+  }
+#endif
+  // Standalone SpiderMonkey embeddings have no content-process IPC bridge.
+  FILE* file = FirefoxTraceOpenJSLog();
+  if (!file) {
+    return false;
+  }
+  size_t written = fwrite(sFirefoxTraceJSBatchData, 1,
+                          sFirefoxTraceJSBatchLen, file);
+  bool closed = fclose(file) == 0;
+  if (written != sFirefoxTraceJSBatchLen || !closed) {
+    fprintf(stderr, "FirefoxTrace JS batch control drain failed\n");
+    return false;
+  }
+  sFirefoxTraceJSBatchLen = 0;
+  return true;
+}
+
+void FirefoxTraceQueueJSBatchEvent(const char* aLine, size_t aLen) {
+  if (!aLine || !aLen) {
+    return;
+  }
+  size_t needed = aLen + (aLine[aLen - 1] == '\n' ? 0 : 1);
+  if (sFirefoxTraceJSBatchLen &&
+      sFirefoxTraceJSBatchLen + needed > kFirefoxTraceJSBatchBytes) {
+    FirefoxTraceFlushJSBatch();
+  }
+  if (sFirefoxTraceJSBatchCapacity < sFirefoxTraceJSBatchLen + needed) {
+    size_t capacity = std::max(kFirefoxTraceJSBatchBytes,
+                               sFirefoxTraceJSBatchLen + needed);
+    char* data = static_cast<char*>(realloc(sFirefoxTraceJSBatchData, capacity));
+    if (!data) {
+      FirefoxTraceWriteJSEventLineRaw(aLine, aLen);
+      return;
+    }
+    sFirefoxTraceJSBatchData = data;
+    sFirefoxTraceJSBatchCapacity = capacity;
+  }
+  memcpy(sFirefoxTraceJSBatchData + sFirefoxTraceJSBatchLen, aLine, aLen);
+  sFirefoxTraceJSBatchLen += aLen;
+  if (aLine[aLen - 1] != '\n') {
+    sFirefoxTraceJSBatchData[sFirefoxTraceJSBatchLen++] = '\n';
+  }
+}
+
+void FirefoxTraceWriteJSEventLineRaw(const char* aLine, size_t aLen) {
+  if (!aLine || !aLen) {
+    return;
+  }
+  if (!FirefoxTraceBaseEnabled()) {
+    return;
+  }
+
+  size_t ipcLen = aLen;
+  if (ipcLen && aLine[ipcLen - 1] == '\n') {
+    ipcLen--;
+  }
+  if (ipcLen && FirefoxTraceTrySendEventToParent(aLine, ipcLen)) {
+    return;
+  }
+
+  FILE* file = FirefoxTraceOpenJSLog();
+  if (!file) {
+    return;
+  }
+  fwrite(aLine, 1, aLen, file);
+  if (aLine[aLen - 1] != '\n') {
+    fputc('\n', file);
+  }
+  fclose(file);
+}
