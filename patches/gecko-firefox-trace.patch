+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\","
+      "\"ts_us\":%llu,\"pid\":%d,\"module\":\"opcode\","
+      "\"reason\":\"opcode_limit\",\"limit\":%u}\n",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(), aLimit);
+  if (len > 0) {
+    FirefoxTraceWriteJSEventLineRaw(line, static_cast<size_t>(len));
+  }
+}
+
+const char* FirefoxTraceOpcodeValueTypeName(const Value& aValue) {
+  if (aValue.isUndefined()) {
+    return "undefined";
+  }
+  if (aValue.isNull()) {
+    return "null";
+  }
+  if (aValue.isBoolean()) {
+    return "boolean";
+  }
+  if (aValue.isNumber()) {
+    return "number";
+  }
+  if (aValue.isString()) {
+    return "string";
+  }
+  if (aValue.isSymbol()) {
+    return "symbol";
+  }
+  if (aValue.isBigInt()) {
+    return "bigint";
+  }
+  if (aValue.isObject()) {
+    return "object";
+  }
+  if (aValue.isMagic()) {
+    return "magic";
+  }
+  return "unknown";
+}
+
+void FirefoxTraceWriteOpcodeStackSlots(FILE* aFile,
+                                       const InterpreterRegs& aRegs) {
+  uint32_t requested = FirefoxTraceOpcodeStackSlots();
+  uint32_t depth = aRegs.stackDepth();
+  uint32_t count = std::min(requested, depth);
+  if (!count) {
+    return;
+  }
+
+  bool includePrimitives = FirefoxTraceOpcodeStackPrimitivesEnabled();
+  fputs(",\"stack_top\":[", aFile);
+  for (uint32_t i = 0; i < count; i++) {
+    if (i) {
+      fputc(',', aFile);
+    }
+    const Value& value = aRegs.sp[-static_cast<int>(i + 1)];
+    fprintf(aFile, "{\"slot_from_top\":%u,\"type\":", i);
+    FirefoxTraceWriteJsonString(aFile, FirefoxTraceOpcodeValueTypeName(value));
+    if (includePrimitives) {
+      if (value.isBoolean()) {
+        fputs(",\"value\":", aFile);
+        fputs(value.toBoolean() ? "true" : "false", aFile);
+      } else if (value.isInt32()) {
+        fprintf(aFile, ",\"value\":%d", value.toInt32());
+      } else if (value.isDouble()) {
+        fprintf(aFile, ",\"value\":%.17g", value.toDouble());
+      } else if (value.isNull() || value.isUndefined()) {
+        fputs(",\"value\":null", aFile);
+      }
+    }
+    fputc('}', aFile);
+  }
+  fputc(']', aFile);
+}
+
+bool FirefoxTraceVMStepMatches(uint64_t aPC) {
+  if (!FirefoxTraceEnvEnabledAlias("FIREFOX_TRACE_VM_STEP", "TRACE_VM_STEP")) {
+    return false;
+  }
+  const char* value = FirefoxTraceEnv("FIREFOX_TRACE_VM_DISPATCH_PC",
+                                      "TRACE_VM_DISPATCH_PC");
+  if (!value || !value[0]) {
+    return false;
+  }
+  char* end = nullptr;
+  unsigned long long pc = strtoull(value, &end, 10);
+  return end != value && end && *end == '\0' && pc == aPC;
+}
