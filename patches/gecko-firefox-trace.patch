+/* static */
+void Storage::FirefoxTraceStorageEvent(Storage* aStorage, const char* aType,
+                                       const char* aStorageType,
+                                       const nsAString& aKey,
+                                       const nsAString* aValue,
+                                       bool aFound) {
+  if (!FirefoxTraceStorageEnabled()) {
+    return;
+  }
+
+  nsAutoCString pageURL;
+  if (aStorage) {
+    if (nsPIDOMWindowInner* window = aStorage->GetParentObject()) {
+      if (Document* doc = window->GetExtantDoc()) {
+        if (nsIURI* docURI = doc->GetDocumentURI()) {
+          Unused << docURI->GetSpec(pageURL);
+        }
+      }
+    }
+  }
+
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  nsAutoCString callerURL;
+  uint32_t callerLine = 0;
+  uint32_t callerColumn = 0;
+  FirefoxTraceStorageGetCaller(cx, callerURL, &callerLine, &callerColumn);
+
+  if (!FirefoxTraceShouldRecordStorageContext(pageURL, callerURL)) {
+    return;
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.storage.v1\",\"type\":");
+  FirefoxTraceStorageAppendJsonCString(line, aType);
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"storage_type\":");
+  FirefoxTraceStorageAppendJsonCString(line, aStorageType);
+  line.AppendLiteral(",\"key\":");
+  FirefoxTraceStorageAppendJsonString16(line, aKey);
+  line.AppendLiteral(",\"found\":");
+  line.Append(aFound ? "true" : "false");
+  if (aValue) {
+    NS_ConvertUTF16toUTF8 valuePreview(*aValue);
+    FirefoxTraceStorageTruncatePreview(valuePreview);
+    line.AppendLiteral(",\"value_preview\":");
+    FirefoxTraceStorageAppendJsonString(line, valuePreview);
+  }
+  line.AppendLiteral(",\"page_url\":");
+  FirefoxTraceStorageAppendJsonString(line, pageURL);
+  line.AppendLiteral(",\"origin_call_id\":");
+  uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+  if (originCallId) {
+    line.AppendPrintf("\"call_%llu\"",
+                      static_cast<unsigned long long>(originCallId));
+  } else {
+    line.AppendLiteral("null");
+  }
+  line.AppendLiteral(",\"caller_url\":");
+  FirefoxTraceStorageAppendJsonString(line, callerURL);
+  line.AppendLiteral(",\"caller_line\":");
+  line.AppendInt(callerLine);
+  line.AppendLiteral(",\"caller_column\":");
+  line.AppendInt(callerColumn);
+  line.Append('}');
+  if (FirefoxTraceFlushJSBoundaryBuffer && originCallId) {
+    FirefoxTraceFlushJSBoundaryBuffer(aType);
+  }
+  FirefoxTraceWriteStorageLine(line);
+}
