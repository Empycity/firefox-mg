+void FirefoxTraceGetCaller(JSContext* aCx, nsACString& aCallerURL,
+                           uint32_t* aLine, uint32_t* aColumn) {
+  *aLine = 0;
+  *aColumn = 0;
+  if (!aCx) {
+    return;
+  }
+
+  JS::AutoFilename filename;
+  JS::ColumnNumberOneOrigin column;
+  if (!JS::DescribeScriptedCaller(&filename, aCx, aLine, &column) ||
+      !filename.get()) {
+    return;
+  }
+
+  aCallerURL.Assign(filename.get());
+  *aColumn = column.oneOriginValue();
+}
+
+void FirefoxTraceDescribeXHRSendBody(
+    const Nullable<
+        DocumentOrBlobOrArrayBufferViewOrArrayBufferOrFormDataOrURLSearchParamsOrUSVString>&
+        aData,
+    nsACString& aKind, nsACString& aPreview) {
+  if (aData.IsNull()) {
+    aKind.AssignLiteral("null");
+    return;
+  }
+
+  const auto& value = aData.Value();
+  if (value.IsUSVString()) {
+    aKind.AssignLiteral("string");
+    CopyUTF16toUTF8(value.GetAsUSVString(), aPreview);
+    return;
+  }
+
+  if (value.IsURLSearchParams()) {
+    aKind.AssignLiteral("URLSearchParams");
+    value.GetAsURLSearchParams().Serialize(aPreview);
+    return;
+  }
+
+  if (value.IsDocument()) {
+    aKind.AssignLiteral("Document");
+    return;
+  }
+  if (value.IsBlob()) {
+    aKind.AssignLiteral("Blob");
+    return;
+  }
+  if (value.IsArrayBuffer()) {
+    aKind.AssignLiteral("ArrayBuffer");
+    return;
+  }
+  if (value.IsArrayBufferView()) {
+    aKind.AssignLiteral("ArrayBufferView");
+    return;
+  }
+  if (value.IsFormData()) {
+    aKind.AssignLiteral("FormData");
+    return;
+  }
+
+  aKind.AssignLiteral("unknown");
+}
