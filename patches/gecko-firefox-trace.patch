+    } else {
+      fputs("null", file);
+    }
+    fputs(",\"callee_kind\":\"script\",\"function_name\":null,\"script_url\":",
+          file);
+    FirefoxTraceWriteJsonString(file, scriptUrl_);
+    fputs(",\"script_id\":", file);
+    FirefoxTraceWriteJsonString(file, scriptId_);
+    if (FirefoxTraceJSScriptHashEnabled()) {
+      if (scriptSha256Available_) {
+        fputs(",\"script_sha256\":", file);
+        FirefoxTraceWriteJsonString(file, scriptSha256_);
+        if (scriptSourcePath_[0]) {
