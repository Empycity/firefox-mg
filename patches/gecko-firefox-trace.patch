+extern "C" bool FirefoxTraceRuntimeActive() {
+  return FirefoxTraceRuntimeStateCached() == FirefoxTraceRuntimeStateActive;
+}
+
+extern "C" bool FirefoxTraceSendEventToParent(const char* aLine, size_t aLen) {
+  if (!aLine || !aLen) {
+    return false;
+  }
+
+  // PContentChild is owned by the content main thread. JS can run on worker
+  // threads, and calling Send* from there trips IPC/thread release asserts.
+  // Record the omission once without entering IPC; worker delivery needs a
+  // dedicated cross-thread queue.
+  if (!NS_IsMainThread()) {
+    FirefoxTraceWriteWorkerTraceSuppressed();
+    return true;
+  }
+
+  mozilla::dom::ContentChild* child =
+      mozilla::dom::ContentChild::GetSingleton();
+  if (!child) {
+    return false;
+  }
+
+  nsDependentCSubstring line(aLine, aLen);
+  if (!FirefoxTraceRuntimeAllowsEvent(line)) {
+    return true;
+  }
+  uint64_t droppedEvents = 0;
+  uint64_t droppedBytes = 0;
+  if (!FirefoxTraceConsumeEventBudget(aLen, &droppedEvents, &droppedBytes)) {
+    FirefoxTraceSendEventBudgetDegraded(child, droppedEvents, droppedBytes);
+    return true;
+  }
+  return child->SendFirefoxTraceDOMEvent(line);
+}
+
+extern "C" bool FirefoxTraceSendValueToParent(const char* aValueId,
+                                              const char* aArtifactKey,
+                                              const char* aData,
+                                              size_t aLen) {
+  if (!aValueId || !aValueId[0] || !aData) {
+    return false;
+  }
+
+  if (!NS_IsMainThread()) {
+    FirefoxTraceWriteWorkerTraceSuppressed();
+    return true;
+  }
+
+  mozilla::dom::ContentChild* child =
+      mozilla::dom::ContentChild::GetSingleton();
+  if (!child) {
+    return false;
+  }
+
+  if (!FirefoxTraceRuntimeAllowsArtifact()) {
+    return true;
+  }
+
+  nsDependentCString valueId(aValueId);
+  nsDependentCString artifactKey(aArtifactKey ? aArtifactKey : "");
+  nsDependentCSubstring data(aData, aLen);
+  mozilla::Unused << child->SendFirefoxTraceJSValue(valueId, artifactKey, data);
+  return true;
+}
+
+extern "C" bool FirefoxTraceSendScriptSourceToParent(
+    const char* aScriptSha256, const char* aData, size_t aLen) {
+  if (!aScriptSha256 || !aScriptSha256[0] || !aData) {
+    return false;
+  }
+
+  if (!NS_IsMainThread()) {
+    FirefoxTraceWriteWorkerTraceSuppressed();
+    return true;
+  }
+
+  mozilla::dom::ContentChild* child =
+      mozilla::dom::ContentChild::GetSingleton();
+  if (!child) {
+    return false;
+  }
+
+  if (!FirefoxTraceRuntimeAllowsArtifact()) {
+    return true;
+  }
+
+  nsDependentCString scriptSha256(aScriptSha256);
+  nsDependentCSubstring data(aData, aLen);
+  mozilla::Unused << child->SendFirefoxTraceJSScriptSource(scriptSha256, data);
+  return true;
+}
