+  if (strcmp(sFirefoxTraceJSSegmentId, segmentId) == 0) {
+    return;
+  }
+
+  sFirefoxTraceSentJSValues.Clear();
+  strncpy(sFirefoxTraceJSSegmentId, segmentId,
+          sizeof(sFirefoxTraceJSSegmentId) - 1);
+  sFirefoxTraceJSSegmentId[sizeof(sFirefoxTraceJSSegmentId) - 1] = '\0';
+  sFirefoxTraceJSEventCount.store(0, std::memory_order_relaxed);
+  sFirefoxTraceJSLimitSentinelWritten.store(false, std::memory_order_relaxed);
+  sFirefoxTraceJSDeepSuppressionNoticeWritten.store(false,
+                                                    std::memory_order_relaxed);
+  sFirefoxTraceOpcodeEventCount.store(0, std::memory_order_relaxed);
