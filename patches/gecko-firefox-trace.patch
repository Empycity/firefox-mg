+  void maybeWritePrimitiveMetadata(FILE* file, const char* valueType,
+                                   const char* preview, const char* role,
+                                   uint32_t argIndex,
+                                   const char* valuePath) {
+    if (!FirefoxTraceJSPrimitiveMetadataEnabled() || !preview || !preview[0]) {
+      return;
+    }
+
+    size_t valueSize = strlen(preview);
+    uint32_t minBytes = FirefoxTraceJSPrimitiveMetadataMinBytes();
+    if (valueSize < minBytes) {
+      return;
+    }
+
+    uint64_t valueSeq =
+        sFirefoxTraceNextJSValueId.fetch_add(1, std::memory_order_relaxed);
+    char valueId[128];
+    char sha256[65];
+    SprintfLiteral(valueId, "jsv_%d_%llu", getpid(),
+                   static_cast<unsigned long long>(valueSeq));
+    FirefoxTraceComputeSHA256Hex(preview, valueSize, sha256);
+    writeValueStoreMetadata(valueId, sha256, "", valueSize, false, role,
+                            argIndex, valuePath, preview, valueType);
+
+    fputs(",\"value_id\":", file);
+    FirefoxTraceWriteJsonString(file, valueId);
+    fputs(",\"value_store_path\":\"\"", file);
+    fputs(",\"sha256\":", file);
+    FirefoxTraceWriteJsonString(file, sha256);
+    fputs(",\"stored\":false", file);
+  }
