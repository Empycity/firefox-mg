+void FirefoxTraceWriteWorkerTraceSuppressed() {
+  static mozilla::Atomic<bool, mozilla::Relaxed>
+      sWorkerTraceSuppressionWritten(false);
+  if (!sWorkerTraceSuppressionWritten.compareExchange(false, true)) {
+    return;
+  }
+
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    return;
+  }
+  mkdir(logDir, 0755);
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-js-%d.jsonl", getpid());
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+  fprintf(file,
+          "{\"schema\":\"firefox_trace.event.v1\","
+          "\"type\":\"trace.suppressed\",\"ts_us\":%lld,"
+          "\"pid\":%d,\"module\":\"js\","
+          "\"reason\":\"worker_thread_ipc_unsupported\","
+          "\"scope\":\"worker\",\"note\":"
+          "\"worker JS trace events and artifacts require a dedicated "
+          "cross-thread queue\"}\n",
+          static_cast<long long>(PR_Now()), getpid());
+  fclose(file);
+}
