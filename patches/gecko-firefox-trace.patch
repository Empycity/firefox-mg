+bool FirefoxTraceScriptResourceEnvTruthy(const char* aName) {
+  const char* value = getenv(aName);
+  return value && value[0] && strcmp(value, "0") != 0 &&
+         strcmp(value, "false") != 0 && strcmp(value, "off") != 0;
+}
+
+const char* FirefoxTraceScriptResourceEnv(const char* aName,
+                                          const char* aFallbackName = nullptr) {
+  const char* value = getenv(aName);
+  if ((!value || !value[0]) && aFallbackName) {
+    value = getenv(aFallbackName);
+  }
+  return value;
+}
+
+bool FirefoxTraceScriptResourceEnabled() {
+  const char* enabled =
+      FirefoxTraceScriptResourceEnv("FIREFOX_TRACE_ENABLE", "TRACE_ENABLE");
+  if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) {
+    return false;
+  }
+  if (FirefoxTraceRuntimeActive && !FirefoxTraceRuntimeActive()) {
+    return false;
+  }
+  const char* scriptEnabled = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE", "TRACE_SCRIPT_RESOURCE");
+  return !scriptEnabled || !scriptEnabled[0] ||
+         (strcmp(scriptEnabled, "0") != 0 &&
+          strcmp(scriptEnabled, "false") != 0 &&
+         strcmp(scriptEnabled, "off") != 0);
+}
+
+bool FirefoxTraceScriptResourceURLIsWeb(nsIURI* aURI) {
+  if (!aURI) {
+    return false;
+  }
+  bool isHTTP = false;
+  bool isHTTPS = false;
+  Unused << aURI->SchemeIs("http", &isHTTP);
+  Unused << aURI->SchemeIs("https", &isHTTPS);
+  return isHTTP || isHTTPS;
+}
+
+bool FirefoxTraceScriptResourceURLIsChromeLike(nsIURI* aURI) {
+  if (!aURI) {
+    return false;
+  }
+  bool isChrome = false;
+  bool isResource = false;
+  bool isAbout = false;
+  bool isMozExtension = false;
+  Unused << aURI->SchemeIs("chrome", &isChrome);
+  Unused << aURI->SchemeIs("resource", &isResource);
+  Unused << aURI->SchemeIs("about", &isAbout);
+  Unused << aURI->SchemeIs("moz-extension", &isMozExtension);
+  return isChrome || isResource || isAbout || isMozExtension;
+}
+
+bool FirefoxTraceScriptResourceShouldRecord(
+    JS::loader::ScriptLoadRequest* aRequest, ScriptLoader* aScriptLoader) {
+  if (!FirefoxTraceScriptResourceEnabled() || !aRequest) {
+    return false;
+  }
+
+  const char* filter = FirefoxTraceScriptResourceEnv(
+      "FIREFOX_TRACE_SCRIPT_RESOURCE_FILTER",
+      "TRACE_SCRIPT_RESOURCE_FILTER");
+  if (!filter || !filter[0]) {
+    filter = "web";
+  }
+  if (!strcmp(filter, "all")) {
+    return true;
+  }
+  bool requestIsWeb = FirefoxTraceScriptResourceURLIsWeb(aRequest->mURI);
+  bool requestIsChrome =
+      FirefoxTraceScriptResourceURLIsChromeLike(aRequest->mURI);
+
+  bool pageIsWeb = false;
+  bool pageIsChrome = false;
+  if (aScriptLoader && aScriptLoader->GetDocument()) {
+    nsIURI* pageURI = aScriptLoader->GetDocument()->GetDocumentURI();
+    pageIsWeb = FirefoxTraceScriptResourceURLIsWeb(pageURI);
+    pageIsChrome = FirefoxTraceScriptResourceURLIsChromeLike(pageURI);
+  }
+
+  if (!strcmp(filter, "chrome")) {
+    return requestIsChrome || pageIsChrome;
+  }
+  if (!strcmp(filter, "web")) {
+    return requestIsWeb || pageIsWeb;
+  }
+  return requestIsWeb || pageIsWeb;
+}
+
+bool FirefoxTraceScriptResourceCaptureEnabled() {
+  return FirefoxTraceScriptResourceEnvTruthy("FIREFOX_TRACE_SCRIPT_RESOURCE_CAPTURE") ||
+         FirefoxTraceScriptResourceEnvTruthy("TRACE_SCRIPT_RESOURCE_CAPTURE") ||
+         FirefoxTraceScriptResourceEnvTruthy("FIREFOX_TRACE_SCRIPT_RESOURCE_STORE") ||
+         FirefoxTraceScriptResourceEnvTruthy("TRACE_SCRIPT_RESOURCE_STORE");
+}
