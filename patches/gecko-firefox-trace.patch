+        }
+      } else {
+        fputs(",\"script_hash_status\":", file);
+        FirefoxTraceWriteJsonString(file, scriptHashStatus_);
+      }
+      if (scriptSourceStatus_) {
+        fputs(",\"script_source_status\":", file);
