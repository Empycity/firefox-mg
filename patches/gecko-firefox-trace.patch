+void FirefoxTraceWriteRuntimeConfigReceipt(uint64_t aVersion,
+                                           const nsACString& aConfigHash,
+                                           bool aAckSent) {
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    return;
+  }
+  mkdir(logDir, 0755);
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.Append("firefox-control-receipts.jsonl");
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+  fprintf(file,
+          "{\"schema\":\"firefox_trace.event.v1\","
+          "\"type\":\"trace.config.received\",\"ts_us\":%lld,"
+          "\"control_version\":%llu,\"config_hash\":\"%s\","
+          "\"ack_sent\":%s}\n",
+          static_cast<long long>(PR_Now()),
+          static_cast<unsigned long long>(aVersion),
+          PromiseFlatCString(aConfigHash).get(), aAckSent ? "true" : "false");
+  fclose(file);
+}
