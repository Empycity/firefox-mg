+  if (XRE_IsContentProcess()) {
+#if defined(__APPLE__) || defined(__GNUC__)
+    if (FirefoxTraceSendEventToParent) {
+      nsCString line(aLine);
+      if (NS_IsMainThread()) {
+        Unused << FirefoxTraceSendEventToParent(line.BeginReading(),
+                                                line.Length());
+      } else {
+        NS_DispatchToMainThread(NS_NewRunnableFunction(
+            "FirefoxTraceFetchBodyChunk",
+            [line = std::move(line)]() {
+              if (FirefoxTraceSendEventToParent) {
+                Unused << FirefoxTraceSendEventToParent(line.BeginReading(),
+                                                        line.Length());
+              }
+            }));
+      }
+    }
+#endif
+    return;
+  }
+
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-fetch-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
