+         (strstr(aLine, "\"type\":\"js.call.enter\"") ||
+          strstr(aLine, "\"type\":\"js.call.return\"") ||
+          strstr(aLine, "\"type\":\"js.value.store\"") ||
+          strstr(aLine, "\"type\":\"js.random\""));
