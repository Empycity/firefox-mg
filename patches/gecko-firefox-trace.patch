+
+bool FirefoxTraceStorageIsChromeURL(const nsACString& aURL) {
+  return FirefoxTraceStorageURLStartsWith(aURL, "chrome://") ||
+         FirefoxTraceStorageURLStartsWith(aURL, "resource://") ||
+         FirefoxTraceStorageURLStartsWith(aURL, "about:");
+}
+
+bool FirefoxTraceStorageIsWebURL(const nsACString& aURL) {
+  return FirefoxTraceStorageURLStartsWith(aURL, "http://") ||
+         FirefoxTraceStorageURLStartsWith(aURL, "https://");
+}
+
+bool FirefoxTraceShouldRecordStorageContext(const nsACString& aPageURL,
+                                            const nsACString& aCallerURL) {
+  const char* filter = getenv("FIREFOX_TRACE_STORAGE_FILTER");
+  if (!filter || !filter[0]) {
+    filter = getenv("TRACE_STORAGE_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = getenv("FIREFOX_TRACE_DOM_FILTER");
+  }
+  if (!filter || !filter[0]) {
+    filter = "content";
+  }
+
+  if (strcmp(filter, "all") == 0) {
+    return true;
+  }
+
+  const nsACString& contextURL = !aPageURL.IsEmpty() ? aPageURL : aCallerURL;
+  if (strcmp(filter, "chrome") == 0) {
+    return FirefoxTraceStorageIsChromeURL(contextURL);
+  }
+
+  if (strcmp(filter, "web") == 0) {
+    return FirefoxTraceStorageIsWebURL(contextURL);
+  }
+
+  if (contextURL.IsEmpty() || FirefoxTraceStorageIsChromeURL(contextURL)) {
+    return false;
+  }
+
+  return true;
