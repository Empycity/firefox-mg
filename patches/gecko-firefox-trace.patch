+bool FirefoxTraceOpcodeBudgetAvailable(JSScript* aScript) {
+  if (!FirefoxTraceOpcodeScriptIdentityMatches(aScript)) {
+    return true;
+  }
+
+  if (FirefoxTraceEnvEnabledAlias("FIREFOX_TRACE_VM_WINDOW",
+                                  "TRACE_VM_WINDOW", false)) {
+    // VM-window work is bounded by its ring capacity and does no per-op IPC.
+    // Keep the selected script in the interpreter until the request trigger.
+    return true;
+  }
+
+  uint32_t limit = FirefoxTraceOpcodeExecutionLimit();
+  // A zero limit is an explicitly unbounded mode. Keep it behind the
+  // opt-in escape hatch; the normal VM UI and presets always use a finite
+  // execution budget so a hot loop can hand control back to JIT.
+  if (!limit) {
+    return FirefoxTraceUnsafeUnlimitedAllowed();
+  }
+  return sFirefoxTraceOpcodeExecutionCount.load(std::memory_order_relaxed) <
+         limit;
+}
+
+bool FirefoxTraceConsumeOpcodeExecutionBudget(JSScript* aScript) {
+  if (!FirefoxTraceOpcodeScriptIdentityMatches(aScript)) {
+    return true;
+  }
+
+  uint32_t limit = FirefoxTraceOpcodeExecutionLimit();
+  if (!limit) {
+    if (FirefoxTraceUnsafeUnlimitedAllowed()) {
+      return true;
+    }
+    FirefoxTraceWriteOpcodeExecutionLimitSentinel(0);
+    return false;
+  }
+
+  uint64_t index = sFirefoxTraceOpcodeExecutionCount.fetch_add(
+                       1, std::memory_order_relaxed) +
+                   1;
+  if (index > limit) {
+    FirefoxTraceWriteOpcodeExecutionLimitSentinel(limit);
+    return false;
+  }
+  return true;
+}
