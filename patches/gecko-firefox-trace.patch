+    }
+    return;
+  }
+
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-storage-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceStorageGetCaller(JSContext* aCx, nsACString& aCallerURL,
+                                  uint32_t* aLine, uint32_t* aColumn) {
+  *aLine = 0;
+  *aColumn = 0;
