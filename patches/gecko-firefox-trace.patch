+void FirefoxTraceWriteJSEventLine(const char* aLine, size_t aLen) {
+  if (FirefoxTraceShouldBufferJSBoundaryEvent(aLine)) {
+    FirefoxTraceBufferJSBoundaryEvent(aLine, aLen);
+    return;
