+void FirefoxTraceCookieAppendJsonCString(nsACString& aLine,
+                                         const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceCookieAppendJsonString(nsACString& aLine,
+                                        const nsACString& aValue) {
+  FirefoxTraceCookieAppendJsonCString(aLine, PromiseFlatCString(aValue).get());
+}
+
+void FirefoxTraceCookieTruncatePreview(nsACString& aPreview) {
+  uint32_t limit = 4096;
+  const char* configured = getenv("FIREFOX_TRACE_PREVIEW_LIMIT");
+  if (configured && configured[0]) {
+    char* end = nullptr;
+    unsigned long parsed = strtoul(configured, &end, 10);
+    if (end != configured && parsed > 0) {
+      limit = parsed > 65536 ? 65536 : static_cast<uint32_t>(parsed);
+    }
+  }
+  if (aPreview.Length() > limit) {
+    aPreview.Truncate(limit);
+    aPreview.AppendLiteral("...");
+  }
+}
+
+void FirefoxTraceCookieWriteLine(const nsACString& aLine) {
+  const char* logDir = getenv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = getenv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+#ifndef XP_WIN
+  mkdir(logDir, 0755);
+#endif
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-cookie-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceCookieHeaderName(const nsACString& aCookieHeader,
+                                  nsACString& aName) {
+  aName.Truncate();
+  nsACString::const_iterator start;
+  nsACString::const_iterator end;
+  aCookieHeader.BeginReading(start);
+  aCookieHeader.EndReading(end);
+
+  while (start != end && nsContentUtils::IsHTMLWhitespace(*start)) {
+    ++start;
+  }
+
+  nsACString::const_iterator cur = start;
+  while (cur != end && *cur != '=' && *cur != ';') {
+    ++cur;
+  }
+
+  nsACString::const_iterator trimmedEnd = cur;
+  while (trimmedEnd != start) {
+    nsACString::const_iterator prev = trimmedEnd;
+    --prev;
+    if (!nsContentUtils::IsHTMLWhitespace(*prev)) {
+      break;
+    }
+    trimmedEnd = prev;
+  }
+  aName.Assign(Substring(start, trimmedEnd));
+}
+
+void FirefoxTraceCookieURI(nsIURI* aURI, nsACString& aOut) {
+  aOut.Truncate();
+  if (aURI) {
+    mozilla::Unused << aURI->GetSpec(aOut);
+  }
+}
+
+void FirefoxTraceCookieChannelURI(nsIChannel* aChannel, nsACString& aOut) {
+  aOut.Truncate();
+  if (!aChannel) {
+    return;
+  }
+  nsCOMPtr<nsIURI> uri;
+  if (NS_SUCCEEDED(aChannel->GetURI(getter_AddRefs(uri)))) {
+    FirefoxTraceCookieURI(uri, aOut);
+  }
+}
+
+void FirefoxTraceCookieFinalURI(nsIChannel* aChannel, nsACString& aOut) {
+  aOut.Truncate();
+  if (!aChannel) {
+    return;
+  }
+  nsCOMPtr<nsIURI> uri;
+  if (NS_SUCCEEDED(NS_GetFinalChannelURI(aChannel, getter_AddRefs(uri)))) {
+    FirefoxTraceCookieURI(uri, aOut);
+  }
+}
+
+void FirefoxTraceHTTPSetCookieEvent(
+    const char* aOutcome, nsIURI* aHostURI, nsIChannel* aChannel,
+    const nsACString& aCookieHeader, const nsACString* aKey,
+    const nsACString* aValue, const nsACString* aDomain,
+    const nsACString* aPath, bool aSecure, bool aHttpOnly, bool aSession,
+    int64_t aExpiry, int32_t aSameSite, bool aPartitioned,
+    uint32_t aRejectedReason) {
+  if (!FirefoxTraceCookieEnabled()) {
+    return;
+  }
+
+  nsAutoCString hostURL;
+  FirefoxTraceCookieURI(aHostURI, hostURL);
+  nsAutoCString channelURL;
+  FirefoxTraceCookieChannelURI(aChannel, channelURL);
+  nsAutoCString finalURL;
+  FirefoxTraceCookieFinalURI(aChannel, finalURL);
+
+  nsAutoCString key;
+  if (aKey) {
+    key.Assign(*aKey);
+  } else {
+    FirefoxTraceCookieHeaderName(aCookieHeader, key);
+  }
+
+  nsAutoCString headerPreview(aCookieHeader);
+  FirefoxTraceCookieTruncatePreview(headerPreview);
+
+  nsAutoCString line;
+  line.AppendLiteral("{\"schema\":\"firefox_trace.cookie.v1\","
+                     "\"type\":\"cookie.http_set\",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"source\":\"http.set-cookie\",\"outcome\":");
+  FirefoxTraceCookieAppendJsonCString(line, aOutcome);
+  line.AppendLiteral(",\"from_http\":true");
+  if (!key.IsEmpty()) {
+    line.AppendLiteral(",\"key\":");
+    FirefoxTraceCookieAppendJsonString(line, key);
+  }
+  line.AppendLiteral(",\"header_preview\":");
+  FirefoxTraceCookieAppendJsonString(line, headerPreview);
+  if (aValue) {
+    nsAutoCString valuePreview(*aValue);
+    FirefoxTraceCookieTruncatePreview(valuePreview);
+    line.AppendLiteral(",\"value_preview\":");
+    FirefoxTraceCookieAppendJsonString(line, valuePreview);
+  }
+  if (aDomain) {
+    line.AppendLiteral(",\"domain\":");
+    FirefoxTraceCookieAppendJsonString(line, *aDomain);
+  }
+  if (aPath) {
+    line.AppendLiteral(",\"path\":");
+    FirefoxTraceCookieAppendJsonString(line, *aPath);
+  }
+  line.AppendLiteral(",\"secure\":");
+  line.Append(aSecure ? "true" : "false");
+  line.AppendLiteral(",\"http_only\":");
+  line.Append(aHttpOnly ? "true" : "false");
+  line.AppendLiteral(",\"session\":");
+  line.Append(aSession ? "true" : "false");
+  if (aExpiry >= 0) {
+    line.AppendLiteral(",\"expiry\":");
+    line.AppendInt(aExpiry);
+  }
+  line.AppendLiteral(",\"same_site\":");
+  line.AppendInt(aSameSite);
+  line.AppendLiteral(",\"partitioned\":");
+  line.Append(aPartitioned ? "true" : "false");
+  if (aRejectedReason) {
+    line.AppendLiteral(",\"rejected_reason\":");
+    line.AppendInt(static_cast<int64_t>(aRejectedReason));
+  }
+  line.AppendLiteral(",\"host_url\":");
+  FirefoxTraceCookieAppendJsonString(line, hostURL);
+  line.AppendLiteral(",\"channel_url\":");
+  FirefoxTraceCookieAppendJsonString(line, channelURL);
+  line.AppendLiteral(",\"final_url\":");
+  FirefoxTraceCookieAppendJsonString(line, finalURL);
+  line.Append('}');
+  FirefoxTraceCookieWriteLine(line);
+}
