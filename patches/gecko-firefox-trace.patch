+FirefoxTraceRuntimeState FirefoxTraceRuntimeStateCached() {
+  static int64_t sLastCheckUS = 0;
+  static FirefoxTraceRuntimeState sState = FirefoxTraceRuntimeStateActive;
+
+  if (sFirefoxTraceRuntimeConfigPushed) {
+    return sFirefoxTraceRuntimeStateFromIPC;
+  }
+
+  const char* path = PR_GetEnv("FIREFOX_TRACE_CONTROL_FILE");
+  if (!path || !path[0]) {
+    path = PR_GetEnv("TRACE_CONTROL_FILE");
+  }
+  if (!path || !path[0]) {
+    return FirefoxTraceRuntimeStateActive;
+  }
+
+  int64_t now = PR_Now();
+  if (sLastCheckUS && now - sLastCheckUS < 200000) {
+    return sState;
+  }
+  sLastCheckUS = now;
+
+  struct stat st;
+  if (stat(path, &st) != 0) {
+    sState = FirefoxTraceRuntimeStateActive;
+    return sState;
+  }
+  (void)st;
+  sState = FirefoxTraceReadRuntimeStateFromControlFile(path);
+  return sState;
+}
