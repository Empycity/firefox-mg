+void FirefoxTraceCookieHeaderName(const nsACString& aCookieHeader,
+                                  nsACString& aName) {
+  aName.Truncate();
+  nsACString::const_iterator start;
+  nsACString::const_iterator end;
+  aCookieHeader.BeginReading(start);
+  aCookieHeader.EndReading(end);
+
+  while (start != end && nsContentUtils::IsHTMLWhitespace(*start)) {
+    ++start;
+  }
+
+  nsACString::const_iterator cur = start;
+  while (cur != end && *cur != '=' && *cur != ';') {
+    ++cur;
+  }
+
+  nsACString::const_iterator trimmedEnd = cur;
+  while (trimmedEnd != start) {
+    nsACString::const_iterator prev = trimmedEnd;
+    --prev;
+    if (!nsContentUtils::IsHTMLWhitespace(*prev)) {
+      break;
+    }
+    trimmedEnd = prev;
+  }
+  aName.Assign(Substring(start, trimmedEnd));
