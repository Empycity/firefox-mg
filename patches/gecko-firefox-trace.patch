+void FirefoxTraceAppendJsonCString(nsACString& aLine, const char* aValue) {
+  aLine.Append('"');
+  if (aValue) {
+    for (const unsigned char* p =
+             reinterpret_cast<const unsigned char*>(aValue);
+         *p; ++p) {
+      switch (*p) {
+        case '"':
+          aLine.AppendLiteral("\\\"");
+          break;
+        case '\\':
+          aLine.AppendLiteral("\\\\");
+          break;
+        case '\b':
+          aLine.AppendLiteral("\\b");
+          break;
+        case '\f':
+          aLine.AppendLiteral("\\f");
+          break;
+        case '\n':
+          aLine.AppendLiteral("\\n");
+          break;
+        case '\r':
+          aLine.AppendLiteral("\\r");
+          break;
+        case '\t':
+          aLine.AppendLiteral("\\t");
+          break;
+        default:
+          if (*p < 0x20) {
+            aLine.AppendPrintf("\\u%04x", *p);
+          } else {
+            aLine.Append(*p);
+          }
+          break;
+      }
+    }
+  }
+  aLine.Append('"');
+}
+
+void FirefoxTraceAppendJsonBoolean(nsACString& aLine, bool aValue) {
+  if (aValue) {
+    aLine.AppendLiteral("true");
+  } else {
+    aLine.AppendLiteral("false");
+  }
+}
+
+void FirefoxTraceWriteLine(const nsACString& aLine) {
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+  mkdir(logDir, 0755);
+
+  nsAutoCString path(logDir);
+  if (!path.IsEmpty() && path.Last() != '/') {
+    path.Append('/');
+  }
+  path.AppendPrintf("firefox-dom-%d.jsonl", getpid());
+
+  FILE* file = fopen(path.get(), "a");
+  if (!file) {
+    return;
+  }
+
+  fwrite(aLine.BeginReading(), 1, aLine.Length(), file);
+  fputc('\n', file);
+  fclose(file);
+}
+
+void FirefoxTraceWriteDOMLineRaw(const nsACString& aLine) {
+  if (XRE_IsContentProcess()) {
+#if defined(__APPLE__) || defined(__GNUC__)
+    // WebIDL bindings also run on Dedicated/Shared/ServiceWorker threads.
+    // PContentChild is main-thread-owned, so direct Send* from a worker trips
+    // MessageChannel's thread assertion.  ContentChild provides a copying
+    // main-thread queue specifically for this trace transport.
+    if (FirefoxTraceQueueEventToParent &&
+        FirefoxTraceQueueEventToParent(aLine.BeginReading(), aLine.Length())) {
+      return;
+    }
+#endif
+    if (!NS_IsMainThread()) {
+      return;
+    }
+    if (ContentChild* child = ContentChild::GetSingleton()) {
+      Unused << child->SendFirefoxTraceDOMEvent(aLine);
+    }
+    return;
+  }
+
+  FirefoxTraceWriteLine(aLine);
+}
+
+bool FirefoxTraceDOMWriteValueStoreFile(const nsACString& aValue,
+                                        nsACString& aRelativePath) {
+  const char* logDir = PR_GetEnv("FIREFOX_TRACE_LOG_DIR");
+  if (!logDir || !logDir[0]) {
+    logDir = PR_GetEnv("TRACE_LOG_DIR");
+  }
+  if (!logDir || !logDir[0]) {
+    logDir = "/tmp/firefox-trace";
+  }
+
+  mkdir(logDir, 0755);
+  nsAutoCString valuesDir(logDir);
+  if (valuesDir.Last() != '/') {
+    valuesDir.Append('/');
+  }
+  valuesDir.AppendLiteral("values");
+  mkdir(valuesDir.get(), 0755);
+
+  const uint64_t sequence =
+      sFirefoxTraceDOMValueStoreSequence.fetch_add(1, std::memory_order_relaxed) + 1;
+  char valueId[96];
+  snprintf(valueId, sizeof(valueId), "dom_value_%d_%llu", getpid(),
+           static_cast<unsigned long long>(sequence));
+  aRelativePath.AppendPrintf("values/%s.txt", valueId);
+
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendValueToParent &&
+      FirefoxTraceSendValueToParent(valueId, "", aValue.BeginReading(),
+                                    aValue.Length())) {
+    return true;
+  }
+#endif
+
+  nsAutoCString path(logDir);
+  if (path.Last() != '/') {
+    path.Append('/');
+  }
+  path.Append(aRelativePath);
+  FILE* file = fopen(path.get(), "wb");
+  if (!file) {
+    aRelativePath.Truncate();
+    return false;
+  }
+  const size_t written =
+      fwrite(aValue.BeginReading(), 1, aValue.Length(), file);
+  fclose(file);
+  if (written != aValue.Length()) {
+    unlink(path.get());
+    aRelativePath.Truncate();
+    return false;
+  }
+  return true;
+}
+
+bool FirefoxTraceDOMFullStringValue(JSContext* aCx,
+                                    JS::Handle<JS::Value> aValue,
+                                    nsACString& aFullValue) {
+  if (!aValue.isString()) {
+    return false;
+  }
+  JS::Rooted<JSString*> string(aCx, aValue.toString());
+  JS::UniqueChars utf8 = JS_EncodeStringToUTF8(aCx, string);
+  if (!utf8) {
+    JS_ClearPendingException(aCx);
+    return false;
+  }
+  aFullValue.Assign(utf8.get());
+  return true;
+}
