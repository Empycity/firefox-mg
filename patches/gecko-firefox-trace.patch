+static std::atomic<uint64_t> sFirefoxTraceJSScriptDumped[4096];
+
+bool FirefoxTraceMarkJSScriptDumped(const char* scriptSha256) {
+  if (!scriptSha256 || !scriptSha256[0]) {
+    return false;
+  }
+
+  uint64_t key = FirefoxTraceHashCString(1469598103934665603ULL, scriptSha256);
+  if (!key) {
+    key = 1;
+  }
+  size_t bucketCount = sizeof(sFirefoxTraceJSScriptDumped) /
+                       sizeof(sFirefoxTraceJSScriptDumped[0]);
+  size_t start = static_cast<size_t>(key) % bucketCount;
+  for (size_t probe = 0; probe < bucketCount; probe++) {
+    std::atomic<uint64_t>& bucket =
+        sFirefoxTraceJSScriptDumped[(start + probe) % bucketCount];
+    uint64_t seen = bucket.load(std::memory_order_relaxed);
+    if (seen == key) {
+      return false;
+    }
+    uint64_t empty = 0;
+    if (seen == empty &&
+        bucket.compare_exchange_strong(empty, key,
+                                       std::memory_order_relaxed)) {
+      return true;
+    }
+  }
+  return false;
+}
