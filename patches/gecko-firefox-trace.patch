+bool FirefoxTraceConsumeEventBudget(size_t aBytes, uint64_t* aDroppedEvents,
+                                    uint64_t* aDroppedBytes) {
+  const uint64_t maxEvents = FirefoxTraceParseBudget(
+      "FIREFOX_TRACE_IPC_MAX_EVENTS_PER_SECOND",
+      "TRACE_IPC_MAX_EVENTS_PER_SECOND");
+  const uint64_t maxBytes = FirefoxTraceParseBudget(
+      "FIREFOX_TRACE_IPC_MAX_BYTES_PER_SECOND",
+      "TRACE_IPC_MAX_BYTES_PER_SECOND");
+  if (!maxEvents && !maxBytes) {
+    return true;
+  }
+
+  static int64_t sWindowStartUS = 0;
+  static uint64_t sEvents = 0;
+  static uint64_t sBytes = 0;
+  static uint64_t sDroppedEvents = 0;
+  static uint64_t sDroppedBytes = 0;
+  int64_t now = PR_Now();
+  if (!sWindowStartUS || now - sWindowStartUS >= PR_USEC_PER_SEC) {
+    sWindowStartUS = now;
+    sEvents = 0;
+    sBytes = 0;
+    sDroppedEvents = 0;
+    sDroppedBytes = 0;
+  }
+  if ((maxEvents && sEvents + 1 > maxEvents) ||
+      (maxBytes && sBytes + aBytes > maxBytes)) {
+    sDroppedEvents++;
+    sDroppedBytes += aBytes;
+    if (aDroppedEvents) {
+      *aDroppedEvents = sDroppedEvents;
+    }
+    if (aDroppedBytes) {
+      *aDroppedBytes = sDroppedBytes;
+    }
+    return false;
+  }
+  sEvents++;
+  sBytes += aBytes;
+  return true;
+}
