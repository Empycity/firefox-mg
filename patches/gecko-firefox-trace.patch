+
+// Match configured script/function/hash identity independently of the JS
+// capture mode. Boundary mode uses this only to decide whether it may expand
+// an object; target/deep modes also use it to select values and prune frames.
+bool FirefoxTraceMatchesConfiguredJSIdentity(const char* scriptUrl,
+                                             const char* functionName,
+                                             const char* scriptSha256,
+                                             bool scriptSha256Available) {
+  const char* scriptFilters =
+      FirefoxTraceEnv("FIREFOX_TRACE_JS_SCRIPT_CONTAINS",
+                      "TRACE_SCRIPT_CONTAINS");
+  const char* functionFilters =
+      FirefoxTraceEnv("FIREFOX_TRACE_JS_FUNCTION_CONTAINS",
+                      "TRACE_FUNCTION_CONTAINS");
+  const char* hashFilters =
+      FirefoxTraceEnv("FIREFOX_TRACE_JS_SCRIPT_SHA256", "TRACE_SCRIPT_SHA256");
+
+  bool hasScriptFilters = scriptFilters && scriptFilters[0];
+  bool hasFunctionFilters = functionFilters && functionFilters[0];
+  bool hasHashFilters = hashFilters && hashFilters[0];
+  bool scriptMatches = FirefoxTraceCSVMatches(scriptFilters, scriptUrl);
+  bool functionMatches = FirefoxTraceCSVMatches(functionFilters, functionName);
+  bool hashMatches = scriptSha256Available &&
+                     FirefoxTraceCSVMatches(hashFilters, scriptSha256);
+
+  bool hasAnyFilters =
+      hasScriptFilters || hasFunctionFilters || hasHashFilters;
+  bool allConfiguredFiltersMatch =
+      hasAnyFilters && (!hasScriptFilters || scriptMatches) &&
+      (!hasFunctionFilters || functionMatches) &&
+      (!hasHashFilters || hashMatches);
+  bool anyConfiguredFilterMatches =
+      (hasScriptFilters && scriptMatches) ||
+      (hasFunctionFilters && functionMatches) || (hasHashFilters && hashMatches);
+
+  const char* matchMode =
+      FirefoxTraceEnv("FIREFOX_TRACE_TARGET_MATCH", "TRACE_TARGET_MATCH");
+  if (matchMode && strcmp(matchMode, "any") == 0) {
+    return anyConfiguredFilterMatches;
+  }
+  if (matchMode && strcmp(matchMode, "all") == 0) {
+    return allConfiguredFiltersMatch;
+  }
+
+  // Default "auto": every configured dimension participates in narrowing. If
+  // only one dimension is configured this behaves like a single-condition
+  // match; if script/function/hash are combined, all configured filters must
+  // match.
+  return allConfiguredFiltersMatch;
+}
