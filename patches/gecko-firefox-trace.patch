+void FirefoxTraceApplyRuntimeConfigEnv() {
+  // Parent IPC supplies subsequent revisions. Keep direct file parsing only as
+  // a bootstrap fallback before the first control revision is installed.
+  if (FirefoxTraceEnv("TRACE_CONTROL_VERSION")) {
+    return;
+  }
+  static int64_t sLastCheckUS = 0;
+  struct timeval tv;
+  gettimeofday(&tv, nullptr);
+  int64_t now = static_cast<int64_t>(tv.tv_sec) * 1000000 + tv.tv_usec;
+  if (sLastCheckUS && now - sLastCheckUS < 200000) {
+    return;
+  }
+  sLastCheckUS = now;
+
+  const char* path = FirefoxTraceEnv("FIREFOX_TRACE_CONTROL_FILE",
+                                     "TRACE_CONTROL_FILE");
+  if (!path || !path[0]) {
+    return;
+  }
+
+  FILE* file = fopen(path, "rb");
+  if (!file) {
+    return;
+  }
+  char buffer[65537];
+  size_t len = fread(buffer, 1, sizeof(buffer) - 1, file);
+  fclose(file);
+  buffer[len] = '\0';
+
+  auto applyTopLevelString = [](char* aBuffer, const char* aJsonKey,
+                                const char* aEnvKey) {
+    char pattern[96];
+    snprintf(pattern, sizeof(pattern), "\"%s\"", aJsonKey);
+    char* p = strstr(aBuffer, pattern);
+    if (!p) {
+      return;
+    }
+    p = strchr(p, ':');
+    if (!p) {
+      return;
+    }
+    p++;
+    while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t') {
+      p++;
+    }
+    if (*p != '"') {
+      return;
+    }
+    p++;
+    char* start = p;
+    while (*p && *p != '"') {
+      p++;
+    }
+    if (!*p) {
+      return;
+    }
+    char value[512];
+    size_t valueLen = std::min<size_t>(p - start, sizeof(value) - 1);
+    memcpy(value, start, valueLen);
+    value[valueLen] = '\0';
+    if (value[0]) {
+      setenv(aEnvKey, value, 1);
+    }
+  };
+
+  auto applyTopLevelUint = [](char* aBuffer, const char* aJsonKey,
+                              const char* aEnvKey) {
+    char pattern[96];
+    snprintf(pattern, sizeof(pattern), "\"%s\"", aJsonKey);
+    char* p = strstr(aBuffer, pattern);
+    if (!p) {
+      return;
+    }
+    p = strchr(p, ':');
+    if (!p) {
+      return;
+    }
+    p++;
+    while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t') {
+      p++;
+    }
+    char value[32];
+    size_t valueLen = 0;
+    while (*p >= '0' && *p <= '9' && valueLen + 1 < sizeof(value)) {
+      value[valueLen++] = *p++;
+    }
+    value[valueLen] = '\0';
+    if (value[0]) {
+      setenv(aEnvKey, value, 1);
+    }
+  };
+
+  char* env = strstr(buffer, "\"env\"");
+  if (env) {
+    char* p = strchr(env, '{');
+    char* end = p ? strchr(p, '}') : nullptr;
+    if (p && end) {
+      p++;
+      while (p < end) {
+        while (p < end && (*p == ' ' || *p == '\n' || *p == '\r' ||
+                           *p == '\t' || *p == ',')) {
+          p++;
+        }
+        if (p >= end || *p != '"') {
+          break;
+        }
+        p++;
+        char* keyStart = p;
+        while (p < end && *p != '"') {
+          p++;
+        }
+        if (p >= end) {
+          break;
+        }
+        char key[256];
+        size_t keyLen = std::min<size_t>(p - keyStart, sizeof(key) - 1);
+        memcpy(key, keyStart, keyLen);
+        key[keyLen] = '\0';
+        p++;
+        while (p < end && *p != ':') {
+          p++;
+        }
+        if (p >= end) {
+          break;
+        }
+        p++;
+        while (p < end && (*p == ' ' || *p == '\n' || *p == '\r' ||
+                           *p == '\t')) {
+          p++;
+        }
+        char value[2048];
+        size_t valueLen = 0;
+        if (p < end && *p == '"') {
+          p++;
+          char* valueStart = p;
+          while (p < end && *p != '"') {
+            p++;
+          }
+          valueLen = std::min<size_t>(p - valueStart, sizeof(value) - 1);
+          memcpy(value, valueStart, valueLen);
+          if (p < end) {
+            p++;
+          }
+        } else {
+          char* valueStart = p;
+          while (p < end && *p != ',' && *p != '}') {
+            p++;
+          }
+          valueLen = std::min<size_t>(p - valueStart, sizeof(value) - 1);
+          memcpy(value, valueStart, valueLen);
+          while (valueLen && (value[valueLen - 1] == ' ' ||
+                              value[valueLen - 1] == '\n' ||
+                              value[valueLen - 1] == '\r' ||
+                              value[valueLen - 1] == '\t')) {
+            valueLen--;
+          }
+        }
+        value[valueLen] = '\0';
+        if ((strncmp(key, "TRACE_", 6) == 0 ||
+             strncmp(key, "FIREFOX_TRACE_", 14) == 0) &&
+            value[0]) {
+          setenv(key, value, 1);
+        }
+      }
+    }
+  }
+
+  applyTopLevelString(buffer, "segment_id", "TRACE_SEGMENT_ID");
+  applyTopLevelString(buffer, "segment_label", "TRACE_SEGMENT_LABEL");
+  applyTopLevelString(buffer, "config_hash", "TRACE_CONFIG_HASH");
+  applyTopLevelUint(buffer, "version", "TRACE_CONTROL_VERSION");
+}
