+void FirefoxTraceFetchAppendResponseHeaders(nsACString& aLine,
+                                            InternalResponse& aResponse) {
+  const char* mode = FirefoxTraceFetchResponseHeadersMode();
+  if (!FirefoxTraceFetchResponseHeadersEnabled()) {
+    aLine.AppendLiteral(",\"headers_enabled\":false");
+    return;
+  }
+
+  nsTArray<InternalHeaders::Entry> entries;
+  aResponse.Headers()->GetEntries(entries);
+
+  const char* names = getenv("FIREFOX_TRACE_FETCH_RESPONSE_HEADER_NAMES");
+  if (!names || !names[0]) {
+    names = getenv("TRACE_FETCH_RESPONSE_HEADER_NAMES");
+  }
+
+  uint32_t maxCount = FirefoxTraceFetchResponseHeadersMaxCount();
+  uint32_t valueMax = FirefoxTraceFetchResponseHeaderValueMaxBytes();
+  bool full = !strcmp(mode, "full");
+  bool truncated = false;
+  uint32_t emitted = 0;
+
+  aLine.AppendLiteral(",\"headers_enabled\":true,\"headers_mode\":");
+  FirefoxTraceFetchAppendJsonCString(aLine, mode);
+  aLine.AppendLiteral(",\"headers\":{");
+  bool first = true;
+  for (const auto& entry : entries) {
+    if (names && names[0] &&
+        !FirefoxTraceFetchContainsToken(names, entry.mName.get())) {
+      continue;
+    }
+    if (emitted >= maxCount) {
+      truncated = true;
+      break;
+    }
+
+    nsAutoCString value(entry.mValue);
+    bool valueTruncated = false;
+    if ((!full || value.Length() > valueMax) && value.Length() > valueMax) {
+      value.Truncate(valueMax);
+      value.AppendLiteral("...");
+      valueTruncated = true;
+    }
+
+    if (!first) {
+      aLine.Append(',');
+    }
+    first = false;
+    FirefoxTraceFetchAppendJsonString(aLine, entry.mName);
+    aLine.AppendLiteral(":{\"value\":");
+    FirefoxTraceFetchAppendJsonString(aLine, value);
+    if (valueTruncated) {
+      aLine.AppendLiteral(",\"truncated\":true");
+    }
+    aLine.Append('}');
+    emitted++;
+  }
+  aLine.Append('}');
+  aLine.AppendLiteral(",\"headers_count\":");
+  aLine.AppendInt(emitted);
+  aLine.AppendLiteral(",\"headers_truncated\":");
+  aLine.Append(truncated ? "true" : "false");
+}
