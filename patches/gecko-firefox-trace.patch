+    FirefoxTraceWriteJSEventLineRaw(line, static_cast<size_t>(len));
+  }
+}
+
+void FirefoxTraceWriteJSEventLine(const char* aLine, size_t aLen) {
+  FirefoxTraceRefreshJSSegmentState();
+
+  if (FirefoxTraceJSFullSpoolEnabled() &&
+      FirefoxTraceShouldBufferJSBoundaryEvent(aLine)) {
+    FirefoxTraceQueueJSBatchEvent(aLine, aLen);
+    return;
+  }
+  if (FirefoxTraceShouldBufferJSBoundaryEvent(aLine)) {
+    FirefoxTraceBufferJSBoundaryEvent(aLine, aLen);
+    return;
+  }
+
+  uint64_t limit = FirefoxTraceJSLimitEvents();
+  if (limit) {
+    uint64_t eventIndex =
+        sFirefoxTraceJSEventCount.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (eventIndex > limit) {
+      FirefoxTraceWriteJSLimitSentinel(limit);
+      return;
+    }
+  }
+
+  FirefoxTraceWriteJSEventLineRaw(aLine, aLen);
+}
