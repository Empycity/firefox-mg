+void XMLHttpRequestMainThread::FirefoxTraceXHRDone(nsresult aStatus) {
+  if (!FirefoxTraceXHREnabled()) {
+    return;
+  }
+
+  nsAutoCString statusValue;
+  statusValue.AppendPrintf("0x%08x", static_cast<uint32_t>(aStatus));
+  if (!FirefoxTraceXHREvent("xhr.done", nullptr, &statusValue)) {
+    return;
+  }
+
+  IgnoredErrorResult rv;
+  uint32_t httpStatus = GetStatus(rv);
+  if (!FirefoxTraceXHREventKindEnabled("xhr.response")) {
+    return;
+  }
+
+  nsAutoCString responseURL;
+  GetResponseURL(responseURL);
+  nsAutoCString responseKind;
+  FirefoxTraceXHRResponseTypeName(mResponseType, responseKind);
+  nsAutoCString responsePreview;
+  nsAutoCString responseBody;
+  bool responseTextAvailable = false;
+  bool responsePreviewEnabled = FirefoxTraceXHRPreviewKindEnabled("response");
+  bool textResponseType = mResponseType == XMLHttpRequestResponseType::_empty ||
+                          mResponseType == XMLHttpRequestResponseType::Text ||
+                          mResponseType == XMLHttpRequestResponseType::Json;
+  if ((responsePreviewEnabled || FirefoxTraceXHRResponseBodyEnabled()) &&
+      textResponseType) {
+    nsAutoString responseText;
+    if (mResponseText.GetAsString(responseText)) {
+      CopyUTF16toUTF8(responseText, responseBody);
+      responseTextAvailable = true;
+      if (responsePreviewEnabled) {
+        responsePreview.Assign(responseBody);
+        FirefoxTraceTruncatePreview(responsePreview);
+      }
+    }
+  }
+
+  nsAutoCString line;
+  line.AppendLiteral(
+      "{\"schema\":\"firefox_trace.xhr.v1\",\"type\":\"xhr.response\"");
+  line.AppendLiteral(",\"ts_us\":");
+  line.AppendInt(static_cast<int64_t>(PR_Now()));
+  line.AppendLiteral(",\"pid\":");
+  line.AppendInt(static_cast<int64_t>(getpid()));
+  line.AppendLiteral(",\"request_id\":\"xhr_");
+  line.AppendInt(static_cast<uint64_t>(mFirefoxTraceXHRId));
+  line.AppendLiteral("\",\"status\":");
+  line.AppendInt(httpStatus);
+  FirefoxTraceAppendXHRWorkerContext(line);
+  FirefoxTraceAppendRequestURLField(line, "response_url", responseURL);
+  line.AppendLiteral(",\"response_type\":");
+  FirefoxTraceAppendJsonString(line, responseKind);
+  if (responsePreviewEnabled) {
+    line.AppendLiteral(",\"response_preview\":");
+    FirefoxTraceAppendJsonString(line, responsePreview);
+  } else {
+    line.AppendLiteral(",\"response_preview_enabled\":false");
+  }
+  if (FirefoxTraceXHRResponseBodyEnabled()) {
+    line.AppendLiteral(",\"response_body_mode\":");
+    FirefoxTraceAppendJsonCString(line, FirefoxTraceXHRResponseBodyMode());
+    if (!textResponseType) {
+      line.AppendLiteral(",\"response_body_skipped\":\"unsupported_response_type\"");
+    } else if (!responseTextAvailable) {
+      line.AppendLiteral(",\"response_body_skipped\":\"response_text_unavailable\"");
+    } else {
+      const nsCString flatBody(PromiseFlatCString(responseBody));
+      char sha256[65];
+      FirefoxTraceComputeSHA256Hex(flatBody.get(), flatBody.Length(), sha256);
+      line.AppendLiteral(",\"response_body_size\":");
+      line.AppendInt(static_cast<uint64_t>(flatBody.Length()));
+      line.AppendLiteral(",\"response_body_sha256\":");
+      FirefoxTraceAppendJsonCString(line, sha256);
+      if (FirefoxTraceXHRResponseBodyStoreEnabled()) {
+        uint32_t storeMax = FirefoxTraceXHRResponseBodyStoreMaxBytes();
+        bool tooLarge = flatBody.Length() > storeMax;
+        char valueId[128] = "";
+        char relPath[512] = "";
+        bool stored =
+            !tooLarge &&
+            FirefoxTraceWriteXHRResponseBodyStoreFile(
+                responseBody, sha256, valueId, sizeof(valueId), relPath,
+                sizeof(relPath));
+        line.AppendLiteral(",\"response_body_value_id\":");
+        FirefoxTraceAppendJsonCString(line, valueId);
+        line.AppendLiteral(",\"response_body_store_path\":");
+        FirefoxTraceAppendJsonCString(line, stored ? relPath : "");
+        line.AppendLiteral(",\"response_body_stored\":");
+        line.Append(stored ? "true" : "false");
+        line.AppendLiteral(",\"response_body_truncated\":");
+        line.Append(tooLarge ? "true" : "false");
+        if (tooLarge) {
+          line.AppendLiteral(",\"response_body_store_limit\":");
+          line.AppendInt(static_cast<uint64_t>(storeMax));
+        }
+      }
+    }
+  }
+  line.Append('}');
+  FirefoxTraceWriteXHRLine(line);
+}
