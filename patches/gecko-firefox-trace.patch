+void FirefoxTraceWriteJSLimitSentinel(uint64_t aLimit) {
+  bool expected = false;
+  if (!sFirefoxTraceJSLimitSentinelWritten.compare_exchange_strong(expected,
+                                                                    true)) {
+    return;
+  }
+
+  char line[512];
+  int len = SprintfLiteral(
+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"trace.degraded\","
+      "\"ts_us\":%llu,\"pid\":%d,\"module\":\"js\",\"reason\":\"event_limit\","
+      "\"limit\":%llu}\n",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+      static_cast<unsigned long long>(aLimit));
