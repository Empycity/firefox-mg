+// Sink-time artifacts already run outside the JS call hot path.  Write them
+// into the shared trace directory directly instead of scheduling thousands of
+// individually serialized parent-process IPC messages.
+bool FirefoxTraceWriteJSValueStoreFileDirect(const char* valueId,
+                                             const char* artifactKey,
+                                             const char* data, size_t len,
+                                             char* relPath,
+                                             size_t relPathLen) {
+  if (!FirefoxTraceBaseEnabled() || !valueId || !artifactKey || !data ||
+      !relPath || !relPathLen) {
+    return false;
+  }
+  const char* logDir = FirefoxTraceLogDir();
+  mkdir(logDir, 0755);
+  char valuesDir[4096];
+  SprintfLiteral(valuesDir, "%s/values", logDir);
+  mkdir(valuesDir, 0755);
+  snprintf(relPath, relPathLen, "values/%s.txt", artifactKey);
+  char path[4096];
+  SprintfLiteral(path, "%s/%s", logDir, relPath);
+  FILE* file = fopen(path, "wb");
+  if (!file) {
+    return false;
+  }
+  size_t written = fwrite(data, 1, len, file);
+  fclose(file);
+  return written == len;
+}
