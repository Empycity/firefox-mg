+// Math.random is normally inlined by CacheIR and never crosses the regular
+// scripted-call hook.  In full spool mode CacheIR falls back to math_random(),
+// which calls here with the exact double returned to page code.  Queue it with
+// the same async JS batch so random replay evidence has no hot-path file I/O.
+extern "C" void FirefoxTraceRecordMathRandom(double aValue) {
+  if (!FirefoxTraceJSFullSpoolEnabled()) {
+    return;
+  }
+
+  uint64_t sequence = sFirefoxTraceNextJSRandomSequence.fetch_add(
+      1, std::memory_order_relaxed);
+  char line[512];
+  int len = SprintfLiteral(
+      line,
+      "{\"schema\":\"firefox_trace.event.v1\",\"type\":\"js.random\","
+      "\"ts_us\":%llu,\"pid\":%d,\"call_id\":\"call_%llu\","
+      "\"sequence\":%llu,\"value\":%.17g}\n",
+      static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+      static_cast<unsigned long long>(FirefoxTraceCurrentJSCallId()),
+      static_cast<unsigned long long>(sequence), aValue);
+  if (len > 0 && static_cast<size_t>(len) < sizeof(line)) {
+    FirefoxTraceWriteJSEventLine(line, static_cast<size_t>(len));
+  }
+}
