+enum FirefoxTraceVMValueType : uint8_t {
+  FirefoxTraceVMValueUnknown = 0,
+  FirefoxTraceVMValueUndefined = 1,
+  FirefoxTraceVMValueNull = 2,
+  FirefoxTraceVMValueBoolean = 3,
+  FirefoxTraceVMValueInt32 = 4,
+  FirefoxTraceVMValueDouble = 5,
+  FirefoxTraceVMValueString = 6,
+  FirefoxTraceVMValueObject = 7,
+  FirefoxTraceVMValueBigInt = 8,
+  FirefoxTraceVMValueSymbol = 9,
+  FirefoxTraceVMValueMagic = 10,
+};
+
+uint8_t FirefoxTraceVMWindowCaptureValue(const Value& aValue,
+                                         uint64_t* aPayload,
+                                         bool* aHasPayload) {
+  *aPayload = 0;
+  *aHasPayload = false;
+  if (aValue.isUndefined()) {
+    return FirefoxTraceVMValueUndefined;
+  }
+  if (aValue.isNull()) {
+    return FirefoxTraceVMValueNull;
+  }
+  if (aValue.isBoolean()) {
+    *aPayload = aValue.toBoolean() ? 1 : 0;
+    *aHasPayload = true;
+    return FirefoxTraceVMValueBoolean;
+  }
+  if (aValue.isInt32()) {
+    *aPayload = static_cast<uint64_t>(static_cast<int64_t>(aValue.toInt32()));
+    *aHasPayload = true;
+    return FirefoxTraceVMValueInt32;
+  }
+  if (aValue.isDouble()) {
+    double number = aValue.toDouble();
+    memcpy(aPayload, &number, sizeof(number));
+    *aHasPayload = true;
+    return FirefoxTraceVMValueDouble;
+  }
+  if (aValue.isString()) {
+    return FirefoxTraceVMValueString;
+  }
+  if (aValue.isObject()) {
+    return FirefoxTraceVMValueObject;
+  }
+  if (aValue.isBigInt()) {
+    return FirefoxTraceVMValueBigInt;
+  }
+  if (aValue.isSymbol()) {
+    return FirefoxTraceVMValueSymbol;
+  }
+  if (aValue.isMagic()) {
+    return FirefoxTraceVMValueMagic;
+  }
+  return FirefoxTraceVMValueUnknown;
+}
+
+bool FirefoxTraceEnsureVMWindow(JSScript* aScript) {
+  uint32_t requested = FirefoxTraceVMWindowRequestedCapacity();
+  if (!requested) {
+    return false;
+  }
+  if (!sFirefoxTraceVMWindow || sFirefoxTraceVMWindowCapacity != requested) {
+    void* memory = realloc(
+        sFirefoxTraceVMWindow,
+        static_cast<size_t>(requested) * sizeof(FirefoxTraceVMWindowRecord));
+    if (!memory) {
+      return false;
+    }
+    sFirefoxTraceVMWindow =
+        static_cast<FirefoxTraceVMWindowRecord*>(memory);
+    sFirefoxTraceVMWindowCapacity = requested;
+    sFirefoxTraceVMWindowWritten = 0;
+    sFirefoxTraceVMWindowOverwritten = 0;
+  }
+
+  const char* scriptURL = aScript && aScript->filename() ? aScript->filename() : "";
+  uint32_t line = aScript ? aScript->lineno() : 0;
+  uint32_t column = aScript ? aScript->column().oneOriginValue() : 0;
+  size_t length = aScript ? aScript->length() : 0;
+  // One target execution commonly crosses many function JSScripts. Keep one
+  // continuous ring and attach the current script identity to every record.
+  strncpy(sFirefoxTraceVMWindowScriptURL, scriptURL,
+          sizeof(sFirefoxTraceVMWindowScriptURL) - 1);
+  sFirefoxTraceVMWindowScriptURL[sizeof(sFirefoxTraceVMWindowScriptURL) - 1] =
+      '\0';
+  sFirefoxTraceVMWindowScriptLine = line;
+  sFirefoxTraceVMWindowScriptColumn = column;
+  sFirefoxTraceVMWindowScriptLength = length;
+  if (!sFirefoxTraceVMWindowBeginWritten) {
+    sFirefoxTraceVMWindowBeginWritten = true;
+    char* buffer = nullptr;
+    size_t bufferSize = 0;
+    FILE* line = open_memstream(&buffer, &bufferSize);
+    if (line) {
+      fprintf(line,
+              "{\"schema\":\"firefox_trace.vm_window.v1\","
+              "\"type\":\"js.vm_window.begin\",\"ts_us\":%llu,"
+              "\"pid\":%d,\"capacity\":%u,\"record_size\":%zu,"
+              "\"script_url\":",
+              static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid(),
+              sFirefoxTraceVMWindowCapacity,
+              sizeof(FirefoxTraceVMWindowRecord));
+      FirefoxTraceWriteJsonString(line, sFirefoxTraceVMWindowScriptURL);
+      fputs("}\n", line);
+      fclose(line);
+      FirefoxTraceWriteJSEventLineRaw(buffer, bufferSize);
+      free(buffer);
+    }
+  }
+  return true;
+}
+
+void FirefoxTraceAppendVMWindowRecord(JSScript* aScript, jsbytecode* aPC,
+                                      uint64_t aPCOffset,
+                                      const InterpreterRegs& aRegs) {
+  if (!FirefoxTraceEnsureVMWindow(aScript)) {
+    return;
+  }
+  uint64_t seq = ++sFirefoxTraceVMWindowWritten;
+  if (seq > sFirefoxTraceVMWindowCapacity) {
+    ++sFirefoxTraceVMWindowOverwritten;
+  }
+  FirefoxTraceVMWindowRecord& record =
+      sFirefoxTraceVMWindow[(seq - 1) % sFirefoxTraceVMWindowCapacity];
+  record = FirefoxTraceVMWindowRecord();
+  record.seq = seq;
+  record.tsUS = FirefoxTraceNowUS();
+  record.originCallId = FirefoxTraceCurrentJSCallId();
+  record.pc = aPCOffset;
+  JSOp op = JSOp(*aPC);
+  record.op = static_cast<uint32_t>(uint8_t(op));
+  record.bytecodeLength = GetBytecodeLength(aPC);
+  record.stackDepth = aRegs.stackDepth();
+  record.operandLength = static_cast<uint8_t>(
+      std::min<unsigned>(record.bytecodeLength > 0 ? record.bytecodeLength - 1
+                                                   : 0,
+                         sizeof(record.operands)));
+  if (record.operandLength) {
+    memcpy(record.operands, aPC + 1, record.operandLength);
+  }
+  uint32_t stackCount = std::min<uint32_t>(2, aRegs.stackDepth());
+  if (stackCount >= 1) {
+    bool hasPayload = false;
+    record.stackType0 = FirefoxTraceVMWindowCaptureValue(
+        aRegs.sp[-1], &record.stackValue0, &hasPayload);
+    if (hasPayload) {
+      record.stackFlags |= 1;
+    }
+  }
+  if (stackCount >= 2) {
+    bool hasPayload = false;
+    record.stackType1 = FirefoxTraceVMWindowCaptureValue(
+        aRegs.sp[-2], &record.stackValue1, &hasPayload);
+    if (hasPayload) {
+      record.stackFlags |= 2;
+    }
+  }
+}
+
+extern "C" void FirefoxTraceTriggerVMWindow(const char* aReason) {
+  bool enabled = FirefoxTraceVMWindowEnabled();
+  if (!enabled) {
+    return;
+  }
+  const char* segmentId = FirefoxTraceEnv("FIREFOX_TRACE_SEGMENT_ID",
+                                          "TRACE_SEGMENT_ID");
+  if (!segmentId || !segmentId[0]) {
+    segmentId = "__process__";
+  }
+  if (sFirefoxTraceVMWindowFlushedSegmentId[0] &&
+      strcmp(sFirefoxTraceVMWindowFlushedSegmentId, segmentId) == 0) {
+    return;
+  }
+  if (!sFirefoxTraceVMWindow || !sFirefoxTraceVMWindowWritten ||
+      !sFirefoxTraceVMWindowCapacity) {
+    char line[512];
+    int len = SprintfLiteral(
+        line,
+        "{\"schema\":\"firefox_trace.event.v1\","
+        "\"type\":\"trace.degraded\",\"ts_us\":%llu,\"pid\":%d,"
+        "\"module\":\"vm_window\","
+        "\"reason\":\"target_trigger_without_records\"}\n",
+        static_cast<unsigned long long>(FirefoxTraceNowUS()), getpid());
+    if (len > 0) {
+      FirefoxTraceWriteJSEventLineRaw(line, static_cast<size_t>(len));
+    }
+    return;
+  }
+  uint64_t flushIndex = ++sFirefoxTraceVMWindowFlushIndex;
+  char fileName[256];
+  SprintfLiteral(fileName, "firefox-vm-window-%d-%p-%llu.bin", getpid(),
+                 PR_GetCurrentThread(),
+                 static_cast<unsigned long long>(flushIndex));
+
+  uint32_t count = static_cast<uint32_t>(std::min<uint64_t>(
+      sFirefoxTraceVMWindowWritten, sFirefoxTraceVMWindowCapacity));
+  uint64_t firstSeq = sFirefoxTraceVMWindowWritten - count + 1;
+  uint32_t firstIndex = static_cast<uint32_t>(
+      (firstSeq - 1) % sFirefoxTraceVMWindowCapacity);
+  FirefoxTraceVMWindowHeader header;
+  memcpy(header.magic, "FTVMW1\0", 7);
+  header.firstSeq = firstSeq;
+  header.lastSeq = sFirefoxTraceVMWindowWritten;
+  header.totalWritten = sFirefoxTraceVMWindowWritten;
+  header.overwritten = sFirefoxTraceVMWindowOverwritten;
+  header.capacity = sFirefoxTraceVMWindowCapacity;
+  header.count = count;
+  header.triggerTsUS = FirefoxTraceNowUS();
+  size_t artifactSize = sizeof(header) +
+                        static_cast<size_t>(count) *
+                            sizeof(FirefoxTraceVMWindowRecord);
+  char* artifact = static_cast<char*>(malloc(artifactSize));
+  if (!artifact) {
+    return;
+  }
+  memcpy(artifact, &header, sizeof(header));
+  uint32_t firstCount =
+      std::min<uint32_t>(count, sFirefoxTraceVMWindowCapacity - firstIndex);
+  memcpy(artifact + sizeof(header), &sFirefoxTraceVMWindow[firstIndex],
+         static_cast<size_t>(firstCount) *
+             sizeof(FirefoxTraceVMWindowRecord));
+  uint32_t secondCount = count - firstCount;
+  if (secondCount) {
+    memcpy(artifact + sizeof(header) +
+               static_cast<size_t>(firstCount) *
+                   sizeof(FirefoxTraceVMWindowRecord),
+           sFirefoxTraceVMWindow,
+           static_cast<size_t>(secondCount) *
+               sizeof(FirefoxTraceVMWindowRecord));
+  }
+
+  bool wrote = false;
+#if defined(__APPLE__) || defined(__GNUC__)
+  if (FirefoxTraceSendVMWindowArtifactToParent) {
+    wrote = FirefoxTraceSendVMWindowArtifactToParent(fileName, artifact,
+                                                     artifactSize);
+  }
+#endif
+  if (!wrote) {
+    const char* logDir =
+        FirefoxTraceEnv("FIREFOX_TRACE_LOG_DIR", "TRACE_LOG_DIR");
+    if (logDir && logDir[0]) {
+      mkdir(logDir, 0755);
+      char path[2048];
+      SprintfLiteral(path, "%s/%s", logDir, fileName);
+      FILE* file = fopen(path, "wb");
+      if (file) {
+        wrote = fwrite(artifact, 1, artifactSize, file) == artifactSize;
+        fclose(file);
+        if (!wrote) {
+          unlink(path);
+        }
+      }
+    }
+  }
+  free(artifact);
+  if (!wrote) {
+    return;
+  }
+  strncpy(sFirefoxTraceVMWindowFlushedSegmentId, segmentId,
+          sizeof(sFirefoxTraceVMWindowFlushedSegmentId) - 1);
+  sFirefoxTraceVMWindowFlushedSegmentId
+      [sizeof(sFirefoxTraceVMWindowFlushedSegmentId) - 1] = '\0';
+
+  char* lineBuffer = nullptr;
+  size_t lineSize = 0;
+  FILE* line = open_memstream(&lineBuffer, &lineSize);
+  if (line) {
+    fprintf(line,
+            "{\"schema\":\"firefox_trace.vm_window.v1\","
+            "\"type\":\"js.vm_window\",\"ts_us\":%llu,\"pid\":%d,"
+            "\"trigger_reason\":",
+            static_cast<unsigned long long>(header.triggerTsUS), getpid());
+    FirefoxTraceWriteJsonString(line, aReason ? aReason : "target-field");
+    fputs(",\"artifact_path\":", line);
+    FirefoxTraceWriteJsonString(line, fileName);
+    fprintf(line,
+            ",\"format\":\"ftvmw1-le\",\"record_size\":%zu,"
+            "\"first_seq\":%llu,\"last_seq\":%llu,\"record_count\":%u,"
+            "\"capacity\":%u,\"pretrigger_overwritten\":%llu,"
+            "\"retained_window_complete\":true,\"script_url\":",
+            sizeof(FirefoxTraceVMWindowRecord),
+            static_cast<unsigned long long>(header.firstSeq),
+            static_cast<unsigned long long>(header.lastSeq), count,
+            header.capacity,
+            static_cast<unsigned long long>(header.overwritten));
+    FirefoxTraceWriteJsonString(line, sFirefoxTraceVMWindowScriptURL);
+    fprintf(line,
+            ",\"script_line\":%u,\"script_column\":%u,"
+            "\"script_bytecode_length\":%zu,\"origin_call_id\":",
+            sFirefoxTraceVMWindowScriptLine,
+            sFirefoxTraceVMWindowScriptColumn,
+            sFirefoxTraceVMWindowScriptLength);
+    uint64_t originCallId = FirefoxTraceCurrentJSCallId();
+    if (originCallId) {
+      fprintf(line, "\"call_%llu\"",
+              static_cast<unsigned long long>(originCallId));
+    } else {
+      fputs("null", line);
+    }
+    fputs("}\n", line);
+    fclose(line);
+    FirefoxTraceWriteJSEventLineRaw(lineBuffer, lineSize);
+    free(lineBuffer);
+  }
+  sFirefoxTraceVMWindowWritten = 0;
+  sFirefoxTraceVMWindowOverwritten = 0;
+}
