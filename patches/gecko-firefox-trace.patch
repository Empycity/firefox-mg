+void FirefoxTraceRefreshJSSegmentState() {
+  const char* segmentId = FirefoxTraceEnv("TRACE_SEGMENT_ID");
+  if (!segmentId) {
+    segmentId = "";
+  }
+  if (strcmp(sFirefoxTraceJSSegmentId, segmentId) == 0) {
+    return;
+  }
+
+  strncpy(sFirefoxTraceJSSegmentId, segmentId,
+          sizeof(sFirefoxTraceJSSegmentId) - 1);
+  sFirefoxTraceJSSegmentId[sizeof(sFirefoxTraceJSSegmentId) - 1] = '\0';
+  sFirefoxTraceJSEventCount.store(0, std::memory_order_relaxed);
+  sFirefoxTraceJSLimitSentinelWritten.store(false, std::memory_order_relaxed);
+  sFirefoxTraceJSDeepSuppressionNoticeWritten.store(false,
+                                                    std::memory_order_relaxed);
+  sFirefoxTraceOpcodeEventCount.store(0, std::memory_order_relaxed);
+  sFirefoxTraceOpcodeLimitSentinelWritten.store(false,
+                                                std::memory_order_relaxed);
+  sFirefoxTraceVMStepCount.store(0, std::memory_order_relaxed);
+  sFirefoxTraceVMStepLimitSentinelWritten.store(false,
+                                                std::memory_order_relaxed);
+
+  for (size_t i = 0; i < kFirefoxTraceJSBoundaryBufferMaxCapacity; i++) {
+    if (sFirefoxTraceJSBoundaryBuffer[i].line) {
+      free(sFirefoxTraceJSBoundaryBuffer[i].line);
+      sFirefoxTraceJSBoundaryBuffer[i].line = nullptr;
+    }
+    sFirefoxTraceJSBoundaryBuffer[i].len = 0;
+    sFirefoxTraceJSBoundaryBuffer[i].seq = 0;
+    sFirefoxTraceJSBoundaryBuffer[i].flushed = false;
+  }
+  sFirefoxTraceJSBoundaryBufferWriteSeq = 0;
+  sFirefoxTraceJSBoundaryBufferFlushedSeq = 0;
+  sFirefoxTraceJSBoundaryBufferDropped = 0;
+  sFirefoxTraceJSBoundaryBufferFlushCount = 0;
+  sFirefoxTraceJSBoundaryBufferDegradedWritten = false;
+}
