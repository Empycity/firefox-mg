+bool FirefoxTraceExtractQueryParam(const nsACString& aURL, const char* aName,
+                                   nsACString& aValue) {
+  const nsCString flatURL(PromiseFlatCString(aURL));
+  nsAutoCString needle;
+  needle.AssignLiteral("?");
+  needle.Append(aName);
+  needle.Append('=');
+
+  int32_t pos = flatURL.Find(needle);
+  uint32_t valueStart = 0;
+  if (pos >= 0) {
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  } else {
+    needle.AssignLiteral("&");
+    needle.Append(aName);
+    needle.Append('=');
+    pos = flatURL.Find(needle);
+    if (pos < 0) {
+      return false;
+    }
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  }
+
+  int32_t end = flatURL.FindChar('&', valueStart);
+  if (end < 0) {
+    aValue.Assign(Substring(flatURL, valueStart));
+  } else {
+    aValue.Assign(Substring(flatURL, valueStart,
+                            static_cast<uint32_t>(end) - valueStart));
+  }
+  return true;
+}
+
+bool FirefoxTraceExtractFormParam(const nsACString& aBody, const char* aName,
+                                  nsACString& aValue) {
+  const nsCString flatBody(PromiseFlatCString(aBody));
+  nsAutoCString needle;
+  needle.Append(aName);
+  needle.Append('=');
+
+  int32_t pos = 0;
+  uint32_t valueStart = 0;
+  if (StringBeginsWith(flatBody, needle)) {
+    valueStart = needle.Length();
+  } else {
+    needle.Insert('&', 0);
+    pos = flatBody.Find(needle);
+    if (pos < 0) {
+      return false;
+    }
+    valueStart = static_cast<uint32_t>(pos) + needle.Length();
+  }
+
+  int32_t end = flatBody.FindChar('&', valueStart);
+  if (end < 0) {
+    aValue.Assign(Substring(flatBody, valueStart));
+  } else {
+    aValue.Assign(Substring(flatBody, valueStart,
+                            static_cast<uint32_t>(end) - valueStart));
+  }
+  return true;
+}
